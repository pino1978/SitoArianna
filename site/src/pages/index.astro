---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import profile from "../data/profile.json";
import results from "../data/results.json";

const videos = [
  {
    title: "World Open Championship 2026",
    subtitle: "Finale - Perugia",
    time: "03:12",
    image: "/assets/images/media-action-placeholder.png"
  },
  {
    title: "Champion Cup 2026",
    subtitle: "Semifinale - Sora",
    time: "02:45",
    image: "/assets/images/media-training-placeholder.png"
  },
  {
    title: "World Open Championship 2025",
    subtitle: "Finale - Perugia",
    time: "04:08",
    image: "/assets/images/discipline-placeholder.png"
  },
  {
    title: "Champion Cup 2025",
    subtitle: "Finale - Sora",
    time: "02:31",
    image: "/assets/images/profile-placeholder.png"
  },
  {
    title: "World Open Championship 2024",
    subtitle: "Semifinale - Perugia",
    time: "03:05",
    image: "/assets/images/ying-placeholder.png"
  }
];

const mediaCards = [
  { title: "Allenamenti", type: "Foto", image: "/assets/images/media-training-placeholder.png" },
  { title: "Gare", type: "Foto", image: "/assets/images/media-action-placeholder.png" },
  { title: "Podi", type: "Foto", image: "/assets/images/profile-placeholder.png" },
  { title: "Incontri", type: "Video", image: "/assets/images/discipline-placeholder.png" },
  { title: "Highlights", type: "Video", image: "/assets/images/ying-placeholder.png" }
];
---
<BaseLayout>
  <main id="main">
    <Hero />

    <section class="mock-highlights" id="media" aria-labelledby="highlights-title">
      <div class="section-head section-head-dark">
        <p>Highlights</p>
        <h2 id="highlights-title">I momenti che contano</h2>
        <a href="#media-gallery">Vai a tutti i video <span aria-hidden="true">→</span></a>
      </div>
      <div class="video-rail" aria-label="Video principali">
        {videos.map((video) => (
          <article class="video-card">
            <a href="#media-gallery" aria-label={`Guarda ${video.title}`}>
              <img src={video.image} alt="" loading="lazy" />
              <span class="play" aria-hidden="true">▶</span>
              <time>{video.time}</time>
            </a>
            <h3>{video.title}</h3>
            <p>{video.subtitle}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mock-duo" id="profilo" aria-label="Profilo e identita">
      <article class="mock-panel profile-panel">
        <img src="/assets/images/profile-placeholder.png" alt="Placeholder ritratto sportivo di Arianna Milano" loading="lazy" />
        <div>
          <span class="panel-number">01</span>
          <h2>Chi è Arianna</h2>
          <p>{profile.summary}</p>
          <p>Determinata, curiosa e sempre pronta a mettersi alla prova. Ogni giorno sceglie di migliorare e superare i propri limiti.</p>
          <strong class="hand-sign">Arianna</strong>
          <a class="text-link" href="#risultati">Scopri il mio profilo <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article class="mock-panel ying-panel" id="ying">
        <div>
          <span class="panel-number">02</span>
          <h2>Yīng · 鹰</h2>
          <p class="wide-tracking">Aquila</p>
          <p>Ho scelto Yīng perché l'aquila vola in alto, vede lontano e non smette mai di allenarsi. Rappresenta libertà, forza interiore e capacità di superare ogni limite.</p>
          <a class="text-link" href="#footer">Scopri il significato <span aria-hidden="true">→</span></a>
        </div>
        <img src="/assets/images/ying-placeholder.png" alt="Placeholder visivo per il significato di Yīng" loading="lazy" />
      </article>
    </section>

    <section class="mock-results" id="risultati" aria-labelledby="results-title">
      <div class="section-head section-head-dark">
        <p>03</p>
        <h2 id="results-title">I risultati principali</h2>
        <a href="#risultati">Vedi tutti i risultati <span aria-hidden="true">→</span></a>
      </div>
      <div class="results-layout">
        <div class="result-events">
          {results.highlights.slice(0, 2).map((item) => (
            <article>
              <span>{item.place}</span>
              <h3>{item.event}</h3>
              <p>{item.note}</p>
            </article>
          ))}
        </div>
        <div class="result-stats">
          {results.heroStats.map((stat) => (
            <article>
              <img src={stat.icon} alt="" aria-hidden="true" />
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </article>
          ))}
          <a class="gold-button" href="#risultati">Scopri tutti i risultati <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="mock-media" id="media-gallery" aria-labelledby="media-title">
      <div class="section-head">
        <p>04</p>
        <h2 id="media-title">Media</h2>
        <a href="#media-gallery">Vai alla gallery completa <span aria-hidden="true">→</span></a>
      </div>
      <div class="media-strip">
        {mediaCards.map((item) => (
          <article>
            <img src={item.image} alt={`Placeholder ${item.title.toLowerCase()}`} loading="lazy" />
            <div>
              <h3>{item.title}</h3>
              <p>{item.type}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer class="mock-footer" id="footer">
    <img src="/assets/svg/signature-ying.svg" alt="Yīng · 鹰" />
    <nav aria-label="Navigazione footer">
      <a href="#top">Home</a>
      <a href="#profilo">Profilo</a>
      <a href="#risultati">Risultati</a>
      <a href="#media">Media</a>
    </nav>
    <p>Per richieste di collaborazione e partnership:<br /><a href={`mailto:${profile.contactEmail}`}>{profile.contactEmail}</a></p>
  </footer>
</BaseLayout>
