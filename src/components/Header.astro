---
import logo from "../assets/svg/logo-arianna-milano.svg";
const normalizePath = (value) => value === "/" ? "/" : `${value.replace(/\/+$/, "")}/`;
const path = normalizePath(Astro.url.pathname);
const nav = [
  { href: "/", label: "Home" },
  { href: "/profilo/", label: "Profilo" },
  { href: "/risultati/", label: "Risultati" },
  { href: "/media/", label: "Media" },
  { href: "/ying/", label: "Yīng" }
];
const languages = [
  { value: "it", flag: "🇮🇹", label: "Italiano" },
  { value: "en", flag: "🇬🇧", label: "English" },
  { value: "el", flag: "🇬🇷", label: "Ελληνικά" }
];
---
<header class="site-header premium-header" data-header>
  <a class="brand-mark" href="/" data-url="/" data-site-link data-interactive aria-label="Arianna Milano · Home"><img src={logo.src} alt="Arianna Milano" width={logo.width} height={logo.height} /></a>
  <div class="header-actions">
    <nav class="primary-nav premium-nav" aria-label="Navigazione principale">
      {nav.map(item => <a href={item.href} data-url={item.href} data-site-link data-interactive aria-current={path === normalizePath(item.href) ? "page" : undefined}>{item.label}</a>)}
    </nav>
    <label class="language-select"><span class="sr-only">Lingua</span><select data-language data-interactive aria-label="Seleziona lingua">{languages.map(lang => <option value={lang.value}>{lang.flag} {lang.value.toUpperCase()}</option>)}</select></label>
  </div>
  <button class="nav-toggle" type="button" data-nav-toggle data-interactive aria-expanded="false" aria-controls="mobile-nav" aria-label="Apri menu"><span></span><span></span><span></span><b>Menu</b></button>
  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <div class="mobile-nav__inner">
      <div class="mobile-nav__top"><p>ARIANNA MILANO</p><strong class="mobile-ying">YĪNG · 鹰 <span aria-hidden="true">🦅</span></strong></div>
      {nav.map((item,index) => <a href={item.href} data-url={item.href} data-site-link data-interactive aria-current={path === normalizePath(item.href) ? "page" : undefined}><span>0{index+1}</span>{item.label}</a>)}
      <div class="mobile-nav__footer"><small>Sanda athlete · Napoli</small><label class="mobile-language"><span>Lingua</span><select data-language data-interactive aria-label="Seleziona lingua">{languages.map(lang => <option value={lang.value}>{lang.flag} {lang.value.toUpperCase()}</option>)}</select></label></div>
    </div>
  </div>
  <div id="google_translate_element" hidden></div>
</header>
<script is:inline>
  window.googleTranslateElementInit = () => {
    if (!window.google?.translate?.TranslateElement) return;
    new window.google.translate.TranslateElement({pageLanguage:'it',includedLanguages:'it,en,el',autoDisplay:false},'google_translate_element');
  };
</script>
<script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async></script>
<script>
  const header=document.querySelector('[data-header]');
  const toggle=header?.querySelector('[data-nav-toggle]');
  const menu=header?.querySelector('[data-mobile-nav]');
  const close=()=>{if(!(toggle instanceof HTMLButtonElement)||!(menu instanceof HTMLElement))return;toggle.setAttribute('aria-expanded','false');toggle.setAttribute('aria-label','Apri menu');menu.hidden=true;document.body.classList.remove('nav-open');};
  toggle?.addEventListener('click',()=>{if(!(toggle instanceof HTMLButtonElement)||!(menu instanceof HTMLElement))return;const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Chiudi menu':'Apri menu');menu.hidden=!open;document.body.classList.toggle('nav-open',open);if(open)menu.querySelector('a')?.focus();});
  header?.querySelectorAll('[data-site-link]').forEach(link=>link.addEventListener('click',event=>{const target=link.getAttribute('data-url')||link.getAttribute('href');if(!target)return;event.preventDefault();close();window.location.assign(target);}));
  document.addEventListener('keydown',e=>{if(e.key==='Escape')close();});
  const languageSelects=[...document.querySelectorAll('[data-language]')];
  const match=document.cookie.match(/(?:^|;\s*)googtrans=\/it\/([^;]+)/);
  const current=['it','en','el'].includes(match?.[1]||'') ? match[1] : 'it';
  languageSelects.forEach(select=>{if(select instanceof HTMLSelectElement){select.value=current;select.addEventListener('change',()=>{const lang=['en','el'].includes(select.value)?select.value:'it';document.cookie=`googtrans=/it/${lang};path=/;max-age=31536000;SameSite=Lax`;document.cookie=`googtrans=/it/${lang};path=/;domain=.ariannamilano.it;max-age=31536000;SameSite=Lax`;location.reload();});}});
</script>
<style is:global>
.goog-te-banner-frame.skiptranslate,.goog-te-gadget-icon{display:none!important}body{top:0!important}.premium-header{position:fixed!important;z-index:9000!important;top:0!important;left:0!important;right:0!important;display:grid!important;grid-template-columns:160px 1fr!important;align-items:start!important;width:100%!important;max-width:none!important;margin:0!important;padding:22px clamp(24px,3vw,48px) 18px!important;transform:none!important;background:linear-gradient(180deg,rgba(4,4,4,.82),rgba(4,4,4,.34) 58%,transparent);pointer-events:none}.premium-header .brand-mark,.premium-header .header-actions,.premium-header .nav-toggle{pointer-events:auto}.premium-header .brand-mark{width:150px}.premium-header .brand-mark img{width:150px}.header-actions{display:flex;align-items:flex-start;justify-content:flex-end;gap:clamp(14px,1.4vw,24px);min-width:0}.premium-nav{display:flex;align-items:center;justify-content:flex-end;gap:clamp(15px,1.7vw,28px);padding-top:13px}.premium-nav a{position:relative;color:rgba(245,240,231,.78);font-family:var(--font-ui);font-size:.62rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;transition:color .2s ease}.premium-nav a:hover,.premium-nav a:focus-visible,.premium-nav a[aria-current="page"]{color:var(--gold-bright)}.premium-nav a::after{position:absolute;left:50%;right:50%;bottom:-9px;height:1px;background:var(--gold-bright);content:"";transition:left .2s ease,right .2s ease}.premium-nav a:hover::after,.premium-nav a:focus-visible::after,.premium-nav a[aria-current="page"]::after{left:0;right:0}.language-select{padding-top:7px}.language-select select,.mobile-language select{border:1px solid rgba(185,134,50,.42);background:rgba(6,6,6,.42);color:var(--gold-bright);padding:7px 9px;font:800 .62rem/1 var(--font-ui);letter-spacing:.06em;cursor:pointer}.mobile-nav{display:none}.nav-toggle{display:none}
@media(max-width:1000px){.premium-header{grid-template-columns:1fr auto!important;padding:18px 18px 14px!important;min-height:74px!important;background:linear-gradient(180deg,rgba(4,4,4,.9),rgba(4,4,4,.48) 65%,transparent)!important}.header-actions{display:none!important}.premium-header .brand-mark{width:122px!important;height:44px!important}.premium-header .brand-mark img{width:118px!important}.premium-header .nav-toggle{position:fixed!important;z-index:10001!important;top:18px!important;right:18px!important;display:block!important;width:82px!important;height:42px!important;min-width:82px!important;min-height:42px!important;padding:0!important;border:1px solid rgba(185,134,50,.42)!important;background:rgba(6,6,6,.76)!important;color:var(--ivory)!important;backdrop-filter:blur(10px);box-sizing:border-box!important}.premium-header .nav-toggle span{position:absolute!important;left:11px!important;width:18px!important;height:1px!important;background:var(--gold-bright)!important;margin:0!important;transform:none!important}.premium-header .nav-toggle span:nth-child(1){top:13px!important}.premium-header .nav-toggle span:nth-child(2){top:20px!important}.premium-header .nav-toggle span:nth-child(3){top:27px!important}.premium-header .nav-toggle b{position:absolute!important;left:38px!important;top:50%!important;transform:translateY(-50%)!important;margin:0!important;font:700 .56rem/1 var(--font-ui)!important;letter-spacing:.1em!important;text-transform:uppercase!important;white-space:nowrap!important}.mobile-nav{position:fixed!important;z-index:9998!important;inset:0!important;display:block!important;overflow-y:auto!important;background:rgba(5,5,5,.985)!important;padding:88px 26px 30px!important;pointer-events:auto!important}.mobile-nav[hidden]{display:none!important}.mobile-nav__inner{display:grid!important;max-width:520px!important;margin:0 auto!important}.mobile-nav__top{display:flex;align-items:center;justify-content:space-between;min-height:62px;margin-bottom:8px;border-bottom:1px solid rgba(185,134,50,.22)}.mobile-nav__top>p{margin:0!important;color:var(--gold-bright)!important;font:800 .6rem var(--font-ui)!important;letter-spacing:.17em!important}.mobile-ying{color:var(--gold-bright);font:800 .9rem/1 var(--font-display);letter-spacing:.05em;white-space:nowrap}.mobile-ying span{font-size:1.2rem}.mobile-nav__inner>a{display:grid!important;grid-template-columns:34px 1fr!important;align-items:center!important;padding:11px 0!important;border-top:1px solid rgba(185,134,50,.22)!important;font:800 clamp(1.5rem,6.4vw,2rem)/1 var(--font-display)!important;letter-spacing:.005em!important;text-transform:uppercase!important}.mobile-nav__inner>a span{color:var(--gold-bright)!important;font:700 .54rem var(--font-ui)!important;letter-spacing:.11em!important}.mobile-nav__inner>a[aria-current="page"]{color:var(--gold-bright)!important}.mobile-nav__footer{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:18px}.mobile-nav__inner small{color:rgba(245,240,231,.5)!important;font:700 .56rem var(--font-ui)!important;letter-spacing:.11em!important;text-transform:uppercase!important}.mobile-language{display:flex;align-items:center;gap:8px;color:rgba(245,240,231,.5);font:700 .54rem var(--font-ui);letter-spacing:.1em;text-transform:uppercase}.nav-open{overflow:hidden!important}}
@media(max-width:390px){.mobile-nav{padding-inline:22px!important}.mobile-nav__inner>a{font-size:clamp(1.42rem,6.4vw,1.8rem)!important;padding:10px 0!important}.mobile-ying{font-size:.8rem}}
</style>