---
import logo from "../assets/svg/logo-arianna-milano.svg";
import yingHeaderMark from "../assets/images/ying-header-mark.png";
---
<header class="site-header site-header--locked" data-header>
  <div class="brand-mark" aria-label="Arianna Milano">
    <img src={logo.src} alt="Arianna Milano" width={logo.width} height={logo.height} />
  </div>

  <img class="ying-header-mark" src={yingHeaderMark.src} alt="" aria-hidden="true" width={yingHeaderMark.width} height={yingHeaderMark.height} />

  <div class="language-select" aria-hidden="true">
    <span>IT</span>
  </div>
</header>

<style is:global>
  .site-header--locked {
    grid-template-columns: 188px 1fr auto auto;
  }

  .site-header--locked .brand-mark {
    pointer-events: none;
  }

  .site-header--locked .ying-header-mark {
    grid-column: 3;
  }

  .site-header--locked .language-select {
    grid-column: 4;
    justify-self: end;
    padding-top: 15px;
    color: var(--gold-bright);
    font-family: var(--font-ui);
    font-size: .64rem;
    font-weight: 800;
    letter-spacing: .12em;
  }

  @media (max-width: 1000px) {
    .site-header--locked {
      grid-template-columns: 160px 1fr;
    }

    .site-header--locked .ying-header-mark,
    .site-header--locked .language-select {
      display: none;
    }
  }
</style>
