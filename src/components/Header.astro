---
import logo from "../assets/svg/logo-arianna-milano.svg";
import yingHeaderMark from "../assets/images/ying-header-mark.png";
const normalizePath = (value) => value === "/" ? "/" : `${value.replace(/\/+$/, "")}/`;
const path = normalizePath(Astro.url.pathname);
const nav = [
  { href: "/", label: "Home" },
  { href: "/profilo/", label: "Profilo" },
  { href: "/risultati/", label: "Palmarès" },
  { href: "/ying/", label: "Yīng" }
];
---
<header class="site-header premium-header" data-header>
  <a class="brand-mark" href="/" data-url="/" data-site-link data-interactive aria-label="Arianna Milano · Home"><img src={logo.src} alt="Arianna Milano" width={logo.width} height={logo.height} /></a>
  <div class="header-actions">
    <nav class="primary-nav premium-nav" aria-label="Navigazione principale">
      {nav.map(item => <a href={item.href} data-url={item.href} data-site-link data-interactive aria-current={path === normalizePath(item.href) ? "page" : undefined}>{item.label}</a>)}
    </nav>
    <a class="ying-header-link" href="/ying/" data-url="/ying/" data-site-link data-interactive aria-label="Yīng · Il nome sul tatami"><img class="ying-header-mark" src={yingHeaderMark.src} alt="Yīng" width={yingHeaderMark.width} height={yingHeaderMark.height} /></a>
    <span class="language-select" aria-hidden="true">IT</span>
  </div>
  <button class="nav-toggle" type="button" data-nav-toggle data-interactive aria-expanded="false" aria-controls="mobile-nav" aria-label="Apri menu"><span></span><span></span><span></span><b>Menu</b></button>
  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <div class="mobile-nav__inner">
      <p>ARIANNA MILANO</p>
      {nav.map((item,index) => <a href={item.href} data-url={item.href} data-site-link data-interactive aria-current={path === normalizePath(item.href) ? "page" : undefined}><span>0{index+1}</span>{item.label}</a>)}
      <small>Sanda athlete · Napoli</small>
    </div>
  </div>
</header>
<script>
  const header=document.querySelector('[data-header]');
  const toggle=header?.querySelector('[data-nav-toggle]');
  const menu=header?.querySelector('[data-mobile-nav]');
  const close=()=>{if(!(toggle instanceof HTMLButtonElement)||!(menu instanceof HTMLElement))return;toggle.setAttribute('aria-expanded','false');toggle.setAttribute('aria-label','Apri menu');menu.hidden=true;document.body.classList.remove('nav-open');};
  toggle?.addEventListener('click',()=>{if(!(toggle instanceof HTMLButtonElement)||!(menu instanceof HTMLElement))return;const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Chiudi menu':'Apri menu');menu.hidden=!open;document.body.classList.toggle('nav-open',open);if(open)menu.querySelector('a')?.focus();});
  header?.querySelectorAll('[data-site-link]').forEach(link=>link.addEventListener('click',event=>{
    const target=link.getAttribute('data-url')||link.getAttribute('href');
    if(!target)return;
    event.preventDefault();
    close();
    window.location.assign(target);
  }));
  document.addEventListener('keydown',e=>{if(e.key==='Escape')close();});
</script>
<style is:global>
.premium-header{position:fixed!important;z-index:9000!important;top:0!important;left:0!important;right:0!important;display:grid!important;grid-template-columns:160px 1fr!important;align-items:start!important;width:100%!important;max-width:none!important;margin:0!important;padding:22px clamp(24px,3vw,48px) 18px!important;transform:none!important;background:linear-gradient(180deg,rgba(4,4,4,.82),rgba(4,4,4,.34) 58%,transparent);pointer-events:none}.premium-header .brand-mark,.premium-header .header-actions,.premium-header .nav-toggle{pointer-events:auto}.premium-header .brand-mark{width:150px}.premium-header .brand-mark img{width:150px}.header-actions{display:flex;align-items:flex-start;justify-content:flex-end;gap:clamp(16px,1.6vw,28px);min-width:0}.premium-nav{display:flex;align-items:center;justify-content:flex-end;gap:clamp(18px,2vw,34px);padding-top:13px}.premium-nav a{position:relative;color:rgba(245,240,231,.78);font-family:var(--font-ui);font-size:.62rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;transition:color .2s ease}.premium-nav a:hover,.premium-nav a:focus-visible,.premium-nav a[aria-current="page"]{color:var(--gold-bright)}.premium-nav a::after{position:absolute;left:50%;right:50%;bottom:-9px;height:1px;background:var(--gold-bright);content:"";transition:left .2s ease,right .2s ease}.premium-nav a:hover::after,.premium-nav a:focus-visible::after,.premium-nav a[aria-current="page"]::after{left:0;right:0}.ying-header-link{display:block;width:92px;margin-top:5px}.premium-header .ying-header-mark{width:92px;height:auto;margin:0;padding:0;opacity:.9}.premium-header .language-select{padding-top:13px;color:var(--gold-bright);font-family:var(--font-ui);font-size:.62rem;font-weight:800;letter-spacing:.12em}.mobile-nav{display:none}.nav-toggle{display:none}
@media(max-width:1000px){
  .premium-header{grid-template-columns:1fr auto!important;padding:18px 18px 14px!important;min-height:74px!important;background:linear-gradient(180deg,rgba(4,4,4,.9),rgba(4,4,4,.48) 65%,transparent)!important}
  .header-actions{display:none!important}
  .premium-header .brand-mark{width:122px!important;height:44px!important}.premium-header .brand-mark img{width:118px!important}
  .premium-header .nav-toggle{position:fixed!important;z-index:10001!important;top:18px!important;right:18px!important;display:grid!important;grid-template-columns:20px auto!important;grid-template-rows:repeat(3,4px)!important;align-items:center!important;column-gap:8px!important;width:78px!important;min-width:78px!important;height:42px!important;min-height:42px!important;padding:7px 9px!important;border:1px solid rgba(185,134,50,.42)!important;background:rgba(6,6,6,.74)!important;color:var(--ivory)!important;backdrop-filter:blur(10px);font:700 .58rem var(--font-ui)!important;letter-spacing:.1em!important;text-transform:uppercase!important;box-sizing:border-box!important}
  .premium-header .nav-toggle span{grid-column:1!important;width:18px!important;height:1px!important;background:var(--gold-bright)!important}.premium-header .nav-toggle b{grid-column:2!important;grid-row:1/4!important;font:inherit!important}
  .mobile-nav{position:fixed!important;z-index:9998!important;inset:0!important;display:block!important;overflow-y:auto!important;background:rgba(5,5,5,.985)!important;padding:100px 26px 34px!important;pointer-events:auto!important}.mobile-nav[hidden]{display:none!important}
  .mobile-nav__inner{display:grid!important;max-width:520px!important;margin:0 auto!important}.mobile-nav__inner>p{margin:0 0 18px!important;color:var(--gold-bright)!important;font:800 .62rem var(--font-ui)!important;letter-spacing:.17em!important}.mobile-nav__inner>a{display:grid!important;grid-template-columns:36px 1fr!important;align-items:center!important;padding:12px 0!important;border-top:1px solid rgba(185,134,50,.22)!important;font:800 clamp(1.65rem,7vw,2.2rem)/1 var(--font-display)!important;letter-spacing:.01em!important;text-transform:uppercase!important}.mobile-nav__inner>a span{color:var(--gold-bright)!important;font:700 .56rem var(--font-ui)!important;letter-spacing:.12em!important}.mobile-nav__inner>a[aria-current="page"]{color:var(--gold-bright)!important}.mobile-nav__inner small{margin-top:22px!important;color:rgba(245,240,231,.52)!important;font:700 .58rem var(--font-ui)!important;letter-spacing:.11em!important;text-transform:uppercase!important}.nav-open{overflow:hidden!important}
}
@media(max-width:390px){.mobile-nav{padding-inline:22px!important}.mobile-nav__inner>a{font-size:clamp(1.55rem,7vw,1.95rem)!important;padding:11px 0!important}}
</style>