---
import logo from "../assets/svg/logo-arianna-milano.svg";
const normalizePath = (value) => value === "/" ? "/" : `${value.replace(/\/+$/, "")}/`;
const path = normalizePath(Astro.url.pathname);
const nav = [
  { href: "/", label: "Home" },
  { href: "/profilo/", label: "Profilo" },
  { href: "/risultati/", label: "Risultati" },
  { href: "/media/", label: "Media" },
  { href: "/ying/", label: "Yīng" }
];
const languages = [
  { value: "it", code: "IT", label: "Italiano" },
  { value: "en", code: "EN", label: "English" },
  { value: "el", code: "EL", label: "Ελληνικά" }
];
---
<header class="site-header premium-header" data-header>
  <a class="brand-mark" href="/" data-url="/" data-site-link data-interactive aria-label="Arianna Milano · Home"><img src={logo.src} alt="Arianna Milano" width={logo.width} height={logo.height} /></a>

  <div class="header-actions">
    <nav class="primary-nav premium-nav" aria-label="Navigazione principale">
      {nav.map(item => <a href={item.href} data-url={item.href} data-site-link data-interactive aria-current={path === normalizePath(item.href) ? "page" : undefined}>{item.label}</a>)}
    </nav>
  </div>

  <div class="language-picker notranslate" translate="no" data-language-picker>
    <button type="button" class="language-trigger" data-language-trigger data-interactive aria-haspopup="listbox" aria-expanded="false" aria-label="Seleziona lingua">
      <span class="flag flag-it" data-language-flag aria-hidden="true"></span><b data-language-code>IT</b><i aria-hidden="true">⌄</i>
    </button>
    <div class="language-options" data-language-options role="listbox" aria-label="Seleziona lingua" hidden>
      {languages.map(lang => <button type="button" role="option" data-interactive data-lang={lang.value} aria-label={lang.label}><span class={`flag flag-${lang.value}`} aria-hidden="true"></span><b>{lang.code}</b><small>{lang.label}</small></button>)}
    </div>
  </div>

  <button class="nav-toggle notranslate" translate="no" type="button" data-nav-toggle data-interactive aria-expanded="false" aria-controls="mobile-nav" aria-label="Apri menu"><span></span><span></span><span></span><b data-nav-toggle-label>Menu</b></button>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <div class="mobile-nav__inner">
      <div class="mobile-nav__top"><p>ARIANNA MILANO</p><strong class="mobile-ying">YĪNG · 鹰 <span aria-hidden="true">🦅</span></strong></div>
      {nav.map(item => <a href={item.href} data-url={item.href} data-site-link data-interactive aria-current={path === normalizePath(item.href) ? "page" : undefined}>{item.label}</a>)}
      <div class="mobile-nav__footer"><small>Sanda athlete · Napoli</small></div>
    </div>
  </div>
  <div id="google_translate_element" hidden></div>
</header>

<script is:inline>
  window.googleTranslateElementInit = () => {
    if (!window.google?.translate?.TranslateElement) return;
    new window.google.translate.TranslateElement({pageLanguage:'it',includedLanguages:'it,en,el',autoDisplay:false},'google_translate_element');
  };
</script>
<script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async></script>
<script>
  const header=document.querySelector('[data-header]');
  const toggle=header?.querySelector('[data-nav-toggle]');
  const toggleLabel=header?.querySelector('[data-nav-toggle-label]');
  const menu=header?.querySelector('[data-mobile-nav]');
  const picker=header?.querySelector('[data-language-picker]');
  const trigger=header?.querySelector('[data-language-trigger]');
  const options=header?.querySelector('[data-language-options]');

  const setToggleState=(open)=>{if(!(toggle instanceof HTMLButtonElement))return;toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Chiudi menu':'Apri menu');if(toggleLabel)toggleLabel.textContent=open?'Chiudi':'Menu';toggle.classList.toggle('is-open',open);};
  const close=()=>{if(!(toggle instanceof HTMLButtonElement)||!(menu instanceof HTMLElement))return;setToggleState(false);menu.hidden=true;document.body.classList.remove('nav-open');};
  toggle?.addEventListener('click',()=>{if(!(toggle instanceof HTMLButtonElement)||!(menu instanceof HTMLElement))return;const open=toggle.getAttribute('aria-expanded')!=='true';setToggleState(open);menu.hidden=!open;document.body.classList.toggle('nav-open',open);if(open)menu.querySelector('a')?.focus();});
  header?.querySelectorAll('[data-site-link]').forEach(link=>link.addEventListener('click',event=>{const target=link.getAttribute('data-url')||link.getAttribute('href');if(!target)return;event.preventDefault();close();window.location.assign(target);}));

  const match=document.cookie.match(/(?:^|;\s*)googtrans=\/it\/([^;]+)/);
  const current=['it','en','el'].includes(match?.[1]||'') ? match[1] : 'it';
  const meta={it:{code:'IT'},en:{code:'EN'},el:{code:'EL'}};
  const setTrigger=(lang)=>{const info=meta[lang]||meta.it;const flag=header?.querySelector('[data-language-flag]');const code=header?.querySelector('[data-language-code]');if(flag)flag.className=`flag flag-${lang}`;if(code)code.textContent=info.code;};
  setTrigger(current);
  trigger?.addEventListener('click',event=>{event.stopPropagation();if(!(trigger instanceof HTMLButtonElement)||!(options instanceof HTMLElement))return;const open=options.hidden;options.hidden=!open;trigger.setAttribute('aria-expanded',String(open));});
  document.addEventListener('click',event=>{if(options instanceof HTMLElement&&trigger instanceof HTMLButtonElement&&picker instanceof HTMLElement&&!picker.contains(event.target)){options.hidden=true;trigger.setAttribute('aria-expanded','false');}});
  document.addEventListener('keydown',event=>{if(event.key==='Escape'){close();if(options instanceof HTMLElement)options.hidden=true;if(trigger instanceof HTMLButtonElement)trigger.setAttribute('aria-expanded','false');}});
  header?.querySelectorAll('[data-lang]').forEach(button=>{if(button instanceof HTMLButtonElement){button.setAttribute('aria-selected',String(button.dataset.lang===current));button.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();const lang=['en','el'].includes(button.dataset.lang||'')?button.dataset.lang:'it';document.cookie=`googtrans=/it/${lang};path=/;max-age=31536000;SameSite=Lax`;document.cookie=`googtrans=/it/${lang};path=/;domain=.ariannamilano.it;max-age=31536000;SameSite=Lax`;location.reload();});}});

  const hideTranslateChrome=()=>{document.querySelectorAll('.goog-te-banner-frame,.VIpgJd-ZVi9od-ORHb-OEVmcd,.VIpgJd-ZVi9od-aZ2wEe-wOHMyf,body > .skiptranslate').forEach(el=>{if(el instanceof HTMLElement)el.style.setProperty('display','none','important');});document.documentElement.style.setProperty('margin-top','0','important');document.body.style.setProperty('top','0','important');};
  hideTranslateChrome();const translateObserver=new MutationObserver(hideTranslateChrome);translateObserver.observe(document.documentElement,{childList:true,subtree:true});window.addEventListener('load',hideTranslateChrome);
</script>

<style is:global>
.goog-te-banner-frame.skiptranslate,.goog-te-banner-frame,.goog-te-gadget-icon,.VIpgJd-ZVi9od-ORHb-OEVmcd,.VIpgJd-ZVi9od-aZ2wEe-wOHMyf,body > .skiptranslate{display:none!important}html{margin-top:0!important}body{top:0!important}
.premium-header{position:fixed!important;z-index:9000!important;top:0!important;left:0!important;right:0!important;display:grid!important;grid-template-columns:160px 1fr auto!important;align-items:start!important;width:100%!important;max-width:none!important;margin:0!important;padding:22px clamp(24px,3vw,48px) 18px!important;transform:none!important;background:linear-gradient(180deg,rgba(4,4,4,.82),rgba(4,4,4,.34) 58%,transparent);pointer-events:none}.premium-header .brand-mark,.premium-header .header-actions,.premium-header .nav-toggle,.premium-header .language-picker{pointer-events:auto}.premium-header .brand-mark{width:150px}.premium-header .brand-mark img{width:150px}.header-actions{display:flex;align-items:flex-start;justify-content:flex-end;min-width:0}.premium-nav{display:flex;align-items:center;justify-content:flex-end;gap:clamp(15px,1.7vw,28px);padding-top:13px}.premium-nav a{position:relative;color:rgba(245,240,231,.78);font-family:var(--font-ui);font-size:.62rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.premium-nav a:hover,.premium-nav a:focus-visible,.premium-nav a[aria-current="page"]{color:var(--gold-bright)}.premium-nav a::after{position:absolute;left:50%;right:50%;bottom:-9px;height:1px;background:var(--gold-bright);content:""}.premium-nav a:hover::after,.premium-nav a:focus-visible::after,.premium-nav a[aria-current="page"]::after{left:0;right:0}
.language-picker{position:relative;margin:6px 0 0 20px;z-index:10002}.language-trigger{display:flex;align-items:center;gap:7px;min-width:82px;height:34px;padding:0 9px;border:1px solid rgba(185,134,50,.42);background:rgba(6,6,6,.42);color:var(--gold-bright);cursor:pointer!important;box-sizing:border-box}.language-trigger b{font:800 .62rem/1 var(--font-ui);letter-spacing:.08em}.language-trigger i{margin-left:auto;color:var(--gold-bright);font-style:normal}.language-options{position:absolute;top:40px;right:0;min-width:154px;padding:5px;border:1px solid rgba(185,134,50,.34);background:#0a0907;box-shadow:0 12px 30px rgba(0,0,0,.35);z-index:10003}.language-options[hidden]{display:none}.language-options button{display:grid;grid-template-columns:27px 28px 1fr;align-items:center;width:100%;padding:9px 8px;border:0;background:transparent;color:#eee7da;text-align:left;cursor:pointer!important}.language-options button:hover,.language-options button[aria-selected="true"]{background:rgba(185,134,50,.12);color:var(--gold-bright)}.language-options button b{font:800 .62rem var(--font-ui)}.language-options button small{font:600 .62rem var(--font-ui);opacity:.72}
.flag{display:inline-block;width:20px;height:13px;border:1px solid rgba(255,255,255,.24);box-shadow:0 0 0 1px rgba(0,0,0,.16);vertical-align:middle}.flag-it{background:linear-gradient(90deg,#169b62 0 33.333%,#fff 33.333% 66.666%,#ce2b37 66.666% 100%)}.flag-en{background:linear-gradient(27deg,transparent 43%,#fff 43% 48%,#c8102e 48% 52%,#fff 52% 57%,transparent 57%),linear-gradient(-27deg,transparent 43%,#fff 43% 48%,#c8102e 48% 52%,#fff 52% 57%,transparent 57%),linear-gradient(90deg,transparent 42%,#fff 42% 46%,#c8102e 46% 54%,#fff 54% 58%,transparent 58%),linear-gradient(0deg,transparent 38%,#fff 38% 43%,#c8102e 43% 57%,#fff 57% 62%,transparent 62%),#012169}.flag-el{background:repeating-linear-gradient(180deg,#0d5eaf 0 1.44px,#fff 1.44px 2.88px)}.mobile-nav{display:none}.nav-toggle{display:none}
@media(max-width:1000px){.premium-header{grid-template-columns:1fr!important;padding:18px 18px 14px!important;min-height:74px!important;background:linear-gradient(180deg,rgba(4,4,4,.9),rgba(4,4,4,.48) 65%,transparent)!important}.header-actions{display:none!important}.premium-header .brand-mark{width:122px!important;height:44px!important}.premium-header .brand-mark img{width:118px!important}.premium-header .nav-toggle{position:fixed!important;z-index:10001!important;top:18px!important;right:84px!important;display:block!important;width:86px!important;height:42px!important;min-width:86px!important;min-height:42px!important;padding:0!important;border:1px solid rgba(185,134,50,.42)!important;background:rgba(6,6,6,.76)!important;color:var(--ivory)!important;backdrop-filter:blur(10px);box-sizing:border-box!important}.premium-header .nav-toggle span{position:absolute!important;left:11px!important;width:17px!important;height:1px!important;background:var(--gold-bright)!important}.premium-header .nav-toggle span:nth-child(1){top:13px!important}.premium-header .nav-toggle span:nth-child(2){top:20px!important}.premium-header .nav-toggle span:nth-child(3){top:27px!important}.premium-header .nav-toggle b{position:absolute!important;left:35px!important;top:50%!important;transform:translateY(-50%)!important;margin:0!important;font:700 .54rem/1 var(--font-ui)!important;letter-spacing:.09em!important;text-transform:uppercase!important}.premium-header .nav-toggle.is-open span:nth-child(1){top:20px!important;transform:rotate(45deg)!important}.premium-header .nav-toggle.is-open span:nth-child(2){opacity:0!important}.premium-header .nav-toggle.is-open span:nth-child(3){top:20px!important;transform:rotate(-45deg)!important}.language-picker{position:fixed!important;z-index:10002!important;top:18px!important;right:18px!important;margin:0!important}.language-trigger{justify-content:center!important;gap:5px!important;width:58px!important;min-width:58px!important;height:42px!important;padding:0 5px!important;background:transparent!important;color:var(--ivory)!important;backdrop-filter:blur(4px)}.language-trigger .flag{width:17px;height:11px}.language-trigger b{font:800 .53rem/1 var(--font-ui)!important}.language-trigger i{margin-left:0!important;font-size:.66rem!important}.language-options{top:48px!important;right:0!important;min-width:92px!important;width:92px!important;padding:5px!important;background:rgba(246,240,230,.98)!important;border:1px solid rgba(185,134,50,.38)!important;box-shadow:0 10px 28px rgba(0,0,0,.2)!important}.language-options button{display:flex!important;align-items:center!important;gap:8px!important;padding:8px 7px!important;color:#171c20!important}.language-options button small{display:none!important}.language-options button[aria-selected="true"]{background:rgba(185,134,50,.13)!important;color:#8d6218!important}.mobile-nav{position:fixed!important;z-index:9998!important;inset:0!important;display:block!important;overflow-y:auto!important;background:rgba(5,5,5,.985)!important;padding:86px 26px 28px!important;pointer-events:auto!important}.mobile-nav[hidden]{display:none!important}.mobile-nav__inner{display:grid!important;max-width:520px!important;margin:0 auto!important}.mobile-nav__top{display:flex;align-items:center;justify-content:space-between;min-height:52px;margin-bottom:6px;border-bottom:1px solid rgba(185,134,50,.22)}.mobile-nav__top>p{margin:0!important;color:var(--gold-bright)!important;font:800 .58rem var(--font-ui)!important;letter-spacing:.16em!important}.mobile-ying{color:var(--gold-bright);font:800 .78rem/1 var(--font-display);letter-spacing:.05em;white-space:nowrap}.mobile-ying span{font-size:1rem}.mobile-nav__inner>a{display:flex!important;align-items:center!important;min-height:58px!important;padding:0!important;border-top:1px solid rgba(185,134,50,.22)!important;font:700 1.42rem/1 var(--font-display)!important;letter-spacing:.002em!important;text-transform:uppercase!important}.mobile-nav__inner>a[aria-current="page"]{color:var(--gold-bright)!important}.mobile-nav__footer{display:grid;gap:11px;margin-top:14px}.mobile-nav__inner small{color:rgba(245,240,231,.5)!important;font:700 .54rem var(--font-ui)!important;letter-spacing:.1em!important;text-transform:uppercase!important}.nav-open{overflow:hidden!important}}
@media(max-width:390px){.premium-header .brand-mark{width:112px!important}.premium-header .brand-mark img{width:108px!important}.premium-header .nav-toggle{right:82px!important;width:84px!important;min-width:84px!important}.language-trigger{width:56px!important;min-width:56px!important}.mobile-nav{padding-inline:22px!important}.mobile-nav__inner>a{font-size:1.32rem!important;min-height:56px!important}.mobile-ying{font-size:.74rem}}
</style>