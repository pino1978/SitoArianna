---
import Header from "./Header.astro";
import profile from "../data/profile.json";
import heroImageSmall from "../assets/images/optimized/home-hero-640.webp";
import heroImageMedium from "../assets/images/optimized/home-hero-1280.webp";
import heroImageLarge from "../assets/images/optimized/home-hero-1774.webp";
import heroImageSmallAvif from "../assets/images/optimized/home-hero-640.avif";
import heroImageMediumAvif from "../assets/images/optimized/home-hero-1280.avif";
import heroImageLargeAvif from "../assets/images/optimized/home-hero-1774.avif";
import heroTitleImage from "../assets/images/optimized/home-title-1200.webp";
import heroTitleImageAvif from "../assets/images/optimized/home-title-1200.avif";
import heroEagleLayerImage from "../assets/images/optimized/home-eagle-900.webp";
import heroEagleLayerImageAvif from "../assets/images/optimized/home-eagle-900.avif";

const copy = profile.content.home.hero;
---
<section class="hero hero--home" id="top" aria-labelledby="hero-title" data-home-hero-layout="compact-v3" style={`--hero-bg-small:image-set(url("${heroImageSmallAvif.src}") type("image/avif"),url("${heroImageSmall.src}") type("image/webp"));--hero-bg-medium:image-set(url("${heroImageMediumAvif.src}") type("image/avif"),url("${heroImageMedium.src}") type("image/webp"));--hero-bg-large:image-set(url("${heroImageLargeAvif.src}") type("image/avif"),url("${heroImageLarge.src}") type("image/webp"));--hero-title:image-set(url("${heroTitleImageAvif.src}") type("image/avif"),url("${heroTitleImage.src}") type("image/webp"));--hero-eagle:image-set(url("${heroEagleLayerImageAvif.src}") type("image/avif"),url("${heroEagleLayerImage.src}") type("image/webp"))`}>
  <div class="hero-overlay hero-overlay-left" aria-hidden="true"></div>
  <div class="hero-overlay hero-overlay-right" aria-hidden="true"></div>
  <div class="hero-overlay hero-overlay-bottom" aria-hidden="true"></div>
  <div class="hero-overlay hero-overlay-top" aria-hidden="true"></div>

  <Header />

  <div class="hero-upper-signature" aria-hidden="true">
    <span class="hero-upper-signature__eyebrow">Yīng · 鹰</span>
  </div>

  <div class="hero-copy">
    <h1 id="hero-title" class="hero-identity">Arianna Milano · Atleta di Sanda e Kung Fu</h1>
    <span class="hero-title-image" aria-hidden="true"></span>
    <p class="hero-subcopy">{copy.subcopy}<br /><strong>{copy.subcopyStrong}</strong></p>
    <p class="hero-affiliation">ASD Kasoria Kombat &amp; Fly · CSEN</p>
  </div>

  <span class="hero-eagle-layer" aria-hidden="true"></span>
</section>

<section class="hero-values" aria-label="I valori di Arianna">
  <div class="hero-values__inner">
    {copy.mobileValues.map((value, index) => index === 2 ? <strong>{value}</strong> : <span>{value}</span>)}
  </div>
</section>

<style>
  .hero-upper-signature,
  .hero-values { display: none; }
  .hero.hero--home { background-image: var(--hero-bg-small); }
  .hero-title-image { display: block; aspect-ratio: 1; background: center / contain no-repeat var(--hero-title); }
  .hero-eagle-layer { display: block; aspect-ratio: 5 / 4; background: center / contain no-repeat var(--hero-eagle); }
  .hero-identity {
    margin: 0 0 14px;
    color: rgba(245, 240, 231, .82);
    font: 800 clamp(.64rem, .72vw, .78rem)/1.25 var(--font-ui);
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .hero-affiliation {
    margin: 12px 0 0;
    color: rgba(245, 240, 231, .58);
    font: 700 clamp(.55rem, .62vw, .68rem)/1.3 var(--font-ui);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  @media (min-width: 1001px) {
    .hero { min-height: clamp(610px, 78vh, 760px); padding-bottom: 56px; background-image: var(--hero-bg-large); }
    .hero-subcopy { margin-top: 84px; }
  }

  @media (min-width: 641px) and (max-width: 1000px) {
    .hero.hero--home { background-image: var(--hero-bg-medium); }
  }

  @media (max-width: 640px) {
    .hero-title-image { display: none; }
    .hero-upper-signature,
    .hero-values { display: block; }
    .hero-identity,
    .hero-affiliation { display: none; }

    .hero.hero--home {
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      padding: 0 0 22px !important;
      background-size: auto clamp(330px, 96vw, 390px) !important;
      background-position: 46% 0 !important;
    }

    .hero.hero--home .hero-copy {
      position: relative !important;
      width: calc(100vw - 36px) !important;
      margin: 0 18px !important;
      padding: clamp(330px, 96vw, 390px) 0 0 !important;
    }

    .hero.hero--home .hero-subcopy {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }
  }

  @media (max-width: 390px) {
    .hero.hero--home {
      padding-bottom: 18px !important;
      background-size: auto clamp(315px, 94vw, 365px) !important;
      background-position: 44% 0 !important;
    }

    .hero.hero--home .hero-copy {
      padding-top: clamp(315px, 94vw, 365px) !important;
    }
  }
</style>
