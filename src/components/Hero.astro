---
import Header from "./Header.astro";
import StatsStrip from "./StatsStrip.astro";
import results from "../data/results.json";
import profile from "../data/profile.json";
import heroImage from "../assets/images/hero-ary14.png";
import heroTitleImage from "../assets/images/hero-title-liberta.png";
import heroEagleLayerImage from "../assets/images/hero-eagle-layer-aq2.png";
import challengeTickerImage from "../assets/images/ticker-greece.jpg";

const showHeroStats = true;
const copy = profile.content.home.hero;
---
<section class="hero" id="top" aria-labelledby="hero-title" style={`--hero-bg: url("${heroImage.src}")`}>
  <div class="hero-overlay hero-overlay-left" aria-hidden="true"></div>
  <div class="hero-overlay hero-overlay-right" aria-hidden="true"></div>
  <div class="hero-overlay hero-overlay-bottom" aria-hidden="true"></div>
  <div class="hero-overlay hero-overlay-top" aria-hidden="true"></div>

  <Header />

  <div class="hero-upper-signature" aria-hidden="true">
    <span class="hero-upper-signature__eyebrow">Yīng · 鹰</span>
  </div>

  <div class="hero-copy">
    <h1 id="hero-title" class="hero-identity">Arianna Milano · Atleta di Sanda e Kung Fu</h1>
    <img class="hero-title-image" src={heroTitleImage.src} alt="" aria-hidden="true" width={heroTitleImage.width} height={heroTitleImage.height} />
    <p class="hero-subcopy">{copy.subcopy}<br /><strong>{copy.subcopyStrong}</strong></p>
    <p class="hero-affiliation">ASD Kasoria Kombat &amp; Fly · CSEN</p>

    <div class="challenge-ticker" aria-label="Prossima sfida internazionale: 18th Palamidio Martial Arts Championship, Nafplio, Grecia, novembre 2026">
      <div class="challenge-ticker__track" aria-hidden="true">
        <div class="challenge-ticker__unit">
          <img class="challenge-ticker__image" src={challengeTickerImage.src} alt="" width={challengeTickerImage.width} height={challengeTickerImage.height} decoding="async" />
          <span class="challenge-ticker__separator"><i></i></span>
        </div>
        <div class="challenge-ticker__unit">
          <img class="challenge-ticker__image" src={challengeTickerImage.src} alt="" width={challengeTickerImage.width} height={challengeTickerImage.height} decoding="async" />
          <span class="challenge-ticker__separator"><i></i></span>
        </div>
      </div>
    </div>

    {showHeroStats && <StatsStrip stats={results.heroStats} />}
  </div>

  <img class="hero-eagle-layer" src={heroEagleLayerImage.src} alt="" aria-hidden="true" width={heroEagleLayerImage.width} height={heroEagleLayerImage.height} />
</section>

<section class="hero-values" aria-label="I valori di Arianna">
  <div class="hero-values__inner">
    {copy.mobileValues.map((value, index) => index === 2 ? <strong>{value}</strong> : <span>{value}</span>)}
  </div>
</section>

<style>
  .hero-upper-signature,
  .hero-values,
  .challenge-ticker { display: none; }
  .hero-identity {
    margin: 0 0 14px;
    color: rgba(245, 240, 231, .82);
    font: 800 clamp(.64rem, .72vw, .78rem)/1.25 var(--font-ui);
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .hero-affiliation {
    margin: 12px 0 0;
    color: rgba(245, 240, 231, .58);
    font: 700 clamp(.55rem, .62vw, .68rem)/1.3 var(--font-ui);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  @media (min-width: 1001px) {
    .hero { min-height: clamp(610px, 78vh, 760px); padding-bottom: 56px; }
    .hero-subcopy { margin-top: 84px; }
  }

  @media (max-width: 640px) {
    .hero-title-image { display: none; }
    .hero-upper-signature,
    .hero-values { display: block; }
    .hero-identity {
      max-width: 320px;
      margin-bottom: 10px;
      font-size: .58rem;
      letter-spacing: .12em;
    }
    .hero-affiliation {
      margin-top: 8px;
      font-size: .5rem;
      letter-spacing: .09em;
    }

    .challenge-ticker {
      position: absolute;
      z-index: 5;
      top: 496px;
      left: -18px;
      display: block;
      width: 100vw;
      height: 50px;
      overflow: hidden;
      border-top: 1px solid rgba(216, 161, 58, .78);
      border-bottom: 1px solid rgba(216, 161, 58, .54);
      background: #050505;
      box-shadow: 0 8px 22px rgba(0, 0, 0, .34);
    }

    .challenge-ticker__track {
      display: flex;
      width: max-content;
      height: 100%;
      gap: 0;
      animation: challengeTickerLoop 19s linear infinite;
      transform: translate3d(-50%, 0, 0);
      will-change: transform;
      backface-visibility: hidden;
    }

    .challenge-ticker__unit {
      display: flex;
      flex: 0 0 auto;
      height: 100%;
    }

    .challenge-ticker__image {
      flex: 0 0 auto;
      width: auto;
      max-width: none;
      height: 100%;
      object-fit: cover;
    }

    .challenge-ticker__separator {
      position: relative;
      flex: 0 0 30px;
      width: 30px;
      height: 100%;
      background: #050505;
    }

    .challenge-ticker__separator i {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: rgba(216, 161, 58, .9);
      box-shadow: 0 0 8px rgba(216, 161, 58, .35);
      transform: translate(-50%, -50%);
    }
  }

  @media (max-width: 390px) {
    .challenge-ticker {
      top: 478px;
      height: 48px;
    }
    .challenge-ticker__separator {
      flex-basis: 28px;
      width: 28px;
    }
  }

  @keyframes challengeTickerLoop {
    from { transform: translate3d(-50%, 0, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .challenge-ticker {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .challenge-ticker::-webkit-scrollbar { display: none; }
    .challenge-ticker__track {
      animation: none;
      transform: translate3d(0, 0, 0);
      will-change: auto;
    }
    .challenge-ticker__unit:nth-child(2) { display: none; }
  }
</style>