---
import Header from "./Header.astro";
import StatsStrip from "./StatsStrip.astro";
import results from "../data/results.json";
import profile from "../data/profile.json";
import heroImage from "../assets/images/hero-ary14.png";
import heroTitleImage from "../assets/images/hero-title-liberta.png";
import heroEagleLayerImage from "../assets/images/hero-eagle-layer-aq2.png";
import challengeTickerImage from "../assets/images/ticker-greece.jpg";

const showHeroStats = true;
const copy = profile.content.home.hero;
---
<section class="hero" id="top" aria-labelledby="hero-title" style={`--hero-bg: url("${heroImage.src}")`}>
  <div class="hero-overlay hero-overlay-left" aria-hidden="true"></div>
  <div class="hero-overlay hero-overlay-right" aria-hidden="true"></div>
  <div class="hero-overlay hero-overlay-bottom" aria-hidden="true"></div>
  <div class="hero-overlay hero-overlay-top" aria-hidden="true"></div>

  <Header />

  <div class="hero-upper-signature" aria-hidden="true">
    <span class="hero-upper-signature__eyebrow">Yīng · 鹰</span>
  </div>

  <div class="hero-copy">
    <h1 id="hero-title" class="hero-identity">Arianna Milano · Atleta di Sanda e Kung Fu</h1>
    <img class="hero-title-image" src={heroTitleImage.src} alt="" aria-hidden="true" width={heroTitleImage.width} height={heroTitleImage.height} />
    <p class="hero-subcopy">{copy.subcopy}<br /><strong>{copy.subcopyStrong}</strong></p>
    <p class="hero-affiliation">ASD Kasoria Kombat &amp; Fly · CSEN</p>

    <a
      class="challenge-ticker"
      href="/grecia/"
      aria-label="Scopri la prossima sfida internazionale di Arianna: 18th Palamidio Martial Arts Championship, Nafplio, Grecia, 13–15 novembre 2026"
    >
      <img
        class="challenge-ticker__image"
        src={challengeTickerImage.src}
        alt=""
        width={challengeTickerImage.width}
        height={challengeTickerImage.height}
        decoding="async"
      />
    </a>

    {showHeroStats && <StatsStrip stats={results.heroStats} />}
  </div>

  <img class="hero-eagle-layer" src={heroEagleLayerImage.src} alt="" aria-hidden="true" width={heroEagleLayerImage.width} height={heroEagleLayerImage.height} />
</section>

<section class="hero-values" aria-label="I valori di Arianna">
  <div class="hero-values__inner">
    {copy.mobileValues.map((value, index) => index === 2 ? <strong>{value}</strong> : <span>{value}</span>)}
  </div>
</section>

<style>
  .hero-upper-signature,
  .hero-values { display: none; }

  .hero-identity {
    margin: 0 0 14px;
    color: rgba(245, 240, 231, .82);
    font: 800 clamp(.64rem, .72vw, .78rem)/1.25 var(--font-ui);
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .hero-affiliation {
    margin: 12px 0 0;
    color: rgba(245, 240, 231, .58);
    font: 700 clamp(.55rem, .62vw, .68rem)/1.3 var(--font-ui);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .challenge-ticker {
    position: relative;
    z-index: 5;
    display: block;
    width: min(1120px, calc(100vw - 96px));
    aspect-ratio: 1600 / 216;
    margin: 20px 0 0 0;
    overflow: hidden;
    background: transparent;
    box-shadow: none;
    isolation: isolate;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 1.5%, #000 98.5%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 1.5%, #000 98.5%, transparent 100%);
    animation: challengeReveal .72s cubic-bezier(.2,.72,.2,1) .2s both;
    transition: filter 260ms ease, transform 260ms ease;
  }

  .challenge-ticker::before,
  .challenge-ticker::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .challenge-ticker::before {
    z-index: 2;
    inset: 0;
    border-top: 1px solid rgba(216, 161, 58, .52);
    border-bottom: 1px solid rgba(216, 161, 58, .34);
    background: linear-gradient(180deg, rgba(255,255,255,.035), transparent 26%, transparent 72%, rgba(0,0,0,.18));
  }

  .challenge-ticker::after {
    z-index: 3;
    top: -55%;
    bottom: -55%;
    left: -22%;
    width: 12%;
    opacity: 0;
    background: linear-gradient(105deg, transparent 0%, rgba(255,255,255,.02) 24%, rgba(255,238,188,.25) 50%, rgba(255,255,255,.06) 68%, transparent 100%);
    filter: blur(2px);
    transform: skewX(-14deg) translate3d(0,0,0);
    animation: challengeLightSweep 1.55s cubic-bezier(.22,.7,.22,1) .95s 1 both;
  }

  .challenge-ticker__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: filter 260ms ease, transform 400ms cubic-bezier(.2,.72,.2,1);
  }

  .challenge-ticker:hover,
  .challenge-ticker:focus-visible {
    filter: brightness(1.06) contrast(1.03);
    transform: translateY(-1px);
  }

  .challenge-ticker:hover .challenge-ticker__image,
  .challenge-ticker:focus-visible .challenge-ticker__image {
    transform: scale(1.003);
  }

  .hero-copy .stats-strip {
    margin-top: 22px;
  }

  @media (min-width: 1001px) {
    .hero { min-height: clamp(670px, 82vh, 800px); padding-bottom: 48px; }
    .hero-subcopy { margin-top: 70px; }
  }

  @media (max-width: 1000px) and (min-width: 641px) {
    .challenge-ticker {
      width: calc(100vw - 56px);
      margin-top: 18px;
    }
  }

  @media (max-width: 640px) {
    .hero-title-image { display: none; }
    .hero-upper-signature,
    .hero-values { display: block; }

    .hero-identity {
      max-width: 320px;
      margin-bottom: 10px;
      font-size: .58rem;
      letter-spacing: .12em;
    }

    .hero-affiliation {
      margin-top: 8px;
      font-size: .5rem;
      letter-spacing: .09em;
    }

    .challenge-ticker {
      position: absolute;
      z-index: 5;
      top: 496px;
      left: -18px;
      width: 100vw;
      height: 50px;
      aspect-ratio: auto;
      margin: 0;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .challenge-ticker::before {
      border-top-color: rgba(216, 161, 58, .64);
      border-bottom-color: rgba(216, 161, 58, .42);
    }

    .challenge-ticker::after {
      left: -34%;
      width: 22%;
    }

    .hero-copy .stats-strip {
      margin-top: 34px;
    }
  }

  @media (max-width: 390px) {
    .challenge-ticker {
      top: 478px;
      height: 48px;
    }
  }

  @keyframes challengeReveal {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes challengeLightSweep {
    0% { opacity: 0; transform: skewX(-14deg) translate3d(0,0,0); }
    12% { opacity: .85; }
    78% { opacity: .85; }
    100% { opacity: 0; transform: skewX(-14deg) translate3d(1050%,0,0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .challenge-ticker,
    .challenge-ticker::after,
    .challenge-ticker__image {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>