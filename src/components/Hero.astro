---
import Header from "./Header.astro";
import StatsStrip from "./StatsStrip.astro";
import results from "../data/results.json";
import profile from "../data/profile.json";
import heroImage from "../assets/images/hero-ary14.png";
import heroTitleImage from "../assets/images/hero-title-liberta.png";
import heroEagleLayerImage from "../assets/images/hero-eagle-layer-aq2.png";
const copy = profile.content.home.hero;
---
<section class="hero hero--compact" id="top" aria-labelledby="hero-title" style={`--hero-bg: url("${heroImage.src}")`}>
  <div class="hero-overlay hero-overlay-left" aria-hidden="true"></div><div class="hero-overlay hero-overlay-right" aria-hidden="true"></div><div class="hero-overlay hero-overlay-bottom" aria-hidden="true"></div><div class="hero-overlay hero-overlay-top" aria-hidden="true"></div>
  <Header />
  <div class="hero-upper-signature" aria-hidden="true"><span class="hero-upper-signature__eyebrow">Yīng · 鹰</span></div>
  <div class="hero-copy">
    <h1 id="hero-title" class="sr-only">{copy.screenReaderTitle}</h1>
    <img class="hero-title-image" src={heroTitleImage.src} alt="" aria-hidden="true" width={heroTitleImage.width} height={heroTitleImage.height} />
    <p class="hero-subcopy">{copy.subcopy}<br /><strong>{copy.subcopyStrong}</strong></p>
    <div class="hero-performance">
      <StatsStrip stats={results.heroStats} />
      <a class="palmares-cta" href="/risultati/" data-interactive aria-label="Scopri il palmarès di Arianna">
        <span class="palmares-cta__eyebrow">Percorso agonistico</span>
        <strong>Scopri il palmarès</strong>
        <b aria-hidden="true">↗</b>
      </a>
    </div>
  </div>
  <img class="hero-eagle-layer" src={heroEagleLayerImage.src} alt="" aria-hidden="true" width={heroEagleLayerImage.width} height={heroEagleLayerImage.height} />
</section>
<section class="hero-values" aria-label="I valori di Arianna"><div class="hero-values__inner">{copy.mobileValues.map((value,index)=>index===2?<strong>{value}</strong>:<span>{value}</span>)}</div></section>
<style>
.hero-upper-signature,.hero-values{display:none}.hero--compact{min-height:0!important;padding-bottom:13px!important;background-position:54% 36%;border-bottom:0!important}.hero--compact .hero-copy{padding-top:clamp(104px,12vh,120px)}.hero--compact .hero-subcopy{margin-top:44px}.hero-performance{display:flex;align-items:flex-end;gap:16px}.hero-performance :global(.stats-strip){flex:0 0 auto}.palmares-cta{position:relative;display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto;align-content:center;column-gap:14px;width:176px;min-height:62px;margin:34px 0 0;padding:9px 12px 8px;border:1px solid rgba(185,134,50,.48);background:linear-gradient(135deg,rgba(185,134,50,.09),rgba(0,0,0,.28));color:var(--ivory);font-family:var(--font-ui);text-transform:uppercase;transition:border-color .2s ease,background .2s ease,transform .2s ease}.palmares-cta::after{position:absolute;left:10px;right:10px;bottom:-14px;height:1px;background:linear-gradient(90deg,rgba(185,134,50,.78),rgba(185,134,50,0));content:""}.palmares-cta__eyebrow{grid-column:1;font-size:.48rem;font-weight:800;letter-spacing:.14em;color:var(--gold-bright);white-space:nowrap}.palmares-cta strong{grid-column:1;font-size:.66rem;line-height:1.1;letter-spacing:.08em}.palmares-cta b{grid-column:2;grid-row:1/3;align-self:center;color:var(--gold-bright);font-size:1rem}.palmares-cta:hover,.palmares-cta:focus-visible{border-color:rgba(217,164,65,.88);background:rgba(185,134,50,.12);transform:translateY(-1px)}
@media(min-width:1001px){.hero--compact .hero-eagle-layer{top:clamp(112px,13vh,148px)}}
@media(max-width:1000px){.hero-performance{display:block}.palmares-cta{width:min(260px,calc(100% - 36px));margin:0 auto 14px}.palmares-cta::after{display:none}.hero--compact{min-height:auto!important;padding-bottom:0!important}}
@media(max-width:640px){.hero-title-image{display:none}.hero-upper-signature,.hero-values{display:block}.hero--compact .hero-subcopy{margin-top:0}}
</style>