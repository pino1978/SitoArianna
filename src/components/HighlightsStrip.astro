---
import "@splidejs/splide/css";
import media from "../data/media.json";
const imageModules=import.meta.glob("../assets/images/*.{png,jpg,jpeg,webp}",{eager:true});
const photoUrl=(item)=>item?.url||imageModules[`../assets/images/${item?.immagine}`]?.default?.src||"";
const youtubeId=(url="")=>url.match(/(?:shorts\/|youtu\.be\/|[?&]v=)([A-Za-z0-9_-]{11})/)?.[1]||"";
const highlights=media.filter(item=>item.visibile&&item.inEvidenza);
---
<section class="highlights-strip" id="highlights" aria-labelledby="highlights-title">
 <div class="section-head compact"><div><p>Highlights</p><h2 id="highlights-title">I momenti che contano</h2></div></div>
 <div class="highlight-carousel splide" aria-label="Media in evidenza"><div class="splide__arrows"><button class="splide__arrow splide__arrow--prev" type="button" aria-label="Precedente" data-interactive>‹</button><button class="splide__arrow splide__arrow--next" type="button" aria-label="Successivo" data-interactive>›</button></div><div class="splide__track"><ul class="splide__list">{highlights.map(item=>{const id=item.tipo==="video"?youtubeId(item.urlYouTube):"";const image=item.tipo==="foto"?photoUrl(item):"";const thumb=id?`https://i.ytimg.com/vi/${id}/hqdefault.jpg`:image;return <li class="splide__slide"><button class="highlight-open" type="button" data-interactive data-type={item.tipo} data-image={image} data-youtube={id} aria-label={`${item.tipo==="video"?"Riproduci":"Apri"} ${item.titolo}`}><span class="highlight-preview">{thumb&&<img src={thumb} alt={item.testoAlternativo||item.titolo} loading="lazy"/>}{item.tipo==="video"&&<span class="play-mark" aria-hidden="true">▶</span>}</span></button></li>})}</ul></div></div>
 <div class="viewer" data-viewer hidden aria-hidden="true"><button class="viewer__backdrop" data-close data-interactive aria-label="Chiudi"></button><div class="viewer__dialog" data-dialog role="dialog" aria-modal="true"><button class="viewer__close" data-close data-interactive aria-label="Chiudi">×</button><button class="viewer__full" data-full data-interactive aria-label="Schermo intero">⛶</button><button class="viewer__nav viewer__prev" data-prev data-interactive aria-label="Precedente">‹</button><div class="viewer__stage" data-stage></div><button class="viewer__nav viewer__next" data-next data-interactive aria-label="Successivo">›</button></div></div>
</section>
<script>
 import Splide from '@splidejs/splide';
 const root=document.querySelector('.highlights-strip');
 if(root){const carousel=root.querySelector('.highlight-carousel');if(carousel)new Splide(carousel,{perPage:3,perMove:1,gap:'12px',pagination:false,arrows:true,breakpoints:{980:{perPage:2},640:{perPage:1,padding:{left:'18px',right:'12vw'}}}}).mount();
 const viewer=root.querySelector('[data-viewer]'),dialog=root.querySelector('[data-dialog]'),stage=root.querySelector('[data-stage]'),full=root.querySelector('[data-full]');const buttons=Array.from(root.querySelectorAll('.highlight-open'));let index=0,last=null;
 const nav=()=>{const p=root.querySelector('[data-prev]'),n=root.querySelector('[data-next]');if(p instanceof HTMLButtonElement)p.disabled=index===0;if(n instanceof HTMLButtonElement)n.disabled=index===buttons.length-1};
 const mount=i=>{const b=buttons[i];if(!b||!stage)return;index=i;nav();const type=b.getAttribute('data-type');if(type==='video'){const id=b.getAttribute('data-youtube');stage.innerHTML=`<iframe class="viewer__video" src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1" title="Video Arianna Milano" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen" allowfullscreen data-interactive></iframe>`}else{stage.innerHTML=`<img class="viewer__image" src="${b.getAttribute('data-image')||''}" alt="${b.getAttribute('aria-label')?.replace(/^Apri /,'')||''}">`}};
 const open=(i,b)=>{if(!viewer)return;last=b;viewer.hidden=false;viewer.setAttribute('aria-hidden','false');document.body.classList.add('viewer-open');mount(i)};
 const close=async()=>{if(!viewer)return;if(document.fullscreenElement)await document.exitFullscreen().catch(()=>{});viewer.hidden=true;viewer.setAttribute('aria-hidden','true');document.body.classList.remove('viewer-open');if(stage)stage.innerHTML='';last?.focus()};
 buttons.forEach((b,i)=>b.addEventListener('click',()=>open(i,b)));root.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',close));root.querySelector('[data-prev]')?.addEventListener('click',()=>{if(index>0)mount(index-1)});root.querySelector('[data-next]')?.addEventListener('click',()=>{if(index<buttons.length-1)mount(index+1)});full?.addEventListener('click',async()=>{if(!dialog)return;document.fullscreenElement?await document.exitFullscreen():await dialog.requestFullscreen?.()});document.addEventListener('keydown',e=>{if(!viewer||viewer.hidden)return;if(e.key==='Escape'&&!document.fullscreenElement)close();if(e.key==='ArrowLeft'&&index>0)mount(index-1);if(e.key==='ArrowRight'&&index<buttons.length-1)mount(index+1)});let sx=0;viewer?.addEventListener('touchstart',e=>sx=e.touches[0]?.clientX||0,{passive:true});viewer?.addEventListener('touchend',e=>{const d=(e.changedTouches[0]?.clientX||0)-sx;if(Math.abs(d)>60){if(d>0&&index>0)mount(index-1);if(d<0&&index<buttons.length-1)mount(index+1)}},{passive:true});}
</script>
<style>
.highlights-strip{padding:18px clamp(28px,6.4vw,104px) 26px;border-block:1px solid rgba(185,134,50,.38);background:#080808}.section-head{margin-bottom:14px}.section-head p{margin:0 0 3px;color:var(--gold-bright);font:800 .64rem var(--font-ui);letter-spacing:.16em;text-transform:uppercase}.section-head h2{margin:0;font:800 clamp(1.15rem,1.55vw,1.65rem)/1 var(--font-display);text-transform:uppercase}.highlight-open{display:block;width:100%;padding:0;border:0;background:none;cursor:pointer}.highlight-preview{position:relative;display:block;aspect-ratio:16/9;overflow:hidden;border:1px solid rgba(185,134,50,.55);background:#050505}.highlight-preview img{width:100%;height:100%;object-fit:cover;opacity:.92;transition:.25s}.highlight-open:hover img{transform:scale(1.025);opacity:1}.play-mark{position:absolute;inset:50% auto auto 50%;display:grid;width:48px;height:48px;place-items:center;transform:translate(-50%,-50%);border:1px solid #fff;border-radius:50%;background:#0008;color:#fff}:global(.highlight-carousel .splide__arrow){width:40px;height:40px;border:1px solid rgba(185,134,50,.8);background:#080808e8;color:#fff}:global(.highlight-carousel .splide__arrow svg){display:none}:global(.highlight-carousel .splide__arrow--prev){left:-22px}:global(.highlight-carousel .splide__arrow--next){right:-22px}.viewer[hidden]{display:none}.viewer{position:fixed;z-index:99999;inset:0}.viewer__backdrop{position:absolute;inset:0;border:0;background:#000}.viewer__dialog{position:relative;z-index:1;display:grid;grid-template-columns:64px 1fr 64px;align-items:center;gap:18px;width:100vw;height:100dvh;padding:24px;background:#000}.viewer__stage{display:grid;width:100%;height:calc(100dvh - 48px);place-items:center;overflow:hidden}.viewer__image{max-width:100%;max-height:100%;object-fit:contain}.viewer__video{width:min(430px,100%);height:min(80dvh,765px);aspect-ratio:9/16;border:0;background:#000}.viewer__close,.viewer__full{position:fixed;z-index:4;top:18px;width:44px;height:44px;border:1px solid #ffffff47;border-radius:50%;background:#080808c9;color:#fff;cursor:pointer}.viewer__close{right:18px;font-size:1.8rem}.viewer__full{right:72px;font-size:1.2rem}.viewer__nav{width:48px;height:64px;border:1px solid #ffffff38;background:#0808088a;color:#fff;font-size:2rem}.viewer__nav:disabled{opacity:.16}.viewer__dialog:fullscreen{padding:0}.viewer__dialog:fullscreen .viewer__stage{height:100vh}:global(body.viewer-open){overflow:hidden}
@media(max-width:640px){.highlights-strip{padding:16px 0 22px}.section-head{padding:0 18px}.viewer__dialog{grid-template-columns:40px 1fr 40px;gap:3px;padding:8px}.viewer__stage{height:calc(100dvh - 16px)}.viewer__nav{width:38px;height:50px}.viewer__video{height:min(90dvh,820px)}:global(.highlight-carousel .splide__arrow--prev){left:4px}:global(.highlight-carousel .splide__arrow--next){right:4px}}
</style>