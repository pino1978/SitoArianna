---
import d1 from "../data/road-to-greece/desktop-1.txt?raw";
import d2 from "../data/road-to-greece/desktop-2.txt?raw";
import d3 from "../data/road-to-greece/desktop-3.txt?raw";
import d4 from "../data/road-to-greece/desktop-4.txt?raw";
import d5 from "../data/road-to-greece/desktop-5.txt?raw";
import d6 from "../data/road-to-greece/desktop-6.txt?raw";
import m1 from "../data/road-to-greece/mobile-1.txt?raw";
import m2 from "../data/road-to-greece/mobile-2.txt?raw";
import m3 from "../data/road-to-greece/mobile-3.txt?raw";
import m4 from "../data/road-to-greece/mobile-4.txt?raw";
import m5 from "../data/road-to-greece/mobile-5.txt?raw";
const desktopSrc=`data:image/webp;base64,${d1}${d2}${d3}${d4}${d5}${d6}`;
const mobileSrc=`data:image/webp;base64,${m1}${m2}${m3}${m4}${m5}`;
---
<section class="road-to-greece" aria-label="Road to Greece">
  <div class="road-to-greece__media" data-rtg-media>
    <a class="road-to-greece__image-link" href="/road-to-greece/" aria-label="Scopri Road to Greece">
      <picture>
        <source media="(max-width:767px)" srcset={mobileSrc} />
        <img class="road-to-greece__image" src={desktopSrc} alt="18th Palamidio Martial Arts Championship, Nafplio, Grecia, 13–15 novembre 2026." width="1024" height="208" loading="eager" decoding="async" />
      </picture>
    </a>
    <span class="road-to-greece__reveal" aria-hidden="true"></span>
    <a class="road-to-greece__cta-wrap" href="/road-to-greece/" aria-label="Scopri Road to Greece">
      <span class="road-to-greece__cta">
        <span>ROAD TO<br />GREECE</span>
        <svg viewBox="0 0 32 20" aria-hidden="true" focusable="false"><path d="M1 10h27M20 2l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </a>
  </div>
</section>
<script>
const rtgMedia=document.querySelector('[data-rtg-media]');
if(rtgMedia&&!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
  const reveal=rtgMedia.querySelector('.road-to-greece__reveal');
  const startReveal=()=>{
    if(rtgMedia.classList.contains('is-discovering')) return;
    rtgMedia.classList.add('is-discovering');
    reveal?.classList.add('is-searching');
    window.setTimeout(()=>{
      rtgMedia.classList.add('is-revealed');
      reveal?.classList.remove('is-searching');
    },7000);
  };
  const observer=new IntersectionObserver((entries,obs)=>{
    for(const entry of entries){if(entry.isIntersecting){startReveal();obs.unobserve(entry.target);break;}}
  },{threshold:.35});
  observer.observe(rtgMedia);
}
</script>
<style>
@property --spot-x{syntax:"<percentage>";inherits:false;initial-value:82%}
@property --spot-y{syntax:"<percentage>";inherits:false;initial-value:22%}
.road-to-greece{width:100%;margin:0;padding:0;background:#080706;overflow:hidden}.road-to-greece__media{position:relative;width:100%;overflow:hidden;isolation:isolate;background:#080706;perspective:900px}.road-to-greece__image-link{position:relative;z-index:1;display:block;width:100%;text-decoration:none}.road-to-greece__image{display:block;width:100%;height:auto;margin:0;transform-origin:50% 50%;will-change:transform;animation:rtg-wave 8s cubic-bezier(.45,0,.2,1) infinite}
@keyframes rtg-wave{0%,80%,100%{transform:translate3d(0,0,0) scale(1) skewY(0)}84%{transform:translate3d(0,-1.5px,0) scale(1.003,1.012) skewY(.16deg)}88%{transform:translate3d(0,1px,0) scale(1.004,.996) skewY(-.13deg)}92%{transform:translate3d(0,-.7px,0) scale(1.002,1.006) skewY(.07deg)}96%{transform:translate3d(0,0,0) scale(1) skewY(0)}}
.road-to-greece__reveal{--spot-x:82%;--spot-y:22%;position:absolute;z-index:2;inset:0;pointer-events:none;opacity:0;background:radial-gradient(ellipse 13% 54% at var(--spot-x) var(--spot-y),rgba(0,0,0,.08) 0 20%,rgba(0,0,0,.32) 38%,rgba(0,0,0,.9) 68%,rgba(0,0,0,.96) 100%);transition:opacity 150ms linear;will-change:opacity}.road-to-greece__media.is-discovering .road-to-greece__reveal{opacity:1}.road-to-greece__reveal.is-searching{animation:rtg-search 7s linear forwards}.road-to-greece__media.is-revealed .road-to-greece__reveal{animation:rtg-open 2.4s cubic-bezier(.25,.1,.25,1) forwards}
@keyframes rtg-search{0%{--spot-x:88%;--spot-y:18%}10%{--spot-x:78%;--spot-y:38%}20%{--spot-x:68%;--spot-y:66%}30%{--spot-x:54%;--spot-y:48%}40%{--spot-x:48%;--spot-y:28%}50%{--spot-x:34%;--spot-y:46%}60%{--spot-x:25%;--spot-y:68%}70%{--spot-x:42%;--spot-y:56%}80%{--spot-x:61%;--spot-y:38%}90%{--spot-x:73%;--spot-y:35%}100%{--spot-x:50%;--spot-y:48%}}
@keyframes rtg-open{0%{opacity:1}18%{opacity:.96}42%{opacity:.78}66%{opacity:.48}84%{opacity:.2}100%{opacity:0}}
.road-to-greece__cta-wrap{position:absolute;z-index:10;top:0;right:0;bottom:0;width:clamp(210px,18vw,350px);display:flex;align-items:center;justify-content:center;padding:0 clamp(20px,2.1vw,42px) 0 clamp(48px,4.8vw,90px);box-sizing:border-box;text-decoration:none;cursor:pointer;background:linear-gradient(90deg,rgba(5,7,9,0),rgba(5,7,9,.72) 34%,rgba(5,7,9,.96) 72%);clip-path:polygon(22% 0,100% 0,100% 100%,0 100%);opacity:1;pointer-events:auto;-webkit-tap-highlight-color:transparent}.road-to-greece__cta-wrap::before{content:"";position:absolute;left:23%;top:-8%;width:1px;height:116%;background:linear-gradient(180deg,transparent,rgba(199,162,92,.95) 18%,rgba(199,162,92,.95) 82%,transparent);transform:rotate(10deg);pointer-events:none}.road-to-greece__cta{position:relative;z-index:11;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;gap:clamp(12px,1.1vw,22px);min-height:54px;padding:12px 18px;color:#0a0908;background:linear-gradient(135deg,#e0bd73,#c79e50 52%,#e3c27b);border:1px solid rgba(255,244,218,.28);box-shadow:0 10px 32px rgba(0,0,0,.26);transition:transform 180ms ease,filter 180ms ease,box-shadow 180ms ease;animation:rtg-cta-glow 5.3s ease-in-out .9s infinite}.road-to-greece__cta::after{content:"";position:absolute;inset:-40% auto -40% -55%;width:32%;pointer-events:none;transform:skewX(-20deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);animation:rtg-cta-shine 5.3s ease-in-out .9s infinite}@keyframes rtg-cta-glow{0%,66%,100%{box-shadow:0 10px 32px rgba(0,0,0,.26)}74%{box-shadow:0 10px 32px rgba(0,0,0,.26),0 0 18px rgba(224,189,115,.34)}}@keyframes rtg-cta-shine{0%,65%{left:-55%;opacity:0}70%{opacity:.6}82%{left:125%;opacity:.3}87%,100%{left:125%;opacity:0}}.road-to-greece__cta span{position:relative;z-index:1;font:800 clamp(.82rem,.84vw,1rem)/1.02 "Arial Narrow","Roboto Condensed",Arial,sans-serif;letter-spacing:.08em;white-space:nowrap}.road-to-greece__cta svg{position:relative;z-index:1;width:clamp(24px,1.6vw,31px);height:auto;transition:transform 180ms ease}.road-to-greece__cta-wrap:hover .road-to-greece__cta,.road-to-greece__cta-wrap:focus-visible .road-to-greece__cta{filter:brightness(1.06);transform:translateY(-1px);box-shadow:0 12px 36px rgba(0,0,0,.34)}.road-to-greece__cta-wrap:hover .road-to-greece__cta svg,.road-to-greece__cta-wrap:focus-visible .road-to-greece__cta svg{transform:translateX(4px)}.road-to-greece__cta-wrap:focus-visible,.road-to-greece__image-link:focus-visible{outline:3px solid #fff4da;outline-offset:-3px}
@media(max-width:767px){.road-to-greece__reveal{background:radial-gradient(ellipse 20% 52% at var(--spot-x) var(--spot-y),rgba(0,0,0,.08) 0 18%,rgba(0,0,0,.34) 38%,rgba(0,0,0,.91) 69%,rgba(0,0,0,.97) 100%)}.road-to-greece__cta-wrap{width:34%;min-width:122px;max-width:158px;padding:0 10px 0 22px;background:linear-gradient(90deg,rgba(4,6,8,0),rgba(4,6,8,.82) 27%,rgba(4,6,8,.98) 66%);clip-path:polygon(19% 0,100% 0,100% 100%,0 100%)}.road-to-greece__cta-wrap::before{left:20%;top:-10%;height:120%;transform:rotate(8deg)}.road-to-greece__cta{width:100%;min-height:46px;padding:10px 8px 10px 10px;gap:7px;box-sizing:border-box}.road-to-greece__cta span{font-size:clamp(.62rem,2.7vw,.75rem);line-height:1.03;letter-spacing:.055em}.road-to-greece__cta svg{width:clamp(18px,5vw,22px)}}
@media(prefers-reduced-motion:reduce){.road-to-greece__image,.road-to-greece__reveal,.road-to-greece__cta,.road-to-greece__cta::after{animation:none!important}.road-to-greece__reveal{display:none}.road-to-greece__cta,.road-to-greece__cta svg{transition:none}}
</style>