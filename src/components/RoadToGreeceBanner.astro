---
import d1 from "../data/road-to-greece/desktop-1.txt?raw";
import d2 from "../data/road-to-greece/desktop-2.txt?raw";
import d3 from "../data/road-to-greece/desktop-3.txt?raw";
import d4 from "../data/road-to-greece/desktop-4.txt?raw";
import d5 from "../data/road-to-greece/desktop-5.txt?raw";
import d6 from "../data/road-to-greece/desktop-6.txt?raw";
import m1 from "../data/road-to-greece/mobile-1.txt?raw";
import m2 from "../data/road-to-greece/mobile-2.txt?raw";
import m3 from "../data/road-to-greece/mobile-3.txt?raw";
import m4 from "../data/road-to-greece/mobile-4.txt?raw";
import m5 from "../data/road-to-greece/mobile-5.txt?raw";
const desktopSrc=`data:image/webp;base64,${d1}${d2}${d3}${d4}${d5}${d6}`;
const mobileSrc=`data:image/webp;base64,${m1}${m2}${m3}${m4}${m5}`;
---
<section class="road-to-greece" aria-label="Road to Greece">
  <a class="road-to-greece__link" href="/road-to-greece/" aria-label="Scopri Road to Greece">
    <picture>
      <source media="(max-width:767px)" srcset={mobileSrc} />
      <img class="road-to-greece__image" src={desktopSrc} alt="18th Palamidio Martial Arts Championship, Nafplio, Grecia, 13–15 novembre 2026." width="1024" height="208" loading="eager" decoding="async" />
    </picture>
    <span class="road-to-greece__cta"><span>ROAD TO<br />GREECE</span><svg viewBox="0 0 32 20" aria-hidden="true"><path d="M1 10h27M20 2l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
  </a>
</section>
<style>
.road-to-greece{width:100%;margin:0;background:#080706;overflow:hidden}.road-to-greece__link{position:relative;display:block;width:100%;color:inherit;text-decoration:none;overflow:hidden}.road-to-greece__image{display:block;width:100%;height:auto}.road-to-greece__cta{position:absolute;right:clamp(18px,4vw,64px);top:50%;transform:translateY(-50%);display:inline-flex;align-items:center;gap:16px;min-height:52px;padding:11px 18px;background:linear-gradient(135deg,#e0bd73,#c79e50 52%,#e3c27b);color:#0a0908;border:1px solid rgba(255,244,218,.28);box-shadow:0 10px 32px rgba(0,0,0,.3);font:800 .85rem/1.02 "Arial Narrow","Roboto Condensed",Arial,sans-serif;letter-spacing:.08em}.road-to-greece__cta svg{width:28px;height:auto;transition:transform .18s ease}.road-to-greece__link:hover .road-to-greece__cta svg,.road-to-greece__link:focus-visible .road-to-greece__cta svg{transform:translateX(4px)}.road-to-greece__link:focus-visible{outline:3px solid #fff4da;outline-offset:-3px}@media(max-width:767px){.road-to-greece__cta{right:10px;min-height:42px;padding:8px 10px;gap:7px;font-size:.68rem}.road-to-greece__cta svg{width:20px}}@media(prefers-reduced-motion:reduce){.road-to-greece__cta svg{transition:none}}
</style>
