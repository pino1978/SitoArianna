---
import d1 from "../data/road-to-greece/desktop-1.txt?raw";
import d2 from "../data/road-to-greece/desktop-2.txt?raw";
import d3 from "../data/road-to-greece/desktop-3.txt?raw";
import d4 from "../data/road-to-greece/desktop-4.txt?raw";
import d5 from "../data/road-to-greece/desktop-5.txt?raw";
import d6 from "../data/road-to-greece/desktop-6.txt?raw";
import m1 from "../data/road-to-greece/mobile-1.txt?raw";
import m2 from "../data/road-to-greece/mobile-2.txt?raw";
import m3 from "../data/road-to-greece/mobile-3.txt?raw";
import m4 from "../data/road-to-greece/mobile-4.txt?raw";
import m5 from "../data/road-to-greece/mobile-5.txt?raw";
const desktopSrc=`data:image/webp;base64,${d1}${d2}${d3}${d4}${d5}${d6}`;
const mobileSrc=`data:image/webp;base64,${m1}${m2}${m3}${m4}${m5}`;
---
<section class="road-to-greece" aria-label="Road to Greece"><div class="road-to-greece__media" data-rtg-media>
<img class="road-to-greece__image road-to-greece__image--desktop" src={desktopSrc} alt="Prossima sfida internazionale: Sanda, 18th Palamidio Martial Arts Championship, Nafplio, Grecia, 13–15 novembre 2026." width="1024" height="208" loading="eager" fetchpriority="high" decoding="async" />
<img class="road-to-greece__image road-to-greece__image--mobile" src={mobileSrc} alt="18th Palamidio Martial Arts Championship, Nafplio, Grecia, 13–15 novembre 2026." width="768" height="224" loading="eager" decoding="async" />
<span class="road-to-greece__reveal" aria-hidden="true"></span>
<div class="road-to-greece__cta-wrap"><a class="road-to-greece__cta" href="/road-to-greece/" aria-label="Scopri Road to Greece"><span>ROAD TO<br />GREECE</span><svg viewBox="0 0 32 20" aria-hidden="true" focusable="false"><path d="M1 10h27M20 2l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a></div>
</div></section>
<script>
const rtgMedia=document.querySelector('[data-rtg-media]');
if(rtgMedia&&!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
  const reveal=rtgMedia.querySelector('.road-to-greece__reveal');
  const startReveal=()=>{
    rtgMedia.classList.add('is-discovering');
    reveal?.classList.add('is-searching');
    window.setTimeout(()=>{
      rtgMedia.classList.add('is-revealed');
      reveal?.classList.remove('is-searching');
    },4700);
  };
  const observer=new IntersectionObserver((entries,obs)=>{
    for(const entry of entries){
      if(entry.isIntersecting){startReveal();obs.unobserve(entry.target);break;}
    }
  },{threshold:.35});
  observer.observe(rtgMedia);
}
</script>
<style>
.road-to-greece{width:100%;margin:0;padding:0;background:#080706;overflow:hidden}.road-to-greece__media{position:relative;width:100%;overflow:hidden;isolation:isolate;background:#080706;perspective:900px}.road-to-greece__image{display:block;width:100%;height:auto;margin:0;transform-origin:50% 50%;will-change:transform;animation:rtg-wave 8s cubic-bezier(.45,0,.2,1) infinite}.road-to-greece__image--mobile{display:none}
@keyframes rtg-wave{0%,80%,100%{transform:translate3d(0,0,0) scale(1) skewY(0)}84%{transform:translate3d(0,-1.5px,0) scale(1.003,1.012) skewY(.16deg)}88%{transform:translate3d(0,1px,0) scale(1.004,.996) skewY(-.13deg)}92%{transform:translate3d(0,-.7px,0) scale(1.002,1.006) skewY(.07deg)}96%{transform:translate3d(0,0,0) scale(1) skewY(0)}}
/* One-shot discovery: the image is already laid out; only a darkness mask is removed after the spotlight search. */
.road-to-greece__reveal{--spot-x:82%;--spot-y:22%;position:absolute;z-index:3;inset:0;pointer-events:none;opacity:0;background:radial-gradient(ellipse 13% 54% at var(--spot-x) var(--spot-y),rgba(0,0,0,.08) 0 20%,rgba(0,0,0,.32) 38%,rgba(0,0,0,.9) 68%,rgba(0,0,0,.96) 100%);transition:opacity 150ms linear}.road-to-greece__media.is-discovering .road-to-greece__reveal{opacity:1}.road-to-greece__reveal.is-searching{animation:rtg-search 4.7s cubic-bezier(.42,0,.24,1) forwards}.road-to-greece__media.is-revealed .road-to-greece__reveal{animation:rtg-open .7s cubic-bezier(.2,.75,.2,1) forwards}
@keyframes rtg-search{0%{--spot-x:88%;--spot-y:18%}15%{--spot-x:68%;--spot-y:66%}30%{--spot-x:48%;--spot-y:28%}44%{--spot-x:25%;--spot-y:68%}58%{--spot-x:38%;--spot-y:42%}72%{--spot-x:73%;--spot-y:35%}86%{--spot-x:55%;--spot-y:70%}100%{--spot-x:50%;--spot-y:48%}}
@keyframes rtg-open{0%{opacity:1;background:radial-gradient(ellipse 15% 60% at 50% 48%,rgba(0,0,0,.06) 0 20%,rgba(0,0,0,.28) 38%,rgba(0,0,0,.9) 68%,rgba(0,0,0,.96) 100%)}55%{opacity:.58;background:radial-gradient(ellipse 62% 170% at 50% 48%,rgba(0,0,0,0) 0 45%,rgba(0,0,0,.24) 68%,rgba(0,0,0,.52) 100%)}100%{opacity:0;background:radial-gradient(ellipse 130% 260% at 50% 48%,transparent 0 100%)}}
.road-to-greece__cta-wrap{position:absolute;z-index:4;top:0;right:0;bottom:0;width:clamp(210px,18vw,350px);display:flex;align-items:center;justify-content:center;padding:0 clamp(20px,2.1vw,42px) 0 clamp(48px,4.8vw,90px);background:linear-gradient(90deg,rgba(5,7,9,0),rgba(5,7,9,.72) 34%,rgba(5,7,9,.96) 72%);clip-path:polygon(22% 0,100% 0,100% 100%,0 100%);transition:opacity .45s ease}.road-to-greece__media.is-discovering:not(.is-revealed) .road-to-greece__cta-wrap{opacity:0}.road-to-greece__media.is-revealed .road-to-greece__cta-wrap{opacity:1;transition-delay:.35s}.road-to-greece__cta-wrap::before{content:"";position:absolute;left:23%;top:-8%;width:1px;height:116%;background:linear-gradient(180deg,transparent,rgba(199,162,92,.95) 18%,rgba(199,162,92,.95) 82%,transparent);transform:rotate(10deg)}
.road-to-greece__cta{position:relative;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;gap:clamp(12px,1.1vw,22px);min-height:54px;padding:12px 18px;color:#0a0908;background:linear-gradient(135deg,#e0bd73,#c79e50 52%,#e3c27b);border:1px solid rgba(255,244,218,.28);text-decoration:none;box-shadow:0 10px 32px rgba(0,0,0,.26);transition:transform 180ms ease,filter 180ms ease,box-shadow 180ms ease;animation:rtg-cta-glow 5.3s ease-in-out .9s infinite}.road-to-greece__cta::after{content:"";position:absolute;inset:-40% auto -40% -55%;width:32%;pointer-events:none;transform:skewX(-20deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);animation:rtg-cta-shine 5.3s ease-in-out .9s infinite}@keyframes rtg-cta-glow{0%,66%,100%{box-shadow:0 10px 32px rgba(0,0,0,.26)}74%{box-shadow:0 10px 32px rgba(0,0,0,.26),0 0 18px rgba(224,189,115,.34)}}@keyframes rtg-cta-shine{0%,65%{left:-55%;opacity:0}70%{opacity:.6}82%{left:125%;opacity:.3}87%,100%{left:125%;opacity:0}}
.road-to-greece__cta span{position:relative;z-index:1;font:800 clamp(.82rem,.84vw,1rem)/1.02 "Arial Narrow","Roboto Condensed",Arial,sans-serif;letter-spacing:.08em;white-space:nowrap}.road-to-greece__cta svg{position:relative;z-index:1;width:clamp(24px,1.6vw,31px);height:auto;transition:transform 180ms ease}.road-to-greece__cta:hover,.road-to-greece__cta:focus-visible{filter:brightness(1.06);transform:translateY(-1px);box-shadow:0 12px 36px rgba(0,0,0,.34)}.road-to-greece__cta:hover svg,.road-to-greece__cta:focus-visible svg{transform:translateX(4px)}.road-to-greece__cta:focus-visible{outline:3px solid #fff4da;outline-offset:4px}
@media(max-width:1100px){.road-to-greece__cta-wrap{width:clamp(190px,20vw,250px);padding-right:18px;padding-left:46px}.road-to-greece__cta{min-height:48px;padding:10px 14px}}
@media(max-width:767px){.road-to-greece__image--desktop{display:none}.road-to-greece__image--mobile{display:block}.road-to-greece__reveal{background:radial-gradient(ellipse 20% 52% at var(--spot-x) var(--spot-y),rgba(0,0,0,.08) 0 18%,rgba(0,0,0,.34) 38%,rgba(0,0,0,.91) 69%,rgba(0,0,0,.97) 100%)}.road-to-greece__cta-wrap{width:31%;min-width:112px;max-width:148px;padding:0 10px 0 22px;background:linear-gradient(90deg,rgba(4,6,8,0),rgba(4,6,8,.82) 27%,rgba(4,6,8,.98) 66%);clip-path:polygon(19% 0,100% 0,100% 100%,0 100%)}.road-to-greece__cta-wrap::before{left:20%;top:-10%;height:120%;transform:rotate(8deg)}.road-to-greece__cta{width:100%;min-height:44px;padding:9px 8px 9px 10px;gap:7px}.road-to-greece__cta span{font-size:clamp(.62rem,2.7vw,.75rem);line-height:1.03;letter-spacing:.055em}.road-to-greece__cta svg{width:clamp(18px,5vw,22px)}}@media(max-width:390px){.road-to-greece__cta-wrap{width:32%;min-width:106px;padding-left:19px;padding-right:7px}.road-to-greece__cta{min-height:42px;padding-inline:7px}}
@media(prefers-reduced-motion:reduce){.road-to-greece__image,.road-to-greece__reveal,.road-to-greece__cta,.road-to-greece__cta::after{animation:none!important}.road-to-greece__reveal{display:none}.road-to-greece__cta-wrap{opacity:1!important;transition:none}.road-to-greece__cta,.road-to-greece__cta svg{transition:none}}
</style>