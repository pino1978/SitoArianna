---
import logo from "../assets/svg/logo-arianna-milano.svg";
---

<footer class="site-footer-global" id="footer" aria-label="Piè di pagina">
  <div class="site-footer-global__brush site-footer-global__brush--left" aria-hidden="true"></div>
  <div class="site-footer-global__brush site-footer-global__brush--right" aria-hidden="true"></div>

  <div class="site-footer-global__inner">
    <div class="site-footer-global__contact">
      <a href="mailto:info@ariannamilano.it" data-interactive>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 5.5h18v13H3zM4 7l8 6 8-6" /></svg>
        <span>info@ariannamilano.it</span>
      </a>
    </div>

    <a class="site-footer-global__brand" href="/" data-interactive aria-label="Arianna Milano, torna alla home">
      <img src={logo.src} alt="Arianna Milano" width={logo.width} height={logo.height} />
    </a>

    <p class="site-footer-global__legal">© 2026 Arianna Milano<br /><span>Tutti i diritti riservati</span></p>
  </div>
</footer>

<style>
  .site-footer-global{position:relative;isolation:isolate;overflow:hidden;min-height:132px;padding:0 clamp(20px,5vw,76px);border-top:1px solid rgba(217,168,63,.18);background:#030303;color:#f4f0e8}
  .site-footer-global__inner{position:relative;z-index:2;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:32px;width:min(1380px,100%);min-height:132px;margin:auto}
  .site-footer-global__brand{position:absolute;left:50%;top:50%;display:block;width:clamp(148px,13vw,190px);transform:translate(-50%,-50%)}
  .site-footer-global__brand img{display:block;width:100%;height:auto}
  .site-footer-global__contact{display:flex;align-items:center;gap:22px;min-width:0}
  .site-footer-global__contact>a{display:inline-flex;align-items:center;gap:9px;color:rgba(244,240,232,.68);font:600 .68rem/1 var(--font-ui,sans-serif);letter-spacing:.035em;text-decoration:none;transition:color .2s ease}
  .site-footer-global__contact svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.4}
  .site-footer-global__contact a:hover,.site-footer-global__contact a:focus-visible{color:#fff}
  .site-footer-global__legal{grid-column:3;justify-self:end;margin:0;color:rgba(244,240,232,.55);font:600 .62rem/1.55 var(--font-ui,sans-serif);letter-spacing:.045em;text-align:right}
  .site-footer-global__legal span{color:rgba(244,240,232,.34)}
  .site-footer-global__brush{position:absolute;z-index:0;top:22%;width:min(34vw,480px);height:58%;opacity:.32;filter:saturate(.8);pointer-events:none}
  .site-footer-global__brush:before,.site-footer-global__brush:after{content:"";position:absolute;inset:0;background:linear-gradient(103deg,transparent 4%,#721712 17%,#b32620 46%,rgba(113,16,14,.28) 76%,transparent 94%);clip-path:polygon(0 47%,9% 35%,25% 40%,42% 18%,63% 37%,100% 30%,92% 53%,70% 56%,48% 82%,25% 61%,6% 72%)}
  .site-footer-global__brush:after{transform:translate(4%,18%) scaleY(.33);opacity:.6}
  .site-footer-global__brush--left{left:-13vw;transform:rotate(-5deg)}
  .site-footer-global__brush--right{right:-13vw;transform:scaleX(-1) rotate(-5deg)}
  @media(max-width:820px){.site-footer-global{padding:32px 20px}.site-footer-global__inner{grid-template-columns:1fr;gap:23px;min-height:0;text-align:center}.site-footer-global__brand{position:static;grid-row:1;justify-self:center;transform:none}.site-footer-global__contact{grid-row:2;justify-self:center;flex-direction:column;gap:14px}.site-footer-global__legal{grid-column:1;grid-row:3;justify-self:center;text-align:center}.site-footer-global__brush{top:3%;width:58vw;height:40%;opacity:.22}.site-footer-global__brush--left{left:-34vw}.site-footer-global__brush--right{right:-34vw}}
  @media(max-width:420px){.site-footer-global__contact>a{font-size:.64rem}.site-footer-global__brand{width:150px}}
  @media(prefers-reduced-motion:reduce){.site-footer-global__contact a{transition:none}}
</style>
