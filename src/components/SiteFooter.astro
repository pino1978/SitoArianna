---
import logo from "../assets/svg/logo-arianna-milano.svg";
import signature from "../assets/svg/signature-ying.svg";
---
<footer class="global-footer" aria-label="Footer del sito">
  <div class="global-footer__topline"></div>
  <div class="global-footer__main">
    <div class="global-footer__identity">
      <a class="global-footer__brand" href="/" data-interactive aria-label="Arianna Milano - Home">
        <img src={logo.src} alt="Arianna Milano" width={logo.width} height={logo.height} />
      </a>
      <p>Disciplina, coraggio, libertà, crescita.</p>
    </div>

    <div class="global-footer__statement" aria-hidden="true">
      <span>YĪNG</span>
      <strong>鹰</strong>
    </div>

    <nav class="global-footer__nav" aria-label="Navigazione footer">
      <p>Esplora</p>
      <a href="/" data-interactive>Home <span>↗</span></a>
      <a href="/profilo/" data-interactive>Il mio percorso <span>↗</span></a>
      <a href="/palmares/" data-interactive>Palmarès <span>↗</span></a>
    </nav>
  </div>

  <div class="global-footer__bottom">
    <p>© 2026 Arianna Milano · Kung Fu Sanda</p>
    <img class="global-footer__signature" src={signature.src} alt="Ying" width="150" height="42" />
    <a href="#top" data-interactive>Torna su <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .global-footer{position:relative;overflow:hidden;padding:0 clamp(20px,5vw,76px) 24px;background:linear-gradient(180deg,#070706 0%,#030303 100%);color:#f4f0e8}.global-footer:before{content:"";position:absolute;right:-8vw;bottom:-17vw;width:42vw;aspect-ratio:1;border:1px solid rgba(217,168,63,.08);border-radius:50%;box-shadow:0 0 0 5vw rgba(217,168,63,.018),0 0 0 10vw rgba(217,168,63,.012);pointer-events:none}.global-footer__topline{height:1px;background:linear-gradient(90deg,transparent,rgba(217,168,63,.72),transparent)}.global-footer__main{position:relative;z-index:1;display:grid;grid-template-columns:minmax(220px,.9fr) minmax(280px,1.35fr) minmax(180px,.65fr);gap:clamp(34px,6vw,88px);align-items:end;width:min(1280px,100%);margin:auto;padding:64px 0 54px}.global-footer__brand{display:block;width:178px}.global-footer__brand img{display:block;width:100%;height:auto}.global-footer__identity p{max-width:260px;margin:24px 0 0;color:rgba(244,240,232,.55);font:500 .82rem/1.65 var(--font-ui,sans-serif);letter-spacing:.04em}.global-footer__statement{display:flex;align-items:flex-end;gap:18px;min-width:0}.global-footer__statement span{font:900 clamp(4rem,9vw,8rem)/.72 var(--font-ui,sans-serif);letter-spacing:-.06em;color:rgba(244,240,232,.92)}.global-footer__statement strong{color:#d9a83f;font:500 clamp(3.8rem,8vw,7rem)/.72 serif}.global-footer__nav{display:grid;align-content:end;gap:12px}.global-footer__nav p{margin:0 0 10px;color:#d9a83f;font:800 .62rem/1 var(--font-ui,sans-serif);letter-spacing:.18em;text-transform:uppercase}.global-footer__nav a{display:flex;justify-content:space-between;gap:24px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.09);color:rgba(244,240,232,.78);text-decoration:none;font:700 .72rem/1 var(--font-ui,sans-serif);letter-spacing:.11em;text-transform:uppercase;transition:color .2s ease,border-color .2s ease}.global-footer__nav a span{color:#d9a83f}.global-footer__nav a:hover,.global-footer__nav a:focus-visible{color:#fff;border-color:rgba(217,168,63,.52)}.global-footer__bottom{position:relative;z-index:1;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:28px;width:min(1280px,100%);margin:auto;padding-top:22px;border-top:1px solid rgba(255,255,255,.07)}.global-footer__bottom p{margin:0;color:rgba(244,240,232,.38);font:700 .56rem/1.4 var(--font-ui,sans-serif);letter-spacing:.12em;text-transform:uppercase}.global-footer__signature{width:132px;height:auto;opacity:.8}.global-footer__bottom>a{justify-self:end;color:#d9a83f;text-decoration:none;font:800 .58rem/1 var(--font-ui,sans-serif);letter-spacing:.14em;text-transform:uppercase}
  @media(max-width:820px){.global-footer__main{grid-template-columns:1fr 1fr;align-items:start;padding:48px 0 42px}.global-footer__statement{grid-column:1/-1;grid-row:1}.global-footer__identity{grid-column:1}.global-footer__nav{grid-column:2}.global-footer__bottom{grid-template-columns:1fr auto}.global-footer__signature{display:none}}
  @media(max-width:560px){.global-footer{padding-left:18px;padding-right:18px}.global-footer__main{grid-template-columns:1fr;gap:36px;padding:42px 0 34px}.global-footer__statement,.global-footer__identity,.global-footer__nav{grid-column:1}.global-footer__statement{grid-row:auto}.global-footer__statement span{font-size:clamp(3.5rem,22vw,5.4rem)}.global-footer__statement strong{font-size:clamp(3rem,18vw,4.8rem)}.global-footer__nav{width:100%}.global-footer__bottom{grid-template-columns:1fr;gap:14px;text-align:left}.global-footer__bottom>a{justify-self:start}.global-footer__brand{width:154px}}
  @media(prefers-reduced-motion:reduce){.global-footer__nav a{transition:none}}
</style>