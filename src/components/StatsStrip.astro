---
const { stats } = Astro.props;
const iconModules = import.meta.glob("../assets/svg/stat-*.svg", { eager: true });

function iconFor(fileName) {
  const key = `../assets/svg/${fileName}`;
  return iconModules[key]?.default?.src ?? "";
}
---
<div class="stats-stage">
  <div class="stats-watermark" aria-hidden="true">Sezione in aggiornamento</div>
  <ul class="stats-strip" aria-label="Statistiche sportive sintetiche in aggiornamento">
    {stats.map((stat) => (
      <li>
        <img src={iconFor(stat.icon)} alt="" aria-hidden="true" width="32" height="32" />
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .stats-stage {
    position: relative;
    isolation: isolate;
  }

  .stats-watermark {
    position: absolute;
    z-index: 5;
    top: 50%;
    left: 50%;
    width: max-content;
    max-width: 92%;
    transform: translate(-50%, -50%);
    color: rgba(255, 255, 255, .24);
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.8rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: .04em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    text-shadow: 0 1px 12px rgba(0, 0, 0, .5);
  }

  @media (max-width: 640px) {
    .stats-watermark {
      font-size: clamp(.78rem, 3.7vw, 1.05rem);
      letter-spacing: .025em;
      color: rgba(255, 255, 255, .22);
    }
  }
</style>
