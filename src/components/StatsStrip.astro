---
const { stats } = Astro.props;
const iconModules = import.meta.glob("../assets/svg/stat-*.svg", { eager: true });

function iconFor(fileName) {
  const key = `../assets/svg/${fileName}`;
  const iconModule = iconModules[key];
  return iconModule?.default?.src ?? iconModule?.default ?? iconModule?.src ?? "";
}
---
<ul class="stats-strip stats-strip--updating" aria-label="Statistiche sportive sintetiche in aggiornamento">
  {stats.map((stat) => (
    <li>
      <img src={iconFor(stat.icon)} alt="" aria-hidden="true" width="32" height="32" />
      <strong>{stat.value}</strong>
      <span>{stat.label}</span>
    </li>
  ))}
</ul>

<style>
  .stats-strip--updating {
    position: relative;
    isolation: isolate;
  }

  .stats-strip--updating::before {
    position: absolute;
    z-index: 10;
    top: 50%;
    left: 50%;
    width: max-content;
    max-width: 94%;
    transform: translate(-50%, -50%);
    color: rgba(255, 255, 255, .22);
    content: "Sezione in aggiornamento";
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.8vw, 2.35rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: .035em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    text-shadow: 0 1px 14px rgba(0, 0, 0, .68);
  }

  .stats-strip--updating li {
    position: relative;
    z-index: 2;
  }

  .stats-strip--updating img {
    position: relative;
    z-index: 2;
    display: block;
    opacity: 1;
  }

  @media (max-width: 640px) {
    .stats-strip--updating {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      width: calc(100vw - 36px);
      margin-inline: 18px;
      padding: 42px 8px 24px;
    }

    .stats-strip--updating li {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      min-width: 0;
      min-height: 150px;
      margin: 0;
      padding: 0 8px;
      text-align: center;
    }

    .stats-strip--updating img {
      display: block !important;
      width: 42px;
      height: 42px;
      max-width: none;
      margin: 0 0 18px;
      object-fit: contain;
    }

    .stats-strip--updating strong {
      display: block;
      margin: 0 0 14px;
      font-size: clamp(2rem, 8.6vw, 2.55rem);
      line-height: .9;
      text-align: center;
      white-space: nowrap;
    }

    .stats-strip--updating span {
      display: block;
      width: auto;
      max-width: 94px;
      margin: 0 auto;
      font-size: clamp(.5rem, 2vw, .66rem);
      line-height: 1.2;
      text-align: center;
      white-space: normal;
    }

    .stats-strip--updating::before {
      top: 48%;
      width: calc(100% - 20px);
      max-width: none;
      transform: translate(-50%, -50%);
      font-size: clamp(1.05rem, 5.2vw, 1.48rem);
      letter-spacing: .018em;
      color: rgba(255, 255, 255, .22);
      white-space: normal;
    }
  }
</style>
