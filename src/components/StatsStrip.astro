---
const { stats } = Astro.props;
const showPalmaresCta = Astro.url.pathname === "/";
const iconModules = import.meta.glob("../assets/svg/stat-*.svg", { eager: true });

function iconFor(fileName) {
  const key = `../assets/svg/${fileName}`;
  const iconModule = iconModules[key];
  return iconModule?.default?.src ?? iconModule?.default ?? iconModule?.src ?? "";
}
---
<div class="stats-block">
  <ul class="stats-strip" aria-label="Statistiche sportive sintetiche">
    {stats.map((stat) => (
      <li>
        <img src={iconFor(stat.icon)} alt="" aria-hidden="true" width="32" height="32" />
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </li>
    ))}
  </ul>

  {showPalmaresCta && (
    <a class="stats-palmares" href="/risultati/" data-interactive aria-label="Esplora il palmarès e tutti i risultati di Arianna Milano">
      <span class="stats-palmares__label">Esplora il palmarès</span>
      <span class="stats-palmares__arrow" aria-hidden="true">→</span>
      <span class="stats-palmares__meta">Risultati · Gare · Podi · Il percorso continua.</span>
    </a>
  )}
</div>

<style>
  .stats-block { width: 100%; }

  .stats-palmares {
    display: flex;
    align-items: center;
    width: 100%;
    margin-top: 9px;
    padding: 13px 0 14px;
    border-top: 0;
    border-bottom: 1px solid rgba(201, 155, 76, .28);
    color: var(--gold-bright);
    text-decoration: none;
    font-family: var(--font-ui);
    text-transform: uppercase;
  }

  .stats-palmares__label {
    flex: 0 0 auto;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .16em;
    white-space: nowrap;
  }

  .stats-palmares__arrow {
    display: inline-block;
    flex: 0 0 auto;
    margin-left: 16px;
    font-size: 1.15rem;
    line-height: 1;
    transition: transform .22s ease;
  }

  .stats-palmares__meta {
    flex: 0 0 auto;
    margin-left: 34px;
    color: rgba(243, 237, 226, .5);
    font-size: .56rem;
    font-weight: 700;
    letter-spacing: .105em;
    line-height: 1;
    white-space: nowrap;
  }

  .stats-palmares:hover .stats-palmares__arrow,
  .stats-palmares:focus-visible .stats-palmares__arrow { transform: translateX(6px); }

  .stats-palmares:focus-visible {
    outline: 2px solid var(--gold-bright);
    outline-offset: 4px;
  }

  @media (max-width: 760px) and (min-width: 641px) {
    .stats-palmares__meta { display: none; }
  }

  @media (max-width: 640px) {
    :global(.home-page .hero) { min-height: 724px !important; }

    :global(.home-page .hero-copy) .stats-block {
      position: absolute;
      top: 548px;
      left: 0;
      width: calc(100vw - 36px);
    }

    .stats-strip,
    :global(.home-page .hero-copy) .stats-strip {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      display: grid !important;
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      gap: 0 !important;
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 12px 0 10px !important;
      transform: none !important;
      box-sizing: border-box !important;
      border-top: 1px solid rgba(216, 161, 58, 0.62);
      border-bottom: 1px solid rgba(216, 161, 58, 0.24);
      background: rgba(5, 5, 5, 0.78);
      backdrop-filter: blur(10px);
    }

    .stats-strip li {
      position: relative;
      display: grid !important;
      grid-template-columns: 1fr !important;
      grid-template-rows: 32px auto auto !important;
      align-items: center;
      justify-items: center;
      align-content: start;
      min-width: 0;
      min-height: 88px !important;
      margin: 0 !important;
      padding: 0 4px !important;
      text-align: center;
    }

    .stats-strip li::after { right: 0; }

    .stats-strip img {
      display: block !important;
      width: 29px !important;
      height: 29px !important;
      max-width: none;
      margin: 0 0 5px !important;
      object-fit: contain;
      grid-column: 1 !important;
      grid-row: 1 !important;
    }

    .stats-strip strong {
      display: block;
      grid-column: 1 !important;
      grid-row: 2 !important;
      margin: 0 0 5px !important;
      color: var(--gold-bright);
      font-size: clamp(1.45rem, 6.4vw, 1.85rem) !important;
      line-height: .92 !important;
      text-align: center;
      white-space: nowrap;
    }

    .stats-strip span {
      display: block;
      grid-column: 1 !important;
      grid-row: 3 !important;
      width: 100%;
      max-width: 84px;
      margin: 0 auto !important;
      font-size: clamp(.42rem, 1.65vw, .52rem) !important;
      line-height: 1.12 !important;
      text-align: center;
      white-space: normal;
    }

    .stats-palmares {
      position: relative;
      display: grid;
      grid-template-columns: auto auto;
      justify-content: start;
      width: 100%;
      margin: 0;
      padding: 14px 0 13px;
      border-top: 1px solid rgba(201, 155, 76, .58);
      background: rgba(5, 5, 5, .9);
    }

    .stats-palmares__label {
      font-size: .66rem;
      letter-spacing: .14em;
    }

    .stats-palmares__arrow { margin-left: 0; }
    .stats-palmares__meta { display: none; }
  }

  @media (max-width: 390px) {
    :global(.home-page .hero) { min-height: 704px !important; }
    :global(.home-page .hero-copy) .stats-block { top: 528px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stats-palmares__arrow { transition: none; }
  }
</style>
