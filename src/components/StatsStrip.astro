---
const { stats } = Astro.props;
const iconModules = import.meta.glob("../assets/svg/stat-*.svg", { eager: true });

function iconFor(fileName) {
  const key = `../assets/svg/${fileName}`;
  const iconModule = iconModules[key];
  return iconModule?.default?.src ?? iconModule?.default ?? iconModule?.src ?? "";
}
---
<ul class="stats-strip stats-strip--updating" aria-label="Statistiche sportive sintetiche in aggiornamento">
  {stats.map((stat) => (
    <li>
      <img src={iconFor(stat.icon)} alt="" aria-hidden="true" width="32" height="32" />
      <strong>{stat.value}</strong>
      <span>{stat.label}</span>
    </li>
  ))}
</ul>

<style>
  .stats-strip--updating {
    isolation: isolate;
  }

  .stats-strip--updating::before {
    position: absolute;
    z-index: 6;
    top: 50%;
    left: 50%;
    width: max-content;
    max-width: 92%;
    transform: translate(-50%, -50%);
    color: rgba(255, 255, 255, .28);
    content: "Sezione in aggiornamento";
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.8rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: .04em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    text-shadow: 0 1px 12px rgba(0, 0, 0, .62);
  }

  .stats-strip--updating img {
    position: relative;
    z-index: 2;
    display: block;
    opacity: 1;
  }

  @media (max-width: 640px) {
    .stats-strip--updating::before {
      font-size: clamp(.72rem, 3.4vw, .98rem);
      letter-spacing: .02em;
      color: rgba(255, 255, 255, .27);
    }
  }
</style>
