---
const { stats } = Astro.props;
const showPalmaresCta = Astro.url.pathname === "/";
const iconModules = import.meta.glob("../assets/svg/stat-*.svg", { eager: true });

function iconFor(fileName) {
  const key = `../assets/svg/${fileName}`;
  const iconModule = iconModules[key];
  return iconModule?.default?.src ?? iconModule?.default ?? iconModule?.src ?? "";
}
---
<div class="stats-block">
  <ul class="stats-strip" aria-label="Statistiche sportive sintetiche">
    {stats.map((stat) => (
      <li>
        <img src={iconFor(stat.icon)} alt="" aria-hidden="true" width="32" height="32" />
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </li>
    ))}
  </ul>

  {showPalmaresCta && (
    <a class="stats-palmares" href="/risultati/" data-interactive aria-label="Esplora il palmarès e tutti i risultati di Arianna Milano">
      <span class="stats-palmares__meta">Risultati · Gare · Podi · Il percorso continua.</span>
      <span class="stats-palmares__button">
        <span class="stats-palmares__label">Esplora il palmarès</span>
        <b class="stats-palmares__arrow" aria-hidden="true">→</b>
      </span>
    </a>
  )}
</div>

<style>
  .stats-block {
    width: min(720px, calc(100vw - 96px));
    max-width: none;
  }

  .stats-palmares {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: calc(100% - 42px);
    margin-top: 10px;
    padding: 12px 0 13px;
    border-bottom: 1px solid rgba(201, 155, 76, .34);
    color: var(--gold-bright);
    text-decoration: none;
    font-family: var(--font-ui);
    text-transform: uppercase;
  }

  .stats-palmares__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-width: 228px;
    padding: 5px 5px 5px 14px;
    border: 1px solid rgba(217, 168, 63, .68);
    transition: background .22s ease, border-color .22s ease;
  }

  .stats-palmares__label {
    flex: 0 0 auto;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .14em;
    white-space: nowrap;
  }

  .stats-palmares__arrow {
    display: grid;
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 50%;
    background: var(--gold-bright);
    color: #080706;
    font-size: 1rem;
    line-height: 1;
    transition: transform .22s ease;
  }

  .stats-palmares__meta {
    flex: 0 0 auto;
    color: rgba(243, 237, 226, .5);
    font-size: .54rem;
    font-weight: 700;
    letter-spacing: .1em;
    line-height: 1;
    white-space: nowrap;
  }

  .stats-palmares:hover .stats-palmares__button,
  .stats-palmares:focus-visible .stats-palmares__button {
    border-color: var(--gold-bright);
    background: rgba(217, 168, 63, .08);
  }

  .stats-palmares:hover .stats-palmares__arrow,
  .stats-palmares:focus-visible .stats-palmares__arrow { transform: translateX(3px); }

  .stats-palmares:focus-visible {
    outline: 2px solid var(--gold-bright);
    outline-offset: 4px;
  }

  @media (max-width: 760px) and (min-width: 641px) {
    .stats-palmares__meta { display: none; }
  }

  @media (max-width: 640px) {
    :global(.home-page .hero) { min-height: 724px !important; }

    :global(.home-page .hero-copy) .stats-block {
      position: absolute;
      top: 548px;
      left: 0;
      width: calc(100vw - 36px);
    }

    .stats-strip,
    :global(.home-page .hero-copy) .stats-strip {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      display: grid !important;
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      gap: 0 !important;
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 12px 0 10px !important;
      transform: none !important;
      box-sizing: border-box !important;
      border-top: 1px solid rgba(216, 161, 58, 0.62);
      border-bottom: 1px solid rgba(216, 161, 58, 0.24);
      background: rgba(5, 5, 5, 0.78);
      backdrop-filter: blur(10px);
    }

    .stats-strip li {
      position: relative;
      display: grid !important;
      grid-template-columns: 1fr !important;
      grid-template-rows: 32px auto auto !important;
      align-items: center;
      justify-items: center;
      align-content: start;
      min-width: 0;
      min-height: 88px !important;
      margin: 0 !important;
      padding: 0 4px !important;
      text-align: center;
    }

    .stats-strip li::after { right: 0; }

    .stats-strip img {
      display: block !important;
      width: 29px !important;
      height: 29px !important;
      max-width: none;
      margin: 0 0 5px !important;
      object-fit: contain;
      grid-column: 1 !important;
      grid-row: 1 !important;
    }

    .stats-strip strong {
      display: block;
      grid-column: 1 !important;
      grid-row: 2 !important;
      margin: 0 0 5px !important;
      color: var(--gold-bright);
      font-size: clamp(1.45rem, 6.4vw, 1.85rem) !important;
      line-height: .92 !important;
      text-align: center;
      white-space: nowrap;
    }

    .stats-strip span {
      display: block;
      grid-column: 1 !important;
      grid-row: 3 !important;
      width: 100%;
      max-width: 84px;
      margin: 0 auto !important;
      font-size: clamp(.42rem, 1.65vw, .52rem) !important;
      line-height: 1.12 !important;
      text-align: center;
      white-space: normal;
    }

    .stats-palmares {
      position: relative;
      display: grid;
      grid-template-columns: auto auto;
      justify-content: start;
      width: 100%;
      margin: 0;
      padding: 14px 0 13px;
      border-top: 1px solid rgba(201, 155, 76, .58);
      border-bottom: 1px solid rgba(201, 155, 76, .24);
      background: rgba(5, 5, 5, .9);
    }

    .stats-palmares__button {
      display: contents;
    }

    .stats-palmares__label {
      font-size: .66rem;
      letter-spacing: .14em;
    }

    .stats-palmares__arrow {
      display: inline-block;
      width: auto;
      height: auto;
      margin-left: 0;
      border-radius: 0;
      background: transparent;
      color: var(--gold-bright);
      font-size: 1.15rem;
    }

    .stats-palmares__meta { display: none; }
  }

  @media (max-width: 390px) {
    :global(.home-page .hero) { min-height: 704px !important; }
    :global(.home-page .hero-copy) .stats-block { top: 528px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stats-palmares__arrow { transition: none; }
  }
</style>
