---
const { stats } = Astro.props;
const iconModules = import.meta.glob("../assets/svg/stat-*.svg", { eager: true });

function iconFor(fileName) {
  const key = `../assets/svg/${fileName}`;
  const iconModule = iconModules[key];
  return iconModule?.default?.src ?? iconModule?.default ?? iconModule?.src ?? "";
}
---
<ul class="stats-strip" aria-label="Statistiche sportive sintetiche">
  {stats.map((stat) => (
    <li>
      <img src={iconFor(stat.icon)} alt="" aria-hidden="true" width="32" height="32" />
      <strong>{stat.value}</strong>
      <span>{stat.label}</span>
    </li>
  ))}
</ul>

<style>
  @media (max-width: 640px) {
    .stats-strip,
    .hero-copy .stats-strip {
      position: relative;
      left: auto;
      right: auto;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 42px 10px 24px;
      transform: none;
      box-sizing: border-box;
    }

    .stats-strip li {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      min-width: 0;
      min-height: 150px;
      margin: 0;
      padding: 0 5px;
      text-align: center;
    }

    .stats-strip li::after {
      right: 0;
    }

    .stats-strip img {
      display: block !important;
      width: 42px;
      height: 42px;
      max-width: none;
      margin: 0 0 18px;
      object-fit: contain;
    }

    .stats-strip strong {
      display: block;
      margin: 0 0 14px;
      font-size: clamp(2rem, 8.6vw, 2.55rem);
      line-height: .9;
      text-align: center;
      white-space: nowrap;
    }

    .stats-strip span {
      display: block;
      width: 100%;
      max-width: 90px;
      margin: 0 auto;
      font-size: clamp(.48rem, 1.9vw, .64rem);
      line-height: 1.2;
      text-align: center;
      white-space: normal;
    }
  }
</style>
