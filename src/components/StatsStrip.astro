---
const { stats } = Astro.props;
const iconModules = import.meta.glob("../assets/svg/stat-*.svg", { eager: true });

function iconFor(fileName) {
  const key = `../assets/svg/${fileName}`;
  const iconModule = iconModules[key];
  return iconModule?.default?.src ?? iconModule?.default ?? iconModule?.src ?? "";
}
---
<ul class="stats-strip stats-strip--updating" aria-label="Statistiche sportive sintetiche in aggiornamento">
  {stats.map((stat) => (
    <li>
      <img src={iconFor(stat.icon)} alt="" aria-hidden="true" width="32" height="32" />
      <strong>{stat.value}</strong>
      <span>{stat.label}</span>
    </li>
  ))}
</ul>

<style>
  .stats-strip--updating {
    position: relative;
    isolation: isolate;
  }

  .stats-strip--updating::before {
    position: absolute;
    z-index: 6;
    top: 50%;
    left: 50%;
    width: max-content;
    max-width: 94%;
    transform: translate(-50%, -50%);
    color: rgba(255, 255, 255, .3);
    content: "Sezione in aggiornamento";
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.8vw, 2.35rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: .035em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    text-shadow: 0 1px 14px rgba(0, 0, 0, .68);
  }

  .stats-strip--updating li {
    position: relative;
    z-index: 2;
  }

  .stats-strip--updating img {
    position: relative;
    z-index: 2;
    display: block;
    opacity: 1;
  }

  @media (max-width: 640px) {
    .stats-strip--updating {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      width: calc(100vw - 36px);
      margin-inline: 18px;
    }

    .stats-strip--updating li {
      display: grid;
      grid-template-columns: 30px minmax(0, 1fr);
      grid-template-rows: 34px auto;
      align-items: center;
      column-gap: 4px;
      row-gap: 8px;
      min-width: 0;
      min-height: 86px;
      margin: 0;
      padding: 0 8px;
    }

    .stats-strip--updating img {
      display: block !important;
      grid-column: 1;
      grid-row: 1;
      width: 28px;
      height: 28px;
      max-width: none;
      object-fit: contain;
    }

    .stats-strip--updating strong {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      font-size: clamp(1.45rem, 6.2vw, 1.85rem);
      line-height: 1;
      white-space: nowrap;
    }

    .stats-strip--updating span {
      grid-column: 1 / -1;
      grid-row: 2;
      width: auto;
      max-width: none;
      font-size: clamp(.48rem, 1.9vw, .62rem);
      line-height: 1.15;
      text-align: center;
      white-space: normal;
    }

    .stats-strip--updating::before {
      top: 49%;
      width: calc(100% - 20px);
      max-width: none;
      font-size: clamp(1.05rem, 5.4vw, 1.48rem);
      letter-spacing: .018em;
      color: rgba(255, 255, 255, .3);
      white-space: normal;
    }
  }
</style>
