---
const { stats } = Astro.props;
const iconModules = import.meta.glob("../assets/svg/stat-*.svg", { eager: true });

function iconFor(fileName) {
  const key = `../assets/svg/${fileName}`;
  const iconModule = iconModules[key];
  return iconModule?.default?.src ?? iconModule?.default ?? iconModule?.src ?? "";
}
---
<ul class="stats-strip" aria-label="Statistiche sportive sintetiche">
  {stats.map((stat) => (
    <li>
      <img src={iconFor(stat.icon)} alt="" aria-hidden="true" width="32" height="32" />
      <strong>{stat.value}</strong>
      <span>{stat.label}</span>
    </li>
  ))}
</ul>

<style>
  @media (max-width: 640px) {
    .stats-strip,
    .hero-copy .stats-strip {
      position: absolute !important;
      left: 0 !important;
      right: auto !important;
      display: grid !important;
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      gap: 0 !important;
      width: calc(100vw - 36px) !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 12px 0 10px !important;
      transform: none !important;
      box-sizing: border-box !important;
    }

    .stats-strip li {
      position: relative;
      display: grid !important;
      grid-template-rows: 30px auto auto;
      align-items: center;
      justify-items: center;
      align-content: start;
      min-width: 0;
      min-height: 88px !important;
      margin: 0 !important;
      padding: 0 4px !important;
      text-align: center;
    }

    .stats-strip li::after {
      right: 0;
    }

    .stats-strip img {
      display: block !important;
      width: 29px !important;
      height: 29px !important;
      max-width: none;
      margin: 0 0 5px !important;
      object-fit: contain;
    }

    .stats-strip strong {
      display: block;
      margin: 0 0 5px !important;
      color: var(--gold-bright);
      font-size: clamp(1.45rem, 6.4vw, 1.85rem) !important;
      line-height: .92 !important;
      text-align: center;
      white-space: nowrap;
    }

    .stats-strip span {
      display: block;
      width: 100%;
      max-width: 84px;
      margin: 0 auto !important;
      font-size: clamp(.42rem, 1.65vw, .52rem) !important;
      line-height: 1.12 !important;
      text-align: center;
      white-space: normal;
    }
  }
</style>
