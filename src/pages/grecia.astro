---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---
<BaseLayout
  title="Road to Greece 2026 | Arianna Milano"
  description="Road to Greece 2026: il percorso di Arianna Milano verso la prossima sfida internazionale di Sanda a Nafplio, Grecia."
>
  <main class="greece-page" id="main">
    <Header />

    <section class="greece-hero" aria-labelledby="greece-title">
      <div class="greece-hero__grid" aria-hidden="true"></div>
      <div class="greece-hero__year" aria-hidden="true">2026</div>
      <div class="greece-hero__content">
        <p class="greece-eyebrow">Next international challenge</p>
        <h1 id="greece-title"><span>Road to</span><br />Greece</h1>
        <p class="greece-hero__meta">Nafplio · Grecia · Novembre 2026</p>
        <p class="greece-hero__claim">Il prossimo passo è oltre il confine.</p>
        <div class="greece-route" aria-label="Dall'Italia alla Grecia"><span>ITA</span><i></i><b aria-hidden="true">→</b><i></i><span>GRE</span></div>
      </div>
      <a class="greece-scroll" href="#sfida" data-interactive>Scopri la sfida <span aria-hidden="true">↓</span></a>
    </section>

    <section class="greece-intro greece-shell" id="sfida" aria-labelledby="challenge-title">
      <p class="section-kicker">La sfida</p>
      <div class="greece-intro__grid">
        <h2 id="challenge-title">Un nuovo tatami.<br /><em>Un nuovo confronto.</em></h2>
        <div class="greece-copy">
          <p>La Grecia rappresenta una nuova tappa del percorso agonistico di Arianna: un’esperienza internazionale, un contesto diverso e la possibilità di misurarsi fuori dai confini abituali.</p>
          <p>Non è soltanto una trasferta. È preparazione, disciplina e crescita: tutto ciò che viene prima di salire sul tatami.</p>
        </div>
      </div>
    </section>

    <section class="greece-milestones" aria-labelledby="road-title">
      <div class="greece-shell">
        <p class="section-kicker">Il percorso</p>
        <h2 id="road-title">La strada verso <em>Nafplio.</em></h2>
        <ol class="roadline">
          <li><span>2021</span><strong>Inizio</strong><p>I primi passi nel Sanda e un percorso costruito allenamento dopo allenamento.</p></li>
          <li><span>2026</span><strong>Competizioni</strong><p>Esperienze agonistiche, vittorie e nuovi obiettivi da raggiungere.</p></li>
          <li class="is-current"><span>Nov 2026</span><strong>Greece</strong><p>La prossima sfida porta Arianna su un tatami internazionale.</p></li>
        </ol>
        <a class="text-link" href="/risultati/" data-interactive>Scopri tutti i risultati <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="greece-prep greece-shell" aria-labelledby="prep-title">
      <div class="greece-prep__statement">
        <p class="section-kicker">Preparazione</p>
        <h2 id="prep-title">La gara dura pochi minuti.<br /><em>La preparazione dura mesi.</em></h2>
      </div>
      <div class="greece-prep__cards">
        <article><span>01</span><h3>Tecnica</h3><p>Allenare precisione, timing, distanza e capacità di adattamento.</p></article>
        <article><span>02</span><h3>Condizione</h3><p>Costruire continuità, resistenza e controllo sotto pressione.</p></article>
        <article><span>03</span><h3>Testa</h3><p>Entrare sul tatami concentrati, lucidi e pronti ad affrontare l’imprevisto.</p></article>
      </div>
    </section>

    <section class="greece-destination" aria-labelledby="destination-title">
      <div class="greece-destination__line" aria-hidden="true"></div>
      <div class="greece-shell greece-destination__inner">
        <div>
          <p class="section-kicker">Destination</p>
          <h2 id="destination-title">Nafplio<br /><em>Greece.</em></h2>
        </div>
        <dl class="event-card">
          <div><dt>Paese</dt><dd>Grecia</dd></div>
          <div><dt>Città</dt><dd>Nafplio</dd></div>
          <div><dt>Periodo</dt><dd>Novembre 2026</dd></div>
          <div><dt>Disciplina</dt><dd>Sanda</dd></div>
        </dl>
      </div>
    </section>

    <section class="greece-follow greece-shell" aria-labelledby="follow-title">
      <p class="section-kicker">Road to Greece</p>
      <h2 id="follow-title">Segui il percorso.</h2>
      <p>Allenamenti, gare e momenti che accompagnano Arianna verso la prossima sfida.</p>
      <div class="greece-follow__actions">
        <a href="/media/" data-interactive>Foto & video <span aria-hidden="true">→</span></a>
        <a href="/profilo/" data-interactive>Profilo atleta <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
:global(body){background:#050504}.greece-page{--gold:#c7a15a;--red:#86171c;--ivory:#f4efe5;--muted:rgba(244,239,229,.68);min-height:100vh;overflow:hidden;background:#050504;color:var(--ivory)}.greece-shell{width:min(1180px,calc(100% - 64px));margin-inline:auto}.greece-hero{position:relative;isolation:isolate;min-height:min(760px,82vh);display:flex;align-items:center;overflow:hidden;border-bottom:1px solid rgba(199,161,90,.28);background:radial-gradient(circle at 76% 42%,rgba(134,23,28,.24),transparent 25%),radial-gradient(circle at 72% 55%,rgba(199,161,90,.08),transparent 36%),linear-gradient(110deg,#050505 0%,#090909 56%,#10100e 100%)}.greece-hero__grid{position:absolute;z-index:-2;inset:0;opacity:.16;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:64px 64px;mask-image:linear-gradient(90deg,transparent 0%,#000 48%,#000 100%)}.greece-hero__year{position:absolute;z-index:-1;right:-1vw;top:50%;transform:translateY(-51%);color:transparent;-webkit-text-stroke:1px rgba(199,161,90,.13);font:900 clamp(10rem,25vw,25rem)/.8 var(--font-display);letter-spacing:-.07em;user-select:none}.greece-hero__content{width:min(1180px,calc(100% - 64px));margin:44px auto 0}.greece-eyebrow,.section-kicker{margin:0 0 14px;color:var(--gold);font:800 .66rem/1.2 var(--font-ui);letter-spacing:.2em;text-transform:uppercase}.greece-hero h1,.greece-page h2{margin:0;font-family:var(--font-display);font-weight:900;letter-spacing:-.045em;text-transform:uppercase}.greece-hero h1{font-size:clamp(4rem,9vw,9rem);line-height:.78}.greece-hero h1 span{font-weight:400;color:var(--ivory)}.greece-hero__meta{margin:20px 0 0;color:#d6cfbf;font:800 .72rem var(--font-ui);letter-spacing:.16em;text-transform:uppercase}.greece-hero__claim{max-width:560px;margin:25px 0 26px;color:var(--ivory);font:400 clamp(1.2rem,2vw,1.75rem)/1.35 var(--font-display);font-style:italic}.greece-route{display:flex;align-items:center;gap:11px;width:max-content;color:#d6cfbf;font:800 .62rem var(--font-ui);letter-spacing:.14em}.greece-route i{width:48px;height:1px;background:linear-gradient(90deg,var(--red),var(--gold))}.greece-route b{color:var(--gold);font-size:1.1rem;font-weight:400}.greece-scroll{position:absolute;right:clamp(32px,6.4vw,104px);bottom:34px;color:rgba(244,239,229,.62);font:800 .58rem var(--font-ui);letter-spacing:.16em;text-decoration:none;text-transform:uppercase}.greece-scroll span{margin-left:8px;color:var(--gold)}.greece-intro{padding:78px 0 84px}.greece-intro__grid{display:grid;grid-template-columns:1.05fr .95fr;gap:76px;align-items:start}.greece-page h2{font-size:clamp(2.8rem,5vw,5rem);line-height:.93}.greece-page h2 em{color:transparent;-webkit-text-stroke:1px rgba(199,161,90,.8);font-style:normal}.greece-copy p,.roadline p,.greece-prep__cards p,.greece-follow>p{color:var(--muted);font-size:1rem;line-height:1.65}.greece-copy p{margin:0 0 18px}.greece-milestones{padding:72px 0 82px;border-block:1px solid rgba(199,161,90,.13);background:#080807}.roadline{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin:46px 0 28px;padding:0;list-style:none}.roadline::before{position:absolute;top:15px;left:0;right:0;height:1px;background:linear-gradient(90deg,rgba(199,161,90,.15),var(--gold));content:""}.roadline li{position:relative;padding-top:42px}.roadline li::before{position:absolute;top:9px;left:0;width:13px;height:13px;border:1px solid var(--gold);border-radius:50%;background:#080807;content:""}.roadline .is-current::before{background:var(--gold);box-shadow:0 0 0 6px rgba(199,161,90,.08)}.roadline span{display:block;margin-bottom:8px;color:var(--gold);font:800 .62rem var(--font-ui);letter-spacing:.14em;text-transform:uppercase}.roadline strong{display:block;color:var(--ivory);font:800 1.3rem var(--font-display);letter-spacing:.02em;text-transform:uppercase}.roadline p{max-width:310px;margin:10px 0 0;font-size:.92rem}.text-link{display:inline-flex;gap:12px;align-items:center;margin-top:12px;border-bottom:1px solid var(--red);padding-bottom:5px;color:var(--ivory);font:800 .64rem var(--font-ui);letter-spacing:.13em;text-decoration:none;text-transform:uppercase}.text-link span{color:var(--gold)}.greece-prep{padding:82px 0}.greece-prep__statement{max-width:850px}.greece-prep__cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:48px;background:rgba(199,161,90,.22)}.greece-prep__cards article{min-height:240px;padding:28px;background:#060606}.greece-prep__cards span{color:var(--gold);font:800 .6rem var(--font-ui);letter-spacing:.15em}.greece-prep__cards h3{margin:28px 0 12px;font:800 1.45rem var(--font-display);letter-spacing:.04em;text-transform:uppercase}.greece-prep__cards p{margin:0;font-size:.92rem}.greece-destination{position:relative;padding:82px 0;border-block:1px solid rgba(199,161,90,.18);background:radial-gradient(circle at 25% 50%,rgba(134,23,28,.16),transparent 32%),#080807}.greece-destination__line{position:absolute;left:0;right:0;top:50%;height:1px;background:linear-gradient(90deg,transparent,var(--red),var(--gold),transparent);opacity:.22}.greece-destination__inner{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:76px;align-items:center}.event-card{margin:0;border:1px solid rgba(199,161,90,.32);background:rgba(0,0,0,.22)}.event-card div{display:grid;grid-template-columns:1fr 1.4fr;gap:20px;padding:18px 22px;border-bottom:1px solid rgba(199,161,90,.14)}.event-card div:last-child{border-bottom:0}.event-card dt{color:rgba(244,239,229,.46);font:700 .62rem var(--font-ui);letter-spacing:.14em;text-transform:uppercase}.event-card dd{margin:0;color:var(--ivory);font:800 .76rem var(--font-ui);letter-spacing:.08em;text-align:right;text-transform:uppercase}.greece-follow{padding:86px 0 92px;text-align:center}.greece-follow h2{font-size:clamp(3rem,6vw,6rem)}.greece-follow>p{max-width:600px;margin:20px auto 28px}.greece-follow__actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}.greece-follow__actions a{display:inline-flex;align-items:center;gap:14px;padding:14px 18px;border:1px solid rgba(199,161,90,.48);color:var(--gold);font:800 .64rem var(--font-ui);letter-spacing:.13em;text-decoration:none;text-transform:uppercase}.greece-follow__actions a span{color:var(--ivory)}
@media(max-width:800px){.greece-shell,.greece-hero__content{width:calc(100% - 36px)}.greece-hero{min-height:650px}.greece-hero__content{margin-top:52px}.greece-hero__year{right:-36px;font-size:15rem}.greece-intro__grid,.greece-destination__inner{grid-template-columns:1fr;gap:34px}.roadline{grid-template-columns:1fr;gap:16px;margin-top:34px;padding-left:24px}.roadline::before{top:0;bottom:0;left:6px;right:auto;width:1px;height:auto}.roadline li{padding:0 0 24px 22px}.roadline li::before{top:3px;left:-24px}.greece-prep__cards{grid-template-columns:1fr}.greece-prep__cards article{min-height:0}.greece-scroll{right:18px;bottom:22px}}
@media(max-width:520px){.greece-hero{min-height:590px}.greece-hero h1{font-size:clamp(3.8rem,19vw,5.5rem)}.greece-hero__meta{font-size:.62rem;line-height:1.5}.greece-hero__claim{max-width:300px;font-size:1.18rem}.greece-route i{width:28px}.greece-intro,.greece-prep,.greece-destination,.greece-follow{padding-block:58px}.greece-milestones{padding-block:58px}.greece-page h2{font-size:clamp(2.5rem,12vw,3.8rem)}.greece-prep__cards{margin-top:34px}.event-card div{padding:16px}.event-card dd{font-size:.68rem}.greece-scroll{display:none}}
</style>
