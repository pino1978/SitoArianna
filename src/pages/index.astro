---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import HighlightsStrip from "../components/HighlightsStrip.astro";
import ProfileFeature from "../components/ProfileFeature.astro";
---
<BaseLayout
  title="Arianna Milano | Atleta Sanda e Kung Fu"
  description="Sito ufficiale di Arianna Milano, giovane atleta agonista di Sanda e Kung Fu. Scopri profilo sportivo, risultati, competizioni, foto e video."
>
  <script is:inline>
    (() => {
      const hash = window.location.hash || "";
      const isIdentityCallback =
        hash.startsWith("#recovery_token=") ||
        hash.startsWith("#invite_token=") ||
        hash.startsWith("#confirmation_token=") ||
        hash.startsWith("#access_token=") ||
        hash.startsWith("#error=");

      if (isIdentityCallback) {
        window.location.replace(`/admin/${hash}`);
      }
    })();
  </script>
  <main id="main" class="home-page">
    <Hero />
    <HighlightsStrip />
    <ProfileFeature />
    <section class="athlete-hub" aria-labelledby="athlete-hub-title">
      <div class="athlete-hub__inner">
        <p class="athlete-hub__eyebrow">Portfolio ufficiale</p>
        <h2 id="athlete-hub-title">Arianna Milano<br /><em>Sanda athlete.</em></h2>
        <p>Arianna Milano è una giovane atleta agonista di Sanda e Kung Fu. Gareggia nel Sanda Light e costruisce il proprio percorso sportivo con ASD Kasoria Kombat &amp; Fly, nell'ambito delle competizioni CSEN. Scopri il suo <a href="/profilo/" data-interactive>profilo sportivo</a>, il <a href="/risultati/" data-interactive>palmarès</a> e la raccolta <a href="/media/" data-interactive>foto e video</a>.</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .home-page{display:block;margin:0;padding:0;background:#080706}
  .home-page>section{margin-block:0!important}
  .home-page .hero,.home-page .hero-values,.home-page .highlights-strip,.home-page .profile-feature{margin-top:0!important;margin-bottom:0!important}
  .athlete-hub{border-top:1px solid rgba(185,134,50,.22);background:radial-gradient(circle at 14% 28%,rgba(185,134,50,.07),transparent 30%),#060606;color:#f5f0e7}
  .athlete-hub__inner{width:min(850px,calc(100% - 80px));margin:auto;padding:clamp(54px,6vw,78px) 0}
  .athlete-hub__eyebrow{margin:0 0 14px;color:var(--gold-bright);font:800 .64rem/1.2 var(--font-ui);letter-spacing:.18em;text-transform:uppercase}
  .athlete-hub h2{margin:0 0 22px;font:900 clamp(2.6rem,4.4vw,4.6rem)/.9 var(--font-display);letter-spacing:-.025em;text-transform:uppercase}
  .athlete-hub h2 em{color:var(--gold-bright);font-style:normal}
  .athlete-hub__inner>p:last-child{max-width:760px;margin:0;color:rgba(245,240,231,.7);font-size:.96rem;line-height:1.72}
  .athlete-hub__inner>p:last-child a{color:#e3bd73;text-decoration:none;border-bottom:1px solid rgba(227,189,115,.38)}
  .athlete-hub__inner>p:last-child a:hover,.athlete-hub__inner>p:last-child a:focus-visible{color:#fff;border-bottom-color:#e3bd73}
  @media(max-width:900px){.athlete-hub__inner{width:calc(100% - 44px);padding:48px 0 52px}.athlete-hub h2{font-size:clamp(2.25rem,11vw,3.4rem)}.athlete-hub__inner>p:last-child{font-size:.92rem;line-height:1.65}}
</style>