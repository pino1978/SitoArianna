---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import RoadToGreeceBanner from "../components/RoadToGreeceBanner.astro";
import StatsStrip from "../components/StatsStrip.astro";
import HighlightsStrip from "../components/HighlightsStrip.astro";
import ProfileFeature from "../components/ProfileFeature.astro";
import results from "../data/results.json";

const pressArticles = [
  { outlet:"NanoTV", date:"16 set 2026", title:"Arianna ha 12 anni ed è di Casoria. Pratica Sanda, disciplina di combattimento del Wushu Kung Fu", url:"https://www.nanotv.it/2026/09/16/arianna-ha-12-anni-ed-e-di-casoria-pratica-sanda-disciplina-di-combattimento-del-wushu-kung-fu-dal-2021-presso-lasd-kasoria-kombat-fly-dove-e-seguita-dal-maestro-eduardo-mazzara/" },
  { outlet:"Redazione Prospettive", date:"14 set 2026", title:"Da Casoria alla Grecia: Arianna Milano vola al 18° Palamidio Martial Arts Championship", url:"https://www.redazioneprospettive.it/da-casoria-alla-grecia-arianna-milano-vola-al-18-palamidio-martial-arts-championship-aperta-una-raccolta-fondi-per-sostenere-la-giovane-campionessa-di-sanda/" },
  { outlet:"CasaNapoli.net", date:"14 set 2026", title:"Arianna Milano, 12 anni di Casoria e 14 ori nel Sanda: sogna la Nazionale, aiutiamola ad arrivare in Grecia", url:"https://www.casanapoli.net/2026/09/14/arianna-milano-12-anni-di-casoria-e-14-ori-nel-sanda-sogna-la-nazionale-aiutiamola-ad-arrivare-in-grecia/" }
];
---
<BaseLayout title="Arianna Milano | Atleta Sanda e Kung Fu" description="Sito ufficiale di Arianna Milano, giovane atleta agonista di Sanda e Kung Fu. Scopri profilo sportivo, risultati, competizioni, foto e video.">
<script is:inline>(()=>{const hash=window.location.hash||"";const isIdentityCallback=hash.startsWith("#recovery_token=")||hash.startsWith("#invite_token=")||hash.startsWith("#confirmation_token=")||hash.startsWith("#access_token=")||hash.startsWith("#error=");if(isIdentityCallback)window.location.replace(`/admin/${hash}`)})();</script>
<main id="main" class="home-page">
<Hero/><RoadToGreeceBanner/>
<section class="press-mentions" aria-labelledby="press-mentions-title">
  <div class="press-mentions__inner">
    <header class="press-mentions__heading"><p>Rassegna stampa</p><h2 id="press-mentions-title">Parlano di Arianna</h2></header>
    <div class="press-mentions__stories">
      {pressArticles.map(article=><a class="press-story" href={article.url} target="_blank" rel="noopener noreferrer" data-interactive><span class="press-story__meta"><strong>{article.outlet}</strong><time>{article.date}</time></span><span class="press-story__title">{article.title}</span><span class="press-story__arrow" aria-hidden="true">↗</span></a>)}
    </div>
    <a class="press-mentions__link" href="/rassegna-stampa/" data-interactive><span>Tutta la rassegna</span><b aria-hidden="true">→</b></a>
  </div>
</section>
<section class="home-stats" aria-label="Statistiche sportive"><StatsStrip stats={results.heroStats}/></section>
<HighlightsStrip/><ProfileFeature/>
</main>
</BaseLayout>
<style is:global>
.home-page{display:block;margin:0;padding:0;background:#080706}.home-page>section{margin-block:0!important}.home-page .hero,.home-page .hero-values,.home-page .road-to-greece,.home-page .press-mentions,.home-page .home-stats,.home-page .highlights-strip,.home-page .profile-feature{margin-top:0!important;margin-bottom:0!important}.home-page .home-stats{display:flex;justify-content:center;padding:22px 48px;background:#080706}.home-page .home-stats .stats-block{width:min(1180px,100%)}
.press-mentions{background:#f4eee3;color:#151310;border-top:1px solid #c99736;border-bottom:1px solid rgba(201,151,54,.55)}
.press-mentions__inner{display:grid;grid-template-columns:minmax(230px,.68fr) minmax(0,2fr) auto;align-items:stretch;gap:38px;width:min(1290px,calc(100% - 96px));margin:auto;padding:24px 0 25px}
.press-mentions__heading{display:flex;flex-direction:column;justify-content:center}.press-mentions__heading p{margin:0 0 7px;color:#8a641f;font:900 .55rem/1 var(--font-ui);letter-spacing:.21em;text-transform:uppercase}.press-mentions__heading h2{max-width:270px;margin:0;font:500 clamp(2rem,2.55vw,2.85rem)/.92 Georgia,serif;letter-spacing:-.045em}
.press-mentions__stories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-left:1px solid rgba(28,23,16,.13)}.press-story{position:relative;display:flex;min-width:0;flex-direction:column;padding:4px 24px 3px;border-right:1px solid rgba(28,23,16,.13);color:inherit;text-decoration:none}.press-story__meta{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px}.press-story__meta strong{overflow:hidden;color:#80520e;font:900 .54rem/1 var(--font-ui);letter-spacing:.08em;text-overflow:ellipsis;text-transform:uppercase;white-space:nowrap}.press-story__meta time{flex:0 0 auto;color:#82796e;font:700 .48rem/1 var(--font-ui);letter-spacing:.04em;text-transform:uppercase}.press-story__title{display:-webkit-box;overflow:hidden;font:600 .83rem/1.25 Georgia,serif;letter-spacing:-.015em;-webkit-box-orient:vertical;-webkit-line-clamp:3}.press-story__arrow{align-self:flex-end;margin-top:auto;padding-top:10px;color:#9b6b19;font-size:.9rem;transition:transform .2s ease}.press-story:hover .press-story__arrow{transform:translate(2px,-2px)}.press-story:hover .press-story__title{color:#80520e}
.press-mentions__link{display:flex;align-items:center;align-self:center;gap:12px;color:#80520e;font:900 .56rem/1.25 var(--font-ui);letter-spacing:.12em;text-decoration:none;text-transform:uppercase;white-space:nowrap}.press-mentions__link b{font-size:1rem;font-weight:500;transition:transform .2s ease}.press-mentions__link:hover b{transform:translateX(3px)}.press-story:focus-visible,.press-mentions__link:focus-visible{outline:3px solid #c99736;outline-offset:4px}
@media(max-width:1100px){.press-mentions__inner{grid-template-columns:210px 1fr;gap:26px;width:calc(100% - 48px)}.press-mentions__link{grid-column:2;justify-self:end}.press-mentions__stories{grid-column:2;grid-row:1}.press-mentions__heading{grid-row:1/3}.press-story{padding-inline:16px}.press-story__meta time{display:none}}
@media(max-width:760px){.press-mentions__inner{display:block;width:calc(100% - 32px);padding:24px 0}.press-mentions__heading{margin-bottom:19px}.press-mentions__heading h2{max-width:none;font-size:2.25rem}.press-mentions__stories{display:block;border-left:0;border-top:1px solid rgba(28,23,16,.13)}.press-story{padding:14px 2px;border-right:0;border-bottom:1px solid rgba(28,23,16,.13)}.press-story:nth-child(3){display:none}.press-story__meta{justify-content:flex-start}.press-story__meta time{display:block}.press-story__title{-webkit-line-clamp:2;font-size:.86rem}.press-story__arrow{position:absolute;right:2px;bottom:14px}.press-mentions__link{display:inline-flex;margin-top:17px}}
@media(max-width:640px){.home-page .home-stats{padding:0 18px}.home-page .home-stats .stats-block{width:100%}}
@media(prefers-reduced-motion:reduce){.press-story__arrow,.press-mentions__link b{transition:none}}
</style>