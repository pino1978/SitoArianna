---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import RoadToGreeceBanner from "../components/RoadToGreeceBanner.astro";
import StatsStrip from "../components/StatsStrip.astro";
import HighlightsStrip from "../components/HighlightsStrip.astro";
import ProfileFeature from "../components/ProfileFeature.astro";
import results from "../data/results.json";

const pressOutlets = [
  { name: "NanoTV", domain: "nanotv.it" },
  { name: "Redazione Prospettive", domain: "redazioneprospettive.it" },
  { name: "Frattamaggiore News", domain: "frattamaggiorenews.com" },
  { name: "CasaNapoli.net", domain: "casanapoli.net" }
];
---
<BaseLayout
  title="Arianna Milano | Atleta Sanda e Kung Fu"
  description="Sito ufficiale di Arianna Milano, giovane atleta agonista di Sanda e Kung Fu. Scopri profilo sportivo, risultati, competizioni, foto e video."
>
  <script is:inline>
    (() => {
      const hash = window.location.hash || "";
      const isIdentityCallback =
        hash.startsWith("#recovery_token=") ||
        hash.startsWith("#invite_token=") ||
        hash.startsWith("#confirmation_token=") ||
        hash.startsWith("#access_token=") ||
        hash.startsWith("#error=");

      if (isIdentityCallback) {
        window.location.replace(`/admin/${hash}`);
      }
    })();
  </script>
  <main id="main" class="home-page">
    <Hero />
    <RoadToGreeceBanner />
    <section class="press-mentions" aria-labelledby="press-mentions-title">
      <div class="press-mentions__inner">
        <div class="press-mentions__heading">
          <p>Parlano di Arianna</p>
          <h2 id="press-mentions-title">La stampa racconta il suo percorso</h2>
        </div>
        <div class="press-mentions__outlets" aria-label="Testate che hanno parlato di Arianna">
          {pressOutlets.map(outlet => (
            <div class="press-mentions__outlet">
              <img src={`https://www.google.com/s2/favicons?domain=${outlet.domain}&sz=128`} alt="" width="42" height="42" loading="lazy" decoding="async" />
              <strong>{outlet.name}</strong>
            </div>
          ))}
        </div>
        <a class="press-mentions__link" href="/rassegna-stampa/" data-interactive>Rassegna stampa <span aria-hidden="true">→</span></a>
      </div>
    </section>
    <section class="home-stats" aria-label="Statistiche sportive">
      <StatsStrip stats={results.heroStats} />
    </section>
    <HighlightsStrip />
    <ProfileFeature />
  </main>
</BaseLayout>

<style is:global>
  .home-page{display:block;margin:0;padding:0;background:#080706}
  .home-page>section{margin-block:0!important}
  .home-page .hero,.home-page .hero-values,.home-page .road-to-greece,.home-page .press-mentions,.home-page .home-stats,.home-page .highlights-strip,.home-page .profile-feature{margin-top:0!important;margin-bottom:0!important}
  .home-page .home-stats{display:flex;justify-content:center;padding:22px 48px;background:#080706}
  .home-page .home-stats .stats-block{width:min(1180px,100%)}

  .press-mentions{position:relative;background:#f3ecdf;color:#171512;border-top:2px solid rgba(201,151,54,.72);border-bottom:1px solid rgba(20,18,15,.08)}
  .press-mentions__inner{display:grid;grid-template-columns:minmax(250px,.95fr) minmax(0,1.65fr) auto;align-items:center;gap:34px;width:min(1180px,calc(100% - 72px));margin:0 auto;padding:20px 0 21px}
  .press-mentions__heading p{margin:0 0 6px;color:#8a641f;font:800 .54rem/1 var(--font-ui);letter-spacing:.2em;text-transform:uppercase}
  .press-mentions__heading h2{max-width:330px;margin:0;font:500 clamp(1.35rem,1.8vw,1.8rem)/1.05 Georgia,serif;letter-spacing:-.03em}
  .press-mentions__outlets{display:flex;align-items:center;justify-content:center;gap:24px;min-width:0}
  .press-mentions__outlet{display:flex;min-width:0;align-items:center;gap:8px;padding:4px 0;text-align:left}
  .press-mentions__outlet img{width:29px;height:29px;flex:0 0 auto;object-fit:contain;border-radius:7px}
  .press-mentions__outlet strong{font:800 .62rem/1.15 var(--font-ui);letter-spacing:.01em}
  .press-mentions__link{display:inline-flex;align-items:center;gap:10px;padding-left:24px;border-left:1px solid rgba(20,18,15,.12);color:#80520e;font:900 .59rem/1 var(--font-ui);letter-spacing:.11em;text-decoration:none;text-transform:uppercase;white-space:nowrap}
  .press-mentions__link:hover{color:#b47a1b}
  .press-mentions__link:focus-visible{outline:3px solid #c99736;outline-offset:5px}

  @media (max-width:1000px){
    .press-mentions__inner{grid-template-columns:1fr auto;gap:18px 28px;width:calc(100% - 48px);padding:22px 0}
    .press-mentions__heading{grid-column:1/-1}.press-mentions__heading h2{max-width:none}
    .press-mentions__outlets{justify-content:flex-start;flex-wrap:wrap;gap:14px 22px}
    .press-mentions__link{align-self:stretch}
  }

  @media (max-width:640px){
    .home-page .home-stats{padding:0 18px;background:#080706}
    .home-page .home-stats .stats-block{width:100%}
    .press-mentions__inner{grid-template-columns:1fr;width:calc(100% - 32px);gap:16px;padding:22px 0 23px}
    .press-mentions__heading{grid-column:auto}.press-mentions__heading p{margin-bottom:6px}.press-mentions__heading h2{font-size:1.65rem;line-height:1.03}
    .press-mentions__outlets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px;width:100%}
    .press-mentions__outlet{padding:0}.press-mentions__outlet img{width:27px;height:27px}.press-mentions__outlet strong{font-size:.6rem}
    .press-mentions__link{justify-self:start;padding:12px 0 0;border-left:0;border-top:1px solid rgba(20,18,15,.12);font-size:.58rem}
  }
</style>