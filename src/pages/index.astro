---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import RoadToGreeceBanner from "../components/RoadToGreeceBanner.astro";
import HighlightsStrip from "../components/HighlightsStrip.astro";
import ProfileFeature from "../components/ProfileFeature.astro";
---
<BaseLayout
  title="Arianna Milano | Atleta Sanda e Kung Fu"
  description="Sito ufficiale di Arianna Milano, giovane atleta agonista di Sanda e Kung Fu. Scopri profilo sportivo, risultati, competizioni, foto e video."
>
  <script is:inline>
    (() => {
      const hash = window.location.hash || "";
      const isIdentityCallback =
        hash.startsWith("#recovery_token=") ||
        hash.startsWith("#invite_token=") ||
        hash.startsWith("#confirmation_token=") ||
        hash.startsWith("#access_token=") ||
        hash.startsWith("#error=");

      if (isIdentityCallback) {
        window.location.replace(`/admin/${hash}`);
      }
    })();
  </script>
  <main id="main" class="home-page">
    <Hero />
    <RoadToGreeceBanner />
    <HighlightsStrip />
    <ProfileFeature />
  </main>
</BaseLayout>

<style is:global>
  .home-page{display:block;margin:0;padding:0;background:#080706}
  .home-page>section{margin-block:0!important}
  .home-page .hero,.home-page .hero-values,.home-page .road-to-greece,.home-page .highlights-strip,.home-page .profile-feature{margin-top:0!important;margin-bottom:0!important}
</style>