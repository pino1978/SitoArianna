---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import RoadToGreeceBanner from "../components/RoadToGreeceBanner.astro";
import StatsStrip from "../components/StatsStrip.astro";
import HighlightsStrip from "../components/HighlightsStrip.astro";
import ProfileFeature from "../components/ProfileFeature.astro";
import results from "../data/results.json";

const pressArticles = [
  { outlet:"NanoTV", domain:"nanotv.it", date:"16 set 2026", title:"Arianna ha 12 anni ed è di Casoria. Pratica Sanda, disciplina di combattimento del Wushu Kung Fu", url:"https://www.nanotv.it/2026/09/16/arianna-ha-12-anni-ed-e-di-casoria-pratica-sanda-disciplina-di-combattimento-del-wushu-kung-fu-dal-2021-presso-lasd-kasoria-kombat-fly-dove-e-seguita-dal-maestro-eduardo-mazzara/" },
  { outlet:"Redazione Prospettive", domain:"redazioneprospettive.it", date:"14 set 2026", title:"Da Casoria alla Grecia: Arianna Milano vola al 18° Palamidio Martial Arts Championship", url:"https://www.redazioneprospettive.it/da-casoria-alla-grecia-arianna-milano-vola-al-18-palamidio-martial-arts-championship-aperta-una-raccolta-fondi-per-sostenere-la-giovane-campionessa-di-sanda/" },
  { outlet:"CasaNapoli.net", domain:"casanapoli.net", date:"14 set 2026", title:"Arianna Milano, 12 anni di Casoria e 14 ori nel Sanda: sogna la Nazionale, aiutiamola ad arrivare in Grecia", url:"https://www.casanapoli.net/2026/09/14/arianna-milano-12-anni-di-casoria-e-14-ori-nel-sanda-sogna-la-nazionale-aiutiamola-ad-arrivare-in-grecia/" }
];
---
<BaseLayout title="Arianna Milano | Atleta Sanda e Kung Fu" description="Sito ufficiale di Arianna Milano, giovane atleta agonista di Sanda e Kung Fu. Scopri profilo sportivo, risultati, competizioni, foto e video.">
<script is:inline>(()=>{const hash=window.location.hash||"";const isIdentityCallback=hash.startsWith("#recovery_token=")||hash.startsWith("#invite_token=")||hash.startsWith("#confirmation_token=")||hash.startsWith("#access_token=")||hash.startsWith("#error=");if(isIdentityCallback)window.location.replace(`/admin/${hash}`)})();</script>
<main id="main" class="home-page">
<Hero/><RoadToGreeceBanner/>
<section class="press-mentions" aria-labelledby="press-mentions-title">
  <div class="press-mentions__inner">
    <header class="press-mentions__heading"><p>Rassegna stampa</p><h2 id="press-mentions-title">Parlano di Arianna</h2></header>
    <div class="press-mentions__stories">
      {pressArticles.map(article=><a class="press-card" href={article.url} target="_blank" rel="noopener noreferrer" data-interactive>
        <span class="press-card__brand"><img src={`https://www.google.com/s2/favicons?domain=${article.domain}&sz=128`} alt="" width="44" height="44" loading="lazy" decoding="async"/><span><strong>{article.outlet}</strong><time>{article.date}</time></span></span>
        <span class="press-card__title">{article.title}</span>
        <span class="press-card__footer"><span>Leggi l'articolo</span><b aria-hidden="true">↗</b></span>
      </a>)}
    </div>
    <a class="press-mentions__link" href="/rassegna-stampa/" data-interactive><span>Tutta la rassegna</span><b aria-hidden="true">→</b></a>
  </div>
</section>
<section class="home-stats" aria-label="Statistiche sportive"><StatsStrip stats={results.heroStats}/></section>
<HighlightsStrip/><ProfileFeature/>
</main>
</BaseLayout>
<style is:global>
.home-page{display:block;margin:0;padding:0;background:#080706}.home-page>section{margin-block:0!important}.home-page .hero,.home-page .hero-values,.home-page .road-to-greece,.home-page .press-mentions,.home-page .home-stats,.home-page .highlights-strip,.home-page .profile-feature{margin-top:0!important;margin-bottom:0!important}.home-page .home-stats{display:flex;justify-content:center;padding:22px 48px;background:#080706}.home-page .home-stats .stats-block{width:min(1180px,100%)}
.press-mentions{background:#f4eee3;color:#151310;border-top:1px solid #c99736;border-bottom:1px solid rgba(201,151,54,.55)}
.press-mentions__inner{display:grid;grid-template-columns:minmax(225px,.62fr) minmax(0,2.15fr) auto;align-items:center;gap:32px;width:min(1320px,calc(100% - 80px));margin:auto;padding:25px 0 26px}
.press-mentions__heading p{margin:0 0 8px;color:#8a641f;font:900 .55rem/1 var(--font-ui);letter-spacing:.21em;text-transform:uppercase}.press-mentions__heading h2{max-width:260px;margin:0;font:500 clamp(2.15rem,2.7vw,3rem)/.91 Georgia,serif;letter-spacing:-.05em}
.press-mentions__stories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;min-width:0}.press-card{display:flex;min-width:0;min-height:154px;flex-direction:column;padding:15px 16px 13px;background:rgba(255,252,247,.72);border:1px solid rgba(73,55,29,.16);color:#17130f;text-decoration:none;box-shadow:0 7px 18px rgba(52,38,18,.045);transition:transform .2s ease,border-color .2s ease,background .2s ease}.press-card__brand{display:flex;align-items:center;gap:10px;margin-bottom:12px}.press-card__brand img{width:34px;height:34px;flex:0 0 auto;object-fit:contain;border-radius:7px;background:#fff}.press-card__brand>span{display:flex;min-width:0;flex-direction:column;gap:4px}.press-card__brand strong{overflow:hidden;color:#80520e;font:900 .55rem/1 var(--font-ui);letter-spacing:.07em;text-overflow:ellipsis;text-transform:uppercase;white-space:nowrap}.press-card__brand time{color:#82796e;font:700 .47rem/1 var(--font-ui);letter-spacing:.05em;text-transform:uppercase}.press-card__title{display:-webkit-box;overflow:hidden;font:600 .79rem/1.23 Georgia,serif;letter-spacing:-.012em;-webkit-box-orient:vertical;-webkit-line-clamp:3}.press-card__footer{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:12px;color:#80520e;font:900 .49rem/1 var(--font-ui);letter-spacing:.11em;text-transform:uppercase}.press-card__footer b{font-size:.85rem;font-weight:500;transition:transform .2s ease}.press-card:hover{transform:translateY(-2px);border-color:rgba(155,107,25,.48);background:#fffaf2}.press-card:hover .press-card__footer b{transform:translate(2px,-2px)}
.press-mentions__link{display:flex;align-items:center;gap:11px;color:#80520e;font:900 .55rem/1.25 var(--font-ui);letter-spacing:.12em;text-decoration:none;text-transform:uppercase;white-space:nowrap}.press-mentions__link b{font-size:1rem;font-weight:500;transition:transform .2s ease}.press-mentions__link:hover b{transform:translateX(3px)}.press-card:focus-visible,.press-mentions__link:focus-visible{outline:3px solid #c99736;outline-offset:4px}
@media(max-width:1120px){.press-mentions__inner{grid-template-columns:200px 1fr;align-items:start;gap:22px 26px;width:calc(100% - 48px)}.press-mentions__heading{padding-top:8px}.press-mentions__stories{grid-column:2}.press-mentions__link{grid-column:2;justify-self:end}.press-card{min-height:160px;padding:14px}.press-card__brand img{width:30px;height:30px}.press-card__brand strong{font-size:.5rem}}
@media(max-width:820px){.press-mentions__inner{display:block;width:calc(100% - 32px);padding:24px 0 25px}.press-mentions__heading{padding:0;margin-bottom:19px}.press-mentions__heading h2{max-width:none;font-size:2.35rem}.press-mentions__stories{display:flex;gap:13px;overflow-x:auto;margin-right:-16px;padding:1px 16px 10px 1px;scroll-snap-type:x mandatory;scrollbar-width:none}.press-mentions__stories::-webkit-scrollbar{display:none}.press-card{flex:0 0 min(78vw,310px);min-height:166px;scroll-snap-align:start}.press-mentions__link{display:inline-flex;margin-top:10px}.press-card__brand img{width:34px;height:34px}.press-card__brand strong{font-size:.55rem}.press-card__title{font-size:.82rem}}
@media(max-width:640px){.home-page .home-stats{padding:0 18px}.home-page .home-stats .stats-block{width:100%}.press-mentions__heading h2{font-size:2.2rem}}
@media(prefers-reduced-motion:reduce){.press-card,.press-card__footer b,.press-mentions__link b{transition:none}}
</style>