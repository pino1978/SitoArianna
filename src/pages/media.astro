---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import media from "../data/media.json";
import profile from "../data/profile.json";

const copy = profile.content.mediaPage;
const imageModules = import.meta.glob("../assets/images/*.{png,jpg,jpeg,webp}", { eager: true });
function localImage(fileName) {
  if (!fileName) return null;
  return imageModules[`../assets/images/${fileName}`]?.default ?? null;
}
function photoUrl(item) {
  if (item.url) return item.url;
  const image = localImage(item.immagine);
  return image?.src ?? "";
}
function youtubeId(url = "") {
  const match = url.match(/(?:shorts\/|youtu\.be\/|[?&]v=)([A-Za-z0-9_-]{11})/);
  return match?.[1] ?? "";
}
function displayDate(value) {
  if (!value) return "";
  const [year, month, day] = value.split("-");
  return `${day}/${month}/${year}`;
}
function eventLabel(item) {
  const detail = item.dettaglio || "";
  const parts = detail.split("·").map((part) => part.trim()).filter(Boolean);
  return parts.at(-1) || item.titolo || "Evento";
}
function itemYear(item) {
  return String(item.anno || item.data?.slice(0, 4) || "");
}

const photos = media.filter((item) => item.tipo === "foto" && item.visibile && !item.isPlaceholder && photoUrl(item));
const videos = media.filter((item) => item.tipo === "video" && item.visibile && youtubeId(item.urlYouTube));
const visibleMedia = [
  ...videos.map((item) => ({ ...item, mediaType: "video", mediaUrl: item.urlYouTube, thumb: `https://i.ytimg.com/vi/${youtubeId(item.urlYouTube)}/hqdefault.jpg` })),
  ...photos.map((item) => ({ ...item, mediaType: "foto", mediaUrl: photoUrl(item), thumb: photoUrl(item) }))
];
const years = [...new Set(visibleMedia.map(itemYear).filter(Boolean))].sort((a, b) => Number(b) - Number(a));
const events = [...new Set(visibleMedia.map(eventLabel).filter(Boolean))].sort((a, b) => a.localeCompare(b, "it"));
const primaryVideo = videos[0] || null;
const secondaryItems = [videos[1], photos[0]].filter(Boolean);
---

<BaseLayout title={copy.seo.title} description={copy.seo.description}>
  <main id="main" class="media-page">
    <section class="media-hero">
      <Header />
      <div class="media-shell media-hero__inner">
        <p class="eyebrow">{copy.hero.kicker}</p>
        <h1>Media</h1>
        <p class="media-hero__claim">Allenamenti. Gare. Momenti.</p>
        <p class="media-hero__intro">Immagini e video che raccontano il percorso sportivo, dentro e fuori dal tatami.</p>
      </div>
    </section>

    {(primaryVideo || secondaryItems.length > 0) && (
      <section class="featured media-shell" aria-labelledby="featured-title">
        <div class="section-row">
          <div>
            <p class="eyebrow">In evidenza</p>
            <h2 id="featured-title">Il movimento prima di tutto.</h2>
          </div>
          <a href="#archivio" data-interactive>Esplora l’archivio <span aria-hidden="true">→</span></a>
        </div>

        <div class="featured-grid">
          {primaryVideo && (() => {
            const id = youtubeId(primaryVideo.urlYouTube);
            return (
              <button class="featured-main media-trigger" type="button" data-interactive data-media-type="video" data-youtube-id={id} data-title={primaryVideo.titolo} data-detail={primaryVideo.dettaglio || ""} data-date={primaryVideo.data || ""}>
                <img src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`} alt="" loading="eager" decoding="async" />
                <span class="shade"></span>
                <span class="play" aria-hidden="true">▶</span>
                <span class="featured-copy">
                  <small>{primaryVideo.anno || ""} · Video</small>
                  <strong>{primaryVideo.titolo}</strong>
                  {primaryVideo.dettaglio && <span>{primaryVideo.dettaglio}</span>}
                </span>
              </button>
            );
          })()}

          <div class="featured-side">
            {secondaryItems.map((item) => {
              const isVideo = item.tipo === "video";
              const id = isVideo ? youtubeId(item.urlYouTube) : "";
              const src = isVideo ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : photoUrl(item);
              return (
                <button class="featured-small media-trigger" type="button" data-interactive data-media-type={isVideo ? "video" : "foto"} data-youtube-id={id || undefined} data-image={!isVideo ? src : undefined} data-title={item.titolo} data-detail={item.dettaglio || ""} data-date={item.data || ""}>
                  <img src={src} alt={isVideo ? "" : (item.testoAlternativo || item.titolo)} loading="lazy" decoding="async" />
                  <span class="shade"></span>
                  {isVideo && <span class="play play--small" aria-hidden="true">▶</span>}
                  <span class="featured-copy featured-copy--small">
                    <small>{item.anno || ""} · {isVideo ? "Video" : "Foto"}</small>
                    <strong>{item.titolo}</strong>
                  </span>
                </button>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <section class="archive" id="archivio" aria-labelledby="archive-title">
      <div class="media-shell">
        <div class="section-row archive-heading">
          <div>
            <p class="eyebrow">Archivio</p>
            <h2 id="archive-title">Foto & video</h2>
            <p>{copy.gallery.intro}</p>
          </div>
        </div>

        <div class="filter-bar" aria-label="Filtri media">
          <div class="filter-types" role="group" aria-label="Tipo di contenuto">
            <button type="button" data-interactive data-type-filter="tutti" aria-pressed="true">Tutti</button>
            <button type="button" data-interactive data-type-filter="video" aria-pressed="false">Video</button>
            <button type="button" data-interactive data-type-filter="foto" aria-pressed="false">Foto</button>
          </div>
          <div class="filter-selects">
            <label>
              <span class="sr-only">Anno</span>
              <select data-year-filter data-interactive>
                <option value="tutti">Anno</option>
                {years.map((year) => <option value={year}>{year}</option>)}
              </select>
            </label>
            <label>
              <span class="sr-only">Evento</span>
              <select data-event-filter data-interactive>
                <option value="tutti">Evento</option>
                {events.map((event) => <option value={event}>{event}</option>)}
              </select>
            </label>
          </div>
        </div>

        {visibleMedia.length > 0 ? (
          <div class="editorial-grid" data-media-grid>
            {visibleMedia.map((item, index) => {
              const isVideo = item.mediaType === "video";
              const id = isVideo ? youtubeId(item.urlYouTube) : "";
              const event = eventLabel(item);
              return (
                <article class:list={["media-card", index % 7 === 0 && "media-card--wide", !isVideo && index % 5 === 0 && "media-card--portrait"]} data-media-type={item.mediaType} data-year={itemYear(item)} data-event={event}>
                  {isVideo ? (
                    <button class="media-card__button media-trigger" type="button" data-interactive data-media-type="video" data-youtube-id={id} data-title={item.titolo} data-detail={item.dettaglio || ""} data-date={item.data || ""} aria-label={`Apri video: ${item.titolo}`}>
                      <span class="media-card__visual media-card__visual--video">
                        <img src={item.thumb} alt="" loading="lazy" decoding="async" />
                        <span class="shade"></span>
                        <span class="play" aria-hidden="true">▶</span>
                      </span>
                      <span class="media-card__copy">
                        <small>{itemYear(item)} · Video</small>
                        <strong>{item.titolo}</strong>
                        <span>{event}</span>
                      </span>
                    </button>
                  ) : (
                    <a class="media-card__button pswp-link" href={item.mediaUrl} data-pswp-width="1600" data-pswp-height="1200" data-cropped="true" data-title={item.titolo} data-detail={item.dettaglio || ""} data-year={itemYear(item)} data-event={event} data-interactive>
                      <span class="media-card__visual">
                        <img src={item.thumb} alt={item.testoAlternativo || item.titolo} loading="lazy" decoding="async" />
                        <span class="shade"></span>
                      </span>
                      <span class="media-card__copy">
                        <small>{itemYear(item)} · Foto</small>
                        <strong>{item.titolo}</strong>
                        <span>{event}</span>
                      </span>
                    </a>
                  )}
                </article>
              );
            })}
          </div>
        ) : (
          <div class="media-empty"><strong>Archivio in preparazione</strong><p>I contenuti verranno pubblicati qui appena disponibili.</p></div>
        )}
      </div>
    </section>

    <section class="media-next">
      <div class="media-shell media-next__inner">
        <div><p class="eyebrow">Continua a esplorare</p><h2>Dietro ogni immagine c’è un percorso.</h2></div>
        <nav aria-label="Continua a esplorare">
          <a href="/profilo/" data-interactive><span>Profilo atleta</span><strong>Scopri il mio percorso</strong><b aria-hidden="true">→</b></a>
          <a href="/risultati/" data-interactive><span>Risultati agonistici</span><strong>Tutti i risultati</strong><b aria-hidden="true">→</b></a>
        </nav>
      </div>
    </section>
  </main>

  <dialog class="video-viewer" id="video-viewer" aria-label="Riproduzione video">
    <div class="video-viewer__frame">
      <button class="viewer-close" type="button" data-interactive data-video-close aria-label="Chiudi video">×</button>
      <div class="video-viewer__player" data-video-player></div>
      <aside class="video-viewer__meta">
        <p class="eyebrow">Video</p>
        <h2 data-video-title></h2>
        <p data-video-detail></p>
        <time data-video-date></time>
      </aside>
    </div>
  </dialog>

  <script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';
    import 'photoswipe/style.css';

    const typeButtons = Array.from(document.querySelectorAll('[data-type-filter]'));
    const yearSelect = document.querySelector('[data-year-filter]');
    const eventSelect = document.querySelector('[data-event-filter]');
    const cards = Array.from(document.querySelectorAll('[data-media-grid] .media-card'));
    let activeType = 'tutti';

    const applyFilters = () => {
      const year = yearSelect instanceof HTMLSelectElement ? yearSelect.value : 'tutti';
      const event = eventSelect instanceof HTMLSelectElement ? eventSelect.value : 'tutti';
      cards.forEach((card) => {
        const typeOk = activeType === 'tutti' || card.getAttribute('data-media-type') === activeType;
        const yearOk = year === 'tutti' || card.getAttribute('data-year') === year;
        const eventOk = event === 'tutti' || card.getAttribute('data-event') === event;
        card.hidden = !(typeOk && yearOk && eventOk);
      });
    };

    typeButtons.forEach((button) => button.addEventListener('click', () => {
      activeType = button.getAttribute('data-type-filter') || 'tutti';
      typeButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      applyFilters();
    }));
    yearSelect?.addEventListener('change', applyFilters);
    eventSelect?.addEventListener('change', applyFilters);

    const lightbox = new PhotoSwipeLightbox({
      gallery: '[data-media-grid]',
      children: 'a.pswp-link:not([hidden])',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.97,
      wheelToZoom: true,
      padding: { top: 42, bottom: 72, left: 42, right: 42 }
    });
    lightbox.on('uiRegister', () => {
      lightbox.pswp?.ui?.registerElement({
        name: 'caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        html: '',
        onInit: (el, pswp) => {
          pswp.on('change', () => {
            const data = pswp.currSlide?.data?.element;
            if (!(data instanceof HTMLElement)) return;
            const title = data.dataset.title || '';
            const detail = data.dataset.detail || '';
            const year = data.dataset.year || '';
            const event = data.dataset.event || '';
            el.innerHTML = `<div class="pswp-caption-inner"><small>${year}${event ? ` · ${event}` : ''}</small><strong>${title}</strong>${detail ? `<span>${detail}</span>` : ''}</div>`;
          });
        }
      });
    });
    lightbox.init();

    const dialog = document.querySelector('#video-viewer');
    const player = dialog?.querySelector('[data-video-player]');
    const videoTitle = dialog?.querySelector('[data-video-title]');
    const videoDetail = dialog?.querySelector('[data-video-detail]');
    const videoDate = dialog?.querySelector('[data-video-date]');

    const closeVideo = () => {
      if (player) player.innerHTML = '';
      if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
    };

    document.querySelectorAll('.media-trigger[data-media-type="video"]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!(dialog instanceof HTMLDialogElement) || !player) return;
        const id = button.getAttribute('data-youtube-id') || '';
        if (!id) return;
        const title = button.getAttribute('data-title') || '';
        player.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="${title.replace(/"/g, '&quot;')}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
        if (videoTitle) videoTitle.textContent = title;
        if (videoDetail) videoDetail.textContent = button.getAttribute('data-detail') || '';
        const date = button.getAttribute('data-date') || '';
        if (videoDate instanceof HTMLTimeElement) {
          videoDate.dateTime = date;
          videoDate.textContent = date ? date.split('-').reverse().join('/') : '';
        }
        dialog.showModal();
      });
    });
    dialog?.querySelector('[data-video-close]')?.addEventListener('click', closeVideo);
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeVideo(); });
    dialog?.addEventListener('cancel', () => { if (player) player.innerHTML = ''; });
  </script>

  <style>
    :global(.pswp__bg){background:#020202!important}.media-page{background:#060504;color:#f3ede2}.media-shell{width:min(1180px,calc(100% - 56px));margin-inline:auto}.eyebrow{margin:0;color:var(--gold-bright);font-family:var(--font-ui);font-size:.68rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.media-hero{position:relative;min-height:390px;padding-top:118px;background:radial-gradient(circle at 78% 20%,rgba(181,138,60,.14),transparent 28%),linear-gradient(180deg,#090807 0%,#060504 100%);overflow:hidden}.media-hero:after{content:"";position:absolute;inset:auto 0 0;height:110px;background:linear-gradient(transparent,#060504);pointer-events:none}.media-hero .site-header{position:absolute;top:0;left:50%;transform:translateX(-50%)}.media-hero__inner{position:relative;z-index:1;padding:54px 0 74px}.media-hero h1,.featured h2,.archive h2,.media-next h2{font-family:var(--font-display);text-transform:uppercase;line-height:.92}.media-hero h1{margin:10px 0 4px;font-size:clamp(4.4rem,9vw,8rem)}.media-hero__claim{margin:0;color:#d6ad61;font-family:var(--font-display);font-size:clamp(1.6rem,2.7vw,2.8rem);line-height:1}.media-hero__intro{max-width:560px;margin:18px 0 0;color:#c8c0b4;font-size:1rem;line-height:1.7}.featured{padding:68px 0 92px}.section-row{display:flex;align-items:end;justify-content:space-between;gap:32px;margin-bottom:26px}.section-row h2{max-width:680px;margin:8px 0 0;font-size:clamp(2.3rem,4.8vw,4.8rem)}.section-row>a{color:#d4a64d;text-decoration:none;font-family:var(--font-ui);font-size:.7rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.featured-grid{display:grid;grid-template-columns:minmax(0,1.85fr) minmax(300px,1fr);gap:14px;min-height:540px}.featured-main,.featured-small{position:relative;overflow:hidden;border:1px solid rgba(181,138,60,.24);padding:0;background:#0a0908;color:#fff;text-align:left;cursor:pointer}.featured-main img,.featured-small img{width:100%;height:100%;object-fit:cover;transition:transform .28s ease,filter .28s ease}.featured-side{display:grid;grid-template-rows:1fr 1fr;gap:14px}.featured-main:hover img,.featured-small:hover img,.featured-main:focus-visible img,.featured-small:focus-visible img{transform:scale(1.03);filter:brightness(.9)}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.02) 42%,rgba(0,0,0,.86) 100%)}.play{position:absolute;left:50%;top:50%;display:grid;width:70px;height:70px;place-items:center;transform:translate(-50%,-50%);border:1px solid rgba(255,255,255,.88);border-radius:50%;background:rgba(0,0,0,.38);font-size:1.15rem;padding-left:4px}.play--small{width:48px;height:48px;font-size:.82rem}.featured-copy{position:absolute;left:26px;right:26px;bottom:24px;display:grid;gap:6px}.featured-copy small,.media-card__copy small{color:#d4a64d;font:700 .64rem/1 var(--font-ui);letter-spacing:.08em;text-transform:uppercase}.featured-copy strong{font-family:var(--font-display);font-size:clamp(1.5rem,2.5vw,2.6rem);line-height:.95;text-transform:uppercase}.featured-copy span{color:#d7d0c4;font-size:.85rem}.featured-copy--small{left:18px;bottom:16px}.featured-copy--small strong{font-size:1.08rem}.archive{padding:86px 0 98px;background:#0b0a09}.archive-heading{margin-bottom:32px}.archive-heading p:last-child{max-width:620px;color:#b9b1a5;line-height:1.65}.filter-bar{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 0 20px;border-top:1px solid rgba(181,138,60,.18)}.filter-types,.filter-selects{display:flex;gap:8px}.filter-types button,.filter-selects select{min-height:42px;border:1px solid rgba(242,235,221,.2);background:#0b0a09;color:#f2ebdd;padding:0 16px;font:700 .65rem/1 var(--font-ui);letter-spacing:.08em;text-transform:uppercase}.filter-types button{border-radius:999px;cursor:pointer}.filter-types button[aria-pressed="true"]{border-color:#c99b4c;background:#c99b4c;color:#080706}.filter-selects select{min-width:128px;cursor:pointer}.editorial-grid{display:grid;grid-