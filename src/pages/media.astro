---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import media from "../data/media.json";
import events from "../data/events.json";
import profile from "../data/profile.json";

const copy = profile.content.mediaPage;
const imageModules = import.meta.glob("../assets/images/*.{png,jpg,jpeg,webp}", { eager: true });
function localImage(fileName) {
  if (!fileName) return null;
  return imageModules[`../assets/images/${fileName}`]?.default ?? null;
}
function photoUrl(item) {
  if (item.url) return item.url;
  const image = localImage(item.immagine);
  return image?.src ?? "";
}
function youtubeId(url = "") {
  const match = url.match(/(?:shorts\/|youtu\.be\/|[?&]v=)([A-Za-z0-9_-]{11})/);
  return match?.[1] ?? "";
}
function itemYear(item) {
  return String(item.anno || item.data?.slice(0, 4) || "");
}
function normalized(value = "") {
  return String(value).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, " ").trim();
}
function mediaCategory(item) {
  return item.categoria === "podio" ? "gara" : (item.categoria || "altro");
}
function mediaMoment(item) {
  if (item.momento) return item.momento;
  if (item.categoria === "podio") return "podio";
  return "";
}
function inferCompetitionId(item) {
  if (item.competitionId && events.some((entry) => entry.id === item.competitionId)) return item.competitionId;
  if (mediaCategory(item) !== "gara") return "";
  const haystack = normalized(`${item.titolo || ""} ${item.dettaglio || ""}`);
  const direct = events.find((entry) => haystack.includes(normalized(entry.name)));
  if (direct) return direct.id;
  if (/world .*championship|c k a/.test(haystack)) return events.find((entry) => entry.id === "cka-world-championship-cup")?.id || "";
  if (/champion cup/.test(haystack)) return events.find((entry) => entry.id === "champion-cup")?.id || "";
  if (/one to one/.test(haystack)) return events.find((entry) => entry.id === "one-to-one")?.id || "";
  if (/xanda prestige/.test(haystack)) return events.find((entry) => entry.id === "xanda-prestige")?.id || "";
  return "";
}
function competitionName(id = "") {
  return events.find((entry) => entry.id === id)?.name || "";
}
function placeLabel(item) {
  if (item.competitionId && item.editionId) {
    const competition = events.find((entry) => entry.id === item.competitionId);
    const edition = competition?.editions?.find((entry) => entry.id === item.editionId);
    if (edition) {
      return [edition.city, edition.province ? `(${edition.province})` : "", edition.country && edition.country !== "Italia" ? edition.country : ""].filter(Boolean).join(" ").replace(/\s+\(/, " (");
    }
  }
  const detail = item.dettaglio || "";
  const parts = detail.split("·").map((part) => part.trim()).filter(Boolean);
  return parts.at(-1) || "";
}
const photos = media.filter((item) => item.tipo === "foto" && item.visibile && !item.isPlaceholder && photoUrl(item));
const videos = media.filter((item) => item.tipo === "video" && item.visibile && youtubeId(item.urlYouTube));
const visibleMedia = [
  ...videos.map((item) => ({ ...item, mediaType: "video", mediaUrl: item.urlYouTube, thumb: `https://i.ytimg.com/vi/${youtubeId(item.urlYouTube)}/hqdefault.jpg` })),
  ...photos.map((item) => ({ ...item, mediaType: "foto", mediaUrl: photoUrl(item), thumb: photoUrl(item) }))
].map((item) => ({
  ...item,
  filterCategory: mediaCategory(item),
  filterMoment: mediaMoment(item),
  filterCompetitionId: inferCompetitionId(item)
}));
const years = [...new Set(visibleMedia.map(itemYear).filter(Boolean))].sort((a, b) => Number(b) - Number(a));
const categories = [
  ["gara", "Gara"],
  ["allenamento", "Allenamento"],
  ["evento", "Evento"],
  ["ritratto", "Ritratto"],
  ["altro", "Altro"]
].filter(([value]) => visibleMedia.some((item) => item.filterCategory === value));
const competitionIds = [...new Set(visibleMedia.filter((item) => item.filterCategory === "gara").map((item) => item.filterCompetitionId).filter(Boolean))];
const competitions = events.filter((entry) => competitionIds.includes(entry.id)).sort((a, b) => a.name.localeCompare(b.name, "it"));
const momentLabels = { azione: "Azione", podio: "Podio", premiazione: "Premiazione", preparazione: "Preparazione", altro: "Altro" };
const moments = [...new Set(visibleMedia.filter((item) => item.filterCategory === "gara").map((item) => item.filterMoment).filter(Boolean))].map((value) => [value, momentLabels[value] || value]).sort((a, b) => a[1].localeCompare(b[1], "it"));
const primaryVideo = videos[0] || null;
const secondaryItems = [videos[1], photos[0]].filter(Boolean);
---
<BaseLayout title={copy.seo.title} description={copy.seo.description}>
  <main id="main" class="media-page">
    <section class="media-hero">
      <Header />
      <div class="media-shell media-hero__inner">
        <p class="eyebrow">{copy.hero.kicker}</p>
        <h1>Media</h1>
        <p class="media-hero__claim">Allenamenti. Gare. Momenti.</p>
        <p class="media-hero__intro">Immagini e video che raccontano il percorso sportivo, dentro e fuori dal tatami.</p>
      </div>
    </section>

    {(primaryVideo || secondaryItems.length > 0) && (
      <section class="featured media-shell" aria-labelledby="featured-title">
        <div class="section-row">
          <div><p class="eyebrow">In evidenza</p><h2 id="featured-title">Il movimento prima di tutto.</h2></div>
          <a href="#archivio" data-interactive>Esplora l’archivio <span aria-hidden="true">→</span></a>
        </div>
        <div class="featured-grid">
          {primaryVideo && (() => {
            const id = youtubeId(primaryVideo.urlYouTube);
            return <button class="featured-main media-trigger" type="button" data-interactive data-media-type="video" data-youtube-id={id} data-title={primaryVideo.titolo} data-detail={primaryVideo.dettaglio || ""} data-date={primaryVideo.data || ""}>
              <img src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`} alt="" loading="eager" decoding="async" />
              <span class="shade"></span><span class="play" aria-hidden="true">▶</span>
              <span class="featured-copy"><small>{primaryVideo.anno || ""} · Video</small><strong>{primaryVideo.titolo}</strong>{primaryVideo.dettaglio && <span>{primaryVideo.dettaglio}</span>}</span>
            </button>;
          })()}
          <div class="featured-side">
            {secondaryItems.map((item) => {
              const isVideo = item.tipo === "video";
              const id = isVideo ? youtubeId(item.urlYouTube) : "";
              const src = isVideo ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : photoUrl(item);
              return <button class="featured-small media-trigger" type="button" data-interactive data-media-type={isVideo ? "video" : "foto"} data-youtube-id={id || undefined} data-image={!isVideo ? src : undefined} data-title={item.titolo} data-detail={item.dettaglio || ""} data-date={item.data || ""}>
                <img src={src} alt={isVideo ? "" : (item.testoAlternativo || item.titolo)} loading="lazy" decoding="async" />
                <span class="shade"></span>{isVideo && <span class="play play--small" aria-hidden="true">▶</span>}
                <span class="featured-copy featured-copy--small"><small>{item.anno || ""} · {isVideo ? "Video" : "Foto"}</small><strong>{item.titolo}</strong></span>
              </button>;
            })}
          </div>
        </div>
      </section>
    )}

    <section class="archive" id="archivio" aria-labelledby="archive-title">
      <div class="media-shell">
        <div class="section-row archive-heading"><div><p class="eyebrow">Archivio</p><h2 id="archive-title">Foto & video</h2><p>{copy.gallery.intro}</p></div></div>
        <div class="filter-bar" aria-label="Filtri media">
          <div class="filter-types" role="group" aria-label="Tipo di contenuto">
            <button type="button" data-interactive data-type-filter="tutti" aria-pressed="true">Tutti</button>
            <button type="button" data-interactive data-type-filter="foto" aria-pressed="false">Foto</button>
            <button type="button" data-interactive data-type-filter="video" aria-pressed="false">Video</button>
          </div>
          <button class="filter-toggle" type="button" data-filter-toggle aria-expanded="false" aria-controls="media-filter-options">Filtri <span aria-hidden="true">＋</span></button>
          <div class="filter-selects" id="media-filter-options" data-filter-options>
            <label><span class="filter-label">Anno</span><select data-year-filter data-interactive><option value="tutti">Tutti</option>{years.map((year) => <option value={year}>{year}</option>)}</select></label>
            <label><span class="filter-label">Tipologia</span><select data-category-filter data-interactive><option value="tutti">Tutte</option>{categories.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
            <label data-race-filter hidden><span class="filter-label">Competizione</span><select data-competition-filter data-interactive><option value="tutti">Tutte</option>{competitions.map((competition) => <option value={competition.id}>{competition.name}</option>)}</select></label>
            {moments.length > 0 && <label data-race-filter hidden><span class="filter-label">Momento</span><select data-moment-filter data-interactive><option value="tutti">Tutti</option>{moments.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>}
          </div>
        </div>
        {visibleMedia.length > 0 ? <div class="editorial-grid" data-media-grid>
          {visibleMedia.map((item, index) => {
            const isVideo = item.mediaType === "video";
            const id = isVideo ? youtubeId(item.urlYouTube) : "";
            const place = placeLabel(item);
            const competition = competitionName(item.filterCompetitionId);
            return <article class:list={["media-card", index % 7 === 0 && "media-card--wide", !isVideo && index % 5 === 0 && "media-card--portrait"]} data-media-type={item.mediaType} data-year={itemYear(item)} data-category={item.filterCategory} data-competition={item.filterCompetitionId} data-moment={item.filterMoment}>
              {isVideo ? <button class="media-card__button media-trigger" type="button" data-interactive data-media-type="video" data-youtube-id={id} data-title={item.titolo} data-detail={item.dettaglio || ""} data-date={item.data || ""} aria-label={`Apri video: ${item.titolo}`}>
                <span class="media-card__visual media-card__visual--video"><img src={item.thumb} alt="" loading="lazy" decoding="async" /><span class="shade"></span><span class="play" aria-hidden="true">▶</span></span>
                <span class="media-card__copy"><small>{itemYear(item)} · Video</small><strong>{item.titolo}</strong><span>{competition || place}</span></span>
              </button> : <a class="media-card__button" href={item.mediaUrl} target="_blank" rel="noopener" data-interactive>
                <span class="media-card__visual"><img src={item.thumb} alt={item.testoAlternativo || item.titolo} loading="lazy" decoding="async" /><span class="shade"></span></span>
                <span class="media-card__copy"><small>{itemYear(item)} · Foto</small><strong>{item.titolo}</strong><span>{competition || place}</span></span>
              </a>}
            </article>;
          })}
        </div> : <div class="media-empty"><strong>Archivio in preparazione</strong><p>I contenuti verranno pubblicati qui appena disponibili.</p></div>}
        <div class="media-empty" data-filter-empty hidden><strong>Nessun contenuto trovato</strong><p>Modifica uno o più filtri per ampliare la ricerca.</p></div>
      </div>
    </section>
  </main>

  <div class="video-viewer" id="video-viewer" hidden aria-hidden="true">
    <div class="video-viewer__backdrop" data-video-close></div>
    <div class="video-viewer__panel" role="dialog" aria-modal="true" aria-label="Riproduzione video">
      <button class="viewer-close" type="button" data-interactive data-video-close aria-label="Chiudi video">×</button>
      <div class="video-viewer__player" data-video-player></div>
      <aside class="video-viewer__meta"><p class="eyebrow">Video</p><h2 data-video-title></h2><p data-video-detail></p><time data-video-date></time></aside>
    </div>
  </div>

  <script>
    const typeButtons = Array.from(document.querySelectorAll('[data-type-filter]'));
    const yearSelect = document.querySelector('[data-year-filter]');
    const categorySelect = document.querySelector('[data-category-filter]');
    const competitionSelect = document.querySelector('[data-competition-filter]');
    const momentSelect = document.querySelector('[data-moment-filter]');
    const raceFilters = Array.from(document.querySelectorAll('[data-race-filter]'));
    const cards = Array.from(document.querySelectorAll('[data-media-grid] .media-card'));
    const filterEmpty = document.querySelector('[data-filter-empty]');
    const filterToggle = document.querySelector('[data-filter-toggle]');
    const filterOptions = document.querySelector('[data-filter-options]');
    let activeType = 'tutti';

    const updateRaceFilters = () => {
      const isRace = categorySelect instanceof HTMLSelectElement && categorySelect.value === 'gara';
      raceFilters.forEach((field) => { if (field instanceof HTMLElement) field.hidden = !isRace; });
      if (!isRace) {
        if (competitionSelect instanceof HTMLSelectElement) competitionSelect.value = 'tutti';
        if (momentSelect instanceof HTMLSelectElement) momentSelect.value = 'tutti';
      }
    };
    const applyFilters = () => {
      updateRaceFilters();
      const year = yearSelect instanceof HTMLSelectElement ? yearSelect.value : 'tutti';
      const category = categorySelect instanceof HTMLSelectElement ? categorySelect.value : 'tutti';
      const competition = competitionSelect instanceof HTMLSelectElement ? competitionSelect.value : 'tutti';
      const moment = momentSelect instanceof HTMLSelectElement ? momentSelect.value : 'tutti';
      let visibleCount = 0;
      cards.forEach((card) => {
        const show =
          (activeType === 'tutti' || card.getAttribute('data-media-type') === activeType) &&
          (year === 'tutti' || card.getAttribute('data-year') === year) &&
          (category === 'tutti' || card.getAttribute('data-category') === category) &&
          (category !== 'gara' || competition === 'tutti' || card.getAttribute('data-competition') === competition) &&
          (category !== 'gara' || moment === 'tutti' || card.getAttribute('data-moment') === moment);
        card.hidden = !show;
        if (show) visibleCount += 1;
      });
      if (filterEmpty instanceof HTMLElement) filterEmpty.hidden = visibleCount !== 0;
    };
    typeButtons.forEach((button) => button.addEventListener('click', () => {
      activeType = button.getAttribute('data-type-filter') || 'tutti';
      typeButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      applyFilters();
    }));
    [yearSelect, categorySelect, competitionSelect, momentSelect].forEach((control) => control?.addEventListener('change', applyFilters));
    filterToggle?.addEventListener('click', () => {
      if (!(filterToggle instanceof HTMLButtonElement) || !(filterOptions instanceof HTMLElement)) return;
      const open = filterToggle.getAttribute('aria-expanded') === 'true';
      filterToggle.setAttribute('aria-expanded', String(!open));
      filterOptions.classList.toggle('is-open', !open);
      const icon = filterToggle.querySelector('span'); if (icon) icon.textContent = open ? '＋' : '−';
    });
    applyFilters();

    const viewer=document.querySelector('#video-viewer');
    const panel=viewer?.querySelector('.video-viewer__panel');
    const player=viewer?.querySelector('[data-video-player]');
    const titleEl=viewer?.querySelector('[data-video-title]');
    const detailEl=viewer?.querySelector('[data-video-detail]');
    const dateEl=viewer?.querySelector('[data-video-date]');
    const triggers=Array.from(document.querySelectorAll('.media-trigger[data-media-type="video"]'));
    let currentIndex=0;
    const openVideo=(button)=>{
      if(!(viewer instanceof HTMLElement)||!(player instanceof HTMLElement)||!(button instanceof HTMLElement))return;
      const id=button.dataset.youtubeId||''; if(!id)return;
      const title=button.dataset.title||'';
      player.innerHTML=`<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&playsinline=1&rel=0&fs=1" title="${title.replace(/"/g,'&quot;')}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen" allowfullscreen webkitallowfullscreen mozallowfullscreen></iframe>`;
      if(titleEl)titleEl.textContent=title; if(detailEl)detailEl.textContent=button.dataset.detail||'';
      if(dateEl instanceof HTMLTimeElement){const date=button.dataset.date||'';dateEl.dateTime=date;dateEl.textContent=date?date.split('-').reverse().join('/'):'';}
      viewer.hidden=false; viewer.setAttribute('aria-hidden','false'); document.body.classList.add('video-open');
      currentIndex=Math.max(0,triggers.indexOf(button)); requestAnimationFrame(()=>viewer.classList.add('is-open'));
    };
    const closeVideo=()=>{if(!(viewer instanceof HTMLElement))return;viewer.classList.remove('is-open');document.body.classList.remove('video-open');if(player)player.innerHTML='';setTimeout(()=>{viewer.hidden=true;viewer.setAttribute('aria-hidden','true');},160);};
    triggers.forEach((button)=>button.addEventListener('click',()=>openVideo(button)));
    viewer?.querySelectorAll('[data-video-close]').forEach((el)=>el.addEventListener('click',closeVideo));
    document.addEventListener('keydown',(e)=>{if(e.key==='Escape'&&!viewer?.hidden)closeVideo();});
    let touchX=0;
    panel?.addEventListener('touchstart',(e)=>{touchX=e.changedTouches[0]?.clientX||0;},{passive:true});
    panel?.addEventListener('touchend',(e)=>{const end=e.changedTouches[0]?.clientX||0;const dx=end-touchX;if(Math.abs(dx)<70||triggers.length<2)return;currentIndex=(currentIndex+(dx<0?1:-1)+triggers.length)%triggers.length;openVideo(triggers[currentIndex]);},{passive:true});
  </script>

  <style>
    .media-page{background:#060504;color:#f3ede2}.media-shell{width:min(1180px,calc(100% - 56px));margin-inline:auto}.eyebrow{margin:0;color:var(--gold-bright);font:800 .68rem/1 var(--font-ui);letter-spacing:.16em;text-transform:uppercase}.media-hero{position:relative;min-height:390px;padding-top:118px;background:radial-gradient(circle at 78% 20%,rgba(181,138,60,.14),transparent 28%),linear-gradient(180deg,#090807,#060504);overflow:hidden}.media-hero__inner{padding:54px 0 74px}.media-hero h1,.featured h2,.archive h2{font-family:var(--font-display);text-transform:uppercase;line-height:.92}.media-hero h1{margin:10px 0 4px;font-size:clamp(4.4rem,9vw,8rem)}.media-hero__claim{margin:0;color:#d6ad61;font-family:var(--font-display);font-size:clamp(1.6rem,2.7vw,2.8rem)}.media-hero__intro{max-width:560px;color:#c8c0b4;line-height:1.7}.featured{padding:68px 0 92px}.section-row{display:flex;align-items:end;justify-content:space-between;gap:32px;margin-bottom:26px}.section-row h2{margin:8px 0 0;font-size:clamp(2.3rem,4.8vw,4.8rem)}.section-row>a{color:#d4a64d;font:700 .7rem/1 var(--font-ui);text-transform:uppercase}.featured-grid{display:grid;grid-template-columns:minmax(0,1.85fr) minmax(300px,1fr);gap:14px;min-height:540px}.featured-main,.featured-small{position:relative;overflow:hidden;border:1px solid rgba(181,138,60,.24);padding:0;background:#0a0908;color:#fff;text-align:left;cursor:pointer}.featured-main img,.featured-small img{width:100%;height:100%;object-fit:cover}.featured-side{display:grid;grid-template-rows:1fr 1fr;gap:14px}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.02) 38%,rgba(0,0,0,.88))}.play{position:absolute;left:50%;top:50%;display:grid;width:70px;height:70px;place-items:center;transform:translate(-50%,-50%);border:1px solid rgba(255,255,255,.88);border-radius:50%;background:rgba(0,0,0,.38)}.play--small{width:48px;height:48px}.featured-copy{position:absolute;left:26px;right:26px;bottom:24px;display:grid;gap:6px}.featured-cop