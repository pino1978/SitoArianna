l img{width:100%;height:100%;object-fit:cover}.media-card__copy{display:grid;gap:5px;padding:15px 17px 18px}.media-card__copy strong{font-family:var(--font-display);font-size:1.05rem;text-transform:uppercase}.media-card__copy>span{color:#aaa296;font-size:.75rem}.media-empty{padding:60px;text-align:center}.video-viewer[hidden]{display:none!important}.video-viewer{position:fixed;inset:0;z-index:20000;display:grid;place-items:center;opacity:0;transition:opacity .16s ease}.video-viewer.is-open{opacity:1}.video-viewer__backdrop{position:absolute;inset:0;background:rgba(0,0,0,.96)}.video-viewer__panel{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) 320px;width:min(1460px,calc(100vw - 28px));max-height:calc(100dvh - 28px);background:#020202;box-shadow:0 20px 70px #000;overflow:auto}.video-viewer__player{display:grid;place-items:center;background:#000}.video-viewer__player iframe{display:block;width:100%;aspect-ratio:16/9;border:0}.video-viewer__meta{display:flex;flex-direction:column;justify-content:center;padding:42px 30px;border-left:1px solid rgba(181,138,60,.2)}.video-viewer__meta h2{margin:10px 0 12px;font-family:var(--font-display);font-size:2rem;text-transform:uppercase}.video-viewer__meta time{color:#d4a64d}.viewer-close{position:fixed;z-index:20002;right:18px;top:18px;width:52px;height:52px;border:1px solid rgba(255,255,255,.4);border-radius:50%;background:#070707;color:#fff;font-size:1.8rem;cursor:pointer}.video-open{overflow:hidden!important}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
