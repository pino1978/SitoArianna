---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import results from "../data/results.json";
const medalLabels = { gold: "Oro", silver: "Argento", bronze: "Bronzo" };
const imageFor = (year, event) => {
  const key = `${year}|${event}`;
  const map = {
    "2022|Palacasoria": 0,
    "2022|FIWuK – Scuola Regionale Campana Alta Specializzazione": 1,
    "2023|2° Trofeo Giovanile di Taolu Wushu": 2,
    "2024|Xanda Prestige": 3,
    "2024|20° World Open Championship C.K.A.": 4,
    "2025|Arti Marziali CSEN": 5,
    "2025|21° World Championship & Cup C.K.A.": 5,
    "2025|Champion Cup": 6,
    "2025|One to One Tournament": 8,
    "2026|Champion Cup": 9,
    "2026|22° World Championship & Cup C.K.A.": 10,
    "2026|One to One": 11
  };
  return map[key] ?? 0;
};
const years = [...results.resultsByYear].sort((a, b) => b.year - a.year);
const medals = years.flatMap((yearBlock) =>
  yearBlock.competitions.flatMap((competition, competitionIndex) =>
    competition.results.map((result, resultIndex) => ({
      id: `${yearBlock.year}-${competitionIndex}-${resultIndex}`,
      year: yearBlock.year,
      event: competition.event,
      place: competition.place,
      discipline: result.discipline,
      medal: result.medal,
      sprite: imageFor(yearBlock.year, competition.event)
    }))
  )
);
const disciplines = [...new Set(medals.map((item) => item.discipline))];
const events = [...new Set(medals.map((item) => item.event))];
const first = medals[0];
const recapGroups = [
  { title: "Champion Cup", place: "Sora (FR)", items: ["2026 · Sanda", "2025 · Sanda", "2025 · Tui Shou – Piedi mobili"] },
  { title: "One to One", place: "Giugliano (NA)", items: ["2026 · Sanda", "2026 · Sanda", "2025 · Sanda"] },
  { title: "World C.K.A.", place: "Perugia", items: ["2026 · Sanda", "2026 · Chambara", "2025 · Tui Shou – Piedi fissi", "2024 · Sanda"] },
  { title: "Arti Marziali CSEN", place: "", items: ["2025 · Sanda"] },
  { title: "Palacasoria", place: "Casoria (NA)", items: ["2022 · Sanda", "2022 · Chambara"] }
];
---
<BaseLayout title="Il mio palmarès | Arianna Milano" description="Il percorso agonistico e le medaglie di Arianna Milano dal 2022 a oggi."><main class="palmares-page" id="main"><section class="palmares-hero" aria-labelledby="page-title"><Header /><div class="palmares-hero__inner"><a class="back-home" href="/" data-interactive>← Torna alla home</a><p class="eyebrow">Il percorso agonistico</p><h1 id="page-title">Il mio palmarès</h1><span class="hero-title-mark" aria-hidden="true"></span><p class="lead">Ogni medaglia racconta un passo del mio percorso.</p><div class="olympic-summary" aria-label="Riepilogo delle medaglie"><div class="summary-medal gold"><strong>14</strong><span>Ori</span></div><div class="summary-medal silver"><strong>2</strong><span>Argenti</span></div><div class="summary-medal bronze"><strong>0</strong><span>Bronzi</span></div></div><div class="recap-groups" aria-label="Riepilogo per manifestazione">{recapGroups.map(group => <article><h2>{group.title}</h2>{group.place && <p>{group.place}</p>}<ul>{group.items.map(item => <li><i aria-hidden="true"></i>{item}</li>)}</ul></article>)}</div><a class="scroll-cta" href="#timeline" data-interactive>Esplora la timeline <span aria-hidden="true">↓</span></a></div><div class="hero-eagle" aria-hidden="true">鹰</div></section><section class="timeline-section reveal" id="timeline" aria-labelledby="timeline-title"><header class="section-heading"><p class="eyebrow">Timeline interattiva</p><h2 id="timeline-title">Anno dopo anno</h2><p>Seleziona una gara per visualizzare la medaglia e il risultato.</p></header><div class="timeline-layout"><div class="timeline-list">
          {years.map((yearBlock) => (
            <article class="timeline-year reveal"><header class="year-heading"><h3>{yearBlock.year}</h3><span>{yearBlock.totals.gold ? `${yearBlock.totals.gold} ${yearBlock.totals.gold === 1 ? "oro" : "ori"}` : ""}{yearBlock.totals.gold && yearBlock.totals.silver ? " · " : ""}{yearBlock.totals.silver ? `${yearBlock.totals.silver} ${yearBlock.totals.silver === 1 ? "argento" : "argenti"}` : ""}</span></header><div class="year-events">
                {yearBlock.competitions.flatMap((competition, competitionIndex) =>
                  competition.results.map((result, resultIndex) => {
                    const id = `${yearBlock.year}-${competitionIndex}-${resultIndex}`;
                    return <button class:list={["timeline-event", `is-${result.medal}`]} type="button" data-interactive data-medal-id={id} aria-pressed="false"><i aria-hidden="true"></i><span><strong>{competition.event}</strong><small>{competition.place || ""}</small></span><em>{result.discipline}</em><b>{medalLabels[result.medal]}</b></button>;
                  })
                )}
              </div></article>
          ))}
        </div><aside class="timeline-detail" aria-live="polite"><div class="detail-image"><div class="medal-photo" role="img" aria-label={`Medaglia ${first.event} ${first.year}`} style={`--sprite-x:${first.sprite % 4};--sprite-y:${Math.floor(first.sprite / 4)}`}></div></div><div class="detail-copy"><span class:list={["result-pill", `is-${first.medal}`]}>{medalLabels[first.medal]}</span><p class="detail-year">{first.year}</p><h3>{first.event}</h3><p class="detail-place">{first.place}</p><dl><div><dt>Disciplina</dt><dd>{first.discipline}</dd></div></dl></div></aside></div></section><section class="medal-board reveal" id="medagliere" aria-labelledby="board-title"><header class="section-heading board-heading"><div><p class="eyebrow">Bacheca delle medaglie</p><h2 id="board-title">Il mio palmarès</h2><p>Tutte le medaglie, ordinate per anno.</p></div><div class="mini-summary"><span><b>14</b> Ori</span><span><b>2</b> Argenti</span><span><b>16</b> Totale</span></div></header><div class="filters" aria-label="Filtra le medaglie"><label><span>Anno</span><select id="filter-year" data-interactive><option value="all">Tutti</option>{years.map(y =><option value={y.year}>{y.year}</option>)}</select></label><label><span>Disciplina</span><select id="filter-discipline" data-interactive><option value="all">Tutte</option>{disciplines.map(d =><option value={d}>{d}</option>)}</select></label><label><span>Manifestazione</span><select id="filter-event" data-interactive><option value="all">Tutte</option>{events.map(e =><option value={e}>{e}</option>)}</select></label><label><span>Risultato</span><select id="filter-medal" data-interactive><option value="all">Tutti</option><option value="gold">Oro</option><option value="silver">Argento</option></select></label></div><p class="filter-count"><strong id="visible-count">{medals.length}</strong> medaglie visualizzate</p><div class="medal-years">
        {years.map((yearBlock) => {
          const yearMedals = medals.filter(m => m.year === yearBlock.year);
          return <section class="board-year" data-board-year={yearBlock.year}><h3>{yearBlock.year}</h3><div class="medal-grid">
              {yearMedals.map(item =><button class="medal-card reveal" type="button" data-interactive data-year={item.year} data-event={item.event} data-discipline={item.discipline} data-medal={item.medal} data-medal-id={item.id}><span class="card-result" data-kind={item.medal}>{medalLabels[item.medal]}</span><div class="medal-photo" role="img" aria-label={`Medaglia ${medalLabels[item.medal].toLowerCase()} ${item.event} ${item.year}, ${item.discipline}`} style={`--sprite-x:${item.sprite % 4};--sprite-y:${Math.floor(item.sprite / 4)}`}></div><strong>{item.event}</strong>
                {item.place && <small>{item.place}</small>}
                <em>{item.discipline}</em></button>)}
            </div></section>;
        })}
      </div></section></main></BaseLayout><script define:vars={{ medals, medalLabels }}>
  const detail = document.querySelector('.timeline-detail');
  const eventButtons = [...document.querySelectorAll('.timeline-event')];
  const showDetail = (id) => {
    const item = medals.find(m => m.id === id); if (!item || !detail) return;
    const photo = detail.querySelector('.medal-photo');
    photo.style.setProperty('--sprite-x', item.sprite % 4);
    photo.style.setProperty('--sprite-y', Math.floor(item.sprite / 4));
    photo.setAttribute('aria-label', `Medaglia ${item.event} ${item.year}`);
    const pill = detail.querySelector('.result-pill'); pill.textContent = medalLabels[item.medal]; pill.className = `result-pill is-${item.medal}`;
    detail.querySelector('.detail-year').textContent = item.year;
    detail.querySelector('h3').textContent = item.event;
    detail.querySelector('.detail-place').textContent = item.place || '';
    detail.querySelector('dd').textContent = item.discipline;
    detail.classList.remove('pulse'); requestAnimationFrame(() => detail.classList.add('pulse'));
    eventButtons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.medalId === id)));
  };
  eventButtons.forEach(b => b.addEventListener('click', () => showDetail(b.dataset.medalId)));
  document.querySelectorAll('.medal-card').forEach(c => c.addEventListener('click', () => { showDetail(c.dataset.medalId); document.querySelector('#timeline')?.scrollIntoView({behavior:'smooth'}); }));
  const filters = ['year','discipline','event','medal'].reduce((a,k) => (a[k]=document.querySelector(`#filter-${k}`),a),{});
  const cards = [...document.querySelectorAll('.medal-card')];
  const yearsEls = [...document.querySelectorAll('.board-year')];
  const count = document.querySelector('#visible-count');
  const apply = () => {
    let visible = 0;
    cards.forEach(card => {
      const ok = Object.entries(filters).every(([k,el]) => el.value === 'all' || card.dataset[k] === el.value);
      card.hidden = !ok; if(ok) visible++;
    });
    yearsEls.forEach(y => y.hidden = ![...y.querySelectorAll('.medal-card')].some(c => !c.hidden));
    count.textContent = visible;
  };
  Object.values(filters).forEach(f => f.addEventListener('change', apply));
  const observer = new IntersectionObserver(entries => entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('is-visible'); observer.unobserve(e.target); }}), {threshold:.12});
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script><style>
  :global(html){scroll-behavior:smooth}.palmares-page{background:#070706;color:#f4f0e8;overflow:hidden}.palmares-hero{position:relative;min-height:720px;padding:0 clamp(18px,5vw,80px) 70px;border-bottom:1px solid rgba(217,168,63,.35);background:radial-gradient(circle at 72% 35%,rgba(114,12,12,.26),transparent 34%),linear-gradient(120deg,#080706,#0d0b09 58%,#050505)}.palmares-hero__inner{position:relative;z-index:2;width:min(1180px,100%);margin:auto;padding-top:145px;text-align:center}.back-home{display:block;width:max-content;margin:0 0 52px;color:#d9a83f;text-decoration:none;font:800 .7rem var(--font-ui);letter-spacing:.14em;text-transform:uppercase}.eyebrow{margin:0 0 13px;color:#d9a83f;font:800 .72rem var(--font-ui);letter-spacing:.22em;text-transform:uppercase}.palmares-hero h1,.section-heading h2{margin:0;font-family:var(--font-ui);font-weight:900;text-transform:uppercase}.palmares-hero h1{font-size:clamp(2.6rem,5vw,4.9rem);line-height:1;letter-spacing:.02em}.hero-title-mark{display:block;width:52px;height:2px;margin:18px auto;background:#b32620}.lead{margin:0 0 34px;color:rgba(244,240,232,.72);font-size:clamp(1rem,2vw,1.25rem)}.olympic-summary{display:flex;justify-content:center;gap:clamp(20px,5vw,58px);flex-wrap:wrap}.summary-medal{position:relative;width:155px;height:118px;display:grid;place-content:center;text-align:center}.summary-medal:before,.summary-medal:after{content:"❯";position:absolute;top:35px;font-size:2.2rem;opacity:.8}.summary-medal:before{left:15px;transform:rotate(180deg)}.summary-medal:after{right:15px}.summary-medal.gold{color:#d9a83f}.summary-medal.silver{color:#c7c7c7}.summary-medal.bronze{color:#9c623d}.summary-medal strong{font:900 2.7rem/1 var(--font-ui)}.summary-medal span{display:block;margin-top:5px;color:#f4f0e8;font:800 .65rem var(--font-ui);letter-spacing:.15em;text-transform:uppercase}.recap-groups{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin:34px auto 0;text-align:left}.recap-groups article{min-height:150px;padding:17px;border:1px solid rgba(217,168,63,.25);background:rgba(255,255,255,.018)}.recap-groups h2{margin:0;font:800 .72rem var(--font-ui);text-transform:uppercase}.recap-groups p{margin:5px 0 12px;color:#d9a83f;font:700 .55rem var(--font-ui);text-transform:uppercase}.recap-groups ul{display:grid;gap:7px;margin:0;padding:0;list-style:none}.recap-groups li{display:flex;gap:7px;color:rgba(244,240,232,.7);font:600 .59rem/1.25 var(--font-ui)}.recap-groups li i{flex:0 0 7px;width:7px;height:7px;margin-top:2px;border-radius:50%;background:#d9a83f}.scroll-cta{display:inline-flex;align-items:center;gap:18px;margin-top:26px;padding:15px 20px;border:1px solid rgba(217,168,63,.7);color:#fff;text-decoration:none;font:800 .68rem var(--font-ui);letter-spacing:.14em;text-transform:uppercase}.hero-eagle{position:absolute;right:2vw;bottom:-.1em;color:rgba(217,168,63,.035);font:900 clamp(20rem,42vw,44rem)/.7 serif}.timeline-section,.medal-board{padding:clamp(70px,10vw,130px) clamp(18px,5vw,80px)}.section-heading,.timeline-layout,.board-heading,.filters,.filter-count,.medal-years{width:min(1180px,100%);margin-left:auto;margin-right:auto}.section-heading{margin-bottom:46px}.section-heading h2{font-size:clamp(2.15rem,5vw,4.5rem);line-height:.95}.section-heading>p:last-child{color:rgba(244,240,232,.6)}.timeline-layout{display:grid;grid-template-columns:1.25fr .75fr;gap:60px}.timeline-list{position:relative}.timeline-list:before{content:"";position:absolute;left:75px;top:18px;bottom:18px;width:1px;background:linear-gradient(#b32620,rgba(217,168,63,.3))}.timeline-year{display:grid;grid-template-columns:120px 1fr;gap:30px;margin-bottom:45px}.year-heading h3{margin:0;color:#b32620;font:900 1.55rem var(--font-ui)}.year-heading span{display:block;margin-top:8px;color:#d9a83f;font:700 .65rem var(--font-ui);text-transform:uppercase}.year-events{display:grid;gap:8px}.timeline-event{position:relative;display:grid;grid-template-columns:12px 1fr minmax(110px,.5fr) 70px;gap:15px;align-items:center;width:100%;padding:12px 14px;border:1px solid transparent;background:transparent;color:#f4f0e8;text-align:left;cursor:pointer}.timeline-event:hover,.timeline-event[aria-pressed="true"]{border-color:rgba(217,168,63,.45);background:rgba(255,255,255,.025)}.timeline-event i{width:9px;height:9px;border-radius:50%;background:#d9a83f;box-shadow:0 0 0 4px rgba(217,168,63,.08)}.timeline-event.is-silver i{background:#bfc2c6}.timeline-event strong,.timeline-event em{font:700 .78rem var(--font-ui)}.timeline-event small{display:block;margin-top:4px;color:rgba(244,240,232,.5);font-style:normal}.timeline-event em{color:rgba(244,240,232,.72);font-style:normal}.timeline-event b{color:#d9a83f;font:800 .63rem var(--font-ui);text-transform:uppercase}.timeline-event.is-silver b{color:#c7c7c7}.timeline-detail{position:sticky;top:24px;align-self:start;border:1px solid rgba(217,168,63,.4);background:rgba(13,11,9,.94)}.detail-image{aspect-ratio:1/1;background:#030303;overflow:hidden}.medal-photo{width:100%;height:100%;background-image:url("/images/medaglie/medaglie-sprite.webp");background-size:400% 300%;background-position:calc(var(--sprite-x) * 33.333333%) calc(var(--sprite-y) * 50%);background-repeat:no-repeat}.detail-image .medal-photo{min-height:100%}.detail-copy{padding:25px}.result-pill{display:inline-block;padding:6px 10px;background:#d9a83f;color:#080706;font:800 .6rem var(--font-ui);letter-spacing:.12em;text-transform:uppercase}.result-pill.is-silver{background:#c7c7c7}.detail-year{margin:20px 0 6px;color:#b32620;font:800 .75rem var(--font-ui)}.detail-copy h3{margin:0;font:900 1.45rem var(--font-ui);text-transform:uppercase}.detail-place{color:rgba(244,240,232,.58)}.detail-copy dl{border-top:1px solid rgba(217,168,63,.22);padding-top:15px}.detail-copy dt{color:rgba(244,240,232,.45);font:700 .62rem var(--font-ui);text-transform:uppercase}.detail-copy dd{margin:6px 0 0}.pulse{animation:pulse .35s ease}.medal-board{border-top:1px solid rgba(217,168,63,.25);background:linear-gradient(180deg,#090807,#050505)}.board-heading{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:30px}.mini-summary{display:flex;gap:1px;background:rgba(217,168,63,.3);border:1px solid rgba(217,168,63,.25)}.mini-summary span{padding:14px 18px;background:#090807;color:rgba(244,240,232,.65);font:700 .62rem var(--font-ui);text-transform:uppercase}.mini-summary b{display:block;color:#d9a83f;font-size:1.4rem}.filters{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px}.filters label span{display:block;margin-bottom:6px;color:rgba(244,240,232,.5);font:700 .58rem var(--font-ui);letter-spacing:.12em;text-transform:uppercase}.filters select{width:100%;padding:13px;border:1px solid rgba(217,168,63,.35);background:#0b0a09;color:#f4f0e8}.filter-count{color:rgba(244,240,232,.5);font-size:.78rem}.board-year{display:grid;grid-template-columns:80px 1fr;gap:25px;padding:28px 0;border-top:1px solid rgba(217,168,63,.14)}.board-year>h3{margin:5px 0;color:#b32620;font:900 1.35rem var(--font-ui)}.medal-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}.medal-card{position:relative;display:flex;flex-direction:column;align-items:center;min-width:0;padding:12px 10px 17px;border:1px solid transparent;background:transparent;color:#f4f0e8;text-align:center;cursor:pointer}.medal-card:hover{border-color:rgba(217,168,63,.38);background:rgba(255,255,255,.02);transform:translateY(-3px)}.medal-card .medal-photo{width:100%;aspect-ratio:1/1;border-radius:50%;filter:drop-shadow(0 12px 18px rgba(0,0,0,.45))}.medal-card strong{margin-top:12px;font:800 .72rem/1.25 var(--font-ui);text-transform:uppercase}.medal-card small{margin-top:4px;color:rgba(244,240,232,.5)}.medal-card em{margin-top:7px;color:#d9a83f;font:700 .68rem var(--font-ui);font-style:normal}.card-result{position:absolute;z-index:2;top:5px;right:5px;padding:4px 7px;background:#d9a83f;color:#080706;font:800 .5rem var(--font-ui);text-transform:uppercase}.card-result[data-kind="silver"]{background:#c7c7c7}.palmares-footer{display:flex;justify-content:space-between;align-items:center;padding:40px clamp(18px,5vw,80px);border-top:1px solid rgba(217,168,63,.25);background:#050505}.palmares-footer a{color:#d9a83f;text-decoration:none;font:800 .65rem var(--font-ui);text-transform:uppercase}.reveal{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s ease}.reveal.is-visible{opacity:1;transform:none}@keyframes pulse{50%{opacity:.76}}
  @media(max-width:1000px){.recap-groups{grid-template-columns:repeat(3,1fr)}.timeline-layout{grid-template-columns:1fr}.timeline-detail{position:relative;top:auto;display:grid;grid-template-columns:minmax(240px,.8fr) 1fr}.detail-image{aspect-ratio:4/3}.medal-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:700px){.recap-groups{grid-template-columns:1fr 1fr}.palmares-hero{min-height:auto;padding-bottom:55px}.palmares-hero__inner{padding-top:115px}.back-home{margin-bottom:45px}.olympic-summary{justify-content:center;gap:0}.summary-medal{width:33.333%;min-width:98px;height:105px}.summary-medal:before,.summary-medal:after{font-size:1.55rem}.summary-medal:before{left:5px}.summary-medal:after{right:5px}.summary-medal strong{font-size:2rem}.timeline-section,.medal-board{padding-left:16px;padding-right:16px}.timeline-list:before{left:17px}.timeline-year{display:block;padding-left:42px}.year-heading{margin-bottom:15px}.timeline-event{grid-template-columns:10px 1fr auto;padding:13px 8px}.timeline-event em{grid-column:2}.timeline-event b{grid-column:3;grid-row:1/3}.timeline-detail{display:block}.board-heading{display:block}.mini-summary{margin-top:22px;width:max-content;max-width:100%}.filters{grid-template-columns:1fr 1fr}.board-year{display:block}.board-year>h3{margin-bottom:15px}.medal-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.medal-card{padding-left:6px;padding-right:6px}.medal-card strong{font-size:.63rem}.palmares-footer{align-items:flex-start}.hero-eagle{display:none}}
  @media(max-width:390px){.recap-groups{grid-template-columns:1fr}.filters{grid-template-columns:1fr}.medal-grid{grid-template-columns:1fr 1fr}.mini-summary span{padding:10px 12px}.timeline-event{grid-template-columns:9px 1fr}.timeline-event b{grid-column:2;grid-row:auto}.summary-medal:before,.summary-medal:after{display:none}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}.pulse{animation:none}.medal-card{transition:none}}
</style>
