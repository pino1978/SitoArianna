---
import BaseLayout from "../layouts/BaseLayout.astro";
import profile from "../data/profile.json";
import logo from "../assets/svg/logo-arianna-milano.svg";
import signature from "../assets/svg/signature-ying.svg";
import profileHeroBg from "../assets/images/profile-ying-bg.png";
import profileAthlete from "../assets/images/profile-athlete-layer.png";
import profileLightWing from "../assets/images/profile-light-wing.png";
import profileObjectiveBg from "../assets/images/profile-objective-bg.png";
import profileCardImage from "../assets/images/profile-placeholder.png";

const values = [
  {
    mark: "谨",
    title: "Disciplina",
    copy: "Regole e regolarita, mi allenano nel metodo. La disciplina e la base di ogni mio progresso."
  },
  {
    mark: "勇",
    title: "Coraggio",
    copy: "Affronto ogni sfida senza paura. Dentro il tatami e nella vita."
  },
  {
    mark: "尊",
    title: "Rispetto",
    copy: "Rispetto l'avversario, i compagni, il maestro e ogni momento del mio percorso."
  },
  {
    mark: "恒",
    title: "Costanza",
    copy: "Ogni giorno scelgo di migliorare un po'. La costanza trasforma gli obiettivi in realta."
  }
];
---

<BaseLayout title="Profilo | Arianna Milano" description="Profilo sportivo di Arianna Milano, giovane atleta agonista di Sanda.">
  <main id="main" class="profile-page">
    <section class="profile-hero" id="top" aria-labelledby="profile-hero-title">
      <img class="profile-hero-bg" src={profileHeroBg.src} alt="" aria-hidden="true" width={profileHeroBg.width} height={profileHeroBg.height} />
      <img class="profile-hero-athlete" src={profileAthlete.src} alt="" aria-hidden="true" width={profileAthlete.width} height={profileAthlete.height} />
      <div class="profile-hero-shade" aria-hidden="true"></div>

      <header class="profile-header">
        <a class="profile-brand" href="/" aria-label="Arianna Milano, torna alla home">
          <img src={logo.src} alt="Arianna Milano" width={logo.width} height={logo.height} />
          <span>Sanda Athlete</span>
        </a>
        <nav class="profile-nav" aria-label="Navigazione profilo">
          <a href="/">Home</a>
          <a class="is-active" href="/profilo/">Profilo</a>
          <a href="/#risultati">Risultati</a>
          <a href="/#media">Media</a>
        </nav>
        <div class="profile-tools" aria-label="Lingua e percorso">
          <span>IT</span>
          <a href="/">Home / Profilo</a>
        </div>
      </header>

      <div class="profile-hero-copy">
        <p>Profilo atleta <span aria-hidden="true">-</span> Kung Fu Sanda</p>
        <h1 id="profile-hero-title">
          <span>Crescere</span>
          <em>Sul Tatami</em>
        </h1>
        <p class="profile-hero-lede">Disciplina, tecnica e determinazione.<br />Un percorso iniziato nel 2022<br />e costruito allenamento dopo allenamento.</p>
      </div>
    </section>

    <section class="profile-path" aria-labelledby="profile-path-title">
      <div class="profile-section-label"><span>01</span> Il mio percorso</div>
      <div class="profile-path-grid">
        <img src={profileCardImage.src} alt="Ritratto editoriale di Arianna Milano in ambiente di allenamento" loading="lazy" width={profileCardImage.width} height={profileCardImage.height} />
        <article>
          <img class="profile-path-watermark" src={profileLightWing.src} alt="" aria-hidden="true" width={profileLightWing.width} height={profileLightWing.height} />
          <h2 id="profile-path-title">La crescita<br />prima del risultato.</h2>
          <p>Il mio percorso nel Kung Fu e iniziato nel 2022.</p>
          <p>Da allora ogni allenamento e diventato un'opportunita per imparare qualcosa di nuovo, migliorare e mettermi alla prova.</p>
          <p>Affronto ogni giorno con impegno, dentro e fuori dal tatami, grazie al supporto della mia famiglia, che mi incoraggia sempre.</p>
        </article>
      </div>
    </section>

    <section class="profile-values" aria-labelledby="profile-values-title">
      <div class="profile-section-label gold"><span>02</span> Valori sportivi</div>
      <h2 id="profile-values-title" class="sr-only">Valori sportivi</h2>
      <div class="profile-value-grid">
        {values.map((item) => (
          <article>
            <div class="profile-value-mark" aria-hidden="true">{item.mark}</div>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="profile-objective" aria-labelledby="profile-objective-title">
      <img src={profileObjectiveBg.src} alt="" aria-hidden="true" width={profileObjectiveBg.width} height={profileObjectiveBg.height} />
      <div>
        <p>Il mio obiettivo</p>
        <h2 id="profile-objective-title">Ogni allenamento<br />mi avvicina alla versione<br />migliore di me.</h2>
        <p>Continuare a crescere come atleta e come persona, affrontare competizioni sempre piu importanti e rappresentare con orgoglio la mia societa dentro e fuori dal tatami.</p>
        <a href="/#risultati">Scopri i risultati <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>
  </main>

  <footer class="profile-footer">
    <div>
      <strong>{profile.name}</strong>
      <span>Sanda Athlete</span>
    </div>
    <nav aria-label="Navigazione footer profilo">
      <a href="/">Home</a>
      <a href="/profilo/">Profilo</a>
      <a href="/#risultati">Risultati</a>
      <a href="/#media">Media</a>
    </nav>
    <img src={signature.src} alt="Ying" width="150" height="42" />
    <a href={`mailto:${profile.contactEmail}`}>{profile.contactEmail}</a>
  </footer>
</BaseLayout>
