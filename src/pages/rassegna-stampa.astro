---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
const articles=[
{outlet:"NanoTV",date:"16 settembre 2026",image:"https://www.nanotv.it/wp-content/uploads/2026/09/arianna.jpg",title:"Arianna ha 12 anni ed è di Casoria. Pratica Sanda, disciplina di combattimento del Wushu Kung Fu",excerpt:"NanoTV racconta il percorso sportivo di Arianna, i risultati raggiunti e i prossimi appuntamenti tra il Palamidio in Grecia e i Campionati Italiani FIWuK.",url:"https://www.nanotv.it/2026/09/16/arianna-ha-12-anni-ed-e-di-casoria-pratica-sanda-disciplina-di-combattimento-del-wushu-kung-fu-dal-2021-presso-lasd-kasoria-kombat-fly-dove-e-seguita-dal-maestro-eduardo-mazzara/"},
{outlet:"Redazione Prospettive",date:"14 settembre 2026",image:"https://www.redazioneprospettive.it/wp-content/uploads/2026/09/WhatsApp-Image-2026-09-14-at-11.00.48.jpeg",title:"Da Casoria alla Grecia: Arianna Milano vola al 18° Palamidio Martial Arts Championship",excerpt:"Redazione Prospettive racconta il percorso di Arianna verso il Palamidio e la raccolta fondi avviata per sostenere la trasferta in Grecia.",url:"https://www.redazioneprospettive.it/da-casoria-alla-grecia-arianna-milano-vola-al-18-palamidio-martial-arts-championship-aperta-una-raccolta-fondi-per-sostenere-la-giovane-campionessa-di-sanda/"},
{outlet:"Frattamaggiore News",date:"14 settembre 2026",image:"https://i0.wp.com/www.frattamaggiorenews.com/wp-content/uploads/2026/09/Arianna_Milano_Palamidio_Grecia_2026.jpg?resize=660%2C356&ssl=1",title:"Da Casoria alla Grecia: Arianna Milano al Palamidio 2026",excerpt:"Frattamaggiore News dedica un articolo al percorso sportivo di Arianna e alla partecipazione al Palamidio 2026 di Nafplio.",url:"https://www.frattamaggiorenews.com/2026/09/14/da-casoria-alla-grecia-arianna-milano-al-palamidio-2026/"},
{outlet:"CasaNapoli.net",date:"14 settembre 2026",image:"https://i0.wp.com/www.casanapoli.net/wp-content/uploads/2026/09/aa95ea7e-2547-53e9-cb42-813485a31c55.jpeg?fit=640%2C360&ssl=1",title:"Arianna Milano, 12 anni di Casoria e 14 ori nel Sanda: sogna la Nazionale, aiutiamola ad arrivare in Grecia",excerpt:"CasaNapoli racconta i risultati ottenuti da Arianna nel Sanda e il prossimo appuntamento internazionale in Grecia.",url:"https://www.casanapoli.net/2026/09/14/arianna-milano-12-anni-di-casoria-e-14-ori-nel-sanda-sogna-la-nazionale-aiutiamola-ad-arrivare-in-grecia/"}
];
---
<BaseLayout title="Rassegna stampa | Arianna Milano" description="Articoli, interviste e servizi che raccontano il percorso sportivo di Arianna Milano, atleta di Sanda."><Header/><main class="press" id="main">
<section class="press-hero"><div class="shell press-hero__inner"><p class="eyebrow">Media</p><h1>Rassegna <em>stampa.</em></h1><p class="press-hero__intro">Articoli, interviste e servizi che raccontano il percorso sportivo di Arianna, le competizioni e i suoi prossimi obiettivi.</p></div></section>
<section class="coverage"><div class="shell"><div class="section-head"><p class="eyebrow">Parlano di Arianna</p><h2>Le pubblicazioni</h2><p>La copertura editoriale dedicata ad Arianna, in ordine cronologico. Tocca l'anteprima per ingrandire la pubblicazione.</p></div><div class="press-grid">{articles.map((a,i)=><article class="press-card"><button class="page-preview" type="button" data-preview={i} aria-label={`Ingrandisci anteprima ${a.outlet}`}><span class="browser-bar"><i></i><i></i><i></i><b>{a.outlet}</b></span><span class="page-sheet"><strong class="masthead">{a.outlet}</strong><small>{a.date}</small><span class="preview-title">{a.title}</span><img src={a.image} alt="" loading="lazy" decoding="async"/><span class="preview-lines"></span></span><span class="zoom-label">＋ Ingrandisci</span></button><div class="press-card__body"><div class="press-card__meta"><strong>{a.outlet}</strong><time>{a.date}</time></div><h3>{a.title}</h3><p>{a.excerpt}</p><a class="read-link" href={a.url} target="_blank" rel="noopener noreferrer">Leggi l'articolo →</a></div></article>)}</div></div></section>
<section class="journalist"><div class="shell journalist__inner"><div><p class="eyebrow">Press & media</p><h2>Sei un giornalista?</h2></div><div><p>Per informazioni, materiali, immagini o richieste relative ad Arianna e al suo percorso sportivo, contattaci attraverso i riferimenti ufficiali del sito.</p><a href="/">Torna al sito →</a></div></div></section>
<div class="preview-modal" data-modal hidden><button class="modal-close" type="button" data-close aria-label="Chiudi anteprima">×</button><div class="modal-frame" data-modal-frame></div></div>
</main></BaseLayout>
<script define:vars={{articles}}>
const modal=document.querySelector('[data-modal]'),frame=document.querySelector('[data-modal-frame]');
const close=()=>{if(modal){modal.hidden=true;document.body.style.overflow='';if(frame)frame.innerHTML='';}};
document.querySelectorAll('[data-preview]').forEach(btn=>btn.addEventListener('click',()=>{const a=articles[Number(btn.dataset.preview)];if(!modal||!frame||!a)return;frame.innerHTML=`<div class="zoom-page"><div class="zoom-head">${a.outlet}</div><div class="zoom-date">${a.date}</div><h2>${a.title}</h2><img src="${a.image}" alt="Immagine dell'articolo di ${a.outlet}"><p>${a.excerpt}</p><a href="${a.url}" target="_blank" rel="noopener noreferrer">Apri l'articolo originale →</a></div>`;modal.hidden=false;document.body.style.overflow='hidden';}));
document.querySelector('[data-close]')?.addEventListener('click',close);modal?.addEventListener('click',e=>{if(e.target===modal)close();});document.addEventListener('keydown',e=>{if(e.key==='Escape')close();});
</script>
<style is:global>
:global(body){background:#080706}.press{--gold:#c99736;overflow:hidden}.shell{width:min(1180px,calc(100% - 72px));margin:auto}.eyebrow{display:flex;align-items:center;gap:13px;margin:0 0 18px;color:#c8bba8;font:800 .62rem/1 var(--font-ui);letter-spacing:.28em;text-transform:uppercase}.eyebrow:before{content:"";width:38px;height:2px;background:var(--gold)}.press-hero{min-height:430px;display:flex;align-items:flex-end;background:radial-gradient(circle at 76% 38%,rgba(201,151,54,.15),transparent 27%),linear-gradient(135deg,#050505,#171109);border-bottom:1px solid rgba(201,151,54,.35)}.press-hero__inner{padding:140px 0 64px}.press-hero h1{margin:0;color:#f5efe5;font:500 clamp(4.6rem,8vw,8.4rem)/.85 Georgia,serif;letter-spacing:-.055em}.press-hero h1 em{color:#d5a74c}.press-hero__intro{max-width:620px;margin:24px 0 0;color:#cfc5b8;line-height:1.6}.coverage{padding:78px 0 100px;background:linear-gradient(#f5efe5,#ece2d3);color:#171717}.section-head{display:grid;grid-template-columns:1fr 1.35fr;gap:20px 60px;align-items:end;margin-bottom:44px}.section-head .eyebrow{grid-column:1/-1;color:#6d665d}.section-head h2{margin:0;font:500 clamp(2.9rem,4.5vw,4.8rem)/.92 Georgia,serif}.section-head>p:last-child{margin:0;color:#5b5a56;line-height:1.6}.press-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:30px}.press-card{background:#fffaf2;border:1px solid #d8cfc1;box-shadow:0 14px 34px rgba(31,24,15,.07);overflow:hidden}.page-preview{position:relative;display:block;width:100%;height:340px;padding:0;border:0;background:#d9d5cf;overflow:hidden;cursor:zoom-in;text-align:left}.browser-bar{display:flex;align-items:center;gap:5px;height:26px;padding:0 10px;background:#292929;color:#ddd}.browser-bar i{width:6px;height:6px;border-radius:50%;background:#777}.browser-bar b{margin-left:8px;font:600 .55rem var(--font-ui)}.page-sheet{display:block;width:82%;min-height:390px;margin:13px auto 0;padding:18px 22px;background:white;box-shadow:0 2px 12px #999}.masthead{display:block;padding-bottom:12px;border-bottom:2px solid #222;font:800 1.15rem Georgia,serif}.page-sheet small{display:block;margin:11px 0;color:#777}.preview-title{display:block;font:700 1.12rem/1.15 Georgia,serif}.page-sheet img{display:block;width:100%;height:145px;margin-top:14px;object-fit:cover}.preview-lines{display:block;height:50px;margin-top:12px;background:repeating-linear-gradient(#bbb 0 2px,transparent 2px 9px);opacity:.5}.zoom-label{position:absolute;right:12px;bottom:12px;padding:8px 10px;background:rgba(0,0,0,.78);color:white;font:700 .56rem var(--font-ui);letter-spacing:.08em;text-transform:uppercase}.press-card__body{padding:24px}.press-card__meta{display:flex;justify-content:space-between;gap:10px;padding-bottom:15px;border-bottom:1px solid #ddd}.press-card__meta strong,.press-card__meta time{font:800 .6rem var(--font-ui);letter-spacing:.08em;text-transform:uppercase}.press-card h3{margin:20px 0 12px;font:500 1.55rem/1.1 Georgia,serif}.press-card p{color:#5b5853;font-size:.9rem;line-height:1.58}.read-link{display:inline-block;margin-top:15px;color:#80520e;font:900 .65rem var(--font-ui);letter-spacing:.1em;text-decoration:none;text-transform:uppercase}.journalist{background:#0b0a09;color:#f5efe5}.journalist__inner{display:grid;grid-template-columns:1fr 1fr;gap:80px;padding:72px 0}.journalist h2{margin:0;font:500 clamp(2.8rem,4vw,4.2rem)/.94 Georgia,serif}.journalist__inner>div:last-child{padding-left:44px;border-left:1px solid rgba(201,151,54,.3)}.journalist a{color:#d6aa54}.preview-modal[hidden]{display:none}.preview-modal{position:fixed;z-index:20000;inset:0;display:flex;align-items:flex-start;justify-content:center;padding:70px 20px 30px;background:rgba(0,0,0,.92);overflow:auto}.modal-close{position:fixed;z-index:2;top:16px;right:20px;width:44px;height:44px;border:1px solid #c99736;background:#111;color:white;font-size:2rem;cursor:pointer}.modal-frame{width:min(850px,100%)}.zoom-page{padding:clamp(24px,5vw,60px);background:white;color:#171717;box-shadow:0 20px 80px #000}.zoom-head{padding-bottom:18px;border-bottom:3px solid #171717;font:900 clamp(1.5rem,4vw,2.8rem) Georgia,serif}.zoom-date{margin:20px 0 8px;color:#777;text-transform:uppercase}.zoom-page h2{font:600 clamp(2rem,5vw,4rem)/1.03 Georgia,serif}.zoom-page img{width:100%;max-height:520px;object-fit:contain;background:#eee}.zoom-page p{font-size:1.05rem;line-height:1.65}.zoom-page a{color:#80520e;font-weight:800}
@media(max-width:767px){.shell{width:calc(100% - 32px)}.press-hero{min-height:330px}.press-hero__inner{padding:112px 0 38px}.press-hero h1{font-size:3.15rem}.press-hero__intro{font-size:.86rem}.coverage{padding:42px 0 64px}.section-head{display:block;margin-bottom:26px}.section-head h2{font-size:2.25rem;margin-bottom:13px}.section-head>p:last-child{font-size:.82rem}.press-grid{grid-template-columns:1fr;gap:26px}.page-preview{height:300px}.page-sheet{width:86%;padding:16px}.press-card__body{padding:20px}.press-card h3{font-size:1.5rem}.journalist__inner{grid-template-columns:1fr;gap:24px;padding:48px 0}.journalist__inner>div:last-child{padding:22px 0 0;border:0;border-top:1px solid rgba(201,151,54,.3)}.preview-modal{padding:66px 10px 20px}.zoom-page{padding:22px 18px}.zoom-page h2{font-size:2rem}}
</style>