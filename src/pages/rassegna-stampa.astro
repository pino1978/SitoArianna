---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";

const articles = [
  {
    outlet: "NanoTV",
    date: "16 settembre 2026",
    title: "Arianna Milano: da Casoria al Palamidio Martial Arts Championship in Grecia",
    excerpt: "NanoTV racconta il percorso sportivo di Arianna nel Sanda, dagli inizi nel 2021 alle competizioni e al prossimo appuntamento internazionale di Nafplio.",
    url: "https://www.nanotv.it/2026/09/16/arianna-ha-12-anni-ed-e-di-casoria-pratica-sanda-disciplina-di-combattimento-del-wushu-kung-fu-dal-2021-presso-lasd-kasoria-kombat-fly-dove-e-seguita-dal-maestro-eduardo-mazzara/"
  }
];
---
<BaseLayout title="Rassegna stampa | Arianna Milano" description="Articoli, interviste e servizi che raccontano il percorso sportivo di Arianna Milano, atleta di Sanda.">
  <Header />
  <main class="press" id="main">
    <section class="press-hero" aria-labelledby="press-title">
      <div class="shell press-hero__inner">
        <p class="eyebrow">Media</p>
        <h1 id="press-title">Rassegna<br /><em>stampa.</em></h1>
        <p class="press-hero__intro">Articoli, interviste e servizi che raccontano il percorso sportivo di Arianna, le competizioni e i suoi prossimi obiettivi.</p>
      </div>
    </section>

    <section class="coverage" aria-labelledby="coverage-title">
      <div class="shell">
        <div class="section-head">
          <p class="eyebrow">Parlano di Arianna</p>
          <h2 id="coverage-title">Le pubblicazioni</h2>
          <p>Una raccolta cronologica della copertura editoriale dedicata ad Arianna. Tutte le pubblicazioni hanno lo stesso rilievo e rimandano alla fonte originale.</p>
        </div>
        <div class="press-grid">
          {articles.map((article) => (
            <article class="press-card">
              <div class="press-card__visual" aria-hidden="true"><span>PRESS</span></div>
              <div class="press-card__body">
                <div class="press-card__meta"><strong>{article.outlet}</strong><time>{article.date}</time></div>
                <h3>{article.title}</h3>
                <p>{article.excerpt}</p>
                <a href={article.url} target="_blank" rel="noopener noreferrer" data-interactive>Leggi l'articolo <span aria-hidden="true">→</span><span class="sr-only"> su {article.outlet}, si apre in una nuova scheda</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="journalist" aria-labelledby="journalist-title">
      <div class="shell journalist__inner">
        <div><p class="eyebrow">Press & media</p><h2 id="journalist-title">Sei un giornalista?</h2></div>
        <div><p>Per informazioni, materiali, immagini o richieste relative ad Arianna e al suo percorso sportivo, contattaci attraverso i riferimenti ufficiali del sito.</p><a href="/" data-interactive>Torna al sito <span aria-hidden="true">→</span></a></div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
:global(body){background:#080706;color:#f4eddf}.press{--paper:#f1e9dc;--ink:#0a0908;--gold:#c99736;overflow:hidden}.shell{width:min(1180px,calc(100% - 72px));margin-inline:auto}.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}.eyebrow{display:flex;align-items:center;gap:13px;margin:0 0 18px;color:#c8bba8;font:800 .62rem/1 var(--font-ui);letter-spacing:.28em;text-transform:uppercase}.eyebrow::before{content:"";width:38px;height:2px;background:var(--gold)}
.press-hero{position:relative;min-height:520px;display:flex;align-items:flex-end;background:radial-gradient(circle at 76% 38%,rgba(201,151,54,.15),transparent 27%),linear-gradient(135deg,#050505 0%,#0d0b09 58%,#171109 100%);border-bottom:1px solid rgba(201,151,54,.35)}.press-hero::after{content:"PRESS";position:absolute;right:-.02em;bottom:-.18em;color:rgba(255,255,255,.025);font:900 clamp(10rem,25vw,26rem)/.7 var(--font-ui);letter-spacing:-.08em;pointer-events:none}.press-hero__inner{position:relative;z-index:1;padding:150px 0 76px}.press-hero h1{margin:0;color:#f5efe5;font:500 clamp(4.6rem,8vw,8.4rem)/.78 Georgia,serif;letter-spacing:-.055em}.press-hero h1 em{color:#d5a74c;font-style:italic}.press-hero__intro{max-width:620px;margin:30px 0 0;color:#cfc5b8;font:400 1.05rem/1.65 var(--font-body)}
.coverage{padding:92px 0 110px;background:linear-gradient(180deg,#f5efe5,#ece2d3);color:#171717}.section-head{display:grid;grid-template-columns:1fr 1.35fr;column-gap:60px;align-items:end;margin-bottom:48px}.section-head .eyebrow{grid-column:1/-1;color:#6d665d}.section-head h2{margin:0;font:500 clamp(2.9rem,4.5vw,4.8rem)/.92 Georgia,serif;letter-spacing:-.045em}.section-head>p:last-child{max-width:580px;margin:0;color:#5b5a56;font:400 .98rem/1.65 var(--font-body)}.press-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.press-card{display:flex;flex-direction:column;min-height:100%;background:#fffaf2;border:1px solid rgba(20,18,15,.11);box-shadow:0 14px 34px rgba(31,24,15,.07)}.press-card__visual{aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#14110d,#2b2116);overflow:hidden}.press-card__visual span{color:#d4a44a;font:900 clamp(2.2rem,4vw,4rem)/1 var(--font-ui);letter-spacing:.18em}.press-card__body{display:flex;flex:1;flex-direction:column;padding:24px}.press-card__meta{display:flex;align-items:baseline;justify-content:space-between;gap:14px;padding-bottom:16px;border-bottom:1px solid rgba(20,18,15,.1)}.press-card__meta strong{color:#9a6818;font:900 .69rem/1 var(--font-ui);letter-spacing:.13em;text-transform:uppercase}.press-card__meta time{color:#77716a;font:700 .58rem/1 var(--font-ui);letter-spacing:.07em;text-transform:uppercase}.press-card h3{margin:20px 0 12px;color:#171512;font:500 1.65rem/1.08 Georgia,serif;letter-spacing:-.025em}.press-card p{margin:0;color:#5b5853;font:400 .9rem/1.58 var(--font-body)}.press-card a{display:inline-flex;align-items:center;gap:12px;margin-top:auto;padding-top:24px;color:#80520e;font:900 .65rem/1 var(--font-ui);letter-spacing:.12em;text-decoration:none;text-transform:uppercase}.press-card a:hover{color:#b47a1b}.press-card a:focus-visible,.journalist a:focus-visible{outline:3px solid #c99736;outline-offset:5px}
.journalist{background:#0b0a09;color:#f5efe5;border-top:1px solid rgba(201,151,54,.34)}.journalist__inner{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;padding-top:72px;padding-bottom:72px}.journalist h2{margin:0;font:500 clamp(2.8rem,4vw,4.2rem)/.94 Georgia,serif;letter-spacing:-.04em}.journalist__inner>div:last-child{padding-left:44px;border-left:1px solid rgba(201,151,54,.3)}.journalist__inner>div:last-child p{max-width:520px;margin:0;color:#c8bfb3;font:400 .96rem/1.65 var(--font-body)}.journalist a{display:inline-flex;gap:12px;margin-top:22px;color:#d6aa54;font:900 .65rem/1 var(--font-ui);letter-spacing:.12em;text-decoration:none;text-transform:uppercase}
@media(max-width:1000px){.shell{width:calc(100% - 48px)}.press-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:767px){.shell{width:calc(100% - 32px)}.press-hero{min-height:450px}.press-hero__inner{padding:130px 0 54px}.press-hero h1{font-size:3.9rem}.press-hero__intro{margin-top:22px;font-size:.93rem;line-height:1.55}.coverage{padding:58px 0 70px}.section-head{display:block;margin-bottom:32px}.section-head h2{font-size:2.65rem;margin-bottom:18px}.section-head>p:last-child{font-size:.9rem;line-height:1.55}.press-grid{grid-template-columns:1fr;gap:28px}.press-card__visual{aspect-ratio:16/9}.press-card__body{padding:22px}.press-card h3{font-size:1.65rem}.press-card p{font-size:.9rem}.press-card__meta{align-items:flex-start;flex-direction:column;gap:7px}.journalist__inner{grid-template-columns:1fr;gap:26px;padding-top:52px;padding-bottom:52px}.journalist h2{font-size:2.7rem}.journalist__inner>div:last-child{padding:24px 0 0;border-left:0;border-top:1px solid rgba(201,151,54,.3)}}
</style>
