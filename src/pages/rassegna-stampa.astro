---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";

const articles = [
  { outlet:"NanoTV", domain:"nanotv.it", date:"16 settembre 2026", title:"Arianna ha 12 anni ed è di Casoria. Pratica Sanda, disciplina di combattimento del Wushu Kung Fu", excerpt:"NanoTV racconta il percorso sportivo di Arianna, i risultati raggiunti e i prossimi appuntamenti tra il Palamidio in Grecia e i Campionati Italiani FIWuK.", url:"https://www.nanotv.it/2026/09/16/arianna-ha-12-anni-ed-e-di-casoria-pratica-sanda-disciplina-di-combattimento-del-wushu-kung-fu-dal-2021-presso-lasd-kasoria-kombat-fly-dove-e-seguita-dal-maestro-eduardo-mazzara/" },
  { outlet:"Redazione Prospettive", domain:"redazioneprospettive.it", date:"14 settembre 2026", title:"Da Casoria alla Grecia: Arianna Milano vola al 18° Palamidio Martial Arts Championship", excerpt:"Redazione Prospettive racconta il percorso di Arianna verso il Palamidio e la raccolta fondi avviata per sostenere la trasferta in Grecia.", url:"https://www.redazioneprospettive.it/da-casoria-alla-grecia-arianna-milano-vola-al-18-palamidio-martial-arts-championship-aperta-una-raccolta-fondi-per-sostenere-la-giovane-campionessa-di-sanda/" },
  { outlet:"Frattamaggiore News", domain:"frattamaggiorenews.com", date:"14 settembre 2026", title:"Da Casoria alla Grecia: Arianna Milano al Palamidio 2026", excerpt:"Frattamaggiore News dedica un articolo al percorso sportivo di Arianna e alla partecipazione al Palamidio 2026 di Nafplio.", url:"https://www.frattamaggiorenews.com/2026/09/14/da-casoria-alla-grecia-arianna-milano-al-palamidio-2026/" },
  { outlet:"CasaNapoli.net", domain:"casanapoli.net", date:"14 settembre 2026", title:"Arianna Milano, 12 anni di Casoria e 14 ori nel Sanda: sogna la Nazionale, aiutiamola ad arrivare in Grecia", excerpt:"CasaNapoli racconta i risultati ottenuti da Arianna nel Sanda e il prossimo appuntamento internazionale in Grecia.", url:"https://www.casanapoli.net/2026/09/14/arianna-milano-12-anni-di-casoria-e-14-ori-nel-sanda-sogna-la-nazionale-aiutiamola-ad-arrivare-in-grecia/" }
];
---
<BaseLayout title="Rassegna stampa | Arianna Milano" description="Articoli, interviste e servizi che raccontano il percorso sportivo di Arianna Milano, atleta di Sanda.">
<Header />
<main class="press" id="main">
<section class="press-hero" aria-labelledby="press-title"><img class="press-hero__image" src="/images/hero_rasegna_stampa.png" alt="Rassegna stampa di Arianna Milano, giovane atleta di Sanda" width="1774" height="887" fetchpriority="high" decoding="async"/><h1 id="press-title" class="sr-only">Rassegna stampa</h1></section>
<section class="coverage" aria-labelledby="coverage-title"><div class="shell"><div class="section-head"><p class="eyebrow">Parlano di Arianna</p><h2 id="coverage-title">Le pubblicazioni</h2><p>La copertura editoriale dedicata ad Arianna, in ordine cronologico. Ogni pubblicazione rimanda alla fonte originale.</p></div><div class="press-grid">{articles.map(article=><article class="press-card"><a class="press-card__brand" href={article.url} target="_blank" rel="noopener noreferrer" aria-label={`Apri l'articolo di ${article.outlet}`}><img src={`https://www.google.com/s2/favicons?domain=${article.domain}&sz=256`} alt="" width="96" height="96" loading="lazy" decoding="async"/><strong>{article.outlet}</strong><small>{article.domain}</small></a><div class="press-card__body"><div class="press-card__meta"><time>{article.date}</time></div><h3>{article.title}</h3><p>{article.excerpt}</p><a class="read-link" href={article.url} target="_blank" rel="noopener noreferrer" data-interactive>Leggi l'articolo <span aria-hidden="true">→</span><span class="sr-only"> su {article.outlet}, si apre in una nuova scheda</span></a></div></article>)}</div></div></section>
<section class="journalist" aria-labelledby="journalist-title"><div class="shell journalist__inner"><div><p class="eyebrow">Press & media</p><h2 id="journalist-title">Sei un giornalista?</h2></div><div><p>Per informazioni, materiali, immagini o richieste relative ad Arianna e al suo percorso sportivo, contattaci attraverso i riferimenti ufficiali del sito.</p><a href="/" data-interactive>Torna al sito <span aria-hidden="true">→</span></a></div></div></section>
</main>
</BaseLayout>
<style>
:global(body){background:#080706;color:#f4eddf}.press{--gold:#c99736;overflow:hidden}.shell{width:min(1180px,calc(100% - 72px));margin-inline:auto}.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}.eyebrow{display:flex;align-items:center;gap:13px;margin:0 0 12px;color:#c8bba8;font:800 .58rem/1 var(--font-ui);letter-spacing:.25em;text-transform:uppercase}.eyebrow::before{content:"";width:34px;height:2px;background:var(--gold)}
.press-hero{position:relative;width:100%;height:35vw;max-height:621px;min-height:280px;overflow:hidden;background:#080706;border-bottom:1px solid rgba(201,151,54,.35)}.press-hero__image{display:block;width:100%;height:100%;object-fit:cover;object-position:center 50%;background:#080706}
.coverage{padding:38px 0 78px;background:linear-gradient(180deg,#f5efe5,#ece2d3);color:#171717}.section-head{display:grid;grid-template-columns:1fr 1.35fr;column-gap:48px;align-items:end;margin-bottom:30px}.section-head .eyebrow{grid-column:1/-1;color:#6d665d}.section-head h2{margin:0;font:500 clamp(2.25rem,3.5vw,3.65rem)/.94 Georgia,serif;letter-spacing:-.04em}.section-head>p:last-child{max-width:560px;margin:0;color:#5b5a56;font:400 .91rem/1.58 var(--font-body)}.press-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.press-card{display:flex;flex-direction:column;min-height:100%;background:#fffaf2;border:1px solid rgba(20,18,15,.11);box-shadow:0 14px 34px rgba(31,24,15,.07);overflow:hidden}.press-card__brand{display:flex;min-height:185px;flex-direction:column;align-items:center;justify-content:center;padding:24px 20px;background:linear-gradient(145deg,#11100e,#211a12);text-align:center;text-decoration:none}.press-card__brand img{width:72px;height:72px;object-fit:contain;margin-bottom:15px;border-radius:16px;box-shadow:0 8px 24px rgba(0,0,0,.25)}.press-card__brand strong{color:#f5efe5;font:800 1.14rem/1.15 var(--font-ui);letter-spacing:.02em}.press-card__brand small{margin-top:7px;color:#b9aa95;font:700 .55rem/1 var(--font-ui);letter-spacing:.11em;text-transform:uppercase}.press-card__brand:hover strong{color:#d5a74c}.press-card__body{display:flex;flex:1;flex-direction:column;padding:22px}.press-card__meta{padding:0 0 13px;border-bottom:1px solid rgba(20,18,15,.1)}.press-card__meta time{color:#77716a;font:700 .55rem/1 var(--font-ui);letter-spacing:.07em;text-transform:uppercase}.press-card h3{margin:17px 0 10px;color:#171512;font:500 1.3rem/1.12 Georgia,serif;letter-spacing:-.02em}.press-card p{margin:0;color:#5b5853;font:400 .84rem/1.52 var(--font-body)}.read-link{display:inline-flex;align-items:center;gap:12px;margin-top:auto;padding-top:20px;color:#80520e;font:900 .61rem/1 var(--font-ui);letter-spacing:.11em;text-decoration:none;text-transform:uppercase}.read-link:hover{color:#b47a1b}.press-card a:focus-visible,.journalist a:focus-visible{outline:3px solid #c99736;outline-offset:4px}
.journalist{background:#0b0a09;color:#f5efe5;border-top:1px solid rgba(201,151,54,.34)}.journalist__inner{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;padding-top:72px;padding-bottom:72px}.journalist h2{margin:0;font:500 clamp(2.8rem,4vw,4.2rem)/.94 Georgia,serif;letter-spacing:-.04em}.journalist__inner>div:last-child{padding-left:44px;border-left:1px solid rgba(201,151,54,.3)}.journalist__inner>div:last-child p{max-width:520px;margin:0;color:#c8bfb3;font:400 .96rem/1.65 var(--font-body)}.journalist a{display:inline-flex;gap:12px;margin-top:22px;color:#d6aa54;font:900 .65rem/1 var(--font-ui);letter-spacing:.12em;text-decoration:none;text-transform:uppercase}
@media(max-width:1000px){.shell{width:calc(100% - 48px)}.press-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.press-hero{height:35vw;min-height:230px}}
@media(max-width:767px){.shell{width:calc(100% - 32px)}.press-hero{height:42vw;min-height:190px;max-height:320px}.press-hero__image{object-fit:cover;object-position:center 50%}.coverage{padding:28px 0 56px}.section-head{display:block;margin-bottom:22px}.section-head .eyebrow{margin-bottom:10px}.section-head h2{font-size:1.95rem;line-height:.98;margin-bottom:11px}.section-head>p:last-child{max-width:100%;font-size:.79rem;line-height:1.45;letter-spacing:0}.press-grid{grid-template-columns:1fr;gap:22px}.press-card__brand{min-height:155px;padding:20px 18px}.press-card__brand img{width:62px;height:62px;margin-bottom:12px;border-radius:13px}.press-card__brand strong{font-size:1.05rem}.press-card__body{padding:18px}.press-card h3{margin-top:14px;font-size:1.25rem;line-height:1.1}.press-card p{font-size:.82rem;line-height:1.48}.read-link{padding-top:18px}.journalist__inner{grid-template-columns:1fr;gap:24px;padding-top:48px;padding-bottom:48px}.journalist h2{font-size:2.5rem}.journalist__inner>div:last-child{padding:22px 0 0;border-left:0;border-top:1px solid rgba(201,151,54,.3)}}
</style>