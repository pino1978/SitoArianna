---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";

const articles = [
  { outlet:"NanoTV", mark:"NANO TV", date:"16 settembre 2026", title:"Arianna ha 12 anni ed è di Casoria. Pratica Sanda, disciplina di combattimento del Wushu Kung Fu", excerpt:"NanoTV racconta il percorso sportivo di Arianna, i risultati raggiunti e i prossimi appuntamenti tra il Palamidio in Grecia e i Campionati Italiani FIWuK.", url:"https://www.nanotv.it/2026/09/16/arianna-ha-12-anni-ed-e-di-casoria-pratica-sanda-disciplina-di-combattimento-del-wushu-kung-fu-dal-2021-presso-lasd-kasoria-kombat-fly-dove-e-seguita-dal-maestro-eduardo-mazzara/" },
  { outlet:"Redazione Prospettive", mark:"PROSPETTIVE", date:"14 settembre 2026", title:"Da Casoria alla Grecia: Arianna Milano vola al 18° Palamidio Martial Arts Championship", excerpt:"Redazione Prospettive racconta il percorso di Arianna verso il Palamidio e la raccolta fondi avviata per sostenere la trasferta in Grecia.", url:"https://www.redazioneprospettive.it/da-casoria-alla-grecia-arianna-milano-vola-al-18-palamidio-martial-arts-championship-aperta-una-raccolta-fondi-per-sostenere-la-giovane-campionessa-di-sanda/" },
  { outlet:"Frattamaggiore News", mark:"FRATTAMAGGIORE NEWS", date:"14 settembre 2026", title:"Da Casoria alla Grecia: Arianna Milano al Palamidio 2026", excerpt:"Frattamaggiore News dedica un articolo al percorso sportivo di Arianna e alla partecipazione al Palamidio 2026 di Nafplio.", url:"https://www.frattamaggiorenews.com/2026/09/14/da-casoria-alla-grecia-arianna-milano-al-palamidio-2026/" },
  { outlet:"CasaNapoli.net", mark:"CASANAPOLI.NET", date:"14 settembre 2026", title:"Arianna Milano, 12 anni di Casoria e 14 ori nel Sanda: sogna la Nazionale, aiutiamola ad arrivare in Grecia", excerpt:"CasaNapoli racconta i risultati ottenuti da Arianna nel Sanda e il prossimo appuntamento internazionale in Grecia.", url:"https://www.casanapoli.net/2026/09/14/arianna-milano-12-anni-di-casoria-e-14-ori-nel-sanda-sogna-la-nazionale-aiutiamola-ad-arrivare-in-grecia/" }
];
---
<BaseLayout title="Rassegna stampa | Arianna Milano" description="Articoli, interviste e servizi che raccontano il percorso sportivo di Arianna Milano, atleta di Sanda.">
<Header />
<main class="press" id="main">
<section class="press-hero" aria-labelledby="press-title"><div class="shell press-hero__inner"><p class="eyebrow">Media</p><h1 id="press-title">Rassegna <em>stampa.</em></h1><p class="press-hero__intro">Articoli, interviste e servizi che raccontano il percorso sportivo di Arianna, le competizioni e i suoi prossimi obiettivi.</p></div></section>
<section class="coverage" aria-labelledby="coverage-title"><div class="shell"><div class="section-head"><p class="eyebrow">Parlano di Arianna</p><h2 id="coverage-title">Le pubblicazioni</h2><p>La copertura editoriale dedicata ad Arianna, in ordine cronologico. Ogni pubblicazione rimanda alla fonte originale.</p></div><div class="press-grid">{articles.map(article=><article class="press-card"><a class="press-card__visual" href={article.url} target="_blank" rel="noopener noreferrer" aria-label={`Apri l'articolo di ${article.outlet}`}><div class="article-photo"><span class="photo-name">ARIANNA</span><span class="photo-sport">SANDA · ROAD TO GREECE</span></div></a><div class="press-card__body"><div class="outlet-logo" aria-label={article.outlet}>{article.mark}</div><div class="press-card__meta"><time>{article.date}</time></div><h3>{article.title}</h3><p>{article.excerpt}</p><a class="read-link" href={article.url} target="_blank" rel="noopener noreferrer" data-interactive>Leggi l'articolo <span aria-hidden="true">→</span><span class="sr-only"> su {article.outlet}, si apre in una nuova scheda</span></a></div></article>)}</div></div></section>
<section class="journalist" aria-labelledby="journalist-title"><div class="shell journalist__inner"><div><p class="eyebrow">Press & media</p><h2 id="journalist-title">Sei un giornalista?</h2></div><div><p>Per informazioni, materiali, immagini o richieste relative ad Arianna e al suo percorso sportivo, contattaci attraverso i riferimenti ufficiali del sito.</p><a href="/" data-interactive>Torna al sito <span aria-hidden="true">→</span></a></div></div></section>
</main>
</BaseLayout>
<style>
:global(body){background:#080706;color:#f4eddf}.press{--gold:#c99736;overflow:hidden}.shell{width:min(1180px,calc(100% - 72px));margin-inline:auto}.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}.eyebrow{display:flex;align-items:center;gap:13px;margin:0 0 18px;color:#c8bba8;font:800 .62rem/1 var(--font-ui);letter-spacing:.28em;text-transform:uppercase}.eyebrow::before{content:"";width:38px;height:2px;background:var(--gold)}
.press-hero{position:relative;min-height:430px;display:flex;align-items:flex-end;background:radial-gradient(circle at 76% 38%,rgba(201,151,54,.15),transparent 27%),linear-gradient(135deg,#050505 0%,#0d0b09 58%,#171109 100%);border-bottom:1px solid rgba(201,151,54,.35)}.press-hero::after{content:"PRESS";position:absolute;right:-.02em;bottom:-.18em;color:rgba(255,255,255,.025);font:900 clamp(10rem,25vw,26rem)/.7 var(--font-ui);letter-spacing:-.08em;pointer-events:none}.press-hero__inner{position:relative;z-index:1;padding:140px 0 64px}.press-hero h1{margin:0;color:#f5efe5;font:500 clamp(4.6rem,8vw,8.4rem)/.85 Georgia,serif;letter-spacing:-.055em}.press-hero h1 em{color:#d5a74c;font-style:italic}.press-hero__intro{max-width:620px;margin:24px 0 0;color:#cfc5b8;font:400 1.05rem/1.6 var(--font-body)}
.coverage{padding:78px 0 100px;background:linear-gradient(180deg,#f5efe5,#ece2d3);color:#171717}.section-head{display:grid;grid-template-columns:1fr 1.35fr;column-gap:60px;align-items:end;margin-bottom:44px}.section-head .eyebrow{grid-column:1/-1;color:#6d665d}.section-head h2{margin:0;font:500 clamp(2.9rem,4.5vw,4.8rem)/.92 Georgia,serif;letter-spacing:-.045em}.section-head>p:last-child{max-width:580px;margin:0;color:#5b5a56;font:400 .98rem/1.65 var(--font-body)}.press-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.press-card{display:flex;flex-direction:column;min-height:100%;background:#fffaf2;border:1px solid rgba(20,18,15,.11);box-shadow:0 14px 34px rgba(31,24,15,.07);overflow:hidden}.press-card__visual{display:block;aspect-ratio:16/9;text-decoration:none;overflow:hidden;background:#15110d}.article-photo{position:relative;width:100%;height:100%;background:radial-gradient(circle at 68% 28%,rgba(213,167,76,.27),transparent 22%),linear-gradient(125deg,#090807 0%,#241b11 52%,#080706 100%)}.article-photo::before{content:"鹰";position:absolute;right:7%;bottom:-13%;color:rgba(255,255,255,.08);font:700 10rem/1 Georgia,serif}.article-photo::after{content:"";position:absolute;left:8%;top:12%;bottom:12%;width:2px;background:#c99736}.photo-name,.photo-sport{position:absolute;left:13%;z-index:1}.photo-name{bottom:30%;color:#f4eddf;font:800 clamp(1.8rem,3vw,3rem)/1 var(--font-ui);letter-spacing:.12em}.photo-sport{bottom:19%;color:#d5a74c;font:800 .55rem/1 var(--font-ui);letter-spacing:.2em}.press-card__body{display:flex;flex:1;flex-direction:column;padding:24px}.outlet-logo{display:inline-flex;align-self:flex-start;min-height:30px;align-items:center;color:#171512;font:900 .82rem/1 var(--font-ui);letter-spacing:.06em}.press-card__meta{padding:7px 0 15px;border-bottom:1px solid rgba(20,18,15,.1)}.press-card__meta time{color:#77716a;font:700 .58rem/1 var(--font-ui);letter-spacing:.07em;text-transform:uppercase}.press-card h3{margin:20px 0 12px;color:#171512;font:500 1.55rem/1.1 Georgia,serif;letter-spacing:-.025em}.press-card p{margin:0;color:#5b5853;font:400 .9rem/1.58 var(--font-body)}.read-link{display:inline-flex;align-items:center;gap:12px;margin-top:auto;padding-top:24px;color:#80520e;font:900 .65rem/1 var(--font-ui);letter-spacing:.12em;text-decoration:none;text-transform:uppercase}.read-link:hover{color:#b47a1b}.press-card a:focus-visible,.journalist a:focus-visible{outline:3px solid #c99736;outline-offset:4px}
.journalist{background:#0b0a09;color:#f5efe5;border-top:1px solid rgba(201,151,54,.34)}.journalist__inner{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;padding-top:72px;padding-bottom:72px}.journalist h2{margin:0;font:500 clamp(2.8rem,4vw,4.2rem)/.94 Georgia,serif;letter-spacing:-.04em}.journalist__inner>div:last-child{padding-left:44px;border-left:1px solid rgba(201,151,54,.3)}.journalist__inner>div:last-child p{max-width:520px;margin:0;color:#c8bfb3;font:400 .96rem/1.65 var(--font-body)}.journalist a{display:inline-flex;gap:12px;margin-top:22px;color:#d6aa54;font:900 .65rem/1 var(--font-ui);letter-spacing:.12em;text-decoration:none;text-transform:uppercase}
@media(max-width:1000px){.shell{width:calc(100% - 48px)}.press-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:767px){.shell{width:calc(100% - 32px)}.press-hero{min-height:330px}.press-hero__inner{padding:112px 0 38px}.press-hero .eyebrow{margin-bottom:12px}.press-hero h1{font-size:3.15rem;line-height:.9}.press-hero__intro{max-width:94%;margin-top:16px;font-size:.86rem;line-height:1.48}.coverage{padding:42px 0 64px}.section-head{display:block;margin-bottom:26px}.section-head .eyebrow{margin-bottom:12px}.section-head h2{font-size:2.25rem;line-height:.95;margin-bottom:13px}.section-head>p:last-child{max-width:100%;font-size:.82rem;line-height:1.48;letter-spacing:0}.press-grid{grid-template-columns:1fr;gap:26px}.press-card__visual{aspect-ratio:16/9}.press-card__body{padding:20px}.outlet-logo{min-height:25px;font-size:.78rem}.press-card__meta{padding-top:5px;padding-bottom:12px}.press-card h3{margin-top:16px;font-size:1.5rem;line-height:1.08}.press-card p{font-size:.86rem;line-height:1.5}.read-link{padding-top:20px}.journalist__inner{grid-template-columns:1fr;gap:24px;padding-top:48px;padding-bottom:48px}.journalist h2{font-size:2.5rem}.journalist__inner>div:last-child{padding:22px 0 0;border-left:0;border-top:1px solid rgba(201,151,54,.3)}}
</style>