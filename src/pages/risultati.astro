---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import StatsStrip from "../components/StatsStrip.astro";
import results from "../data/results.json";

const years = [...results.resultsByYear].map(x => x.year).sort((a,b)=>b-a);
const disciplines = [...new Set(results.resultsByYear.flatMap(y => y.competitions.flatMap(c => c.results.map(r => r.discipline))))].sort();
const rows = results.resultsByYear.flatMap(y => y.competitions.flatMap(c => c.results.map((r,i) => ({year:y.year,event:c.event,place:c.place||"—",discipline:r.discipline,medal:r.medal,key:`${y.year}-${c.event}-${i}`})))).sort((a,b)=>b.year-a.year);
const medalName = {gold:"Oro",silver:"Argento",bronze:"Bronzo"};
---
<BaseLayout title="Palmarès | Arianna Milano" description="Risultati agonistici di Arianna Milano: competizioni, piazzamenti e medaglie nel Sanda e Kung Fu sportivo.">
<main id="main" class="palmares">
<section class="hero"><Header /><img class="hero-bg" src="/images/file_0000000018808210aee456d67f26cba1.png?v=2" alt="" aria-hidden="true" decoding="async" fetchpriority="high" loading="eager" /><div class="hero-shade" aria-hidden="true"></div><div class="hero-inner"><div class="hero-copy-wrap"><span class="hero-kicker">Palmarès agonistico</span><h1>Risultati</h1><div class="hero-rule" aria-hidden="true"></div><h2>Ogni gara lascia qualcosa.</h2><p>Competizioni, piazzamenti e medaglie raccontano una crescita costruita con allenamento, disciplina e continuità.</p></div></div></section>
<section class="content"><div class="home-stats"><StatsStrip stats={results.heroStats} /></div><div class="filters"><div class="year-tabs"><button class="active" data-year="all">Tutti</button>{years.map(y => <button data-year={y}>{y}</button>)}</div><div class="selects"><select data-discipline aria-label="Disciplina"><option value="all">Disciplina</option>{disciplines.map(d=><option value={d}>{d}</option>)}</select><select data-medal aria-label="Medaglia"><option value="all">Medaglia</option><option value="gold">Oro</option><option value="silver">Argento</option><option value="bronze">Bronzo</option></select><select data-place aria-label="Luogo"><option value="all">Luogo</option>{[...new Set(rows.map(r=>r.place).filter(p=>p!=="—"))].sort().map(p=><option value={p}>{p}</option>)}</select></div><button class="reset" data-reset>↻&nbsp; Reset</button></div><div class="table-wrap"><div class="table-head"><span>Anno</span><span>Competizione</span><span>Luogo</span><span>Disciplina</span><span>Risultato</span><span>Medaglia</span><span>Note</span><span></span></div><div class="table-body">{rows.map(r => <div class="result-row" data-row data-year={r.year} data-discipline={r.discipline} data-medal={r.medal} data-place={r.place}><span>{r.year}</span><strong>{r.event}</strong><span>{r.place}</span><span>{r.discipline}</span><span>1°</span><span class:list={["medal",r.medal]}><i></i>{medalName[r.medal]||r.medal}</span><span>—</span><span class="arrow">→</span></div>)}</div></div><div class="below">Mostrati <b data-count>{rows.length}</b> risultati</div></section>
</main>
<script>
const root=document.querySelector('.palmares');if(root){const tabs=[...root.querySelectorAll('[data-year]')],d=root.querySelector('[data-discipline]'),m=root.querySelector('[data-medal]'),p=root.querySelector('[data-place]'),reset=root.querySelector('[data-reset]'),count=root.querySelector('[data-count]');let year='all';const apply=()=>{let n=0;root.querySelectorAll('[data-row]').forEach(r=>{const show=(year==='all'||r.dataset.year===year)&&(d.value==='all'||r.dataset.discipline===d.value)&&(m.value==='all'||r.dataset.medal===m.value)&&(p.value==='all'||r.dataset.place===p.value);r.hidden=!show;if(show)n++});count.textContent=n;tabs.forEach(t=>t.classList.toggle('active',t.dataset.year===year))};tabs.forEach(t=>t.addEventListener('click',()=>{year=t.dataset.year;apply()}));[d,m,p].forEach(x=>x.addEventListener('change',apply));reset.addEventListener('click',()=>{year='all';d.value=m.value=p.value='all';apply()})}
</script>
<style>
:global(body){background:#030404}.palmares{--gold:#d4a64d;--gold2:#f0c875;color:#f4efe7;background:#030404;min-height:100vh}.hero{position:relative;height:650px;overflow:hidden;background:#050606}.hero :global(header){position:relative;z-index:20}.hero-bg{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;object-fit:cover!important;object-position:58% center;opacity:1!important;visibility:visible!important;display:block!important;z-index:0!important}.hero-shade{position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(3,4,4,.86) 0%,rgba(3,4,4,.64) 28%,rgba(3,4,4,.20) 52%,rgba(3,4,4,0) 82%),linear-gradient(0deg,rgba(3,4,4,.34),transparent 50%)}.hero-inner{position:relative;z-index:5;max-width:1180px;height:570px;margin:auto;padding:20px 24px;display:flex;align-items:center}.hero-copy-wrap{max-width:610px}.hero-kicker{display:block;margin-bottom:16px;color:#d8b66e;font:700 .74rem/1 var(--font-ui);letter-spacing:.28em;text-transform:uppercase}.hero h1{margin:0;font:650 clamp(4.6rem,8vw,7.8rem)/.82 var(--font-display);letter-spacing:-.035em;text-transform:uppercase;color:#f5f0e8;text-shadow:0 3px 28px #000}.hero-rule{width:72px;height:2px;margin:28px 0 22px;background:var(--gold2)}.hero h2{margin:0 0 12px;font:400 clamp(1.6rem,2.6vw,2.6rem)/1.1 var(--font-display);color:#f4efe7}.hero p{max-width:490px;margin:0;color:#d7d0c5;font:400 1rem/1.55 var(--font-ui)}.content{max-width:1180px;margin:0 auto;padding:0 24px 32px;position:relative;z-index:10}.home-stats{margin:0}.home-stats :global(.stats-strip){margin:0!important}.filters{display:grid;grid-template-columns:auto 1fr auto;gap:20px;align-items:center;padding:18px 0 16px}.year-tabs,.selects{display:flex;gap:5px}.filters button,.filters select{height:44px;border:1px solid #15191a;border-radius:5px;background:#111516;color:#d5d0c8;padding:0 17px;font:600 .75rem var(--font-ui);cursor:pointer}.year-tabs button.active{border-color:#e0b45e;background:linear-gradient(#f3cd7c,#d9a94f);color:#090909}.selects{justify-content:center}.selects select{min-width:130px}.reset{border-color:#4a4030!important;background:#050606!important;color:#e4b75e!important}.table-wrap{border:1px solid #171b1c;border-radius:6px;overflow:hidden;background:#080a0b}.table-head,.result-row{display:grid;grid-template-columns:.75fr 1.65fr .85fr 1.1fr .62fr .85fr .45fr 32px;gap:14px;align-items:center}.table-head{min-height:46px;padding:0 15px;border-bottom:1px solid #242829;color:#9da09f;font:700 .65rem var(--font-ui);letter-spacing:.06em;text-transform:uppercase}.result-row{min-height:58px;padding:0 15px;border-bottom:1px solid #171a1b;color:#d4d2cd;font-size:.9rem}.result-row:nth-child(even){background:#0b0e0f}.result-row strong{color:#f0ede7}.medal{display:flex;align-items:center;gap:8px;font-weight:650}.medal i{width:16px;height:16px;border-radius:50%;background:#777}.medal.gold{color:#e8b854}.medal.gold i{background:radial-gradient(circle at 35% 30%,#f7d989,#b98227)}.medal.silver{color:#d2d2d2}.medal.silver i{background:radial-gradient(circle at 35% 30%,#fff,#8d9295)}.arrow{display:grid;width:26px;height:26px;place-items:center;border:1px solid #a67c2c;border-radius:50%;color:#e6b653}.below{padding:18px 0;color:#777b7a;font-size:.75rem}[hidden]{display:none!important}
@media(max-width:820px){.hero{height:560px}.hero-bg{object-position:68% center}.hero-shade{background:linear-gradient(90deg,rgba(3,4,4,.76) 0%,rgba(3,4,4,.42) 46%,rgba(3,4,4,.03) 100%),linear-gradient(0deg,rgba(3,4,4,.30),transparent 62%)}.hero-inner{height:480px;padding:26px 20px;align-items:center}.hero-copy-wrap{max-width:390px}.hero h1{font-size:4.2rem}.hero h2{font-size:1.6rem}.content{padding-inline:14px}.filters{grid-template-columns:1fr}.year-tabs{overflow-x:auto}.selects{justify-content:stretch}.selects select{min-width:0;width:100%}.reset{justify-self:start}.table-wrap{overflow-x:auto}.table-head,.result-row{min-width:930px}}
@media(max-width:640px){.hero{height:520px}.hero-bg{object-position:72% center}.hero-shade{background:linear-gradient(90deg,rgba(3,4,4,.68) 0%,rgba(3,4,4,.34) 44%,rgba(3,4,4,0) 100%),linear-gradient(0deg,rgba(3,4,4,.26),transparent 68%)}.hero-inner{height:440px;padding:32px 18px 18px;align-items:center}.hero-copy-wrap{max-width:310px}.hero-kicker{font-size:.64rem;margin-bottom:12px}.hero h1{font-size:3.55rem}.hero-rule{margin:20px 0 16px;width:54px}.hero h2{font-size:1.38rem}.hero p{font-size:.86rem;line-height:1.45;max-width:285px}.home-stats{position:relative;height:110px}}
@media(max-width:520px){.hero{height:500px}.hero-bg{object-position:74% center}.hero-inner{height:420px;padding:28px 18px 16px}.hero h1{font-size:3.25rem}.selects{display:grid;grid-template-columns:1fr 1fr}.selects select:last-child{grid-column:1/-1}}
@media(max-width:820px){
  .palmares .hero{height:360px!important;min-height:0!important;max-height:360px!important}
  .palmares .hero-bg{height:360px!important;min-height:0!important;max-height:360px!important;object-fit:cover!important;object-position:70% center!important}
  .palmares .hero-inner{height:280px!important;min-height:0!important;max-height:280px!important;padding:12px 18px!important;align-items:center!important}
  .palmares .hero-copy-wrap{max-width:300px!important}
  .palmares .hero-kicker{font-size:.6rem!important;margin-bottom:8px!important}
  .palmares .hero h1{font-size:3.05rem!important}
  .palmares .hero-rule{margin:12px 0 10px!important;width:48px!important}
  .palmares .hero h2{font-size:1.2rem!important;margin-bottom:7px!important}
  .palmares .hero p{font-size:.78rem!important;line-height:1.38!important;max-width:270px!important}
}
@media(max-width:520px){
  .palmares .hero{height:340px!important;max-height:340px!important}
  .palmares .hero-bg{height:340px!important;max-height:340px!important;object-position:72% center!important}
  .palmares .hero-inner{height:260px!important;max-height:260px!important;padding:10px 16px!important}
  .palmares .hero h1{font-size:2.85rem!important}
}
</style>
</BaseLayout>