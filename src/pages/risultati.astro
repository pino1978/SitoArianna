---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import results from "../data/results.json";
const medalLabel={gold:"Oro",silver:"Argento",bronze:"Bronzo",placement:"Piazzamento"};
---
<BaseLayout title="Palmarès | Arianna Milano" description="Timeline del palmarès agonistico di Arianna Milano: competizioni, discipline e medaglie.">
<main id="main" class="palmares-page">
  <section class="page-hero"><Header/><div><p class="eyebrow">Percorso agonistico</p><h1>Palmarès</h1><p>Una timeline essenziale delle competizioni e dei risultati che segnano la crescita sportiva.</p></div></section>
  <section class="medal-summary" aria-label="Medagliere"><div><strong>{results.medalSummary.gold}</strong><span>Ori</span></div><div><strong>{results.medalSummary.silver}</strong><span>Argenti</span></div><div><strong>{results.medalSummary.total}</strong><span>Medaglie</span></div><div><strong>{results.heroStats.find(x=>x.id==='competitions')?.value}</strong><span>Competizioni</span></div></section>
  <section class="palmares-timeline" aria-labelledby="timeline-title"><header><p class="eyebrow">Dal tatami</p><h2 id="timeline-title">La crescita,<br/><em>anno dopo anno.</em></h2></header>
    <div class="timeline-years">{[...results.resultsByYear].reverse().map(group=><article class="timeline-year"><div class="year-rail"><strong>{group.year}</strong><span>{group.totals.gold} ori{group.totals.silver?` · ${group.totals.silver} argento`:''}</span></div><div class="year-events">{group.competitions.map(comp=><section class="event"><div class="event-head"><h3>{comp.event}</h3>{comp.place&&<p>{comp.place}</p>}</div><div class="event-results">{comp.results.map(r=><div class:list={["result-row",`is-${r.medal}`]}><span class="medal-dot" aria-hidden="true"></span><strong>{r.discipline}</strong><span>{medalLabel[r.medal]??r.medal}</span></div>)}</div></section>)}</div></article>)}</div>
  </section>
</main>
<style>
.palmares-page{background:#080706;color:#f5f0e7}.page-hero{position:relative;min-height:390px;padding:145px max(28px,calc((100vw - 1160px)/2)) 64px;background:radial-gradient(circle at 78% 22%,rgba(185,134,50,.13),transparent 28%),linear-gradient(135deg,#070706,#15110d)}.page-hero .site-header{position:absolute;top:0;left:50%;transform:translateX(-50%)}.page-hero>div{max-width:760px}.eyebrow{margin:0;color:var(--gold-bright);font:800 .68rem var(--font-ui);letter-spacing:.17em;text-transform:uppercase}.page-hero h1,.palmares-timeline h2{margin:.15em 0;font-family:var(--font-display);text-transform:uppercase;line-height:.9}.page-hero h1{font-size:clamp(4rem,9vw,8rem)}.page-hero>div>p:last-child{max-width:620px;color:#cfc6b8;font-size:1.05rem;line-height:1.6}.medal-summary{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid rgba(185,134,50,.32);background:#0a0908}.medal-summary div{padding:26px;text-align:center;border-right:1px solid rgba(185,134,50,.2)}.medal-summary div:last-child{border:0}.medal-summary strong{display:block;color:#fff;font:800 clamp(2rem,4vw,3.5rem) var(--font-ui)}.medal-summary span{color:var(--gold-bright);font:800 .62rem var(--font-ui);letter-spacing:.14em;text-transform:uppercase}.palmares-timeline{padding:84px max(28px,calc((100vw - 1160px)/2)) 110px}.palmares-timeline>header{margin-bottom:56px}.palmares-timeline h2{font-size:clamp(2.7rem,6vw,5.8rem)}.palmares-timeline h2 em{color:var(--gold-bright);font-style:normal}.timeline-year{display:grid;grid-template-columns:190px 1fr;border-top:1px solid rgba(185,134,50,.3)}.year-rail{position:relative;padding:32px 28px 32px 0}.year-rail::after{position:absolute;top:0;right:0;width:1px;height:100%;background:linear-gradient(#b98632,rgba(185,134,50,.12));content:""}.year-rail strong{display:block;color:var(--gold-bright);font:800 2.5rem var(--font-display)}.year-rail span{font:700 .6rem var(--font-ui);letter-spacing:.1em;text-transform:uppercase;color:#9e9588}.year-events{padding:18px 0 34px 36px}.event{display:grid;grid-template-columns:minmax(220px,1.15fr) 1fr;gap:28px;padding:20px 0;border-bottom:1px solid rgba(245,240,231,.09)}.event:last-child{border-bottom:0}.event h3{margin:0;color:#f5f0e7;font:800 1.15rem/1.1 var(--font-display);text-transform:uppercase}.event-head p{margin:7px 0 0;color:#8f877c;font-size:.76rem}.event-results{display:grid;gap:7px}.result-row{display:grid;grid-template-columns:10px 1fr auto;gap:10px;align-items:center;font:700 .69rem var(--font-ui);letter-spacing:.04em}.result-row>span:last-child{font-size:.61rem;text-transform:uppercase;letter-spacing:.12em}.medal-dot{width:7px;height:7px;border-radius:50%;background:#8d8d8d}.is-gold .medal-dot{background:#d7a64c;box-shadow:0 0 10px rgba(215,166,76,.4)}.is-gold>span:last-child{color:#d7a64c}.is-silver .medal-dot{background:#c8c8c8}.is-silver>span:last-child{color:#c8c8c8}
@media(max-width:760px){.page-hero{min-height:330px;padding-top:126px}.medal-summary{grid-template-columns:repeat(2,1fr)}.medal-summary div:nth-child(2){border-right:0}.timeline-year{grid-template-columns:1fr}.year-rail{padding:26px 0 14px}.year-rail::after{top:auto;bottom:0;width:70px;height:1px}.year-events{padding:10px 0 34px}.event{grid-template-columns:1fr;gap:15px}.palmares-timeline{padding-top:62px}}
</style>
</BaseLayout>