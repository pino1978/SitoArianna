---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import results from "../data/results.json";
const years=[...results.resultsByYear].map(x=>x.year).sort((a,b)=>b-a);
const disciplines=[...new Set(results.resultsByYear.flatMap(y=>y.competitions.flatMap(c=>c.results.map(r=>r.discipline))))].sort();
const rows=results.resultsByYear.flatMap(y=>y.competitions.flatMap(c=>c.results.map((r,i)=>({year:y.year,event:c.event,place:c.place||"—",discipline:r.discipline,medal:r.medal,key:`${y.year}-${c.event}-${i}`})))).sort((a,b)=>b.year-a.year);
const medalName={gold:"Oro",silver:"Argento",bronze:"Bronzo"};
---
<BaseLayout title="Palmarès Preview | Arianna Milano" description="Anteprima privata della nuova pagina risultati." noindex={true}>
<main id="main" class="palmares"><section class="hero"><Header/><div class="tatami" aria-hidden="true"><div class="mat m1"></div><div class="mat m2"></div><div class="mat m3"></div><div class="mat m4"></div><div class="backwall"></div></div><div class="hero-shade"></div><div class="hero-inner"><div class="hero-copy"><p class="overline">Palmarès</p><h1>Risultati<br/><span>che parlano</span></h1><p class="lead">Disciplina. Costanza. Crescita.<br/>Ogni gara è un passo nel mio percorso.</p></div><div class="values"><span>Disciplina</span><span>Determinazione</span><span>Rispetto</span><span>Crescita</span></div><blockquote>“Il tatami non mente mai.”</blockquote></div></section>
<section class="content"><div class="stats"><div class="stat"><i>◉</i><strong>{results.medalSummary.total}</strong><span>Medaglie totali</span><b></b></div><div class="stat"><i>♛</i><strong>{results.medalSummary.gold}</strong><span>Ori</span><b></b></div><div class="stat"><i>▣</i><strong>{results.heroStats.find(x=>x.id==="competitions")?.value}</strong><span>Competizioni</span><b></b></div><div class="stat"><i>▥</i><strong>{results.heroStats.find(x=>x.id==="years")?.value}</strong><span>Anni di attività</span><b></b></div></div>
<div class="filters"><div class="year-tabs"><button class="active" data-year="all">Tutti</button>{years.map(y=><button data-year={y}>{y}</button>)}</div><div class="selects"><select data-discipline aria-label="Disciplina"><option value="all">Disciplina</option>{disciplines.map(d=><option value={d}>{d}</option>)}</select><select data-medal aria-label="Medaglia"><option value="all">Medaglia</option><option value="gold">Oro</option><option value="silver">Argento</option><option value="bronze">Bronzo</option></select><select data-place aria-label="Luogo"><option value="all">Luogo</option>{[...new Set(rows.map(r=>r.place).filter(p=>p!=="—"))].sort().map(p=><option value={p}>{p}</option>)}</select></div><button class="reset" data-reset>↻&nbsp; Reset</button></div>
<div class="table-wrap"><div class="table-head"><span>Anno</span><span>Competizione</span><span>Luogo</span><span>Disciplina</span><span>Risultato</span><span>Medaglia</span><span>Note</span><span></span></div><div class="table-body">{rows.map(r=><div class="result-row" data-row data-year={r.year} data-discipline={r.discipline} data-medal={r.medal} data-place={r.place}><span>{r.year}</span><strong>{r.event}</strong><span>{r.place}</span><span>{r.discipline}</span><span>1°</span><span class:list={["medal",r.medal]}><i></i>{medalName[r.medal]||r.medal}</span><span>—</span><span class="arrow">→</span></div>)}</div></div><div class="below">Mostrati <b data-count>{rows.length}</b> risultati</div><div class="closing"><blockquote>“Ogni risultato<br/>è una tappa di un percorso<br/>più grande.”</blockquote><div class="mountains"><i></i><i></i><i></i></div></div><footer class="motto"><span></span><p>Disciplina <b>•</b> Determinazione <b>•</b> Rispetto <b>•</b> Crescita</p><span></span></footer></section></main>
<script>const root=document.querySelector('.palmares');if(root){const tabs=[...root.querySelectorAll('[data-year]')],d=root.querySelector('[data-discipline]'),m=root.querySelector('[data-medal]'),p=root.querySelector('[data-place]'),reset=root.querySelector('[data-reset]'),count=root.querySelector('[data-count]');let year='all';const apply=()=>{let n=0;root.querySelectorAll('[data-row]').forEach(r=>{const show=(year==='all'||r.dataset.year===year)&&(d.value==='all'||r.dataset.discipline===d.value)&&(m.value==='all'||r.dataset.medal===m.value)&&(p.value==='all'||r.dataset.place===p.value);r.hidden=!show;if(show)n++});count.textContent=n;tabs.forEach(t=>t.classList.toggle('active',t.dataset.year===year))};tabs.forEach(t=>t.addEventListener('click',()=>{year=t.dataset.year;apply()}));[d,m,p].forEach(x=>x.addEventListener('change',apply));reset.addEventListener('click',()=>{year='all';d.value=m.value=p.value='all';apply()})}</script>
<style>
:global(body){background:#030404}.palmares{--gold:#d4a64d;--gold2:#f0c875;color:#f4efe7;background:#030404;min-height:100vh}.hero{position:relative;height:430px;overflow:hidden;background:#050606}.hero :global(header){position:relative;z-index:20}.tatami{position:absolute;inset:0;overflow:hidden;background:linear-gradient(#080a0b 0 43%,#0b0d0e 44% 100%);perspective:700px}.backwall{position:absolute;left:45%;right:4%;top:60px;height:180px;background:repeating-linear-gradient(90deg,#080909 0 75px,#111313 76px,#080909 78px);box-shadow:inset 0 -30px 45px #000}.mat{position:absolute;bottom:-80px;height:245px;transform:rotateX(62deg);transform-origin:bottom;background:#111516;border:1px solid #282b2c;box-shadow:inset 0 0 45px #000}.m1{left:34%;width:31%}.m2{left:64%;width:31%}.m3{left:47%;width:48%;height:115px;background:#351314;border-color:#561d1d}.m4{left:58%;width:36%;height:88px;background:#541819;border-color:#772323}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,#030404 0%,rgba(3,4,4,.97) 28%,rgba(3,4,4,.38) 59%,rgba(3,4,4,.35)),linear-gradient(0deg,#030404 0%,transparent 28%)}.hero-inner{position:relative;z-index:5;max-width:1180px;height:330px;margin:auto;padding:52px 24px 0}.hero-copy{width:58%}.overline{display:flex;align-items:center;gap:16px;margin:0 0 12px;color:#d8c7a8;font:600 1rem var(--font-display);letter-spacing:.26em;text-transform:uppercase}.overline:before{content:"";width:18px;height:1px;background:var(--gold)}.hero h1{margin:0;font:700 clamp(3.2rem,6.2vw,6.4rem)/.82 var(--font-display);letter-spacing:-.035em;text-transform:uppercase}.hero h1 span{color:var(--gold2)}.lead{margin:22px 0 0;color:#eee8de;font-size:1rem;line-height:1.5}.values{position:absolute;right:25px;top:42px;display:grid;gap:8px;padding-left:14px;border-left:1px solid #a68d68;color:#d9d3c9;font:700 .57rem var(--font-ui);letter-spacing:.08em;text-transform:uppercase}.hero blockquote{position:absolute;right:24px;bottom:26px;margin:0;color:#ddd1bf;font:italic 1rem var(--font-display)}.content{max-width:1180px;margin:-8px auto 0;padding:0 24px 70px;position:relative;z-index:10}.stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #313638;border-radius:6px;background:linear-gradient(#101314,#090b0c);box-shadow:0 14px 30px #000}.stat{position:relative;display:flex;min-height:150px;flex-direction:column;align-items:center;justify-content:center;border-right:1px solid #292d2e}.stat:last-child{border:0}.stat i{color:var(--gold2);font-style:normal;font-size:1.7rem}.stat strong{margin:4px 0 2px;color:var(--gold2);font:600 2.9rem var(--font-display)}.stat span{font:700 .68rem var(--font-display);letter-spacing:.06em;text-transform:uppercase}.stat b{position:absolute;bottom:19px;width:36px;height:2px;background:#a51b1b}.filters{display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:center;padding:24px 0 20px}.year-tabs,.selects{display:flex;gap:5px}.filters button,.filters select{height:42px;border:1px solid #15191a;border-radius:5px;background:#111516;color:#d5d0c8;padding:0 17px;font:600 .67rem var(--font-ui);cursor:pointer}.year-tabs button.active{border-color:#e0b45e;background:linear-gradient(#f3cd7c,#d9a94f);color:#090909}.selects{justify-content:center}.selects select{min-width:130px}.reset{border-color:#4a4030!important;background:#050606!important;color:#e4b75e!important}.table-wrap{border:1px solid #171b1c;border-radius:6px;overflow:hidden;background:#080a0b}.table-head,.result-row{display:grid;grid-template-columns:.75fr 1.65fr .85fr 1.1fr .62fr .85fr .45fr 32px;gap:14px;align-items:center}.table-head{min-height:42px;padding:0 15px;border-bottom:1px solid #242829;color:#8f9291;font:700 .52rem var(--font-ui);letter-spacing:.06em;text-transform:uppercase}.result-row{min-height:49px;padding:0 15px;border-bottom:1px solid #171a1b;color:#c8c7c3;font-size:.7rem}.result-row:nth-child(even){background:#0b0e0f}.result-row strong{color:#f0ede7;font-weight:600}.medal{display:flex;align-items:center;gap:7px}.medal i{width:15px;height:15px;border-radius:50%;background:#777}.medal.gold{color:#e8b854}.medal.gold i{background:radial-gradient(circle at 35% 30%,#f7d989,#b98227)}.medal.silver{color:#d2d2d2}.medal.silver i{background:radial-gradient(circle at 35% 30%,#fff,#8d9295)}.arrow{display:grid;width:24px;height:24px;place-items:center;border:1px solid #a67c2c;border-radius:50%;color:#e6b653}.below{padding:22px 0;color:#6f7372;font-size:.65rem}.closing{position:relative;min-height:150px;padding:20px 24px}.closing blockquote{position:relative;z-index:2;margin:0;padding-left:18px;border-left:3px solid #b41919;color:#eee8de;font:italic 1.25rem/1.3 var(--font-display)}.mountains{position:absolute;left:36%;right:18%;bottom:0;height:115px;opacity:.25;overflow:hidden}.mountains i{position:absolute;bottom:-55px;width:160px;height:160px;transform:rotate(45deg);border:1px solid #4a4c4c;background:linear-gradient(135deg,#161819,#030404 55%)}.mountains i:nth-child(2){left:120px;width:120px;height:120px}.mountains i:nth-child(3){left:215px;width:180px;height:180px}.motto{display:flex;align-items:center;gap:28px;margin-top:15px;color:#b89551}.motto>span{height:1px;flex:1;background:linear-gradient(90deg,transparent,#a77b2c)}.motto>span:last-child{transform:scaleX(-1)}.motto p{font:600 .58rem var(--font-display);letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}.motto b{margin:0 9px;color:#d8a841}[hidden]{display:none!important}@media(max-width:820px){.hero{height:500px}.hero-inner{padding-top:38px}.hero-copy{width:85%}.values{top:auto;bottom:65px;left:24px;right:auto;grid-template-columns:repeat(2,auto)}.hero blockquote{display:none}.content{padding-inline:14px}.stats{grid-template-columns:repeat(2,1fr)}.stat:nth-child(2){border-right:0}.stat:nth-child(-n+2){border-bottom:1px solid #292d2e}.filters{grid-template-columns:1fr}.year-tabs{overflow-x:auto}.selects{justify-content:stretch}.selects select{min-width:0;width:100%}.reset{justify-self:start}.table-wrap{overflow-x:auto}.table-head,.result-row{min-width:900px}.motto p{white-space:normal;text-align:center}}@media(max-width:520px){.hero{height:470px}.hero h1{font-size:3.55rem}.hero-copy{width:100%}.lead{font-size:.88rem}.stats{margin-top:-20px}.stat{min-height:120px}.stat strong{font-size:2.25rem}.stat span{font-size:.58rem}.selects{display:grid;grid-template-columns:1fr 1fr}.selects select:last-child{grid-column:1/-1}.closing{padding-inline:5px}.motto{gap:10px}.motto p{font-size:.48rem}.motto b{margin:0 4px}}</style></BaseLayout>