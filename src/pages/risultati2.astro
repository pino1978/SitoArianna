---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import results from "../data/results.json";

const medalLabel = { gold:"Oro", silver:"Argento", bronze:"Bronzo", placement:"Piazzamento" };
const years=[...results.resultsByYear].map(g=>g.year).sort((a,b)=>b-a);
const disciplines=[...new Set(results.resultsByYear.flatMap(g=>g.competitions.flatMap(c=>c.results.map(r=>r.discipline))))].sort((a,b)=>a.localeCompare(b,"it"));
const competitionCount=Number(results.heroStats.find(i=>i.id==="competitions")?.value||0);
const practiceYears=Number(results.heroStats.find(i=>i.id==="years")?.value||results.resultsByYear.length);
const goldRate=results.medalSummary.total?Math.round(results.medalSummary.gold/results.medalSummary.total*100):0;
const totalResultRows=results.resultsByYear.reduce((t,g)=>t+g.competitions.reduce((s,c)=>s+c.results.length,0),0);
const highlightEvents=new Set(results.highlights.map(i=>i.event));
---
<BaseLayout title="Palmarès Preview | Arianna Milano" description="Anteprima privata della nuova pagina risultati di Arianna Milano." noindex={true}>
<main id="main" class="results-dossier">
<section class="results-hero" aria-labelledby="results-title"><Header/><div class="hero-grid"><div class="hero-copy"><p class="eyebrow">Percorso agonistico</p><h1 id="results-title">Palmarès</h1><p class="hero-lead">Risultati, continuità e crescita. Una lettura immediata del percorso sportivo, con il dettaglio di ogni competizione.</p><div class="hero-meta"><span>Atleta Sanda</span><span>Categoria -40 kg</span><span>Attività agonistica 2022—2026</span></div></div><aside class="performance-snapshot"><div class="snapshot-primary"><span class="snapshot-label">Medaglie complessive</span><strong>{results.medalSummary.total}</strong><small>{goldRate}% del medagliere è oro</small></div><div class="snapshot-secondary"><div><strong>{results.medalSummary.gold}</strong><span>Ori</span></div><div><strong>{results.medalSummary.silver}</strong><span>Argenti</span></div><div><strong>{competitionCount}</strong><span>Competizioni</span></div><div><strong>{practiceYears}</strong><span>Anni</span></div></div><p class="snapshot-note">Dati aggiornati sul palmarès verificato 2022—2026.</p></aside></div><div class="hero-year" aria-hidden="true">{years[0]}</div></section>
<section class="growth-strip"><div class="section-intro"><p class="eyebrow">Progressione</p><h2>Anno dopo anno.</h2><p>La crescita non è raccontata da una singola gara, ma dalla continuità nel tempo.</p></div><div class="growth-years">{results.resultsByYear.map(g=>{const n=g.totals.gold+g.totals.silver+g.totals.bronze;return <button type="button" class="growth-year" data-year-shortcut={g.year} data-interactive><span>{g.year}</span><strong>{n}</strong><small>{n===1?"medaglia":"medaglie"}</small><i></i></button>})}</div></section>
<section class="results-archive"><header class="archive-heading"><div><p class="eyebrow">Archivio agonistico</p><h2>Tutti i risultati.</h2></div><p><strong data-result-count>{totalResultRows}</strong><span data-result-count-label>risultati mostrati</span></p></header><div class="filter-bar"><div class="year-filters"><button class="filter-chip is-active" type="button" data-year="all" data-interactive aria-pressed="true">Tutti</button>{years.map(y=><button class="filter-chip" type="button" data-year={y} data-interactive aria-pressed="false">{y}</button>)}</div><div class="select-filters"><label><span>Disciplina</span><select data-filter-discipline data-interactive><option value="all">Tutte</option>{disciplines.map(d=><option value={d}>{d}</option>)}</select></label><label><span>Medaglia</span><select data-filter-medal data-interactive><option value="all">Tutte</option><option value="gold">Oro</option><option value="silver">Argento</option><option value="bronze">Bronzo</option></select></label><button class="reset-filters" type="button" data-reset-filters data-interactive>Reset</button></div></div>
<div>{[...results.resultsByYear].reverse().map(g=><section class="archive-year" data-year-section={g.year}><header class="archive-year__header"><div><span>{g.year}</span><p>{g.totals.gold} {g.totals.gold===1?"oro":"ori"}{g.totals.silver?` · ${g.totals.silver} argento`:""}</p></div><strong>{g.competitions.length} {g.competitions.length===1?"competizione":"competizioni"}</strong></header><div>{g.competitions.map(c=><article class:list={["competition-card",highlightEvents.has(c.event)&&"is-highlight"]} data-competition-card data-year={g.year}><div class="competition-main"><div class="competition-kicker"><span>{g.year}</span>{highlightEvents.has(c.event)&&<em>Highlight</em>}</div><h3>{c.event}</h3>{c.place&&<p>{c.place}</p>}</div><div class="competition-results">{c.results.map(r=><div class:list={["competition-result",`is-${r.medal}`]} data-result-row data-discipline={r.discipline} data-medal={r.medal}><span class="medal-mark"></span><strong>{r.discipline}</strong><span>{medalLabel[r.medal]??r.medal}</span></div>)}</div></article>)}</div></section>)}</div><div class="empty-state" data-empty-state hidden><p class="eyebrow">Nessun risultato</p><h3>Prova a modificare i filtri.</h3><button type="button" data-empty-reset data-interactive>Mostra tutto</button></div></section></main>
<script>
const root=document.querySelector('.results-dossier');if(root){const ys=[...root.querySelectorAll('button[data-year]')],short=[...root.querySelectorAll('[data-year-shortcut]')],ds=root.querySelector('[data-filter-discipline]'),ms=root.querySelector('[data-filter-medal]'),resetBtn=root.querySelector('[data-reset-filters]'),emptyReset=root.querySelector('[data-empty-reset]'),count=root.querySelector('[data-result-count]'),label=root.querySelector('[data-result-count-label]'),empty=root.querySelector('[data-empty-state]');let active='all';const apply=()=>{const d=ds?.value||'all',m=ms?.value||'all';let n=0;root.querySelectorAll('[data-competition-card]').forEach(card=>{let cn=0;card.querySelectorAll('[data-result-row]').forEach(row=>{const show=(active==='all'||card.dataset.year===active)&&(d==='all'||row.dataset.discipline===d)&&(m==='all'||row.dataset.medal===m);row.hidden=!show;if(show){cn++;n++}});card.hidden=cn===0});root.querySelectorAll('[data-year-section]').forEach(sec=>sec.hidden=![...sec.querySelectorAll('[data-competition-card]')].some(c=>!c.hidden));ys.forEach(b=>{const on=b.dataset.year===active;b.classList.toggle('is-active',on);b.setAttribute('aria-pressed',String(on))});if(count)count.textContent=String(n);if(label)label.textContent=n===1?'risultato mostrato':'risultati mostrati';if(empty)empty.hidden=n!==0};ys.forEach(b=>b.addEventListener('click',()=>{active=b.dataset.year||'all';apply()}));short.forEach(b=>b.addEventListener('click',()=>{active=b.dataset.yearShortcut||'all';apply();root.querySelector('.filter-bar')?.scrollIntoView({behavior:'smooth',block:'start'})}));ds?.addEventListener('change',apply);ms?.addEventListener('change',apply);const reset=()=>{active='all';if(ds)ds.value='all';if(ms)ms.value='all';apply()};resetBtn?.addEventListener('click',reset);emptyReset?.addEventListener('click',reset);apply()}
</script>
<style>
:global(body){background:#080706}.results-dossier{--ink:#080706;--ivory:#f5f0e7;--gold:#b98632;--gold-hi:#d3a653;background:var(--ink);color:var(--ivory);overflow:hidden}.eyebrow{margin:0;color:var(--gold-hi);font:800 .64rem var(--font-ui);letter-spacing:.18em;text-transform:uppercase}.results-hero{position:relative;min-height:650px;padding:152px max(28px,calc((100vw - 1180px)/2)) 78px;background:radial-gradient(circle at 78% 28%,rgba(185,134,50,.11),transparent 28%),linear-gradient(135deg,#070706,#0c0a08 58%,#15100b)}.results-hero .site-header{position:absolute;top:0;left:0;right:0}.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(50px,8vw,110px);align-items:end}.hero-copy h1{margin:.12em 0 .18em;font:800 clamp(4.8rem,9.5vw,9rem)/.82 var(--font-display);letter-spacing:-.035em;text-transform:uppercase}.hero-lead{max-width:610px;margin:0;color:#cfc6b8;font-size:1.04rem;line-height:1.65}.hero-meta{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:30px;color:#91877c;font:800 .58rem var(--font-ui);letter-spacing:.11em;text-transform:uppercase}.performance-snapshot{border:1px solid rgba(185,134,50,.28);background:linear-gradient(145deg,rgba(255,255,255,.026),rgba(185,134,50,.035))}.snapshot-primary{padding:30px 32px 28px;border-bottom:1px solid rgba(185,134,50,.2)}.snapshot-label{display:block;color:#9e9488;font:800 .58rem var(--font-ui);letter-spacing:.14em;text-transform:uppercase}.snapshot-primary strong{display:block;margin:8px 0;color:#fff;font:800 clamp(4.6rem,7vw,7.4rem)/.82 var(--font-display)}.snapshot-primary small{color:var(--gold-hi);font:700 .68rem var(--font-ui);text-transform:uppercase}.snapshot-secondary{display:grid;grid-template-columns:repeat(4,1fr)}.snapshot-secondary div{padding:20px 10px;text-align:center;border-right:1px solid rgba(185,134,50,.16)}.snapshot-secondary strong{display:block;font:800 1.75rem var(--font-display)}.snapshot-secondary span{color:#968c81;font:800 .51rem var(--font-ui);text-transform:uppercase}.snapshot-note{margin:0;padding:14px 18px;border-top:1px solid rgba(185,134,50,.16);color:#756d64;font:700 .52rem var(--font-ui);text-transform:uppercase}.hero-year{position:absolute;right:5vw;top:82px;color:rgba(245,240,231,.025);font:900 clamp(10rem,25vw,25rem) var(--font-display);pointer-events:none}.growth-strip{display:grid;grid-template-columns:.7fr 1.3fr;gap:60px;padding:82px max(28px,calc((100vw - 1180px)/2));border-bottom:1px solid rgba(185,134,50,.2);background:#0b0908}.section-intro h2,.archive-heading h2{margin:14px 0 16px;font:800 clamp(2.4rem,5vw,4.9rem)/.9 var(--font-display);text-transform:uppercase}.section-intro>p:last-child{color:#92887e;line-height:1.6}.growth-years{display:grid;grid-template-columns:repeat(5,1fr);align-items:end}.growth-year{position:relative;padding:22px 14px 32px;border:0;border-bottom:1px solid rgba(185,134,50,.26);background:transparent;color:inherit;text-align:left;cursor:pointer}.growth-year::after{position:absolute;left:0;bottom:-5px;width:9px;height:9px;border:1px solid var(--gold);border-radius:50%;background:#0b0908;content:""}.growth-year span{color:#93897e;font:800 .63rem var(--font-ui)}.growth-year strong{display:block;margin-top:18px;font:800 clamp(2.4rem,4vw,4.3rem)/.8 var(--font-display)}.growth-year small{color:var(--gold-hi);font:800 .52rem var(--font-ui);text-transform:uppercase}.results-archive{padding:92px max(28px,calc((100vw - 1180px)/2)) 120px}.archive-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:38px}.archive-heading>p{display:flex;align-items:baseline;gap:10px;color:#877d72}.archive-heading>p strong{color:#fff;font:800 2rem var(--font-display)}.filter-bar{position:sticky;z-index:30;top:0;display:flex;justify-content:space-between;gap:22px;margin-bottom:54px;padding:14px 0;border-block:1px solid rgba(185,134,50,.24);background:rgba(8,7,6,.94);backdrop-filter:blur(14px)}.year-filters,.select-filters{display:flex;gap:6px}.filter-chip,.reset-filters,.select-filters select{min-height:38px;border:1px solid rgba(185,134,50,.22);background:#0c0a09;color:#9f958a;padding:0 14px;font:800 .56rem var(--font-ui);text-transform:uppercase}.filter-chip.is-active{border-color:var(--gold);background:rgba(185,134,50,.12);color:var(--gold-hi)}.select-filters label{display:grid;gap:5px}.select-filters label>span{color:#756d64;font:800 .48rem var(--font-ui);text-transform:uppercase}.archive-year{margin-top:72px}.archive-year:first-child{margin-top:0}.archive-year__header{display:flex;align-items:end;justify-content:space-between;padding-bottom:18px;border-bottom:1px solid rgba(185,134,50,.34)}.archive-year__header>div{display:flex;align-items:baseline;gap:18px}.archive-year__header span{color:var(--gold-hi);font:800 clamp(2.8rem,5vw,5.2rem)/.8 var(--font-display)}.archive-year__header p,.archive-year__header>strong{color:#80776d;font:800 .54rem var(--font-ui);text-transform:uppercase}.competition-card{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(28px,5vw,72px);padding:28px 0;border-bottom:1px solid rgba(245,240,231,.08)}.competition-card.is-highlight{position:relative}.competition-card.is-highlight::before{position:absolute;left:-18px;top:32px;width:2px;height:54px;background:var(--gold);content:""}.competition-kicker{display:flex;gap:10px;margin-bottom:8px;color:#746b62;font:800 .53rem var(--font-ui)}.competition-kicker em{color:var(--gold-hi);font-style:normal;text-transform:uppercase}.competition-main h3{margin:0;font:800 clamp(1.25rem,2.1vw,2rem)/1.02 var(--font-display);text-transform:uppercase}.competition-main>p{color:#746d64;font-size:.76rem}.competition-results{display:grid;align-content:center;gap:8px}.competition-result{display:grid;grid-template-columns:10px 1fr auto;gap:11px;align-items:center;min-height:34px;font:700 .67rem var(--font-ui)}.competition-result>span:last-child{font-size:.53rem;text-transform:uppercase}.medal-mark{width:7px;height:7px;border-radius:50%;background:#777}.is-gold .medal-mark{background:#d5a44c;box-shadow:0 0 12px rgba(213,164,76,.35)}.is-gold>span:last-child{color:#d5a44c}.is-silver .medal-mark{background:#c7c7c7}.is-silver>span:last-child{color:#c7c7c7}[hidden]{display:none!important}.empty-state{padding:80px 20px;text-align:center}.empty-state h3{font:800 2rem var(--font-display);text-transform:uppercase}@media(max-width:900px){.hero-grid,.growth-strip{grid-template-columns:1fr}.results-hero{min-height:0;padding-top:128px}.filter-bar{flex-direction:column}}@media(max-width:700px){.results-hero{padding:112px 18px 52px}.hero-copy h1{font-size:clamp(4rem,20vw,6.2rem)}.snapshot-secondary{grid-template-columns:repeat(2,1fr)}.hero-year{display:none}.growth-strip{padding:58px 18px}.growth-years{grid-template-columns:repeat(5,minmax(82px,1fr));overflow-x:auto}.results-archive{padding:66px 18px 90px}.archive-heading{align-items:start;flex-direction:column}.filter-bar{margin-inline:-18px;padding:12px 18px}.select-filters{display:grid;grid-template-columns:1fr 1fr auto}.competition-card{grid-template-columns:1fr;gap:18px}.archive-year__header{align-items:start}.archive-year__header>div{display:grid;gap:7px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style></BaseLayout>