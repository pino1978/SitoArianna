---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import page from "../data/road-to-greece.json";
import heroMobileRaw from "../data/road-to-greece/generated/hero-mobile-clean.txt?raw";
import mapMobileRaw from "../data/road-to-greece/generated/map-mobile-clean.txt?raw";
import wingMobileRaw from "../data/road-to-greece/generated/wing-mobile-clean.txt?raw";
import panoramaMobileRaw from "../data/road-to-greece/generated/panorama-mobile-clean.txt?raw";
import ruinsMobileRaw from "../data/road-to-greece/generated/ruins-mobile-clean.txt?raw";
const heroMobile=`data:image/webp;base64,${heroMobileRaw.trim()}`;
const mapMobile=`data:image/webp;base64,${mapMobileRaw.trim()}`;
const wingMobile=`data:image/webp;base64,${wingMobileRaw.trim()}`;
const panoramaMobile=`data:image/webp;base64,${panoramaMobileRaw.trim()}`;
const ruinsMobile=`data:image/webp;base64,${ruinsMobileRaw.trim()}`;
---
<BaseLayout title={page.seo.title} description={page.seo.description}>
<main class="rtg" id="main">
<Header />
<section class="rtg-hero" aria-labelledby="rtg-title"><h1 id="rtg-title" class="sr-only">Arianna al Palamidio 2026</h1><img src={heroMobile} alt="" decoding="async" fetchpriority="high" /></section>
<section class="journey" aria-labelledby="journey-title">
<div class="journey__intro shell"><div class="journey__copy"><p class="kicker">La prossima sfida</p><h2 id="journey-title">Da Casoria<br/><em>a Nafplio.</em></h2><p>{page.route.body}</p><small>{page.route.tagline}</small></div><div class="journey__aside" aria-hidden="true"><span>Più di una gara.</span><span>Un’esperienza che fa crescere.</span></div></div>
<figure class="journey__map"><img src={mapMobile} alt="Mappa stilizzata del percorso da Casoria a Nafplio." loading="eager" decoding="async" /></figure>
</section>
<section class="event" aria-labelledby="event-title"><img class="event__ruins" src={ruinsMobile} alt="" loading="lazy" decoding="async" aria-hidden="true"/><div class="event__grid shell"><div class="event__wing" aria-hidden="true"><img src={wingMobile} alt="" loading="lazy" decoding="async"/></div><div class="event__copy"><p class="kicker">{page.event.kicker}</p><h2 id="event-title">{page.event.title1}<br/>{page.event.title2}</h2><p class="event__date"><strong>{page.event.date}</strong><br/>{page.event.place}</p><p class="event__body">{page.event.body}</p><a class="cta" href={page.event.url} target="_blank" rel="noopener noreferrer"><span>{page.event.cta}</span><span aria-hidden="true">→</span></a></div></div></section>
<section class="closing" aria-label="Nafplio, nuovi orizzonti"><img src={panoramaMobile} alt="" loading="lazy" decoding="async"/><div class="closing__shade" aria-hidden="true"></div><div class="closing__copy shell"><span class="closing__script">Beyond<br/>Limits</span><div class="closing__place"><b>NAFPLIO</b><small>Higher horizons</small></div></div></section>
</main>
</BaseLayout>
<style>
:global(body){background:#07090a;color:#f5efe5}.rtg{--ink:#07090a;--paper:#f3ecdf;--gold:#c99427;--text:#121a21;overflow:hidden;background:var(--ink)}.shell{width:min(1180px,calc(100% - 72px));margin-inline:auto}.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}.kicker{display:flex;align-items:center;gap:13px;margin:0 0 16px;color:#44505a;font:800 .62rem/1 var(--font-ui);letter-spacing:.3em;text-transform:uppercase}.kicker::before{content:"";width:38px;height:2px;background:var(--gold)}
.rtg-hero{position:relative;width:100%;aspect-ratio:2/1;min-height:0!important;height:auto!important;margin:0!important;padding:0!important;overflow:hidden;background:#020405;line-height:0}.rtg-hero img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;object-position:center;margin:0}
.journey{background:linear-gradient(180deg,#f6f0e6,#eee5d8);color:var(--text);padding:46px 0 0}.journey__intro{display:grid;grid-template-columns:minmax(0,1fr) 210px;gap:48px;align-items:end}.journey__copy h2{margin:0 0 18px;font:500 clamp(3rem,5vw,5.2rem)/.9 Georgia,serif;letter-spacing:-.045em}.journey__copy h2 em{font-style:italic;color:#b57d18}.journey__copy>p{max-width:590px;margin:0;color:#2f373d;font:400 1rem/1.55 var(--font-body)}.journey__copy small{display:block;margin-top:18px;color:#60686d;font:800 .58rem/1 var(--font-ui);letter-spacing:.19em;text-transform:uppercase}.journey__aside{display:grid;gap:8px;padding-left:24px;border-left:1px solid rgba(16,24,32,.16);color:#5d666b;font:800 .62rem/1.5 var(--font-ui);letter-spacing:.18em;text-transform:uppercase}.journey__aside::after{content:"";width:32px;height:2px;background:var(--gold);margin-top:8px}.journey__map{width:min(1120px,94vw);margin:18px auto 0;overflow:hidden}.journey__map img{display:block;width:100%;height:420px;object-fit:cover;object-position:center 48%}
.event{position:relative;background:linear-gradient(180deg,#f2eadf,#e9dfd1);color:var(--text);padding:26px 0 34px;overflow:hidden}.event__ruins{position:absolute;right:-4%;bottom:0;width:min(330px,25vw);height:100%;object-fit:cover;object-position:right center;opacity:.22;pointer-events:none}.event__grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(300px,.9fr) minmax(420px,1.1fr);gap:42px;align-items:stretch}.event__wing{min-height:360px;overflow:hidden;border-right:1px solid rgba(16,24,32,.12)}.event__wing img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 42%}.event__copy{padding:26px 0 20px}.event__copy h2{margin:0 0 14px;font:500 clamp(2.2rem,3.4vw,3.8rem)/.95 Georgia,serif;letter-spacing:-.035em;max-width:650px}.event__date{margin:0 0 18px;font:700 .94rem/1.45 var(--font-ui)}.event__body{max-width:560px;margin:0;color:#41494f;font:400 1rem/1.55 var(--font-body)}.cta{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-width:310px;margin-top:20px;padding:14px 18px;background:linear-gradient(90deg,#d3a33d,#e6bd58);color:#101820;text-decoration:none;font:900 .66rem/1 var(--font-ui);letter-spacing:.08em;text-transform:uppercase}
.closing{position:relative;height:145px;overflow:hidden;background:#1f2b33}.closing img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 67%}.closing__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,12,15,.22),transparent 48%,rgba(8,12,15,.24))}.closing__copy{position:absolute;inset:0;display:flex;align-items:center;justify-content:space-between;color:#141a1e}.closing__script{font:italic 2rem/.9 Georgia,serif;transform:rotate(-8deg)}.closing__place{display:grid;gap:4px;text-align:right;letter-spacing:.2em;text-transform:uppercase}.closing__place b{font:900 .9rem/1 var(--font-ui)}.closing__place small{font:700 .55rem/1 var(--font-ui)}
@media(max-width:767px){.shell{width:calc(100% - 32px)}.rtg-hero{aspect-ratio:2/1}.rtg-hero img{object-fit:cover;object-position:center}.journey{padding-top:26px}.journey__intro{display:block}.journey__copy h2{font-size:3rem}.journey__copy>p{font-size:.94rem;line-height:1.5}.journey__copy small{margin-top:14px}.journey__aside{display:none}.journey__map{width:100%;margin:10px 0 0}.journey__map img{display:block;width:100%;height:auto;max-height:none;object-fit:contain}.event{padding:0 0 20px}.event__ruins{width:38%;right:-12%;opacity:.13}.event__grid{display:block;width:100%}.event__wing{height:154px;min-height:0;border:0;border-bottom:1px solid rgba(16,24,32,.12)}.event__wing img{width:100%;height:100%;object-fit:cover;object-position:center 46%}.event__copy{width:calc(100% - 32px);margin-inline:auto;padding:20px 0 4px}.event__copy h2{font-size:2.18rem;line-height:.96}.event__date{font-size:.84rem}.event__body{font-size:.92rem}.cta{width:100%;min-width:0;box-sizing:border-box;margin-top:14px}.closing{height:84px}.closing img{object-position:center 72%}.closing__copy{width:calc(100% - 28px)}.closing__script{font-size:1.1rem}.closing__place b{font-size:.64rem}.closing__place small{font-size:.42rem}}
@media(max-width:390px){.journey__copy h2{font-size:2.7rem}.event__wing{height:146px}.closing{height:78px}}
</style>