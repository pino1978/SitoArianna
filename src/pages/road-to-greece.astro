---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import page from "../data/road-to-greece.json";
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <Header />
  <main class="rtg" id="main">
    <section class="rtg-hero" aria-labelledby="rtg-title">
      <h1 id="rtg-title" class="sr-only">Arianna al 18th Palamidio Martial Arts Championship 2026, dal 13 al 15 novembre a Nafplio, in Grecia</h1>
      <picture>
        <source media="(max-width: 767px)" srcset="/images/road-to-greece/hero_mobile.webp" width="900" height="1200" />
        <img src="/images/road-to-greece/hero.webp" width="1774" height="887" alt="" decoding="async" fetchpriority="high" />
      </picture>
    </section>

    <section class="journey" aria-labelledby="journey-title">
      <div class="journey__intro shell">
        <div class="journey__copy">
          <p class="kicker">{page.route.kicker}</p>
          <h2 id="journey-title">{page.route.title1}<br /><em>{page.route.title2}</em></h2>
          <p>{page.route.body}</p>
          <dl class="journey__facts" aria-label="Informazioni sulla competizione">
            {page.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
          </dl>
        </div>
        <div class="step" aria-labelledby="step-title">
          <div class="step__inner">
            <span class="step__line" aria-hidden="true"></span>
            <p class="step__eyebrow">Non è solo una destinazione.</p>
            <h2 id="step-title">È il prossimo passo.</h2>
            <p class="step__body">Dalla palestra di ogni giorno a una nuova esperienza internazionale.<br />Stessa disciplina. Una sfida più grande.</p>
          </div>
        </div>
        <figure class="journey__map">
          <picture><img src="/images/road-to-greece/map.webp" width="1536" height="768" alt="Mappa stilizzata del percorso da Casoria a Nafplio." loading="lazy" decoding="async" /></picture>
        </figure>
      </div>
    </section>

    <section class="ying-bridge" aria-label="Yīng, la firma sportiva di Arianna">
      <div class="ying-bridge__inner shell">
        <img src="/images/road-to-greece/ying.webp" width="1536" height="1152" alt="Yīng, aquila: simbolo di visione, concentrazione e determinazione." loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="event" aria-labelledby="event-title">
      <picture class="event__ruins" aria-hidden="true"><source media="(max-width: 767px)" srcset="/images/road-to-greece/templio_mobile.webp" width="800" height="1281" /><img src="/images/road-to-greece/templio.webp" width="1536" height="1024" alt="" loading="lazy" decoding="async" /></picture>
      <div class="event__grid shell">
        <div class="event__wing" aria-hidden="true"><img src="/images/road-to-greece/ying.webp" width="1536" height="1152" alt="" loading="lazy" decoding="async" /></div>
        <div class="event__copy">
          <p class="kicker">{page.event.kicker}</p>
          <h2 id="event-title">{page.event.title1}<br />{page.event.title2}</h2>
          <p class="event__date"><strong>{page.event.date}</strong><br />{page.event.place}</p>
          <p class="event__body">{page.event.body}</p>
          <a class="cta" href={page.event.url} target="_blank" rel="noopener noreferrer" data-interactive><span>{page.event.cta}<span class="sr-only"> (si apre in una nuova scheda)</span></span><span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="closing" aria-label="Nafplio, nuovi orizzonti">
      <picture><img src="/images/road-to-greece/panorama.webp" width="1800" height="600" alt="" loading="lazy" decoding="async" /></picture>
      <div class="closing__shade" aria-hidden="true"></div>
      <div class="closing__copy shell"><span class="closing__script">Oltre<br />i limiti</span><div class="closing__place"><b>NAFPLIO</b><small>Nuovi orizzonti</small></div></div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body){background:#07090a;color:#f5efe5}
  .rtg{--ink:#07090a;--paper:#f3ecdf;--gold:#c99427;--text:#121a21;overflow:hidden;background:var(--ink)}
  .shell{width:min(1180px,calc(100% - 72px));margin-inline:auto}
  .sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
  .kicker{display:flex;align-items:center;gap:13px;margin:0 0 16px;color:#44505a;font:800 .62rem/1 var(--font-ui);letter-spacing:.3em;text-transform:uppercase}.kicker::before{content:"";width:38px;height:2px;background:var(--gold)}
  .rtg-hero{position:relative;width:100%;margin:0;padding:0;overflow:hidden;background:#020405;line-height:0}.rtg-hero picture,.rtg-hero img{display:block;width:100%}.rtg-hero img{height:auto}
  .journey{background:linear-gradient(180deg,#f6f0e6 0%,#eee5d8 100%);color:var(--text);padding:96px 0 104px}.journey__intro{display:grid;grid-template-columns:minmax(0,7fr) minmax(300px,5fr);grid-template-areas:"copy step" "map map";column-gap:72px;row-gap:56px;align-items:start}.journey__copy{grid-area:copy}.journey__copy h2{margin:0 0 22px;font:500 clamp(3.4rem,5vw,5.2rem)/.9 Georgia,serif;letter-spacing:-.045em}.journey__copy h2 em{font-style:italic;color:#b57d18}.journey__copy>p{max-width:650px;margin:0;color:#2f373d;font:400 1rem/1.62 var(--font-body)}.journey__facts{display:flex;flex-wrap:wrap;gap:16px 32px;margin:28px 0 0;padding:22px 0 0;border-top:1px solid rgba(18,26,33,.12)}.journey__facts div{display:grid;gap:6px}.journey__facts dd{order:1;margin:0;color:#20282e;font:800 .76rem/1 var(--font-ui);letter-spacing:.04em}.journey__facts dt{order:2;color:#697177;font:800 .54rem/1 var(--font-ui);letter-spacing:.18em;text-transform:uppercase}.journey__map{grid-area:map;width:100%;margin:0;overflow:hidden;line-height:0;-webkit-mask-image:linear-gradient(to right,transparent 0,#000 5%,#000 95%,transparent 100%),linear-gradient(to bottom,transparent 0,#000 8%,#000 92%,transparent 100%);-webkit-mask-composite:source-in;mask-image:linear-gradient(to right,transparent 0,#000 5%,#000 95%,transparent 100%),linear-gradient(to bottom,transparent 0,#000 8%,#000 92%,transparent 100%);mask-composite:intersect}.journey__map picture,.journey__map img{display:block;width:100%}.journey__map img{height:auto;mix-blend-mode:multiply}
  .step{grid-area:step;align-self:stretch;display:flex;align-items:flex-end;padding:24px 0 24px 40px;border-left:1px solid rgba(18,26,33,.16);color:var(--text)}.step__inner{position:relative}.step__line{display:block;width:42px;height:2px;margin-bottom:20px;background:var(--gold)}.step__eyebrow{margin:0 0 12px;color:#5f676c;font:800 .62rem/1.2 var(--font-ui);letter-spacing:.2em;text-transform:uppercase}.step h2{margin:0 0 18px;color:#131b21;font:500 clamp(2.45rem,3.4vw,3.7rem)/.95 Georgia,serif;letter-spacing:-.035em}.step__body{margin:0;max-width:430px;color:#4a5359;font:400 .98rem/1.6 var(--font-body)}
  .ying-bridge{position:relative;background:linear-gradient(180deg,#eee5d8,#f2eadf);padding:20px 0 72px;overflow:hidden}.ying-bridge__inner{max-width:980px;line-height:0;-webkit-mask-image:radial-gradient(ellipse 68% 76% at center,#000 58%,transparent 100%);mask-image:radial-gradient(ellipse 68% 76% at center,#000 58%,transparent 100%)}.ying-bridge img{display:block;width:100%;height:auto;mix-blend-mode:multiply}
  .event{position:relative;min-height:620px;background:#090d10;color:#f5efe5;overflow:hidden}.event::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,8,10,.92) 0%,rgba(5,8,10,.82) 36%,rgba(5,8,10,.28) 64%,rgba(5,8,10,.08) 100%);z-index:0;pointer-events:none}.event__ruins{position:absolute;inset:0;pointer-events:none;opacity:1;z-index:0}.event__ruins img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}.event__grid{position:relative;z-index:1;display:flex;min-height:620px;align-items:center}.event__wing{display:none}.event__copy{width:min(540px,52%);padding:72px 0}.event .kicker{color:#d8cfc2}.event__copy h2{margin:0 0 20px;color:#f8f1e7;font:500 clamp(3rem,4.2vw,4.25rem)/.93 Georgia,serif;letter-spacing:-.04em}.event__date{margin:0 0 22px;color:#e6dcca;font:700 .94rem/1.45 var(--font-ui)}.event__body{max-width:500px;margin:0;color:#d2cbc0;font:400 1rem/1.65 var(--font-body)}.cta{position:relative;z-index:3;display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-width:310px;margin-top:30px;padding:14px 18px;background:linear-gradient(90deg,#d3a33d,#e6bd58);color:#101820;text-decoration:none;font:900 .66rem/1 var(--font-ui);letter-spacing:.08em;text-transform:uppercase;pointer-events:auto;cursor:pointer;transition:filter .2s ease,transform .2s ease}.cta:hover{filter:brightness(1.08);transform:translateY(-1px)}.cta:focus-visible{outline:3px solid #f5efe5;outline-offset:4px}
  .closing{position:relative;height:clamp(340px,30vw,430px);overflow:hidden;background:#1f2b33}.closing>picture,.closing>picture>img{display:block;width:100%;height:100%}.closing>picture>img{object-fit:cover;object-position:center 64%}.closing__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,12,15,.48),rgba(8,12,15,.12) 48%,rgba(8,12,15,.5))}.closing__copy{position:absolute;inset:0;display:flex;align-items:center;justify-content:space-between;color:#f5efe5;text-shadow:0 2px 20px rgba(0,0,0,.65)}.closing__script{font:italic 2.8rem/.9 Georgia,serif;transform:rotate(-8deg)}.closing__place{display:grid;gap:6px;text-align:right;letter-spacing:.2em;text-transform:uppercase}.closing__place b{font:900 1rem/1 var(--font-ui)}.closing__place small{font:700 .68rem/1 var(--font-ui)}
  @media(min-width:768px) and (max-width:1099px){
    .shell{width:calc(100% - 48px)}
    .journey{padding:72px 0 80px}.journey__intro{grid-template-columns:1fr;grid-template-areas:"copy" "map" "step";row-gap:40px}.journey__copy h2{font-size:clamp(3rem,7vw,4.5rem)}.step{padding:36px 0 0;border-left:0;border-top:1px solid rgba(18,26,33,.12)}.step h2{font-size:clamp(2.4rem,5vw,3.2rem)}
    .event,.event__grid{min-height:560px}.event__copy{width:min(500px,62%)}.event__copy h2{font-size:clamp(2.7rem,5vw,3.5rem)}
  }
  @media(max-width:767px){
    .shell{width:calc(100% - 32px)}.rtg-hero{height:auto;background:#020405;padding:0}.rtg-hero picture{display:block;width:100%;margin:0}.rtg-hero img{display:block;width:100%;height:auto;object-fit:contain}.journey{padding:26px 0 0}.journey__intro{display:grid;grid-template-columns:1fr;grid-template-areas:"copy" "map" "step";gap:0}.journey__copy h2{font-size:2.75rem;margin-bottom:14px}.journey__copy>p{font-size:.91rem;line-height:1.48}.journey__facts{gap:14px 22px;margin-top:20px;padding-top:16px}.journey__facts dd{font-size:.68rem}.journey__facts dt{font-size:.5rem}
    .journey__map{position:relative;width:96%;max-width:580px;height:auto;margin:12px auto 4px;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 9%,#000 91%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0,#000 9%,#000 91%,transparent 100%)}.journey__map::before{content:"";position:absolute;z-index:2;inset:0 0 auto;height:58px;background:linear-gradient(180deg,#f1e9dc 0,rgba(241,233,220,.94) 18%,rgba(241,233,220,.62) 48%,rgba(241,233,220,0) 100%);pointer-events:none}.journey__map picture,.journey__map img{display:block;width:100%;height:auto}.journey__map img{object-fit:contain;mix-blend-mode:multiply}
    .step{display:block;padding:36px 0 38px;border-left:0;border-top:1px solid rgba(18,26,33,.08);background:transparent}.step__line{width:34px;margin-bottom:15px}.step__eyebrow{font-size:.56rem;letter-spacing:.19em;margin-bottom:8px}.step h2{font-size:2.25rem;margin-bottom:13px}.step__body{font-size:.88rem;line-height:1.5;max-width:340px}
    .ying-bridge{display:none}.event{min-height:0;padding:0 0 20px;background:linear-gradient(180deg,#f2eadf,#e9dfd1);color:var(--text)}.event::after{display:none}.event__ruins{inset:auto -9% 0 auto;width:38%;height:58%;opacity:.1}.event__grid{display:block;min-height:0;width:100%}.event__wing{display:block;position:relative;height:auto;min-height:0;overflow:hidden;border:0;background:transparent;padding:0;margin:0 0 28px}.event__wing::before{content:"";position:absolute;z-index:2;inset:0 0 auto;height:84px;background:linear-gradient(180deg,#f5eee4 0,rgba(245,238,228,.96) 18%,rgba(245,238,228,.68) 48%,rgba(245,238,228,0) 100%);pointer-events:none}.event__wing img{display:block;width:108%;max-width:none;height:auto;margin:0 -4%;object-fit:contain;object-position:center;mix-blend-mode:multiply;opacity:.98;transform:none}.event__copy{width:calc(100% - 32px);margin-inline:auto;padding:10px 0 4px}.event .kicker{color:#44505a}.event__copy h2{color:#131b21;font-size:1.95rem;line-height:.96;margin-bottom:12px}.event__date{color:#121a21;font-size:.8rem;margin-bottom:14px}.event__body{color:#41494f;font-size:.9rem;line-height:1.48}.cta{width:100%;min-width:0;box-sizing:border-box;margin-top:14px}.closing{height:120px}.closing>picture>img{object-position:center 66%}.closing__copy{width:calc(100% - 28px)}.closing__script{font-size:1.1rem}.closing__place b{font-size:.64rem}.closing__place small{font-size:.55rem}
  }
  @media(max-width:390px){.journey__map{width:98%}.journey__copy h2{font-size:2.55rem}.event__wing img{width:110%;margin-inline:-5%}.event__wing{margin-bottom:24px}.closing{height:110px}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
