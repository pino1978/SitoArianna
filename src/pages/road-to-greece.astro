---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import page from "../data/road-to-greece.json";
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <main class="rtg" id="main">
    <Header />

    <section class="rtg-hero" aria-labelledby="rtg-title">
      <h1 id="rtg-title" class="sr-only">Arianna al Palamidio 2026</h1>
      <picture>
        <source media="(max-width: 767px)" srcset="/images/road-to-greece/hero_mobile5.png" />
        <img src="/images/road-to-greece/hero.png" alt="" decoding="async" fetchpriority="high" />
      </picture>
    </section>

    <section class="journey" aria-labelledby="journey-title">
      <div class="journey__intro shell">
        <div class="journey__copy">
          <p class="kicker">La prossima sfida</p>
          <h2 id="journey-title">Da Casoria<br /><em>a Nafplio.</em></h2>
          <p>{page.route.body}</p>
          <small>{page.route.tagline}</small>
        </div>
        <div class="journey__aside" aria-hidden="true">
          <span>Più di una gara.</span><span>Un’esperienza che fa crescere.</span>
        </div>
      </div>
      <figure class="journey__map">
        <picture>
          <img src="/images/road-to-greece/map.png" alt="Mappa stilizzata del percorso da Casoria a Nafplio." loading="eager" decoding="async" />
        </picture>
      </figure>
    </section>

    <section class="step" aria-labelledby="step-title">
      <div class="step__inner shell">
        <span class="step__line" aria-hidden="true"></span>
        <p class="step__eyebrow">Non è solo una destinazione.</p>
        <h2 id="step-title">È il prossimo passo.</h2>
        <p class="step__body">Dalla palestra di ogni giorno a una nuova esperienza internazionale.<br />Stessa disciplina. Una sfida più grande.</p>
      </div>
    </section>

    <section class="event" aria-labelledby="event-title">
      <picture class="event__ruins" aria-hidden="true">
        <source media="(max-width: 767px)" srcset="/images/road-to-greece/templio_mobile.png" />
        <img src="/images/road-to-greece/templio.png" alt="" loading="lazy" decoding="async" />
      </picture>
      <div class="event__grid shell">
        <div class="event__wing" aria-hidden="true">
          <img src="/images/road-to-greece/ying.png" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="event__copy">
          <p class="kicker">{page.event.kicker}</p>
          <h2 id="event-title">{page.event.title1}<br />{page.event.title2}</h2>
          <p class="event__date"><strong>{page.event.date}</strong><br />{page.event.place}</p>
          <p class="event__body">{page.event.body}</p>
          <a class="cta" href={page.event.url} target="_blank" rel="noopener noreferrer" data-interactive><span>{page.event.cta}</span><span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="closing" aria-label="Nafplio, nuovi orizzonti">
      <picture>
        <source media="(max-width: 767px)" srcset="/images/road-to-greece/panorama_mobile.png" />
        <img src="/images/road-to-greece/panorama.png" alt="" loading="lazy" decoding="async" />
      </picture>
      <div class="closing__shade" aria-hidden="true"></div>
      <div class="closing__copy shell"><span class="closing__script">Beyond<br />Limits</span><div class="closing__place"><b>NAFPLIO</b><small>Higher horizons</small></div></div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body){background:#07090a;color:#f5efe5}
  .rtg{--ink:#07090a;--paper:#f3ecdf;--gold:#c99427;--text:#121a21;overflow:hidden;background:var(--ink)}
  .shell{width:min(1180px,calc(100% - 72px));margin-inline:auto}
  .sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
  .kicker{display:flex;align-items:center;gap:13px;margin:0 0 16px;color:#44505a;font:800 .62rem/1 var(--font-ui);letter-spacing:.3em;text-transform:uppercase}.kicker::before{content:"";width:38px;height:2px;background:var(--gold)}
  .rtg-hero{position:relative;width:100%;margin:0;padding:0;overflow:hidden;background:#020405;line-height:0}
  .rtg-hero picture,.rtg-hero img{display:block;width:100%}.rtg-hero img{height:auto}
  .journey{background:linear-gradient(180deg,#f6f0e6,#eee5d8);color:var(--text);padding:52px 0 0}
  .journey__intro{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:52px;align-items:end}
  .journey__copy h2{margin:0 0 18px;font:500 clamp(3rem,5vw,5.2rem)/.9 Georgia,serif;letter-spacing:-.045em}.journey__copy h2 em{font-style:italic;color:#b57d18}.journey__copy>p{max-width:590px;margin:0;color:#2f373d;font:400 1rem/1.55 var(--font-body)}.journey__copy small{display:block;margin-top:18px;color:#60686d;font:800 .58rem/1 var(--font-ui);letter-spacing:.19em;text-transform:uppercase}.journey__aside{display:grid;gap:8px;padding-left:24px;border-left:1px solid rgba(16,24,32,.16);color:#5d666b;font:800 .62rem/1.5 var(--font-ui);letter-spacing:.18em;text-transform:uppercase}.journey__aside::after{content:"";width:32px;height:2px;background:var(--gold);margin-top:8px}.journey__map{width:min(1240px,100%);margin:16px auto 0;overflow:hidden;line-height:0}.journey__map picture,.journey__map img{display:block;width:100%}.journey__map img{height:auto;mix-blend-mode:multiply}
  .step{background:linear-gradient(180deg,#eee5d8,#f5eee4);color:var(--text);padding:58px 0 62px;border-top:1px solid rgba(18,26,33,.08);border-bottom:1px solid rgba(18,26,33,.08)}.step__inner{position:relative}.step__line{display:block;width:42px;height:2px;margin-bottom:20px;background:var(--gold)}.step__eyebrow{margin:0 0 10px;color:#5f676c;font:800 .66rem/1 var(--font-ui);letter-spacing:.22em;text-transform:uppercase}.step h2{margin:0 0 18px;color:#131b21;font:500 clamp(2.6rem,5vw,4.8rem)/.95 Georgia,serif;letter-spacing:-.035em}.step__body{margin:0;max-width:650px;color:#4a5359;font:400 1rem/1.6 var(--font-body)}
  .event{position:relative;background:linear-gradient(180deg,#f2eadf,#e9dfd1);color:var(--text);padding:22px 0 30px;overflow:hidden}.event__ruins{position:absolute;right:0;bottom:0;width:min(330px,24vw);height:100%;pointer-events:none;opacity:.2;z-index:0}.event__ruins img{display:block;width:100%;height:100%;object-fit:cover;object-position:right center}.event__grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(330px,.9fr) minmax(420px,1.1fr);gap:44px;align-items:stretch}.event__wing{min-height:350px;overflow:hidden}.event__wing img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;mix-blend-mode:multiply}.event__copy{padding:30px 0 18px}.event__copy h2{margin:0 0 14px;font:500 clamp(2.2rem,3.4vw,3.8rem)/.95 Georgia,serif;letter-spacing:-.035em;max-width:650px}.event__date{margin:0 0 18px;font:700 .94rem/1.45 var(--font-ui)}.event__body{max-width:560px;margin:0;color:#41494f;font:400 1rem/1.55 var(--font-body)}.cta{position:relative;z-index:3;display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-width:310px;margin-top:20px;padding:14px 18px;background:linear-gradient(90deg,#d3a33d,#e6bd58);color:#101820;text-decoration:none;font:900 .66rem/1 var(--font-ui);letter-spacing:.08em;text-transform:uppercase;pointer-events:auto;cursor:pointer}.cta:focus-visible{outline:3px solid #101820;outline-offset:3px}
  .closing{position:relative;height:150px;overflow:hidden;background:#1f2b33}.closing>picture,.closing>picture>img{display:block;width:100%;height:100%}.closing>picture>img{object-fit:cover;object-position:center 64%}.closing__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,12,15,.20),transparent 48%,rgba(8,12,15,.23))}.closing__copy{position:absolute;inset:0;display:flex;align-items:center;justify-content:space-between;color:#141a1e}.closing__script{font:italic 2rem/.9 Georgia,serif;transform:rotate(-8deg)}.closing__place{display:grid;gap:4px;text-align:right;letter-spacing:.2em;text-transform:uppercase}.closing__place b{font:900 .9rem/1 var(--font-ui)}.closing__place small{font:700 .55rem/1 var(--font-ui)}
  @media(max-width:767px){
    .shell{width:calc(100% - 32px)}.rtg-hero{height:auto;background:#020405;padding:0}.rtg-hero picture{display:block;width:100%;margin:0}.rtg-hero img{display:block;width:100%;height:auto;object-fit:contain}.journey{padding-top:26px}.journey__intro{display:block}.journey__copy h2{font-size:2.75rem;margin-bottom:14px}.journey__copy>p{font-size:.91rem;line-height:1.48}.journey__copy small{margin-top:12px}.journey__aside{display:none}.journey__map{width:94%;max-width:560px;height:auto;margin:12px auto 4px;overflow:visible}.journey__map picture,.journey__map img{display:block;width:100%;height:auto}.journey__map img{object-fit:contain;mix-blend-mode:multiply}.step{padding:36px 0 38px;background:linear-gradient(180deg,#eee5d8,#f5eee4)}.step__line{width:34px;margin-bottom:15px}.step__eyebrow{font-size:.56rem;letter-spacing:.19em;margin-bottom:8px}.step h2{font-size:2.25rem;margin-bottom:13px}.step__body{font-size:.88rem;line-height:1.5;max-width:340px}.event{padding:0 0 20px}.event__ruins{width:38%;height:58%;right:-9%;bottom:0;opacity:.1}.event__grid{display:block;width:100%}.event__wing{height:auto;min-height:0;overflow:visible;border:0;background:transparent;padding:4px 0 2px}.event__wing img{display:block;width:82%;max-width:520px;height:auto;margin:0 auto;object-fit:contain;object-position:center;mix-blend-mode:normal;opacity:1;transform:none}.event__copy{width:calc(100% - 32px);margin-inline:auto;padding:8px 0 4px}.event__copy h2{font-size:1.95rem;line-height:.96;margin-bottom:12px}.event__date{font-size:.8rem;margin-bottom:14px}.event__body{font-size:.9rem;line-height:1.48}.cta{width:100%;min-width:0;box-sizing:border-box;margin-top:14px}.closing{height:88px}.closing>picture>img{object-position:center 66%}.closing__copy{width:calc(100% - 28px)}.closing__script{font-size:1.1rem}.closing__place b{font-size:.64rem}.closing__place small{font-size:.42rem}
  }
  @media(max-width:390px){.journey__map{width:94%}.journey__copy h2{font-size:2.55rem}.event__wing img{width:80%}.closing{height:82px}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>