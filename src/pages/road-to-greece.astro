---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import page from "../data/road-to-greece.json";
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <Header />
  <main class="rtg" id="main">
    <section class="rtg-hero" aria-labelledby="rtg-title">
      <h1 id="rtg-title" class="sr-only">Arianna al 18th Palamidio Martial Arts Championship 2026, dal 13 al 15 novembre a Nafplio, in Grecia</h1>
      <picture>
        <source media="(max-width: 767px)" srcset="/images/road-to-greece/hero_mobile.webp" width="900" height="1200" />
        <img src="/images/road-to-greece/hero.webp" width="1774" height="887" alt="" decoding="async" fetchpriority="high" />
      </picture>
    </section>

    <section class="journey" aria-labelledby="journey-title">
      <div class="journey__intro shell">
        <div class="journey__copy">
          <p class="kicker">{page.route.kicker}</p>
          <h2 id="journey-title">{page.route.title1}<br /><em>{page.route.title2}</em></h2>
          <p>{page.route.body}</p>
          <dl class="journey__facts" aria-label="Informazioni sulla competizione">
            {page.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
          </dl>
        </div>
        <div class="step" aria-labelledby="step-title">
          <div class="step__inner">
            <span class="step__line" aria-hidden="true"></span>
            <p class="step__eyebrow">Non è solo una destinazione.</p>
            <h2 id="step-title">È il prossimo passo.</h2>
            <p class="step__body">Dalla palestra di ogni giorno a una nuova esperienza internazionale.<br />Stessa disciplina. Una sfida più grande.</p>
          </div>
        </div>
        <figure class="journey__map">
          <picture><img src="/images/road-to-greece/map.webp" width="1536" height="768" alt="Mappa stilizzata del percorso da Casoria a Nafplio." loading="lazy" decoding="async" /></picture>
        </figure>
      </div>
    </section>

    <section class="ying-bridge" aria-label="Yīng, la firma sportiva di Arianna">
      <div class="ying-bridge__inner shell">
        <div class="ying-bridge__art">
          <img src="/images/road-to-greece/ying.webp" width="1536" height="1152" alt="Stessa passione. Nuovi orizzonti. Yīng, l’aquila simbolo di Arianna." loading="lazy" decoding="async" />
        </div>
        <div class="ying-bridge__copy">
          <p class="kicker">Identità</p>
          <h2>Il simbolo<br /><em>di Arianna.</em></h2>
          <p class="ying-bridge__body">Un segno nato dal suo modo di affrontare ogni sfida, con sguardo alto, concentrazione e coraggio.</p>
          <a class="text-link" href="/ying/" data-interactive>Scopri Yīng <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="event" aria-labelledby="event-title">
      <picture class="event__scene" aria-hidden="true">
        <img src="/images/road-to-greece/nafplio-event.webp" width="1800" height="900" alt="" loading="lazy" decoding="async" />
      </picture>
      <div class="event__grid shell">
        <div class="event__copy">
          <p class="kicker">{page.event.kicker}</p>
          <h2 id="event-title">{page.event.title1}<br />{page.event.title2}</h2>
        </div>
        <div class="event__details">
          <p class="event__date"><strong>{page.event.date}</strong><br />{page.event.place}</p>
          <p class="event__body">Una nuova tappa nel percorso agonistico di Arianna, l’occasione per trasformare il lavoro quotidiano in esperienza.</p>
          <p class="event__history"><strong>Un legame nel nome.</strong> Sotto il dominio veneziano Nafplio era chiamata «Napoli di Romania». Nel linguaggio medievale “Romania” indicava le terre dell’Impero romano d’Oriente, non l’attuale Romania né il popolo rumeno, e distingueva la città greca dalla Napoli italiana.</p>
          <a class="cta" href={page.event.url} target="_blank" rel="noopener noreferrer" data-interactive><span>{page.event.cta}<span class="sr-only"> (si apre in una nuova scheda)</span></span><span aria-hidden="true">→</span></a>
          <p class="event__credit">Foto adattata da <a href="https://commons.wikimedia.org/wiki/File:BourtziCastleNafplio_gobeirne.jpg" target="_blank" rel="noopener noreferrer">Greg O’Beirne / Wikimedia Commons<span class="sr-only"> (si apre in una nuova scheda)</span></a> · <a href="https://creativecommons.org/licenses/by/2.5/" target="_blank" rel="noopener noreferrer">CC BY 2.5<span class="sr-only"> (si apre in una nuova scheda)</span></a></p>
        </div>
      </div>
    </section>

    <section class="closing" aria-label="Nafplio">
      <picture><img src="/images/road-to-greece/panorama.webp" width="1800" height="600" alt="" loading="lazy" decoding="async" /></picture>
      <div class="closing__shade" aria-hidden="true"></div>
      <div class="closing__copy shell"><div class="closing__place"><b>NAFPLIO</b></div></div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body){background:#07090a;color:#f5efe5}
  .rtg{--ink:#07090a;--paper:#f3ecdf;--gold:#c99427;--text:#121a21;overflow:hidden;background:var(--ink)}
  .shell{width:min(1180px,calc(100% - 72px));margin-inline:auto}
  .sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
  .kicker{display:flex;align-items:center;gap:13px;margin:0 0 16px;color:#44505a;font:800 .62rem/1 var(--font-ui);letter-spacing:.3em;text-transform:uppercase}.kicker::before{content:"";width:38px;height:2px;background:var(--gold)}
  .rtg-hero{position:relative;width:100%;margin:0;padding:0;overflow:hidden;background:#020405;line-height:0}.rtg-hero picture,.rtg-hero img{display:block;width:100%}.rtg-hero img{height:auto}
  .journey{background:linear-gradient(180deg,#f6f0e6 0%,#eee5d8 100%);color:var(--text);padding:96px 0 38px}.journey__intro{display:grid;grid-template-columns:minmax(0,7fr) minmax(300px,5fr);grid-template-areas:"copy step" "map map";column-gap:72px;row-gap:48px;align-items:start}.journey__copy{grid-area:copy}.journey__copy h2{margin:0 0 22px;font:500 clamp(3.4rem,5vw,5.2rem)/.9 Georgia,serif;letter-spacing:-.045em}.journey__copy h2 em{font-style:italic;color:#b57d18}.journey__copy>p{max-width:650px;margin:0;color:#2f373d;font:400 1rem/1.62 var(--font-body)}.journey__facts{display:flex;flex-wrap:wrap;gap:16px 32px;margin:28px 0 0;padding:22px 0 0;border-top:1px solid rgba(18,26,33,.12)}.journey__facts div{display:grid;gap:6px}.journey__facts dd{order:1;margin:0;color:#20282e;font:800 .76rem/1 var(--font-ui);letter-spacing:.04em}.journey__facts dt{order:2;color:#697177;font:800 .54rem/1 var(--font-ui);letter-spacing:.18em;text-transform:uppercase}.journey__map{grid-area:map;width:min(960px,100%);height:370px;margin:0 auto;overflow:hidden;line-height:0;-webkit-mask-image:linear-gradient(to right,transparent 0,#000 8%,#000 92%,transparent 100%),linear-gradient(to bottom,transparent 0,#000 12%,#000 88%,transparent 100%);-webkit-mask-composite:source-in;mask-image:linear-gradient(to right,transparent 0,#000 8%,#000 92%,transparent 100%),linear-gradient(to bottom,transparent 0,#000 12%,#000 88%,transparent 100%);mask-composite:intersect}.journey__map picture,.journey__map img{display:block;width:100%;height:100%}.journey__map img{object-fit:cover;mix-blend-mode:multiply}
  .step{grid-area:step;align-self:stretch;display:flex;align-items:flex-end;padding:24px 0 24px 40px;border-left:1px solid rgba(18,26,33,.16);color:var(--text)}.step__inner{position:relative}.step__line{display:block;width:42px;height:2px;margin-bottom:20px;background:var(--gold)}.step__eyebrow{margin:0 0 12px;color:#5f676c;font:800 .62rem/1.2 var(--font-ui);letter-spacing:.2em;text-transform:uppercase}.step h2{margin:0 0 18px;color:#131b21;font:500 clamp(2.45rem,3.4vw,3.7rem)/.95 Georgia,serif;letter-spacing:-.035em}.step__body{margin:0;max-width:430px;color:#4a5359;font:400 .98rem/1.6 var(--font-body)}
  .ying-bridge{position:relative;background:linear-gradient(180deg,#eee5d8,#f2eadf);color:var(--text);overflow:hidden}.ying-bridge__inner{display:grid;grid-template-columns:62% 38%;align-items:center;height:430px}.ying-bridge__art{height:100%;line-height:0;-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 8%,#000 74%,transparent 100%);mask-image:linear-gradient(180deg,transparent 0,#000 8%,#000 74%,transparent 100%)}.ying-bridge__art img{display:block;width:100%;height:100%;object-fit:contain;object-position:left center;mix-blend-mode:multiply}.ying-bridge__copy{padding:44px 0 44px 30px}.ying-bridge__copy h2{margin:0;color:#131b21;font:500 clamp(3rem,4.2vw,4.4rem)/.92 Georgia,serif;letter-spacing:-.04em}.ying-bridge__copy h2 em{color:#b57d18;font-style:italic}.ying-bridge__body{max-width:390px;margin:18px 0 0;color:#4b5052;font:400 .98rem/1.58 var(--font-body)}.text-link{display:inline-flex;min-height:24px;align-items:center;gap:14px;margin-top:20px;color:#7b5110;font:900 .68rem/1 var(--font-ui);letter-spacing:.13em;text-decoration:none;text-transform:uppercase}.text-link:focus-visible{outline:3px solid #8d641b;outline-offset:6px}
  .event{position:relative;min-height:320px;background:#071018;color:#f5efe5;overflow:hidden;border-top:1px solid rgba(146,28,30,.55)}.event__scene{position:absolute;inset:0;display:block}.event__scene img{width:100%;height:100%;object-fit:cover;object-position:54% 58%;filter:saturate(.64) contrast(1.06)}.event::before{content:"";position:absolute;z-index:1;inset:0;background:linear-gradient(90deg,rgba(5,14,21,.96) 0%,rgba(6,17,25,.91) 42%,rgba(7,20,30,.7) 67%,rgba(5,14,21,.56) 100%)}.event::after{content:"";position:absolute;z-index:1;inset:0;background:linear-gradient(180deg,rgba(4,11,17,.34),transparent 35%,rgba(4,11,17,.52));pointer-events:none}.event__grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(440px,1.05fr) minmax(360px,.95fr);gap:72px;min-height:320px;align-items:center}.event__copy{padding:42px 0;text-align:left}.event .kicker{justify-content:flex-start;color:#cfc6ba}.event__copy h2{margin:0;color:#f8f1e7;font:500 clamp(2.5rem,3.25vw,3.55rem)/.94 Georgia,serif;letter-spacing:-.04em}.event__details{position:relative;z-index:2;padding:24px 64px 22px 0}.event__date{margin:0 0 10px;color:#e6dcca;font:700 .88rem/1.4 var(--font-ui)}.event__body{max-width:500px;margin:0;color:#e2dbd0;font:400 .91rem/1.45 var(--font-body)}.event__history{max-width:510px;margin:10px 0 0;padding-left:12px;border-left:2px solid rgba(214,167,68,.72);color:#c9c3ba;font:400 .77rem/1.45 var(--font-body)}.event__history strong{color:#e7c16d;font-family:var(--font-ui);font-size:.68rem;letter-spacing:.04em;text-transform:uppercase}.event__credit{display:block;width:max-content;max-width:100%;margin:7px 0 0;color:rgba(235,228,217,.58);font:500 .5rem/1.3 var(--font-ui)}.event__credit a{color:inherit;text-decoration:none}.event__credit a:hover{text-decoration:underline}.event__credit a:focus-visible{outline:2px solid #f5efe5;outline-offset:3px}.cta{position:relative;z-index:3;display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-width:310px;margin-top:14px;padding:13px 18px;background:linear-gradient(90deg,#d3a33d,#e6bd58);color:#101820;text-decoration:none;font:900 .66rem/1 var(--font-ui);letter-spacing:.08em;text-transform:uppercase;pointer-events:auto;cursor:pointer;transition:filter .2s ease,transform .2s ease}.cta:hover{filter:brightness(1.08);transform:translateY(-1px)}.cta:focus-visible{outline:3px solid #f5efe5;outline-offset:4px}
  .closing{display:none}
  @media(min-width:768px) and (max-width:1099px){
    .shell{width:calc(100% - 48px)}
    .journey{padding:72px 0 38px}.journey__intro{grid-template-columns:1fr;grid-template-areas:"copy" "step" "map";row-gap:40px}.journey__copy h2{font-size:clamp(3rem,7vw,4.5rem)}.step{padding:36px 0 0;border-left:0;border-top:1px solid rgba(18,26,33,.12)}.step h2{font-size:clamp(2.4rem,5vw,3.2rem)}.journey__map{height:350px}
    .ying-bridge__inner{grid-template-columns:55% 45%;height:440px}.ying-bridge__copy{padding-left:24px}.ying-bridge__copy h2{font-size:clamp(2.7rem,5vw,3.6rem)}
    .event{min-height:410px}.event__grid{grid-template-columns:minmax(0,46fr) minmax(0,54fr);gap:34px;min-height:410px}.event__copy{width:auto;padding:44px 0}.event__copy h2{font-size:clamp(2.45rem,4.8vw,3.2rem)}.event__details{padding:30px 24px 28px 0}.event__details .cta{width:min(100%,310px);min-width:0;box-sizing:border-box}
  }
  @media(max-width:767px){
    .shell{width:calc(100% - 32px)}.rtg-hero{height:auto;background:#020405;padding:0}.rtg-hero picture{display:block;width:100%;margin:0}.rtg-hero img{display:block;width:100%;height:auto;object-fit:contain}.journey{padding:26px 0 20px}.journey__intro{display:grid;grid-template-columns:1fr;grid-template-areas:"copy" "step" "map";gap:0}.journey__copy h2{font-size:2.75rem;margin-bottom:14px}.journey__copy>p{font-size:.91rem;line-height:1.48}.journey__facts{gap:14px 22px;margin-top:20px;padding-top:16px}.journey__facts dd{font-size:.68rem}.journey__facts dt{font-size:.5rem}
    .journey__map{position:relative;width:96%;max-width:580px;height:auto;margin:12px auto 0;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 9%,#000 91%,transparent 100%),linear-gradient(180deg,transparent 0,#000 10%,#000 90%,transparent 100%);-webkit-mask-composite:source-in;mask-image:linear-gradient(90deg,transparent 0,#000 9%,#000 91%,transparent 100%),linear-gradient(180deg,transparent 0,#000 10%,#000 90%,transparent 100%);mask-composite:intersect}.journey__map picture,.journey__map img{display:block;width:100%;height:auto}.journey__map img{object-fit:contain;mix-blend-mode:multiply}
    .step{display:block;padding:36px 0 38px;border-left:0;border-top:1px solid rgba(18,26,33,.08);background:transparent}.step__line{width:34px;margin-bottom:15px}.step__eyebrow{font-size:.56rem;letter-spacing:.19em;margin-bottom:8px}.step h2{font-size:2.25rem;margin-bottom:13px}.step__body{font-size:.88rem;line-height:1.5;max-width:340px}
    .ying-bridge{display:block;padding:0 0 34px}.ying-bridge__inner{display:flex;flex-direction:column;width:100%;height:auto;min-height:0}.ying-bridge__art{width:100%;height:auto;-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 7%,#000 76%,transparent 100%);mask-image:linear-gradient(180deg,transparent 0,#000 7%,#000 76%,transparent 100%)}.ying-bridge__art img{width:100%;height:auto;margin:0;object-fit:contain}.ying-bridge__copy{width:calc(100% - 32px);box-sizing:border-box;margin:-12px auto 0;padding:0}.ying-bridge__copy h2{font-size:2.3rem}.text-link{min-height:44px;margin-top:12px}
    .ying-bridge__body{margin-top:14px;font-size:.9rem;line-height:1.5}.event{min-height:570px}.event__scene img{object-position:58% center}.event::before{background:linear-gradient(180deg,rgba(5,14,21,.78),rgba(5,14,21,.91) 54%,rgba(5,14,21,.94))}.event__grid{display:flex;flex-direction:column;justify-content:center;gap:0;min-height:570px;width:calc(100% - 32px)}.event__copy{width:100%;padding:42px 0 0;text-align:center}.event__details{width:100%;box-sizing:border-box;padding:0 0 34px;text-align:center}.event .kicker{justify-content:center;color:#cfc6ba}.event .kicker::before{display:none}.event__copy h2{color:#f8f1e7;font-size:2.15rem;line-height:.96;margin-bottom:16px}.event__date{color:#e6dcca;font-size:.8rem;margin-bottom:12px}.event__body{color:#e2dbd0;font-size:.88rem;line-height:1.45}.event__history{margin:12px 0 0;padding:0 0 0 10px;text-align:left;font-size:.74rem;line-height:1.45}.event__credit{width:auto;margin-top:8px}.cta{width:100%;min-width:0;box-sizing:border-box;margin-top:16px}.closing{display:block;height:105px}.closing>picture,.closing>picture>img{display:block;width:100%;height:100%}.closing>picture>img{object-fit:cover;object-position:center 66%}.closing__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,12,15,.28),rgba(8,12,15,.06),rgba(8,12,15,.42))}.closing__copy{position:absolute;inset:0;display:flex;align-items:center;justify-content:flex-end;color:#f5efe5;text-shadow:0 2px 20px rgba(0,0,0,.65);width:calc(100% - 28px)}.closing__place{letter-spacing:.2em;text-transform:uppercase}.closing__place b{font:900 .66rem/1 var(--font-ui)}
  }
  @media(max-width:390px){.journey__map{width:98%}.journey__copy h2{font-size:2.55rem}.closing{height:100px}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
