---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import page from "../data/road-to-greece.json";
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <main class="rtg" id="main">
    <Header />

    <section class="hero" aria-labelledby="rtg-title">
      <div class="hero__noise" aria-hidden="true"></div>
      <div class="hero__flag" aria-hidden="true"></div>
      <div class="hero__brush" aria-hidden="true"></div>
      <div class="hero__18" aria-hidden="true">18</div>

      <div class="shell hero__inner">
        <div class="hero__copy">
          <p class="kicker kicker--light">{page.hero.kicker}</p>
          <h1 id="rtg-title">
            <span>{page.hero.title1}</span>
            <em>{page.hero.title2}</em>
            <strong>{page.hero.title3}</strong>
          </h1>

          <div class="hero__event">
            <b>{page.hero.eventLine1}</b>
            <span>{page.hero.eventLine2}</span>
          </div>

          <div class="hero__facts" aria-label="Informazioni principali">
            {page.hero.facts.map((fact, i) => <><span>{fact}</span>{i < page.hero.facts.length - 1 && <i aria-hidden="true"></i>}</>)}
            <span class="it-flag" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="route" aria-labelledby="route-title">
      <div class="shell">
        <div class="route__top">
          <div class="route__copy">
            <p class="kicker">{page.route.kicker}</p>
            <h2 id="route-title">{page.route.title1}<br /><em>{page.route.title2}</em></h2>
            <p>{page.route.body}</p>
            <small>{page.route.tagline}</small>
          </div>

          <div class="route__map" role="img" aria-label="Percorso simbolico da Casoria a Nafplio">
            <svg viewBox="0 0 780 360" aria-hidden="true">
              <path class="map-land italy" d="M154 35l41 11 20 27-6 26 17 21-7 22 22 25-12 21 15 24-17 11-18-16-12 9-14-19-20-2-5-28 14-16-17-23 11-22-14-25 2-25z"/>
              <path class="map-land greece" d="M611 176l22-16 22 7 4 19 19 10-2 21 18 12-12 18-22-5-10 18-20-10-8 15-16-12 5-19-19-10 11-16z"/>
              <path class="route-line" d="M208 157 C338 137 455 159 623 224"/>
              <circle class="route-dot" cx="208" cy="157" r="8"/>
              <circle class="route-dot" cx="623" cy="224" r="8"/>
              <g class="plane" transform="translate(424 165) rotate(15)"><path d="M-28-3h24l15-25h7L9-3l23 3L9 4l9 25h-7L-4 6h-24l-10 10h-5l5-15-5-15h5z"/></g>
              <text class="map-city" x="222" y="138">CASORIA</text>
              <text class="map-country" x="222" y="159">ITALY</text>
              <text class="map-city" x="640" y="210">NAFPLIO</text>
              <text class="map-country" x="640" y="232">GREECE</text>
            </svg>
          </div>

          <aside class="route__aside" aria-label="Messaggio">
            {page.route.aside.map(line => <span>{line}</span>)}
          </aside>
        </div>

        <div class="facts" aria-label="Dettagli gara">
          {page.facts.map(fact => (
            <div class="fact">
              <span class={`fact__icon fact__icon--${fact.kind}`} aria-hidden="true"></span>
              <strong>{fact.value}</strong>
              <span>{fact.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="event" aria-labelledby="event-title">
      <div class="shell event__grid">
        <div class="wing-panel" aria-hidden="true">
          <div class="wing-panel__label">Stessa passione.<br />Nuovi orizzonti.</div>
          <svg viewBox="0 0 520 370">
            <path class="wing-base" d="M30 320C110 302 182 250 235 181c61-80 132-118 245-139-69 44-113 84-149 131 43-31 91-51 145-62-49 33-92 68-127 105 43-22 88-34 133-37-50 27-95 58-136 94 36-12 73-17 109-13-51 18-101 47-144 80-77 59-161 51-286-20Z"/>
            <path class="feather" d="M225 191c72-57 140-94 231-121"/><path class="feather" d="M205 219c78-46 155-72 249-82"/><path class="feather" d="M182 246c82-32 164-47 260-37"/><path class="feather" d="M151 272c78-20 153-19 233 2"/><path class="feather" d="M111 297c69-8 130 3 196 28"/>
            <path class="wing-red" d="M42 338c72-21 139-29 205-23"/>
          </svg>
        </div>

        <div class="event__copy">
          <p class="kicker">{page.event.kicker}</p>
          <h2 id="event-title">{page.event.title1}<br />{page.event.title2}</h2>
          <p class="event__date">{page.event.date}<br /><span>{page.event.place}</span></p>
          <p class="event__body">{page.event.body}</p>
          <a class="cta" href={page.event.url} target="_blank" rel="noopener noreferrer" data-interactive>{page.event.cta}<span aria-hidden="true">→</span></a>
        </div>

        <blockquote class="quote">
          <span class="quote__mark" aria-hidden="true">“</span>
          <p>{page.quote.text}</p>
          <footer>{page.quote.author}</footer>
        </blockquote>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
:global(body){background:#050708;color:#f4eee2}.rtg{--ink:#050708;--blue:#08141d;--paper:#f4eee2;--paper2:#e9dfce;--gold:#d7a52f;--gold2:#e8c35f;--gblue:#0d5eaf;--red:#8e271f;overflow:hidden;background:var(--ink)}.shell{width:min(1240px,calc(100% - 72px));margin-inline:auto}.kicker{display:flex;align-items:center;gap:14px;margin:0 0 18px;color:#374047;font:800 .66rem/1 var(--font-ui);letter-spacing:.31em;text-transform:uppercase}.kicker::before{content:"";width:38px;height:2px;background:var(--gold)}.kicker--light{color:rgba(255,255,255,.78)}
.hero{position:relative;min-height:660px;display:flex;align-items:flex-end;isolation:isolate;background:linear-gradient(118deg,#030506 0%,#061018 55%,#0a1922 100%)}.hero__noise{position:absolute;inset:0;z-index:-1;opacity:.65;background:repeating-linear-gradient(168deg,transparent 0 20px,rgba(255,255,255,.015) 21px 22px),radial-gradient(circle at 18% 20%,rgba(255,255,255,.04),transparent 28%)}.hero__flag{position:absolute;right:-4%;top:-12%;z-index:-3;width:min(700px,52vw);height:650px;opacity:.74;transform:rotate(-7deg);background:repeating-linear-gradient(180deg,var(--gblue) 0 48px,#f7f4ed 48px 96px);clip-path:polygon(8% 0,100% 0,100% 91%,18% 100%,0 83%,9% 67%,0 42%)}.hero__flag::before{content:"";position:absolute;left:0;top:0;width:278px;height:278px;background:var(--gblue)}.hero__flag::after{content:"";position:absolute;left:0;top:0;width:278px;height:278px;background:linear-gradient(90deg,transparent 38%,#fff 38% 58%,transparent 58%),linear-gradient(0deg,transparent 38%,#fff 38% 58%,transparent 58%)}.hero__brush{position:absolute;right:-2%;top:0;bottom:0;width:62%;z-index:-2;background:repeating-linear-gradient(155deg,transparent 0 18px,rgba(0,0,0,.2) 19px 34px),linear-gradient(105deg,transparent 3%,rgba(2,5,8,.08) 25%,rgba(2,5,8,.38) 74%,rgba(2,5,8,.08) 100%);clip-path:polygon(21% 0,100% 0,100% 100%,7% 100%,18% 76%,4% 58%,20% 38%,8% 18%)}.hero__18{position:absolute;right:14%;bottom:46px;z-index:-1;color:var(--gold);font:900 clamp(16rem,31vw,31rem)/.72 var(--font-display);letter-spacing:-.14em;transform:rotate(-8deg);text-shadow:0 0 34px rgba(215,165,47,.13)}.hero__inner{padding:145px 0 46px}.hero__copy{width:min(620px,52vw);position:relative;z-index:2}.hero h1{margin:0;text-transform:uppercase;letter-spacing:-.045em}.hero h1 span,.hero h1 em,.hero h1 strong{display:block}.hero h1 span{font:900 clamp(4.2rem,7vw,7.2rem)/.8 var(--font-display);color:#fff}.hero h1 em{margin-top:10px;font:900 clamp(3.5rem,5.7vw,5.9rem)/.82 var(--font-display);font-style:normal;color:var(--gold2)}.hero h1 strong{margin-top:9px;font:900 clamp(3rem,5vw,5rem)/.84 var(--font-display);color:#fff}.hero__event{display:grid;gap:3px;margin-top:27px;text-transform:uppercase}.hero__event b{font:900 1.62rem/1 var(--font-display);letter-spacing:.04em}.hero__event span{font:800 1rem/1.2 var(--font-ui);letter-spacing:.08em}.hero__event::after{content:"";width:215px;height:2px;margin-top:14px;background:var(--gold)}.hero__facts{display:flex;align-items:center;gap:13px;flex-wrap:wrap;margin-top:16px;font:900 .85rem/1 var(--font-ui);letter-spacing:.09em;text-transform:uppercase}.hero__facts i{width:1px;height:18px;background:rgba(232,195,95,.7)}.it-flag{display:inline-block;width:23px;height:15px;background:linear-gradient(90deg,#169b62 0 33.33%,#fff 33.33% 66.66%,#ce2b37 66.66%)}
.route{padding:50px 0 0;background:linear-gradient(180deg,#f7f1e7,#eee5d7);color:#111a22}.route__top{display:grid;grid-template-columns:minmax(280px,.92fr) minmax(470px,1.45fr) 145px;gap:32px;align-items:center}.route__copy h2{margin:0 0 18px;font:500 clamp(2.8rem,4.6vw,4.9rem)/.92 Georgia,serif;letter-spacing:-.04em}.route__copy h2 em{color:#b98421;font-style:italic}.route__copy>p{max-width:395px;margin:0;color:#252d32;font:400 1rem/1.5 var(--font-body)}.route__copy small{display:block;margin-top:18px;color:#5c6469;font:800 .58rem/1 var(--font-ui);letter-spacing:.19em;text-transform:uppercase}.route__map svg{display:block;width:100%;height:auto}.map-land{fill:#d7cec0;opacity:.54}.route-line{fill:none;stroke:var(--gold);stroke-width:3;stroke-dasharray:10 8}.route-dot{fill:#fff;stroke:var(--gold);stroke-width:6}.plane{fill:var(--gold)}.map-city{font:900 18px var(--font-ui);fill:#1a2228}.map-country{font:700 13px var(--font-ui);fill:#6e757a;letter-spacing:2px}.route__aside{display:grid;align-content:center;gap:8px;min-height:180px;padding-left:24px;border-left:1px solid rgba(17,26,34,.18);color:#555f66;font:800 .64rem/1.05 var(--font-ui);letter-spacing:.2em;text-transform:uppercase}.route__aside::after{content:"";width:30px;height:2px;margin-top:10px;background:var(--gold)}.facts{display:grid;grid-template-columns:repeat(4,1fr);margin-top:34px;border-top:1px solid rgba(17,26,34,.12);border-bottom:1px solid rgba(17,26,34,.12)}.fact{position:relative;display:grid;justify-items:center;gap:7px;padding:22px 16px 25px;text-align:center}.fact:not(:last-child)::after{content:"";position:absolute;right:0;top:20%;bottom:20%;width:1px;background:rgba(17,26,34,.13)}.fact__icon{width:31px;height:31px;position:relative;color:#bf861c}.fact__icon--calendar::before{content:"";position:absolute;inset:6px 2px 2px;border:3px solid currentColor;border-radius:2px}.fact__icon--calendar::after{content:"";position:absolute;left:5px;right:5px;top:11px;height:3px;background:currentColor;box-shadow:5px -8px 0 -1px currentColor,-5px -8px 0 -1px currentColor}.fact__icon--sanda::before{content:"";position:absolute;width:10px;height:10px;border-radius:50%;background:currentColor;left:11px;top:0}.fact__icon--sanda::after{content:"";position:absolute;left:13px;top:10px;width:7px;height:19px;background:currentColor;transform:rotate(30deg);box-shadow:-8px 9px 0 -2px currentColor,8px 8px 0 -2px currentColor}.fact__icon--weight::before{content:"";position:absolute;left:5px;right:5px;bottom:1px;height:22px;border-radius:4px 4px 7px 7px;background:currentColor}.fact__icon--weight::after{content:"";position:absolute;left:10px;top:0;width:11px;height:8px;border:3px solid currentColor;border-bottom:0;border-radius:6px 6px 0 0}.fact__icon--pin::before{content:"";position:absolute;left:5px;top:0;width:22px;height:27px;background:currentColor;border-radius:50% 50% 50% 0;transform:rotate(-45deg)}.fact__icon--pin::after{content:"";position:absolute;left:12px;top:7px;width:8px;height:8px;border-radius:50%;background:#f3ecdf}.fact strong{font:900 .95rem/1.1 var(--font-display);text-transform:uppercase}.fact>span:last-child{color:#657077;font:800 .56rem/1 var(--font-ui);letter-spacing:.22em;text-transform:uppercase}
.event{background:linear-gradient(180deg,#f2eadf,#ebe2d3);color:#101820;padding:20px 0 36px}.event__grid{display:grid;grid-template-columns:minmax(260px,.92fr) minmax(380px,1.08fr) minmax(220px,.7fr);gap:28px;align-items:stretch}.wing-panel{position:relative;min-height:320px;overflow:hidden;border-right:1px solid rgba(16,24,32,.12)}.wing-panel__label{position:absolute;z-index:2;left:0;top:25px;color:#4f5960;font:800 .64rem/1.55 var(--font-ui);letter-spacing:.18em;text-transform:uppercase}.wing-panel svg{position:absolute;left:-42px;bottom:-30px;width:118%;height:auto}.wing-base,.feather{fill:none;stroke:#676d70;stroke-linecap:round}.wing-base{stroke-width:12;opacity:.28}.feather{stroke-width:4;opacity:.22}.wing-red{fill:none;stroke:var(--red);stroke-width:6;stroke-linecap:round;opacity:.65}.event__copy{padding:24px 10px 10px}.event__copy h2{margin:0 0 12px;font:500 clamp(2rem,3vw,3.15rem)/.95 Georgia,serif;letter-spacing:-.035em}.event__date{margin:0 0 18px;font:900 .88rem/1.45 var(--font-ui);text-transform:uppercase}.event__date span{font-weight:700;text-transform:none}.event__body{max-width:520px;color:#414a50;font:400 .98rem/1.5 var(--font-body)}.cta{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;min-width:290px;margin-top:8px;padding:14px 18px;background:linear-gradient(90deg,#d3a33d,#e5bd59);color:#101820;font:900 .66rem/1 var(--font-ui);letter-spacing:.08em;text-transform:uppercase}.quote{margin:0;padding:30px 0 10px 34px;border-left:1px solid rgba(16,24,32,.12);align-self:center}.quote__mark{display:block;color:var(--gold);font:700 4.5rem/.5 Georgia,serif}.quote p{margin:12px 0 24px;font:italic 1.65rem/1.18 Georgia,serif}.quote footer{font:800 .65rem/1 var(--font-ui);letter-spacing:.28em;text-transform:uppercase}
@media(max-width:980px){.shell{width:calc(100% - 36px)}.hero{min-height:620px}.hero__flag{width:64vw;right:-14%}.hero__18{right:6%;opacity:.78}.hero__copy{width:64vw}.route__top{grid-template-columns:1fr}.route__aside{display:none}.route__map{order:2}.facts{grid-template-columns:repeat(2,1fr)}.fact:nth-child(2)::after{display:none}.event__grid{grid-template-columns:1fr 1fr}.wing-panel{grid-row:1 / span 2}.quote{border-left:0;border-top:1px solid rgba(16,24,32,.12);padding:25px 0 0}}
@media(max-width:640px){.hero{min-height:670px;align-items:flex-end}.hero__inner{padding:118px 0 34px}.hero__copy{width:100%}.hero__flag{width:92vw;height:500px;right:-34%;top:-5%;opacity:.48}.hero__18{right:-2%;bottom:88px;font-size:15rem;opacity:.42}.hero h1 span{font-size:3.55rem}.hero h1 em{font-size:2.8rem}.hero h1 strong{font-size:2.55rem}.hero__event b{font-size:1.3rem}.hero__event span{font-size:.86rem}.hero__facts{max-width:320px;gap:10px;font-size:.72rem}.route{padding-top:34px}.route__copy h2{font-size:3rem}.route__copy>p{font-size:.95rem}.route__map{margin-top:4px}.route__map svg{transform:scale(1.08);transform-origin:center}.facts{grid-template-columns:1fr 1fr;margin-top:18px}.fact{padding:18px 10px 20px}.fact strong{font-size:.8rem}.event{padding-top:8px}.event__grid{grid-template-columns:1fr}.wing-panel{min-height:250px;border-right:0;border-bottom:1px solid rgba(16,24,32,.12)}.wing-panel svg{width:105%;left:-22px;bottom:-46px}.event__copy{padding:24px 0}.event__copy h2{font-size:2.3rem}.quote{padding:24px 0 8px}.quote p{font-size:1.45rem}.cta{min-width:0;width:100%}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
