---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import page from "../data/road-to-greece.json";
import heroMobileRaw from "../data/road-to-greece/generated/hero-mobile-clean.txt?raw";
import mapMobileRaw from "../data/road-to-greece/generated/map-mobile-clean.txt?raw";
import wingMobileRaw from "../data/road-to-greece/generated/wing-mobile-clean.txt?raw";
import panoramaMobileRaw from "../data/road-to-greece/generated/panorama-mobile-clean.txt?raw";
import ruinsMobileRaw from "../data/road-to-greece/generated/ruins-mobile-clean.txt?raw";

const heroMobile = `data:image/webp;base64,${heroMobileRaw.trim()}`;
const mapMobile = `data:image/webp;base64,${mapMobileRaw.trim()}`;
const wingMobile = `data:image/webp;base64,${wingMobileRaw.trim()}`;
const panoramaMobile = `data:image/webp;base64,${panoramaMobileRaw.trim()}`;
const ruinsMobile = `data:image/webp;base64,${ruinsMobileRaw.trim()}`;
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <main class="rtg" id="main">
    <Header />

    <section class="hero" aria-labelledby="rtg-title">
      <h1 id="rtg-title" class="sr-only">Arianna al Palamidio 2026</h1>
      <img src={heroMobile} alt="" width="768" height="384" decoding="async" fetchpriority="high" />
    </section>

    <section class="journey" aria-labelledby="journey-title">
      <div class="journey__intro shell">
        <div class="journey__copy">
          <p class="kicker">La prossima sfida</p>
          <h2 id="journey-title">Da Casoria<br /><em>a Nafplio.</em></h2>
          <p>{page.route.body}</p>
          <small>{page.route.tagline}</small>
        </div>
        <div class="journey__aside" aria-hidden="true">
          <span>Più di una gara.</span>
          <span>Un’esperienza che fa crescere.</span>
        </div>
      </div>

      <figure class="journey__map">
        <img src={mapMobile} alt="Mappa stilizzata del percorso da Casoria a Nafplio." width="768" height="1365" loading="eager" decoding="async" />
      </figure>

      <div class="facts shell" aria-label="Dettagli gara">
        {page.facts.map(fact => (
          <div class="fact">
            <span class={`fact__icon fact__icon--${fact.kind}`} aria-hidden="true"></span>
            <strong>{fact.value}</strong>
            <span>{fact.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="event" aria-labelledby="event-title">
      <img class="event__ruins" src={ruinsMobile} alt="" width="959" height="1536" loading="lazy" decoding="async" aria-hidden="true" />
      <div class="event__grid shell">
        <div class="event__wing" aria-hidden="true">
          <img src={wingMobile} alt="" width="1152" height="1536" loading="lazy" decoding="async" />
        </div>
        <div class="event__copy">
          <p class="kicker">{page.event.kicker}</p>
          <h2 id="event-title">{page.event.title1}<br />{page.event.title2}</h2>
          <p class="event__date"><strong>{page.event.date}</strong><br />{page.event.place}</p>
          <p class="event__body">{page.event.body}</p>
          <a class="cta" href={page.event.url} target="_blank" rel="noopener noreferrer" data-interactive>
            <span>{page.event.cta}</span><span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="closing" aria-label="Nafplio, nuovi orizzonti">
      <img src={panoramaMobile} alt="" width="1024" height="1536" loading="lazy" decoding="async" />
      <div class="closing__shade" aria-hidden="true"></div>
      <div class="closing__copy shell">
        <span class="closing__script">Beyond<br />Limits</span>
        <div class="closing__place"><b>NAFPLIO</b><small>Higher horizons</small></div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
:global(body){background:#07090a;color:#f5efe5}.rtg{--ink:#07090a;--paper:#f3ecdf;--paper2:#ece2d4;--gold:#c99427;--gold2:#e4bb55;--text:#121a21;overflow:hidden;background:var(--ink)}.shell{width:min(1180px,calc(100% - 72px));margin-inline:auto}.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}.kicker{display:flex;align-items:center;gap:13px;margin:0 0 16px;color:#44505a;font:800 .62rem/1 var(--font-ui);letter-spacing:.3em;text-transform:uppercase}.kicker::before{content:"";width:38px;height:2px;background:var(--gold)}
.hero{background:#020405}.hero img{display:block;width:100%;height:auto;max-height:690px;object-fit:cover;object-position:center}
.journey{background:linear-gradient(180deg,#f6f0e6,#eee5d8);color:var(--text);padding:46px 0 0}.journey__intro{display:grid;grid-template-columns:minmax(0,1fr) 210px;gap:48px;align-items:end}.journey__copy h2{margin:0 0 18px;font:500 clamp(3rem,5vw,5.2rem)/.9 Georgia,serif;letter-spacing:-.045em}.journey__copy h2 em{font-style:italic;color:#b57d18}.journey__copy>p{max-width:590px;margin:0;color:#2f373d;font:400 1rem/1.55 var(--font-body)}.journey__copy small{display:block;margin-top:18px;color:#60686d;font:800 .58rem/1 var(--font-ui);letter-spacing:.19em;text-transform:uppercase}.journey__aside{display:grid;gap:8px;padding-left:24px;border-left:1px solid rgba(16,24,32,.16);color:#5d666b;font:800 .62rem/1.5 var(--font-ui);letter-spacing:.18em;text-transform:uppercase}.journey__aside::after{content:"";width:32px;height:2px;background:var(--gold);margin-top:8px}.journey__map{width:min(1120px,94vw);margin:18px auto 0;overflow:hidden}.journey__map img{display:block;width:100%;height:420px;object-fit:cover;object-position:center 48%}.facts{display:grid;grid-template-columns:repeat(3,1fr);margin-top:14px;border-top:1px solid rgba(16,24,32,.12);border-bottom:1px solid rgba(16,24,32,.12)}.fact{position:relative;display:grid;justify-items:center;gap:7px;padding:20px 14px 24px;text-align:center}.fact:not(:last-child)::after{content:"";position:absolute;right:0;top:20%;bottom:20%;width:1px;background:rgba(16,24,32,.13)}.fact strong{font:900 .92rem/1.1 var(--font-display);text-transform:uppercase}.fact>span:last-child{color:#687177;font:800 .54rem/1 var(--font-ui);letter-spacing:.22em;text-transform:uppercase}.fact__icon{width:30px;height:30px;position:relative;color:#bf861c}.fact__icon--calendar::before{content:"";position:absolute;inset:6px 2px 2px;border:3px solid currentColor;border-radius:2px}.fact__icon--calendar::after{content:"";position:absolute;left:5px;right:5px;top:11px;height:3px;background:currentColor;box-shadow:5px -8px 0 -1px currentColor,-5px -8px 0 -1px currentColor}.fact__icon--weight::before{content:"";position:absolute;left:5px;right:5px;bottom:1px;height:22px;border-radius:4px 4px 7px 7px;background:currentColor}.fact__icon--weight::after{content:"";position:absolute;left:10px;top:0;width:11px;height:8px;border:3px solid currentColor;border-bottom:0;border-radius:6px 6px 0 0}.fact__icon--pin::before{content:"";position:absolute;left:5px;top:0;width:22px;height:27px;background:currentColor;border-radius:50% 50% 50% 0;transform:rotate(-45deg)}.fact__icon--pin::after{content:"";position:absolute;left:12px;top:7px;width:8px;height:8px;border-radius:50%;background:#f3ecdf}
.event{position:relative;background:linear-gradient(180deg,#f2eadf,#e9dfd1);color:var(--text);padding:26px 0 34px;overflow:hidden}.event__ruins{position:absolute;right:-4%;bottom:0;width:min(330px,25vw);height:100%;object-fit:cover;object-position:right center;opacity:.22;pointer-events:none}.event__grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(300px,.9fr) minmax(420px,1.1fr);gap:42px;align-items:stretch}.event__wing{min-height:360px;overflow:hidden;border-right:1px solid rgba(16,24,32,.12)}.event__wing img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 42%}.event__copy{padding:26px 0 20px}.event__copy h2{margin:0 0 14px;font:500 clamp(2.2rem,3.4vw,3.8rem)/.95 Georgia,serif;letter-spacing:-.035em;max-width:650px}.event__date{margin:0 0 18px;font:700 .94rem/1.45 var(--font-ui)}.event__body{max-width:560px;margin:0;color:#41494f;font:400 1rem/1.55 var(--font-body)}.cta{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-width:310px;margin-top:20px;padding:14px 18px;background:linear-gradient(90deg,#d3a33d,#e6bd58);color:#101820;text-decoration:none;font:900 .66rem/1 var(--font-ui);letter-spacing:.08em;text-transform:uppercase}.cta:hover,.cta:focus-visible{filter:brightness(1.04)}
.closing{position:relative;height:165px;overflow:hidden;background:#1f2b33}.closing img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 67%}.closing__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,12,15,.22),rgba(8,12,15,0) 48%,rgba(8,12,15,.24))}.closing__copy{position:absolute;inset:0;display:flex;align-items:center;justify-content:space-between;color:#141a1e}.closing__script{font:italic 2.1rem/.9 Georgia,serif;color:#10161a;transform:rotate(-8deg)}.closing__place{display:grid;gap:4px;text-align:right;letter-spacing:.2em;text-transform:uppercase}.closing__place b{font:900 .9rem/1 var(--font-ui)}.closing__place small{font:700 .55rem/1 var(--font-ui)}
@media(max-width:767px){.shell{width:calc(100% - 32px)}.hero img{height:auto;max-height:none}.journey{padding-top:28px}.journey__intro{display:block}.journey__copy h2{font-size:3rem}.journey__copy>p{font-size:.94rem;line-height:1.5}.journey__copy small{margin-top:14px}.journey__aside{display:none}.journey__map{width:100%;margin-top:14px}.journey__map img{height:auto;max-height:520px;object-fit:cover;object-position:center 45%}.facts{grid-template-columns:repeat(3,1fr);width:100%;margin-top:0}.fact{padding:16px 6px 18px;gap:6px}.fact strong{font-size:.72rem;line-height:1.1}.fact>span:last-child{font-size:.48rem;letter-spacing:.14em}.fact__icon{transform:scale(.88)}.event{padding:0 0 24px}.event__ruins{width:42%;right:-13%;opacity:.15}.event__grid{display:block;width:100%}.event__wing{height:172px;min-height:0;border-right:0;border-bottom:1px solid rgba(16,24,32,.12)}.event__wing img{width:100%;height:100%;object-fit:cover;object-position:center 46%}.event__copy{width:calc(100% - 32px);margin-inline:auto;padding:24px 0 6px}.event__copy h2{font-size:2.25rem;line-height:.96}.event__date{font-size:.86rem}.event__body{font-size:.94rem}.cta{width:100%;min-width:0;box-sizing:border-box;margin-top:16px}.closing{height:108px}.closing img{object-position:center 72%}.closing__copy{width:calc(100% - 28px)}.closing__script{font-size:1.3rem}.closing__place b{font-size:.68rem}.closing__place small{font-size:.45rem}}
@media(max-width:390px){.journey__copy h2{font-size:2.7rem}.facts{grid-template-columns:1fr 1fr 1fr}.fact strong{font-size:.66rem}.event__wing{height:154px}.closing{height:96px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
