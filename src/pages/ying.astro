---
import BaseLayout from "../layouts/BaseLayout.astro";
import logo from "../assets/svg/logo-arianna-milano.svg";
import hero from "../assets/images/ying-hero-wide.png";
import eagleDetail from "../assets/images/hero-eagle-layer-aq2.png";
import portrait from "../assets/images/profile-placeholder.png";

const values = [
  ["Osservare", "Guardo e ascolto prima di muovermi."],
  ["Provare", "Metto in pratica quello che imparo."],
  ["Crescere", "Ogni allenamento mi insegna qualcosa."]
];
---

<BaseLayout title="Yīng · Aquila | Arianna Milano" description="Yīng significa aquila: il nome scelto da Arianna per accompagnarla sul tatami, un allenamento alla volta.">
  <a class="skip-link" href="#main" data-interactive>Vai al contenuto</a>
  <main class="ying-page" id="main">
    <section class="hero" id="top" aria-labelledby="ying-title">
      <header class="site-head">
        <a href="/" data-interactive aria-label="Arianna Milano — Home"><img src={logo.src} alt="Arianna Milano" width={logo.width} height={logo.height} /></a>
        <nav aria-label="Navigazione principale">
          <a href="/profilo/" data-interactive>Profilo</a><a href="/ying/" data-interactive aria-current="page">Yīng</a><a href="/risultati/" data-interactive>Risultati</a><a href="/media/" data-interactive>Media</a>
        </nav>
        <span class="site-head__menu" aria-hidden="true"><i></i><i></i><i></i></span>
      </header>
      <img class="hero__art" src={hero.src} alt="Illustrazione pittorica di un'aquila in volo" width={hero.width} height={hero.height} fetchpriority="high" />
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="hero__content">
        <p class="eyebrow">Il mio nome sul tatami</p>
        <div class="wordmark" aria-label="Ying, aquila">
          <h1 id="ying-title" aria-label="Yīng"><b>Y</b><i>i</i><b>ng</b></h1><span>Aquila</span>
        </div>
        <p class="hero__claim">Un nome che mi ricorda<br />di guardare avanti.</p>
        <p class="hero__intro">Yīng significa aquila. È il nome che ho scelto per accompagnarmi sul tatami.</p>
      </div>
    </section>

    <section class="meaning" aria-labelledby="meaning-title">
      <div class="meaning__copy content-pad">
        <p class="eyebrow eyebrow--red">Il significato</p>
        <h2 id="meaning-title">Guardare lontano.<br /><em>Restare presenti.</em></h2>
        <p>Mi piace l’aquila perché osserva ciò che ha intorno e sceglie il momento giusto per muoversi.</p>
        <p>Per me Yīng è un piccolo promemoria: restare attenta, avere coraggio e continuare a imparare.</p>
      </div>
      <div class="meaning__visual" aria-hidden="true"><img src={eagleDetail.src} alt="" width={eagleDetail.width} height={eagleDetail.height} loading="lazy" /><span>Un allenamento alla volta</span></div>
    </section>

    <section class="choice" aria-labelledby="choice-title">
      <div class="choice__image"><img src={portrait.src} alt="Arianna durante un momento di allenamento" width={portrait.width} height={portrait.height} loading="lazy" /></div>
      <div class="choice__copy content-pad">
        <p class="eyebrow">Perché l’ho scelto</p>
        <h2 id="choice-title">Mi somiglia nel modo<br /><em>in cui voglio crescere.</em></h2>
        <p>Non perché devo essere la più forte, ma perché voglio imparare a osservare, scegliere e provare con fiducia.</p>
        <p>Sul tatami ascolto il mio maestro, imparo dai miei errori e cerco di dare il meglio che posso.</p>
      </div>
    </section>

    <section class="values" aria-labelledby="values-title">
      <div class="values__head"><p class="eyebrow eyebrow--red">Yīng sul tatami</p><h2 id="values-title">Tre gesti semplici.<br /><em>Ogni giorno.</em></h2></div>
      <div class="values__list" role="list">
        {values.map(([title, text]) => <article role="listitem"><span aria-hidden="true"></span><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <p class="eyebrow">Essere Yīng</p>
      <h2 id="closing-title">Non devo essere perfetta.</h2>
      <p>Voglio imparare, divertirmi e dare il meglio che posso.</p>
      <a href="/profilo/" data-interactive>Scopri il mio percorso <span aria-hidden="true">→</span></a>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body){background:#060605}.ying-page{--ink:#080706;--panel:#12100e;--paper:#eee7dc;--gold:#c49a54;--red:#a4201b;--soft:#bdb3a5;overflow:hidden;background:var(--ink);color:var(--paper)}
  .site-head{position:absolute;z-index:5;inset:0 0 auto;display:flex;align-items:center;justify-content:space-between;height:88px;padding:0 clamp(22px,4vw,64px);border-bottom:1px solid rgba(238,231,220,.12)}.site-head img{display:block;width:174px;height:auto}.site-head nav{display:flex;gap:28px}.site-head nav a{position:relative;padding:34px 0;color:rgba(238,231,220,.72);font:800 .62rem/1 var(--font-ui);letter-spacing:.16em;text-transform:uppercase}.site-head nav a:after{position:absolute;right:0;bottom:25px;left:0;height:1px;background:var(--red);transform:scaleX(0);content:""}.site-head nav a:hover,.site-head nav a:focus-visible,.site-head nav [aria-current=page]{color:#fff}.site-head nav [aria-current=page]:after{transform:scaleX(1)}.site-head__menu{display:none;width:24px}.site-head__menu i{display:block;height:1px;margin:5px 0;background:var(--gold)}
  .hero{position:relative;min-height:min(920px,100svh);isolation:isolate}.hero__art{position:absolute;z-index:-3;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}.hero__shade{position:absolute;z-index:-2;inset:0;background:linear-gradient(90deg,rgba(5,5,4,.18),rgba(5,5,4,.7) 40%,rgba(5,5,4,.08) 72%),linear-gradient(180deg,rgba(5,5,4,.15) 55%,#080706 100%)}.hero__content{width:min(520px,38vw);padding-top:clamp(175px,22vh,250px);margin-left:clamp(36px,7.4vw,118px)}.eyebrow{margin:0;color:var(--gold);font:800 .66rem/1.2 var(--font-ui);letter-spacing:.22em;text-transform:uppercase}.eyebrow--red{color:var(--red)}
  .wordmark{position:relative;display:inline-block;margin-top:30px;padding-bottom:30px}.wordmark:after{position:absolute;bottom:16px;left:2px;width:72%;height:2px;background:linear-gradient(90deg,var(--red),transparent);transform:skewX(-28deg);content:""}.wordmark h1{margin:0;color:#efe7da;font:500 clamp(5.8rem,9vw,9rem)/.78 Georgia,"Times New Roman",serif;letter-spacing:-.055em}.wordmark h1 b{font:inherit}.wordmark h1 i{position:relative;font:inherit}.wordmark h1 i:before{position:absolute;top:-.02em;left:48%;width:.62em;height:2px;background:linear-gradient(90deg,#9d7232,#e2b65e 55%,#9d7232);content:"";transform:translateX(-50%) rotate(-4deg)}.wordmark span{position:absolute;right:-25px;bottom:0;color:var(--gold);font:800 .6rem/1 var(--font-ui);letter-spacing:.34em;text-transform:uppercase}.hero__claim{margin:45px 0 0;color:#fff;font:600 clamp(1.75rem,2.5vw,2.55rem)/1.15 Georgia,"Times New Roman",serif}.hero__intro{max-width:40ch;margin:25px 0 0;color:var(--soft);font:400 1rem/1.7 var(--font-body)}
  .content-pad{padding:clamp(80px,9vw,140px) clamp(28px,7vw,108px)}.meaning{display:grid;grid-template-columns:.84fr 1.16fr;min-height:720px;background:var(--paper);color:#17130f}.meaning h2,.choice h2,.values h2,.closing h2{margin:30px 0 40px;font:500 clamp(3.2rem,5.6vw,6rem)/.94 Georgia,"Times New Roman",serif;letter-spacing:-.04em}.meaning h2 em,.values h2 em{color:var(--red);font-style:normal}.meaning__copy>p:not(.eyebrow),.choice__copy>p:not(.eyebrow){max-width:50ch;margin:0 0 18px;color:#544b41;font:400 1rem/1.7 var(--font-body)}.meaning__visual{position:relative;overflow:hidden;background:#ddd2c3}.meaning__visual img{position:absolute;inset:0;width:180%;height:100%;max-width:none;object-fit:cover;object-position:left center;filter:grayscale(1) sepia(.3) brightness(1.3) contrast(.82);mix-blend-mode:multiply}.meaning__visual:after{position:absolute;inset:0;background:linear-gradient(90deg,var(--paper),transparent 20%);content:""}.meaning__visual span{position:absolute;z-index:1;right:36px;bottom:36px;color:var(--red);font:800 .58rem/1 var(--font-ui);letter-spacing:.16em;text-transform:uppercase}
  .choice{display:grid;grid-template-columns:1fr 1fr;min-height:780px;background:var(--panel)}.choice__image{position:relative;overflow:hidden}.choice__image:after{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,7,6,.05),rgba(18,16,14,.75) 100%);content:""}.choice__image img{width:100%;height:100%;object-fit:cover;filter:grayscale(1) sepia(.12) brightness(.55) contrast(1.12)}.choice__copy{align-self:center}.choice h2 em{color:var(--gold);font-style:normal}.choice__copy>p:not(.eyebrow){color:#b5aa9d}
  .values{padding:clamp(86px,9vw,130px) clamp(28px,6vw,92px);background:var(--paper);color:#181410}.values__head{display:flex;align-items:end;justify-content:space-between;gap:50px}.values h2{margin-bottom:0}.values__list{display:grid;grid-template-columns:repeat(3,1fr);margin-top:75px;border-top:1px solid rgba(83,62,36,.22)}.values article{position:relative;padding:42px clamp(20px,3vw,48px) 0;border-right:1px solid rgba(83,62,36,.18)}.values article:first-child{padding-left:0}.values article:last-child{border:0}.values article span{display:block;width:34px;height:34px;border:1px solid var(--gold);border-radius:50%}.values article span:after{display:block;width:8px;height:8px;margin:12px;border-radius:50%;background:var(--red);content:""}.values h3{margin:25px 0 12px;font:800 1rem/1 var(--font-ui);letter-spacing:.13em;text-transform:uppercase}.values article p{max-width:30ch;margin:0;color:#62584c;font:400 .88rem/1.65 var(--font-body)}
  .closing{position:relative;display:flex;min-height:650px;flex-direction:column;align-items:center;justify-content:center;padding:90px 24px;text-align:center;background:radial-gradient(circle at 50% 48%,rgba(196,154,84,.09),transparent 34%),#050504}.closing h2{position:relative;margin:26px 0 20px;color:#f2ebe1}.closing>p:not(.eyebrow){position:relative;margin:0;color:var(--soft);font:400 1rem/1.7 var(--font-body)}.closing>a{position:relative;display:flex;gap:44px;align-items:center;margin-top:42px;padding:16px 22px;border:1px solid rgba(196,154,84,.58);color:#f2ebe1;font:800 .6rem/1 var(--font-ui);letter-spacing:.16em;text-transform:uppercase}.closing>a:hover,.closing>a:focus-visible{background:var(--gold);color:#080706}
  @media(max-width:760px){.site-head{height:68px;padding:0 18px}.site-head img{width:140px}.site-head nav{display:none}.site-head__menu{display:block}.hero{min-height:850px}.hero__art{height:47%;object-position:66% center}.hero__shade{background:linear-gradient(180deg,rgba(5,5,4,.05) 0 30%,var(--ink) 48%)}.hero__content{width:auto;margin:0;padding:440px 20px 72px}.hero__content>.eyebrow{text-align:center}.wordmark{display:block;width:max-content;margin:24px auto 0}.wordmark h1{font-size:5.3rem}.wordmark span{right:-8px}.hero__claim{margin-top:36px;font-size:1.7rem}.hero__intro{font-size:1rem}.meaning,.choice{grid-template-columns:1fr;min-height:0}.meaning__visual{grid-row:1;min-height:300px}.meaning__visual:after{background:linear-gradient(180deg,transparent 50%,var(--paper))}.meaning__visual span{right:20px;bottom:24px}.content-pad{padding:62px 20px 76px}.meaning h2,.choice h2,.values h2,.closing h2{font-size:2.85rem}.meaning__copy>p:not(.eyebrow),.choice__copy>p:not(.eyebrow),.values article p{font-size:1rem}.choice__image{height:420px}.choice__image:after{background:linear-gradient(180deg,transparent 55%,var(--panel))}.values{padding:72px 20px}.values__head{display:block}.values__list{grid-template-columns:1fr;margin-top:48px}.values article,.values article:first-child{padding:28px 0;border-right:0;border-bottom:1px solid rgba(83,62,36,.18)}.values article:last-child{border:0}.values article span{width:30px;height:30px}.values article span:after{margin:10px}.closing{min-height:560px;padding:78px 20px}.closing>a{width:100%;justify-content:space-between}.closing h2{font-size:2.65rem}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
