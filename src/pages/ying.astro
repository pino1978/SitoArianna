---
import BaseLayout from "../layouts/BaseLayout.astro";
import logo from "../assets/svg/logo-arianna-milano.svg";
import artwork from "../assets/images/profile-ying-bg.png";
---

<BaseLayout
  title="Yīng | Arianna Milano"
  description="Yīng è la firma sportiva di Arianna Milano: visione, controllo e precisione sul tatami."
>
  <header class="ying-header">
    <a class="ying-brand" href="/" aria-label="Arianna Milano, torna alla home">
      <img src={logo.src} alt="Arianna Milano" width={logo.width} height={logo.height} />
    </a>
    <nav aria-label="Navigazione principale">
      <a href="/profilo/">Profilo</a>
      <a href="/ying/" aria-current="page">Ying</a>
      <a href="/#risultati">Risultati</a>
      <a href="/#media">Media</a>
    </nav>
  </header>

  <main id="main">
    <section class="ying-hero" aria-labelledby="ying-title">
      <div class="ying-artwork" aria-hidden="true">
        <img src={artwork.src} alt="" width={artwork.width} height={artwork.height} />
      </div>

      <div class="ying-manifesto">
        <div class="manifesto-inner">
          <p class="manifesto-kicker">La mia firma sul tatami</p>

          <div class="identity-line">
            <h1 id="ying-title">Yīng</h1>
            <p><span lang="zh-Hans">鹰</span><i aria-hidden="true"></i>Aquila</p>
          </div>

          <div class="manifesto-statement">
            <p>Vedere prima.<br />Scegliere <em>il momento.</em></p>
          </div>

          <p class="manifesto-intro">
            Ho scelto Yīng perché nell’aquila riconosco il mio modo di affrontare il tatami:
            osservare, restare concentrata e agire con precisione.
          </p>

          <ol class="principles" aria-label="I tre principi di Yīng">
            <li>
              <strong>Visione</strong>
              <p>Leggere lo spazio prima del movimento.</p>
            </li>
            <li>
              <strong>Controllo</strong>
              <p>Restare lucida, anche sotto pressione.</p>
            </li>
            <li>
              <strong>Precisione</strong>
              <p>Trasformare l’attesa nell’azione giusta.</p>
            </li>
          </ol>

          <p class="manifesto-note">Yīng non è un personaggio. È il segno del percorso di Arianna.</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) { background: #050504; }
  .ying-header { position: relative; z-index: 10; display: flex; align-items: center; justify-content: space-between; height: 87px; padding: 0 clamp(28px, 3.7vw, 60px); border-bottom: 1px solid rgba(217, 164, 65, .14); background: #050504; font-family: var(--font-ui); }
  .ying-brand { display: block; width: 132px; height: 58px; overflow: hidden; }
  .ying-brand img { width: 132px; height: auto; }
  .ying-header nav { display: flex; gap: clamp(22px, 2.2vw, 36px); align-items: center; }
  .ying-header nav a { position: relative; color: #aaa39b; font-size: .68rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .ying-header nav a:hover, .ying-header nav a:focus-visible, .ying-header nav a[aria-current="page"] { color: var(--gold-bright); }
  .ying-header nav a[aria-current="page"]::after { position: absolute; right: 0; bottom: -18px; left: 0; height: 1px; background: var(--gold-bright); content: ""; }
  .ying-hero { display: grid; grid-template-columns: 50% 50%; min-height: calc(100svh - 87px); overflow: hidden; background: #070706; }
  .ying-artwork { position: relative; min-height: 690px; overflow: hidden; background: #090908; }
  .ying-artwork::after { position: absolute; inset: 0; background: linear-gradient(90deg, transparent 72%, #070706 100%), linear-gradient(0deg, rgba(0,0,0,.3), transparent 36%); content: ""; }
  .ying-artwork img { width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 67% center; filter: saturate(.72) brightness(.62) contrast(1.08); }
  .ying-manifesto { position: relative; display: grid; align-items: center; min-width: 0; padding: clamp(44px, 5.2vw, 86px) clamp(44px, 6vw, 100px); background: radial-gradient(circle at 2% 5%, rgba(185,134,50,.11), transparent 30%), radial-gradient(circle at 100% 100%, rgba(105,13,11,.07), transparent 36%), #070706; }
  .ying-manifesto::before { position: absolute; inset: 7% auto 7% 0; width: 1px; background: linear-gradient(transparent, rgba(217,164,65,.46) 20%, rgba(217,164,65,.2) 82%, transparent); content: ""; }
  .manifesto-inner { width: min(100%, 620px); }
  .manifesto-kicker { margin: 0 0 18px; color: var(--gold-bright); font-family: var(--font-ui); font-size: .68rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; }
  .identity-line { display: flex; align-items: baseline; gap: 24px; }
  .identity-line h1 { margin: 0; color: #f4eee5; font-family: var(--font-display); font-size: clamp(5.1rem, 7.25vw, 7.6rem); font-weight: 800; line-height: .88; letter-spacing: -.055em; }
  .identity-line > p { display: flex; gap: 10px; align-items: center; margin: 0; color: var(--gold-bright); font-family: var(--font-ui); font-size: .67rem; font-style: normal; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; white-space: nowrap; }
  .identity-line > p span { font-family: serif; font-size: 1.1rem; }
  .identity-line i { width: 18px; height: 1px; background: rgba(217,164,65,.65); }
  .manifesto-statement { margin-top: 27px; padding: 23px 0 21px; border-top: 1px solid rgba(217,164,65,.32); border-bottom: 1px solid rgba(217,164,65,.18); }
  .manifesto-statement p { margin: 0; color: #f4eee5; font-family: var(--font-display); font-size: clamp(2rem, 2.5vw, 2.65rem); font-weight: 800; line-height: .98; letter-spacing: -.025em; text-transform: uppercase; }
  .manifesto-statement em { color: var(--gold-bright); font-style: normal; }
  .manifesto-intro { max-width: 535px; margin: 20px 0 23px; color: #d3cbc0; font-size: clamp(.98rem, 1.05vw, 1.1rem); line-height: 1.55; }
  .principles { margin: 0; padding: 0; list-style: none; border-bottom: 1px solid rgba(217,164,65,.2); }
  .principles li { display: grid; grid-template-columns: 122px 1fr; gap: 12px; align-items: center; min-height: 46px; border-top: 1px solid rgba(217,164,65,.2); font-family: var(--font-ui); }
  .principles strong { color: #eee8df; font-size: .69rem; letter-spacing: .13em; text-transform: uppercase; }
  .principles p { margin: 0; color: #aaa39a; font-family: var(--font-body); font-size: .86rem; line-height: 1.35; }
  .manifesto-note { margin: 18px 0 0; color: #827b72; font-family: var(--font-ui); font-size: .62rem; letter-spacing: .11em; line-height: 1.5; text-transform: uppercase; }
  @media (max-width: 1100px) {
    .ying-hero { grid-template-columns: 47% 53%; }
    .ying-manifesto { padding-inline: 42px; }
    .identity-line { display: block; }
    .identity-line > p { margin-top: 12px; }
  }
  @media (max-width: 760px) {
    .ying-header { height: 76px; padding-inline: 20px; }
    .ying-brand { width: 112px; height: 50px; }
    .ying-brand img { width: 112px; }
    .ying-header nav { gap: 18px; }
    .ying-header nav a { font-size: .61rem; }
    .ying-header nav a:first-child, .ying-header nav a:nth-child(3) { display: none; }
    .ying-hero { display: block; min-height: 0; }
    .ying-artwork { min-height: 0; aspect-ratio: 4 / 3; }
    .ying-artwork::after { background: linear-gradient(0deg, #070706 0, transparent 20%); }
    .ying-artwork img { object-position: 69% center; }
    .ying-manifesto { padding: 34px 24px 46px; }
    .ying-manifesto::before { display: none; }
    .identity-line h1 { font-size: clamp(4rem, 20vw, 5.2rem); }
    .manifesto-statement { margin-top: 24px; }
    .principles li { grid-template-columns: 1fr; gap: 5px; padding: 11px 0; }
  }
  @media (max-width: 380px) {
    .ying-header nav a:last-child { display: none; }
    .ying-manifesto { padding-inline: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; } }
</style>
