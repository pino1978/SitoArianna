---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { Image } from "astro:assets";
import hero from "../assets/images/ying-hero-wide.png";
import wordmark from "../assets/images/ying-wordmark-underline.png";
import preparation from "../assets/images/discipline-placeholder.png";
import portrait from "../assets/images/Ying_profile.png";
import panorama from "../assets/images/ying_panoramica.png";
---

<BaseLayout title="Yīng · Aquila | Arianna Milano" description="Yīng significa aquila. È il nome scelto da Arianna per accompagnarla sul tatami, un allenamento alla volta.">
  <a class="skip-link" href="#main" data-interactive>Vai al contenuto</a>
  <Header />
  <main class="ying-page" id="main">
    <section class="hero" id="top" aria-labelledby="ying-title">
      <Image class="hero__art" src={hero} alt="Illustrazione pittorica di un'aquila in volo, simbolo del nome sportivo Yīng di Arianna Milano" widths={[640,960,1280,1600,1920]} sizes="100vw" format="webp" quality={78} loading="eager" fetchpriority="high" />
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="hero__content">
        <div class="hero__identity"><p class="eyebrow">Il mio nome sul tatami</p><div class="wordmark" aria-label="Ying, aquila"><h1 id="ying-title"><img src={wordmark.src} alt="Yīng" width={wordmark.width} height={wordmark.height} /></h1><p><span aria-hidden="true"></span>Aquila<span aria-hidden="true"></span></p></div></div>
        <p class="hero__claim">Guardo. Scelgo. Provo.</p>
        <div class="hero__intro"><p>Yīng significa aquila.<br />Ho scelto questo nome perché mi ricorda di osservare.<br />Di restare concentrata.<br />Di capire quello che succede intorno a me per poi agire.</p></div>
      </div>
    </section>

    <section class="meaning" aria-labelledby="meaning-title">
      <div class="meaning__visual"><Image src={portrait} alt="Arianna Milano osserva il tatami prima dell’allenamento di Sanda" widths={[480,720,960]} sizes="(max-width: 760px) 100vw, 44vw" format="webp" quality={78} loading="lazy" /><span>Attenzione prima dell’azione</span></div>
      <div class="meaning__copy content-pad"><p class="eyebrow eyebrow--red">Cosa significa per me</p><h2 id="meaning-title">Prima guardo.<br /><em>Poi mi muovo.</em></h2><p>Mi piace l’idea dell’aquila che osserva prima di muoversi.<br />Non è soltanto forza.<br />È attenzione, pazienza e capacità di scegliere il momento giusto.</p><p>Sul tatami provo a fare lo stesso.<br />Guardo chi ho davanti e ascolto il mio maestro.<br />Poi decido.</p></div>
    </section>

    <section class="choice" aria-labelledby="choice-title">
      <div class="choice__copy content-pad"><p class="eyebrow">Perché l’ho scelto</p><h2 id="choice-title">Un nome che cresce<br /><em>insieme a me.</em></h2><p>Yīng non racconta quello che sono già.<br />Racconta qualcosa verso cui voglio continuare a crescere.</p><p>Più mi alleno, più capisco che essere forte non significa riuscire sempre.<br />Significa continuare a provarci e imparare.<br />Ogni volta torno sul tatami con qualcosa in più.</p></div>
      <div class="choice__image"><Image src={preparation} alt="Arianna Milano prepara le fasce prima dell’allenamento di Sanda" widths={[480,720,960]} sizes="(max-width: 760px) 100vw, 44vw" format="webp" quality={78} loading="lazy" /></div>
    </section>

    <section class="journey" aria-labelledby="journey-title">
      <Image src={panorama} alt="Una giovane atleta osserva le montagne al tramonto mentre un’aquila vola in lontananza" widths={[640,960,1280,1600,1920]} sizes="100vw" format="webp" quality={80} loading="lazy" />
      <div class="journey__copy">
        <p class="eyebrow">Essere Yīng</p>
        <h2 id="journey-title">Continuare a imparare.</h2>
        <p>Ogni allenamento mi insegna qualcosa: a restare concentrata, ad ascoltare e a non fermarmi quando una cosa non riesce subito.</p>
        <p>Voglio crescere un passo alla volta, con impegno e curiosità. Per me essere Yīng significa proprio questo: guardare avanti e avere sempre il coraggio di riprovare.</p>
        <nav class="journey__actions" aria-label="Continua il percorso di Arianna">
          <a href="/profilo/" data-interactive>Scopri il profilo <span aria-hidden="true">→</span></a>
          <a href="/risultati/" data-interactive>Scopri i miei risultati <span aria-hidden="true">→</span></a>
        </nav>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
:global(body){background:#060605}.ying-page{--ink:#080706;--panel:#12100e;--paper:#eee7dc;--gold:#c49a54;--red:#a4201b;--soft:#bdb3a5;overflow:hidden;background:var(--ink);color:var(--paper)}
.hero{position:relative;height:clamp(480px,58svh,600px);min-height:480px;isolation:isolate}.hero__art{position:absolute;z-index:-3;inset:0;width:100%;height:100%;object-fit:cover;object-position:72% center}.hero__shade{position:absolute;z-index:-2;inset:0;background:linear-gradient(90deg,rgba(5,5,4,.12),rgba(5,5,4,.78) 43%,rgba(5,5,4,.05) 73%),linear-gradient(180deg,rgba(5,5,4,.12) 55%,#080706 100%)}.hero__content{width:min(620px,43vw);padding-top:clamp(84px,9vh,112px);margin-left:clamp(36px,7.4vw,118px);padding-bottom:30px}.eyebrow{margin:0;color:var(--gold);font:800 .66rem/1.2 var(--font-ui);letter-spacing:.22em;text-transform:uppercase}.eyebrow--red{color:var(--red)}
.wordmark{display:inline-grid;margin-top:20px;justify-items:start}.wordmark h1{margin:0;line-height:0}.wordmark h1 img{display:block;width:clamp(250px,22vw,340px);height:auto}.wordmark>p{display:flex;align-items:center;gap:14px;margin:14px 0 0;color:#f0bd57;font:800 .65rem/1 var(--font-ui);letter-spacing:.38em;text-transform:uppercase}.wordmark>p span{width:32px;height:1px;background:rgba(240,189,87,.72)}.hero__claim{margin:20px 0 0;color:#fff;font:600 clamp(1.9rem,2.6vw,2.7rem)/1.12 Georgia,"Times New Roman",serif}.hero__intro{max-width:58ch;margin:12px 0 0;color:var(--soft);font:400 1.08rem/1.52 var(--font-body)}.hero__intro p{margin:0 0 8px}
.content-pad{padding:clamp(62px,6.5vw,96px) clamp(28px,6vw,92px)}.meaning{display:grid;grid-template-columns:.86fr 1.14fr;min-height:540px;background:var(--paper);color:#17130f}.meaning h2,.choice h2{margin:26px 0 32px;font:500 clamp(3rem,4.7vw,5.2rem)/.95 Georgia,"Times New Roman",serif;letter-spacing:-.04em}.meaning h2 em{color:var(--red);font-style:normal}.meaning__copy>p:not(.eyebrow),.choice__copy>p:not(.eyebrow){max-width:52ch;margin:0 0 18px;color:#544b41;font:400 1.08rem/1.68 var(--font-body)}.meaning__copy{align-self:center}.meaning__visual{position:relative;overflow:hidden;background:#d5c8b6}.meaning__visual img{display:block;width:100%;height:100%;object-fit:cover;object-position:72% center;filter:grayscale(1) sepia(.2) contrast(.95)}.meaning__visual:after{position:absolute;inset:0;background:linear-gradient(90deg,transparent 76%,var(--paper));content:""}.meaning__visual span{position:absolute;z-index:1;left:30px;bottom:30px;color:#fff;font:800 .58rem/1 var(--font-ui);letter-spacing:.16em;text-transform:uppercase}
.choice{display:grid;grid-template-columns:1.08fr .92fr;min-height:560px;background:var(--panel)}.choice__copy{position:relative;z-index:2;align-self:center}.choice h2 em{color:var(--gold);font-style:normal}.choice__copy>p:not(.eyebrow){color:#b5aa9d}.choice__image{position:relative;overflow:hidden;margin:0;background:var(--panel)}.choice__image img{display:block;width:100%;height:100%;object-fit:cover;filter:grayscale(1) sepia(.12) brightness(.62) contrast(1.1)}.choice__image:after{position:absolute;inset:0;background:linear-gradient(90deg,var(--panel) 0%,rgba(18,16,14,.78) 10%,rgba(18,16,14,.28) 30%,transparent 58%),linear-gradient(180deg,rgba(18,16,14,.12),rgba(18,16,14,.1));content:""}
.journey{position:relative;height:540px;overflow:hidden;background:#050607}.journey>img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 43%}.journey:after{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,3,3,.06) 0%,rgba(3,3,3,.08) 30%,rgba(3,3,3,.34) 48%,rgba(3,3,3,.72) 70%,rgba(3,3,3,.88) 100%),linear-gradient(180deg,rgba(3,3,3,.08),rgba(3,3,3,.2));content:""}.journey__copy{position:absolute;z-index:1;top:50%;right:clamp(34px,7vw,112px);left:auto;width:min(560px,40vw);max-width:560px;transform:translateY(-50%)}.journey__copy h2{margin:18px 0 16px;color:#f5eee3;font:500 clamp(2.4rem,4.2vw,4.7rem)/.98 Georgia,"Times New Roman",serif;letter-spacing:-.04em}.journey__copy>p:not(.eyebrow){max-width:50ch;margin:0 0 12px;color:rgba(245,238,227,.84);font:400 1.03rem/1.55 var(--font-body)}.journey__actions{display:grid;width:min(370px,100%);gap:10px;margin-top:22px}.journey__actions a{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 18px;border:1px solid rgba(196,154,84,.62);color:var(--gold);font:800 .68rem/1 var(--font-ui);letter-spacing:.14em;text-decoration:none;text-transform:uppercase}.journey__actions a:hover,.journey__actions a:focus-visible{border-color:var(--gold);background:rgba(196,154,84,.08)}
@media(max-width:980px) and (min-width:761px){.journey__copy{right:34px;width:46vw}.journey__copy h2{font-size:clamp(2.6rem,5vw,3.8rem)}.journey__copy>p:not(.eyebrow){font-size:.96rem}.journey__actions{width:min(340px,100%)}}
@media(max-width:760px){.hero{display:grid;grid-template-columns:minmax(0,1fr);height:auto;min-height:0;padding-top:0}.hero__art{position:relative;z-index:-1;grid-area:1/1;width:100%;height:auto;aspect-ratio:1.62/1;object-fit:cover;object-position:center top;-webkit-mask-image:linear-gradient(180deg,#000 0%,#000 72%,rgba(0,0,0,.76) 86%,transparent 100%);mask-image:linear-gradient(180deg,#000 0%,#000 72%,rgba(0,0,0,.76) 86%,transparent 100%)}.hero__shade{grid-area:1/1;background:linear-gradient(180deg,transparent 56%,rgba(8,7,6,.68) 80%,var(--ink) 100%)}.hero__content{box-sizing:border-box;min-width:0;width:100%;margin:-32px 0 0;padding:10px 20px 36px}.hero__identity{position:absolute;z-index:2;top:clamp(28px,5vw,44px);left:20px}.hero__identity>.eyebrow{text-align:left}.wordmark{display:grid;width:max-content;max-width:100%;margin:18px 0 0;justify-items:start}.wordmark h1 img{width:min(38vw,180px)}.wordmark>p{margin-top:14px}.hero__claim{margin-top:8px;font-size:1.78rem}.hero__intro{color:#c9c1b6;font-size:.96rem;line-height:1.55}.meaning,.choice{grid-template-columns:minmax(0,1fr);min-height:0}.meaning>*,.choice>*{min-width:0}.meaning__visual{min-height:0;background:var(--paper)}.meaning__visual img{height:auto;aspect-ratio:3/2;object-fit:contain;object-position:center;background:#d5c8b6;-webkit-mask-image:linear-gradient(180deg,#000 0%,#000 72%,rgba(0,0,0,.74) 87%,transparent 100%);mask-image:linear-gradient(180deg,#000 0%,#000 72%,rgba(0,0,0,.74) 87%,transparent 100%)}.meaning__visual:after{display:none}.meaning__visual span{left:20px;bottom:20px}.content-pad{box-sizing:border-box;min-width:0;width:100%;padding:48px 20px 44px}.choice__copy{position:relative;z-index:2;margin-top:-36px}.meaning h2,.choice h2{margin:20px 0 22px;font-size:2.55rem;line-height:.98}.meaning__copy>p:not(.eyebrow),.choice__copy>p:not(.eyebrow){margin-bottom:10px;font-size:.96rem;line-height:1.55}.choice__image{order:-1;height:auto;margin:0}.choice__image img{height:auto;aspect-ratio:3/2;object-fit:contain;background:#12100e;-webkit-mask-image:linear-gradient(180deg,#000 0%,#000 68%,rgba(0,0,0,.74) 85%,transparent 100%);mask-image:linear-gradient(180deg,#000 0%,#000 68%,rgba(0,0,0,.74) 85%,transparent 100%)}.choice__image:after{border:0;background:linear-gradient(180deg,transparent 66%,rgba(18,16,14,.62) 84%,var(--panel) 100%)}.journey{display:flex;height:auto;flex-direction:column}.journey>img{position:relative;z-index:1;width:100%;height:auto;margin-bottom:-34px;object-fit:initial;object-position:center;-webkit-mask-image:linear-gradient(180deg,#000 0%,#000 70%,rgba(0,0,0,.7) 86%,transparent 100%);mask-image:linear-gradient(180deg,#000 0%,#000 70%,rgba(0,0,0,.7) 86%,transparent 100%)}.journey:after{display:none}.journey__copy{position:static;width:auto;max-width:none;padding:28px 20px 34px;transform:none;background:#050607}.journey__copy h2{margin:18px 0 16px;font-size:2.25rem;line-height:1}.journey__copy>p:not(.eyebrow){font-size:.96rem;line-height:1.55}.journey__actions{width:100%;gap:12px;margin-top:22px}.journey__actions a{width:100%;box-sizing:border-box}}
@media(max-width:390px){.hero__content,.content-pad{padding-right:16px;padding-left:16px}.hero__identity{top:28px;left:16px}.wordmark h1 img{width:min(38vw,150px)}.wordmark>p{gap:9px;font-size:.58rem}.wordmark>p span{width:22px}.hero__claim{font-size:1.54rem}.meaning h2,.choice h2{font-size:2.08rem;overflow-wrap:anywhere}.meaning__copy>p:not(.eyebrow),.choice__copy>p:not(.eyebrow){max-width:100%;overflow-wrap:anywhere}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>